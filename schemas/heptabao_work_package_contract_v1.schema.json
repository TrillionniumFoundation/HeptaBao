{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptabao.dev/schemas/heptabao_work_package_contract_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "critical",
    "contract_profile",
    "objective",
    "authority_effect"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^H(?:0[0-9]|1[0-9]|2[0-7])-WP[0-9]{2,3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "critical": {
      "type": "boolean"
    },
    "contract_profile": {
      "enum": [
        "STANDARD",
        "CRITICAL",
        "DISTRIBUTED_OR_SCALE_CRITICAL"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
