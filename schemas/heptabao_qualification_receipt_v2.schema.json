{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptabao.invalid/schemas/qualification-v2.json",
  "title": "HeptaBao Qualification Receipt V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_binding",
    "gate_id",
    "receipt_id",
    "status",
    "generated_at_utc",
    "valid_until_utc",
    "source",
    "environment",
    "dependency_receipts",
    "evidence",
    "test_summary",
    "findings",
    "exit_gates",
    "approvals",
    "signature",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "heptabao.qualification-receipt.v2"},
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "revision", "plan_digest_sha256"],
      "properties": {
        "plan_id": {"const": "HEPTABAO-PLAN-2026-08-28"},
        "revision": {"const": "1.1"},
        "plan_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gate_id": {"pattern": "^H(0[0-9]|1[0-9]|2[0-7])$"},
    "receipt_id": {"pattern": "^HB-QR-[A-Z0-9._-]{8,200}$"},
    "status": {"enum": ["QUALIFIED", "FAILED", "BLOCKED", "SUPERSEDED", "REVOKED"]},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "valid_until_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "tree_sha", "clean_tree", "ref"],
      "properties": {
        "repository": {"const": "ProfHepta/HeptaBao"},
        "commit_sha": {"$ref": "#/$defs/sha40"},
        "tree_sha": {"$ref": "#/$defs/sha40"},
        "clean_tree": {"type": "boolean"},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_image", "os", "arch", "rustc", "cargo", "python", "dependency_lock_sha256", "config_digest_sha256"],
      "properties": {
        "runner_image": {"type": "string"},
        "os": {"type": "string"},
        "arch": {"type": "string"},
        "rustc": {"type": "string"},
        "cargo": {"type": "string"},
        "python": {"type": "string"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "config_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependency_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["receipt_id", "sha256"],
        "properties": {
          "receipt_id": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "sha256"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "test_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped", "unknown", "required_lanes"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "required_lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "evidence_ref"],
            "properties": {
              "id": {"type": "string"},
              "status": {"enum": ["PASS", "FAIL", "SKIP", "UNKNOWN"]},
              "evidence_ref": {"type": "string"}
            }
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_open", "high_open", "medium_open", "low_open", "unclassified", "accepted_risks"],
      "properties": {
        "critical_open": {"type": "integer", "minimum": 0},
        "high_open": {"type": "integer", "minimum": 0},
        "medium_open": {"type": "integer", "minimum": 0},
        "low_open": {"type": "integer", "minimum": 0},
        "unclassified": {"type": "integer", "minimum": 0},
        "accepted_risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exit_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence_ref"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN"]},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "identity", "decision", "timestamp_utc", "signature_ref"],
        "properties": {
          "role": {"enum": ["program", "security", "domain", "compatibility", "crypto", "distributed-systems", "operations", "migration", "release", "legal"]},
          "identity": {"type": "string", "minLength": 1},
          "decision": {"enum": ["APPROVE", "REJECT", "ABSTAIN"]},
          "timestamp_utc": {"type": "string", "format": "date-time"},
          "signature_ref": {"type": "string", "minLength": 8}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature_ref", "payload_sha256"],
      "properties": {
        "algorithm": {"enum": ["sigstore-bundle", "ed25519", "ecdsa-p256-sha256"]},
        "key_id": {"type": "string", "minLength": 1},
        "signature_ref": {"type": "string", "minLength": 8},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority_effect": {"const": "NONE"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "QUALIFIED"}}},
      "then": {
        "properties": {
          "source": {"properties": {"clean_tree": {"const": true}}},
          "test_summary": {
            "properties": {
              "failed": {"const": 0},
              "unknown": {"const": 0},
              "required_lanes": {"items": {"properties": {"status": {"const": "PASS"}}}}
            }
          },
          "findings": {
            "properties": {
              "critical_open": {"const": 0},
              "high_open": {"const": 0},
              "unclassified": {"const": 0}
            }
          },
          "exit_gates": {"items": {"properties": {"status": {"const": "PASS"}}}},
          "approvals": {
            "minItems": 3,
            "items": {"properties": {"decision": {"const": "APPROVE"}}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
