{
  "$id": "https://heptabao.invalid/schemas/heptabao_h02_linearizability_result_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "EXECUTED_PASS"}}, "required": ["status"]},
      "then": {"properties": {"linearizable": {"const": true}}}
    },
    {
      "if": {"properties": {"status": {"const": "EXECUTED_FAIL"}}, "required": ["status"]},
      "then": {"properties": {"linearizable": {"const": false}}}
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]},
      "then": {"properties": {"linearizable": {"type": "null"}}}
    }
  ],
  "properties": {
    "authority_effect": {"const": "NONE"},
    "checker": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "bounded-real-time-precedence-backtracking"},
        "max_operations": {"const": 64},
        "model": {"const": "single-register-v1"}
      },
      "required": ["algorithm", "model", "max_operations"],
      "type": "object"
    },
    "explored_states": {"minimum": 0, "type": "integer"},
    "history_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "linearizable": {"type": ["boolean", "null"]},
    "operation_count": {"maximum": 64, "minimum": 0, "type": "integer"},
    "promotion_effect": {"const": "BLOCK_PENDING_DURABLE_STORE_OS_DISK_CLOCK_AND_INDEPENDENT_REPRODUCTION"},
    "qualification": {"const": false},
    "reason": {"minLength": 1, "type": "string"},
    "schema": {"const": "heptabao.h02-linearizability-result.v1"},
    "selection_effect": {"const": "NONE"},
    "status": {"enum": ["EXECUTED_PASS", "EXECUTED_FAIL", "BLOCKED"]},
    "witness_order": {"items": {"minLength": 1, "type": "string"}, "maxItems": 64, "type": "array"}
  },
  "required": [
    "schema", "status", "linearizable", "history_sha256", "operation_count", "witness_order",
    "explored_states", "reason", "checker", "qualification", "selection_effect", "promotion_effect", "authority_effect"
  ],
  "title": "HeptaBao H02 linearizability checker result v1",
  "type": "object"
}
