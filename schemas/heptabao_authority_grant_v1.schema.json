{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptabao.invalid/schemas/authority-grant-v1.json",
  "title": "HeptaBao Authority Grant V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant_id", "plan_binding", "authority_kind", "scope", "qualification_receipts", "issued_at_utc", "not_before_utc", "expires_at_utc", "approvals", "signature", "revocation_status"],
  "properties": {
    "schema": {"const": "heptabao.authority-grant.v1"},
    "grant_id": {"pattern": "^HB-AG-[A-Z0-9._-]{8,200}$"},
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "revision", "plan_digest_sha256"],
      "properties": {
        "plan_id": {"const": "HEPTABAO-PLAN-2026-08-28"},
        "revision": {"const": "1.1"},
        "plan_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority_kind": {"enum": ["implementation_stage_promotion", "compatibility_publication", "migration_rehearsal", "migration_canary", "production_canary", "general_availability"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "environment", "domains", "operations"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "environment": {"enum": ["development", "internal-test", "migration-rehearsal", "canary", "production"]},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "qualification_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "sha256"],
        "properties": {"receipt_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
      }
    },
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "not_before_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "approvals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "identity", "decision", "timestamp_utc", "signature_ref"],
        "properties": {
          "role": {"enum": ["program", "security", "domain", "compatibility", "operations", "migration", "release", "legal"]},
          "identity": {"type": "string", "minLength": 1},
          "decision": {"const": "APPROVE"},
          "timestamp_utc": {"type": "string", "format": "date-time"},
          "signature_ref": {"type": "string", "minLength": 8}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature_ref", "payload_sha256"],
      "properties": {
        "algorithm": {"enum": ["sigstore-bundle", "ed25519", "ecdsa-p256-sha256"]},
        "key_id": {"type": "string", "minLength": 1},
        "signature_ref": {"type": "string", "minLength": 8},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "revocation_status": {"enum": ["ACTIVE", "REVOKED", "EXPIRED", "SUPERSEDED"]},
    "revocation_ref": {"type": ["string", "null"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
