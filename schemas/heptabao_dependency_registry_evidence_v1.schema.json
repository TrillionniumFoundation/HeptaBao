{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptabao.invalid/schemas/dependency-registry-evidence-v1.json",
  "title": "HeptaBao H02 Dependency Registry Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "revision",
    "evidence_id",
    "candidate_id",
    "capability",
    "captured_at_utc",
    "release_binding",
    "registry_source",
    "registry_entry",
    "byte_verification",
    "review_status",
    "selection_state",
    "qualification",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "heptabao.dependency-registry-evidence.v1"},
    "plan_id": {"const": "HEPTABAO-PLAN-2026-08-28"},
    "revision": {"const": "1.1"},
    "evidence_id": {"pattern": "^HB-DEP-REGISTRY-[A-Z0-9._-]{8,200}$"},
    "candidate_id": {"enum": ["HB-DEP-ASYNC-TOKIO", "HB-DEP-TLS-RUSTLS", "HB-DEP-RAFT-OPENRAFT"]},
    "capability": {"enum": ["ASYNC_RUNTIME", "TLS", "RAFT"]},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "release_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit_sha", "tree_sha"],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "commit_sha": {"$ref": "#/$defs/sha40"},
        "tree_sha": {"$ref": "#/$defs/sha40"}
      }
    },
    "registry_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit_sha", "path", "blob_sha"],
      "properties": {
        "repository": {"const": "https://github.com/rust-lang/crates.io-index"},
        "ref": {"const": "refs/heads/master"},
        "commit_sha": {"$ref": "#/$defs/sha40"},
        "path": {"type": "string", "minLength": 1},
        "blob_sha": {"$ref": "#/$defs/sha40"}
      }
    },
    "registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "checksum_sha256", "yanked", "rust_version", "published_at_utc", "observed_features"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "checksum_sha256": {"$ref": "#/$defs/sha256"},
        "yanked": {"const": false},
        "rust_version": {"type": ["string", "null"]},
        "published_at_utc": {"type": "string", "format": "date-time"},
        "observed_features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "byte_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "crate_download_sha256", "matches_registry_checksum", "source_archive_sha256", "source_archive_digest_kind", "package_vcs_commit_sha", "independent_reproduction_count"],
      "properties": {
        "status": {"enum": ["UNEXECUTED", "EXECUTED_MATCH", "EXECUTED_MISMATCH", "BLOCKED"]},
        "crate_download_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "matches_registry_checksum": {"type": "boolean"},
        "source_archive_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "source_archive_digest_kind": {"enum": ["NOT_CAPTURED", "OBSERVED_GITHUB_GENERATED_ARCHIVE", "PUBLISHER_SIGNED_CHECKSUM"]},
        "package_vcs_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "independent_reproduction_count": {"type": "integer", "minimum": 0}
      }
    },
    "review_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "security", "license", "specialist"],
      "properties": {
        "platform": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "security": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "license": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "specialist": {"enum": ["PENDING", "APPROVED", "REJECTED", "NOT_REQUIRED_OR_PENDING_PROFILE"]}
      }
    },
    "selection_state": {"const": "IDENTIFIED"},
    "qualification": {"const": false},
    "authority_effect": {"const": "NONE"}
  },
  "allOf": [
    {
      "if": {"properties": {"byte_verification": {"properties": {"status": {"const": "UNEXECUTED"}}}}},
      "then": {"properties": {"byte_verification": {"properties": {
        "crate_download_sha256": {"type": "null"},
        "matches_registry_checksum": {"const": false},
        "source_archive_sha256": {"type": "null"},
        "source_archive_digest_kind": {"const": "NOT_CAPTURED"},
        "package_vcs_commit_sha": {"type": "null"},
        "independent_reproduction_count": {"const": 0}
      }}}}
    },
    {
      "if": {"properties": {"byte_verification": {"properties": {"status": {"const": "EXECUTED_MATCH"}}}}},
      "then": {"properties": {"byte_verification": {"properties": {
        "crate_download_sha256": {"$ref": "#/$defs/sha256"},
        "matches_registry_checksum": {"const": true},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "package_vcs_commit_sha": {"$ref": "#/$defs/sha40"}
      }}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
