{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "profile_digest_sha256",
    "toolchain",
    "source",
    "run_id",
    "run_attempt",
    "runner_name",
    "context_sha256",
    "artifacts",
    "problems",
    "behavioral_cases",
    "schema",
    "execution_profile_id",
    "mechanical_status",
    "graph_summary",
    "package_binding",
    "qualification",
    "selection_effect",
    "authority_effect",
    "graph_scope",
    "feature_artifact_kind"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "profile_digest_sha256": {
      "type": "string"
    },
    "toolchain": {
      "enum": [
        "1.71.0",
        "1.88.0",
        "1.99.0"
      ]
    },
    "source": {
      "type": "object"
    },
    "run_id": {
      "type": "string"
    },
    "run_attempt": {
      "type": "string"
    },
    "runner_name": {
      "type": "string"
    },
    "context_sha256": {
      "type": "string"
    },
    "artifacts": {
      "type": "object"
    },
    "problems": {
      "type": "array"
    },
    "behavioral_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "status"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "status": {
            "const": "UNEXECUTED"
          }
        }
      }
    },
    "schema": {
      "const": "heptabao.dependency-mechanical-evidence.v2"
    },
    "execution_profile_id": {
      "const": "HB-H02-MECHANICAL-PROBE-CURRENT-V2"
    },
    "mechanical_status": {
      "enum": [
        "EXECUTED_PASS",
        "EXECUTED_FAIL",
        "BLOCKED"
      ]
    },
    "graph_summary": {
      "type": [
        "object",
        "null"
      ]
    },
    "package_binding": {
      "type": [
        "object",
        "null"
      ]
    },
    "qualification": {
      "const": false
    },
    "selection_effect": {
      "const": "NONE"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "graph_scope": {
      "const": "ALL_TARGET_ENABLED_NORMAL_BUILD_OBSERVATION"
    },
    "feature_artifact_kind": {
      "const": "RESOLVED_PACKAGE_FEATURE_PROJECTION"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mechanical_status": {
            "const": "EXECUTED_PASS"
          }
        }
      },
      "then": {
        "properties": {
          "problems": {
            "maxItems": 0
          },
          "graph_summary": {
            "type": "object"
          },
          "package_binding": {
            "type": "object"
          }
        }
      }
    }
  ]
}
