{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptabao.dev/schemas/heptabao_v1_3_1_technical_completion_receipt_v1.schema.json",
  "title": "HeptaBao V1.3.1 technical completion receipt",
  "description": "The exact-source, non-authoritative receipt emitted by the V1.3.1 head/merge workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "runner",
    "arbitration",
    "gates",
    "github_identity",
    "independent_review",
    "qualification",
    "compatibility_claim",
    "selected_candidates",
    "selection_effect",
    "production_authority",
    "migration_authority",
    "release_authority",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": "heptabao.v1-3-1-technical-completion-receipt.v1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "runner": {
      "$ref": "#/$defs/runner"
    },
    "arbitration": {
      "$ref": "#/$defs/arbitration"
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "github_identity": {
      "$ref": "#/$defs/github_identity"
    },
    "independent_review": {
      "const": false
    },
    "qualification": {
      "const": false
    },
    "compatibility_claim": {
      "const": false
    },
    "selected_candidates": {
      "const": []
    },
    "selection_effect": {
      "const": "NONE"
    },
    "production_authority": {
      "const": false
    },
    "migration_authority": {
      "const": false
    },
    "release_authority": {
      "const": false
    },
    "authority_effect": {
      "const": "NONE"
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "non_negative_decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "non_empty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "positive_decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "date_time_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "runner_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "status",
        "conclusion",
        "started_at",
        "completed_at",
        "outcome"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "$ref": "#/$defs/non_empty"
        },
        "status": {
          "enum": [
            "queued",
            "in_progress",
            "completed"
          ]
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "neutral",
            "timed_out",
            "action_required",
            null
          ]
        },
        "started_at": {
          "$ref": "#/$defs/date_time_or_null"
        },
        "completed_at": {
          "$ref": "#/$defs/date_time_or_null"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "SKIPPED",
            "IN_PROGRESS",
            "QUEUED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "queued"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "conclusion": {
                "const": null
              },
              "started_at": {
                "const": null
              },
              "completed_at": {
                "const": null
              },
              "outcome": {
                "const": "QUEUED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "in_progress"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "conclusion": {
                "const": null
              },
              "started_at": {
                "$ref": "#/$defs/date_time"
              },
              "completed_at": {
                "const": null
              },
              "outcome": {
                "const": "IN_PROGRESS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "conclusion": {
                "enum": [
                  "success",
                  "failure",
                  "cancelled",
                  "skipped",
                  "neutral",
                  "timed_out",
                  "action_required"
                ]
              },
              "started_at": {
                "$ref": "#/$defs/date_time"
              },
              "completed_at": {
                "$ref": "#/$defs/date_time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "conclusion": {
                "const": "success"
              }
            },
            "required": [
              "status",
              "conclusion"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "#/$defs/date_time"
              },
              "completed_at": {
                "$ref": "#/$defs/date_time"
              },
              "outcome": {
                "const": "PASS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "conclusion": {
                "const": "failure"
              }
            },
            "required": [
              "status",
              "conclusion"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "#/$defs/date_time"
              },
              "completed_at": {
                "$ref": "#/$defs/date_time"
              },
              "outcome": {
                "const": "FAIL"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "conclusion": {
                "enum": [
                  "cancelled",
                  "timed_out",
                  "action_required"
                ]
              }
            },
            "required": [
              "status",
              "conclusion"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "#/$defs/date_time"
              },
              "completed_at": {
                "$ref": "#/$defs/date_time"
              },
              "outcome": {
                "const": "BLOCKED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "conclusion": {
                "enum": [
                  "skipped",
                  "neutral"
                ]
              }
            },
            "required": [
              "status",
              "conclusion"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "#/$defs/date_time"
              },
              "completed_at": {
                "$ref": "#/$defs/date_time"
              },
              "outcome": {
                "const": "SKIPPED"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "kind",
        "commit",
        "tree",
        "head",
        "base",
        "event_merge"
      ],
      "properties": {
        "repository": {
          "const": "TrillionniumFoundation/HeptaBao"
        },
        "kind": {
          "enum": [
            "head",
            "merge"
          ]
        },
        "commit": {
          "$ref": "#/$defs/sha40"
        },
        "tree": {
          "$ref": "#/$defs/sha40"
        },
        "head": {
          "$ref": "#/$defs/sha40"
        },
        "base": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40})?$"
        },
        "event_merge": {
          "$ref": "#/$defs/sha40"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "merge"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "base": {
                "$ref": "#/$defs/sha40"
              }
            }
          }
        }
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_attempt",
        "job",
        "job_id",
        "job_name",
        "workflow_name",
        "job_status",
        "job_conclusion",
        "name",
        "runner_labels",
        "runner_id",
        "runner_group_id",
        "runner_group",
        "os",
        "arch",
        "head_sha",
        "source_kind",
        "job_started_at",
        "job_completed_at",
        "required_step_names",
        "steps",
        "step_outcomes_digest",
        "api_response_digest",
        "raw_log_manifest_digest",
        "artifact_digest"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/positive_decimal"
        },
        "run_attempt": {
          "$ref": "#/$defs/positive_decimal"
        },
        "job": {
          "$ref": "#/$defs/non_empty"
        },
        "job_id": {
          "$ref": "#/$defs/positive_decimal"
        },
        "job_name": {
          "$ref": "#/$defs/non_empty"
        },
        "workflow_name": {
          "$ref": "#/$defs/non_empty"
        },
        "job_status": {
          "enum": [
            "queued",
            "in_progress",
            "completed"
          ]
        },
        "job_conclusion": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "neutral",
            "timed_out",
            "action_required",
            null
          ]
        },
        "name": {
          "$ref": "#/$defs/non_empty"
        },
        "runner_labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "contains": {
            "const": "ubuntu-24.04"
          }
        },
        "runner_id": {
          "$ref": "#/$defs/positive_decimal"
        },
        "runner_group_id": {
          "$ref": "#/$defs/non_negative_decimal"
        },
        "runner_group": {
          "$ref": "#/$defs/non_empty"
        },
        "os": {
          "$ref": "#/$defs/non_empty"
        },
        "arch": {
          "$ref": "#/$defs/non_empty"
        },
        "head_sha": {
          "$ref": "#/$defs/sha40"
        },
        "source_kind": {
          "enum": [
            "head",
            "merge"
          ]
        },
        "job_started_at": {
          "$ref": "#/$defs/date_time_or_null"
        },
        "job_completed_at": {
          "$ref": "#/$defs/date_time_or_null"
        },
        "required_step_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/runner_step"
          }
        },
        "step_outcomes_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "api_response_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "raw_log_manifest_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256_digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "job_status": {
                "const": "queued"
              }
            },
            "required": [
              "job_status"
            ]
          },
          "then": {
            "properties": {
              "job_conclusion": {
                "const": null
              },
              "job_started_at": {
                "const": null
              },
              "job_completed_at": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "job_status": {
                "const": "in_progress"
              }
            },
            "required": [
              "job_status"
            ]
          },
          "then": {
            "properties": {
              "job_conclusion": {
                "const": null
              },
              "job_started_at": {
                "$ref": "#/$defs/date_time"
              },
              "job_completed_at": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "job_status": {
                "const": "completed"
              }
            },
            "required": [
              "job_status"
            ]
          },
          "then": {
            "properties": {
              "job_conclusion": {
                "const": "success"
              },
              "job_started_at": {
                "$ref": "#/$defs/date_time"
              },
              "job_completed_at": {
                "$ref": "#/$defs/date_time"
              }
            }
          }
        }
      ]
    },
    "arbitration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "pull_request_number",
        "head_sha",
        "source_kind",
        "required_lanes"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*|workflow_dispatch):[0-9a-f]{40}:(?:head|merge)$"
        },
        "pull_request_number": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*|workflow_dispatch)$"
        },
        "head_sha": {
          "$ref": "#/$defs/sha40"
        },
        "source_kind": {
          "enum": [
            "head",
            "merge"
          ]
        },
        "required_lanes": {
          "enum": [
            [
              "head"
            ],
            [
              "head",
              "merge"
            ]
          ]
        }
      }
    },
    "github_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "source_sha",
        "repository_id",
        "repository_full_name",
        "expected_head_owner",
        "head_owner",
        "expected_ratifier_login",
        "expected_ratifier_id",
        "author_login",
        "committer_login",
        "author_id",
        "committer_id",
        "verification",
        "identity_verified",
        "signature_required"
      ],
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "source_sha": {
          "$ref": "#/$defs/sha40"
        },
        "repository_id": {
          "const": 1349115072
        },
        "repository_full_name": {
          "const": "TrillionniumFoundation/HeptaBao"
        },
        "expected_head_owner": {
          "const": "TrillionniumFoundation"
        },
        "head_owner": {
          "const": "TrillionniumFoundation"
        },
        "expected_ratifier_login": {
          "const": "ProfHepta"
        },
        "expected_ratifier_id": {
          "const": 102159240
        },
        "author_login": {
          "const": "ProfHepta"
        },
        "committer_login": {
          "const": "ProfHepta"
        },
        "author_id": {
          "const": 102159240
        },
        "committer_id": {
          "const": 102159240
        },
        "verification": {
          "$ref": "#/$defs/github_verification"
        },
        "identity_verified": {
          "const": true
        },
        "signature_required": {
          "const": false
        }
      }
    },
    "github_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "reason"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_python",
        "root_rust_1_98",
        "p0",
        "h02"
      ],
      "properties": {
        "plan_python": {
          "const": "PASS"
        },
        "root_rust_1_98": {
          "const": "PASS"
        },
        "p0": {
          "$ref": "#/$defs/p0_gate"
        },
        "h02": {
          "$ref": "#/$defs/h02_gate"
        }
      }
    },
    "p0_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_socket_observed",
        "exact_head_compiled_source_bound",
        "best_effort_source_bound",
        "artifact_digest"
      ],
      "properties": {
        "runtime_socket_observed": {
          "const": 11
        },
        "exact_head_compiled_source_bound": {
          "const": 2
        },
        "best_effort_source_bound": {
          "const": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256_digest"
        }
      }
    },
    "h02_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_entries",
        "pass",
        "artifact_digest"
      ],
      "properties": {
        "executed_entries": {
          "const": 24
        },
        "pass": {
          "const": 24
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256_digest"
        }
      }
    }
  }
}
