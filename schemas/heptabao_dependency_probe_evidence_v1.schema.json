{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptabao.invalid/schemas/dependency-probe-evidence-v1.json",
  "title": "HeptaBao H02 Dependency Probe Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","plan_id","revision","evidence_id","profile_id","candidate_id","capability","package","version","execution_kind","status","captured_at_utc","source","environment","profile","artifacts","graph_summary","result","review_status","qualification","selection_effect","authority_effect"],
  "properties": {
    "schema": {"const": "heptabao.dependency-probe-evidence.v1"},
    "plan_id": {"const": "HEPTABAO-PLAN-2026-08-28"},
    "revision": {"const": "1.1"},
    "evidence_id": {"pattern": "^HB-H02-PROBE-EVIDENCE-[A-Z0-9._-]{8,200}$"},
    "profile_id": {"pattern": "^HB-H02-PROBE-[A-Z0-9._-]{8,200}$"},
    "candidate_id": {"pattern": "^HB-DEP-[A-Z0-9._-]{8,200}$"},
    "capability": {"enum": ["ASYNC_RUNTIME", "TLS", "RAFT"]},
    "package": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "execution_kind": {"enum": ["GITHUB_HOSTED", "ATTESTED_SELF_HOSTED", "INDEPENDENT_LAB", "LOCAL_UNATTESTED"]},
    "status": {"enum": ["EXECUTED_PASS", "EXECUTED_FAIL", "BLOCKED", "UNEXECUTED", "UNKNOWN"]},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository","branch","commit_sha","tree_sha","clean_tree"],
      "properties": {
        "repository": {"const": "ProfHepta/HeptaBao"},
        "branch": {"type": "string", "minLength": 1},
        "commit_sha": {"$ref": "#/$defs/sha40"},
        "tree_sha": {"$ref": "#/$defs/sha40"},
        "clean_tree": {"type": "boolean"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_id","os","arch","target","toolchain","rustc","cargo","python","runner_name","runner_id","job_id","container_or_image_digest"],
      "properties": {
        "environment_id": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "toolchain": {"type": "string", "minLength": 1},
        "rustc": {"type": ["string", "null"]},
        "cargo": {"type": ["string", "null"]},
        "python": {"type": ["string", "null"]},
        "runner_name": {"type": ["string", "null"]},
        "runner_id": {"type": ["integer", "null"], "minimum": 1},
        "job_id": {"type": ["integer", "null"], "minimum": 1},
        "container_or_image_digest": {"type": ["string", "null"]}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_path","default_features","features","profile_digest_sha256","expected_registry_checksum_sha256","expected_release_commit_sha"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "default_features": {"type": "boolean"},
        "features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "profile_digest_sha256": {"$ref": "#/$defs/sha256"},
        "expected_registry_checksum_sha256": {"$ref": "#/$defs/sha256"},
        "expected_release_commit_sha": {"$ref": "#/$defs/sha40"}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["cargo_lock","cargo_metadata","dependency_tree","feature_tree","build_log","test_log","source_scan"],
      "properties": {
        "cargo_lock": {"$ref": "#/$defs/nullable_digest_ref"},
        "cargo_metadata": {"$ref": "#/$defs/nullable_digest_ref"},
        "dependency_tree": {"$ref": "#/$defs/nullable_digest_ref"},
        "feature_tree": {"$ref": "#/$defs/nullable_digest_ref"},
        "build_log": {"$ref": "#/$defs/nullable_digest_ref"},
        "test_log": {"$ref": "#/$defs/nullable_digest_ref"},
        "source_scan": {"$ref": "#/$defs/nullable_digest_ref"}
      }
    },
    "graph_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["package_count","normal_edge_count","build_edge_count","build_script_packages","native_link_packages","native_tool_packages","heuristic_unsafe_files","heuristic_unsafe_occurrences","heuristic_ffi_files","heuristic_ffi_occurrences"],
      "properties": {
        "package_count": {"type": "integer", "minimum": 0},
        "normal_edge_count": {"type": "integer", "minimum": 0},
        "build_edge_count": {"type": "integer", "minimum": 0},
        "build_script_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "native_link_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "native_tool_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "heuristic_unsafe_files": {"type": "integer", "minimum": 0},
        "heuristic_unsafe_occurrences": {"type": "integer", "minimum": 0},
        "heuristic_ffi_files": {"type": "integer", "minimum": 0},
        "heuristic_ffi_occurrences": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["lock_status","metadata_status","build_status","test_status","package_checksum_match","package_vcs_commit_match","failed_steps","unknown_steps","required_cases"],
      "properties": {
        "lock_status": {"enum": ["PASS","FAIL","BLOCKED","UNEXECUTED","UNKNOWN"]},
        "metadata_status": {"enum": ["PASS","FAIL","BLOCKED","UNEXECUTED","UNKNOWN"]},
        "build_status": {"enum": ["PASS","FAIL","BLOCKED","UNEXECUTED","UNKNOWN"]},
        "test_status": {"enum": ["PASS","FAIL","BLOCKED","UNEXECUTED","UNKNOWN"]},
        "package_checksum_match": {"type": ["boolean", "null"]},
        "package_vcs_commit_match": {"type": ["boolean", "null"]},
        "failed_steps": {"type": "integer", "minimum": 0},
        "unknown_steps": {"type": "integer", "minimum": 0},
        "required_cases": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["case_id","status","evidence_ref"], "properties": {"case_id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS","FAIL","BLOCKED","UNEXECUTED","UNKNOWN"]}, "evidence_ref": {"type": ["string", "null"]}}}}
      }
    },
    "review_status": {
      "type": "object", "additionalProperties": false,
      "required": ["license","security_advisories","unsafe_and_ffi","msrv","platform","specialist","independent_reproduction_count"],
      "properties": {
        "license": {"enum": ["PENDING","APPROVED","REJECTED"]},
        "security_advisories": {"enum": ["PENDING","APPROVED","REJECTED"]},
        "unsafe_and_ffi": {"enum": ["PENDING","APPROVED","REJECTED"]},
        "msrv": {"enum": ["PENDING","APPROVED","REJECTED"]},
        "platform": {"enum": ["PENDING","APPROVED","REJECTED"]},
        "specialist": {"enum": ["NOT_REQUIRED","PENDING","APPROVED","REJECTED"]},
        "independent_reproduction_count": {"type": "integer", "minimum": 0}
      }
    },
    "qualification": {"const": false},
    "selection_effect": {"const": "NONE"},
    "authority_effect": {"const": "NONE"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "EXECUTED_PASS"}}}, "then": {"properties": {
      "source": {"properties": {"clean_tree": {"const": true}}},
      "artifacts": {"properties": {"cargo_lock": {"type":"object"},"cargo_metadata":{"type":"object"},"dependency_tree":{"type":"object"},"feature_tree":{"type":"object"},"build_log":{"type":"object"},"test_log":{"type":"object"},"source_scan":{"type":"object"}}},
      "result": {"properties": {"lock_status":{"const":"PASS"},"metadata_status":{"const":"PASS"},"build_status":{"const":"PASS"},"test_status":{"const":"PASS"},"package_checksum_match":{"const":true},"package_vcs_commit_match":{"const":true},"failed_steps":{"const":0},"unknown_steps":{"const":0}}}
    }}},
    {"if": {"properties": {"execution_kind": {"const": "LOCAL_UNATTESTED"}}}, "then": {"properties": {"environment": {"properties": {"runner_id":{"type":"null"},"job_id":{"type":"null"}}},"review_status":{"properties":{"independent_reproduction_count":{"maximum":0}}}}}}
  ],
  "$defs": {
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "sha40": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "digest_ref": {"type":"object","additionalProperties":false,"required":["path","sha256","byte_length"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"},"byte_length":{"type":"integer","minimum":1}}},
    "nullable_digest_ref": {"anyOf":[{"$ref":"#/$defs/digest_ref"},{"type":"null"}]}
  }
}
