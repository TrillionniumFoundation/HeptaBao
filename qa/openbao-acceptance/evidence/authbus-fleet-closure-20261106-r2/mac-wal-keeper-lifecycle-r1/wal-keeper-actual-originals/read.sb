(version 1)
(deny default)
(allow process*)
(allow signal (target children))
(allow sysctl-read)
(allow mach-lookup)
(allow file-read-metadata)
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/opt/homebrew"))
(allow file-read* (subpath "/dev/fd"))
(allow file-read* (subpath "/Users/qianqi/heptabao-authbus-wal-keeper-lifecycle-20261106-r1/code"))
(allow file-read* (subpath "/Users/qianqi/heptabao-authbus-wal-keeper-lifecycle-20261106-r1/output"))
(allow file-read* (literal "/Users/qianqi/heptabao-authbus-wal-keeper-lifecycle-20261106-r1"))
(allow file-read* (literal "/Users/qianqi"))
(allow file-read* (literal "/Users"))
(allow file-read* (literal "/"))
(allow file-read* (literal "/dev/null"))
(allow file-read* (literal "/dev/urandom"))
(allow file-read* (literal "/dev/random"))
(allow file-write* (subpath "/Users/qianqi/heptabao-authbus-wal-keeper-lifecycle-20261106-r1/output/tmp"))
(allow file-write* (literal "/dev/null"))
