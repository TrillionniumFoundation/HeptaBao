+def run_snapshot_mechanism(root, *, until, source_vfs="unix-posix"):
+    """Actual API snapshot/Busy behavior in a separate tiny synthetic namespace."""
+    root = Path(root)
+    root.mkdir(mode=0o700, exist_ok=False)
+    for name in ("live", "archive"):
+        (root / name).mkdir(mode=0o700, exist_ok=False)
+    store = WholeStore(root=root / "archive", source_root=root / "live",
+                       until=until, source_vfs=source_vfs)
+    report = {"schema": "heptabao.actual-sqlite-streaming-snapshot-mechanism.r1", "ok": False,
+              "syntheticOnly": True, "productionReads": 0, "productionWrites": 0,
+              "sourceGenerationChangesIntentionalOnlyInThisSyntheticCase": True, "cases": []}
+
+    def check(name, value):
+        need(value, "snapshot_mechanism_" + name)
+        report["cases"].append({"id": name, "passed": True})
+
+    try:
+        path = root / "live/source.sqlite"
+        store.create(path, b"")
+        writer = store.connect(path, readonly=False, role="mechanism-writer")
+        need(store.query(writer, "PRAGMA journal_mode=WAL") == [("wal",)], "mechanism_actual_wal")
+        store.query(writer, "PRAGMA wal_autocheckpoint=0")
+        store.query(writer, "CREATE TABLE opaque(id INTEGER PRIMARY KEY, value TEXT)")
+        store.query(writer, "INSERT INTO opaque VALUES(1,'before')")
+        source = store.connect(path, readonly=True, role="mechanism-fresh-reader")
+        store.query(source, "BEGIN")
+        source["transaction"] = True
+        need(store.query(source, "SELECT value FROM opaque") == [("before",)], "mechanism_begin_read")
+        pages = store.query(source, "PRAGMA page_count")[0][0]
+        outputs = []
+        for ordinal in range(2):
+            destination = root / "archive" / ("output-" + str(ordinal) + ".sqlite")
+            store.create(destination, b"")
+            target = store.connect(destination, readonly=False, role="mechanism-output")
+            store._backup_once(source, target, pages, purpose="same-begin-independent-output")
+            need(store.query(target, "SELECT value FROM opaque") == [("before",)],
+                 "mechanism_output_keeps_original_snapshot")
+            store.close_connection(target)
+            outputs.append(destination)
+            if ordinal == 0:
+                store.query(writer, "UPDATE opaque SET value='after' WHERE id=1")
+        check("two_backups_retain_same_begin_snapshot_across_writer_commit", True)
+        check("two_closed_outputs_all_pages_equal", store.stream_compare_pages(*outputs)["bytes"] > 0)
+        latest = store.connect(path, readonly=True, role="mechanism-latest-reader")
+        check("independent_latest_reader_observes_new_writer_commit",
+              store.query(latest, "SELECT value FROM opaque") == [("after",)])
+
+        busy_path = root / "archive/busy.sqlite"
+        store.create(busy_path, b"")
+        busy_target = store.connect(busy_path, readonly=False, role="mechanism-busy-target")
+        blocker = store.connect(busy_path, readonly=False, role="mechanism-exclusive-blocker")
+        store.query(blocker, "BEGIN EXCLUSIVE")
+        blocker["transaction"] = True
+        caught = False
+        try:
+            store._backup_once(source, busy_target, pages, purpose="mechanism-busy-first-callback")
+        except SnapshotRefused as error:
+            caught = str(error) == "backup_busy_or_error_no_retry"
+        record = store.backup_records[-1]
+        check("busy_first_callback_refused_without_retry", caught and record["progressCalls"] == 1
+              and record["lastStatus"] == sqlite3.SQLITE_BUSY and not record["completed"])
+        store.query(blocker, "ROLLBACK")
+        blocker["transaction"] = False
+
+        # Alter one non-normalized byte in an owned output. No source is changed.
+        original = store.open(outputs[1], os.O_RDWR)
+        try:
+            byte = os.pread(original["fd"], 1, 68)
+            need(len(byte) == 1, "mechanism_one_synthetic_byte")
+            need(os.pwrite(original["fd"], bytes((byte[0] ^ 1,)), 68) == 1,
+                 "mechanism_owned_output_corruption")
+            os.fsync(original["fd"])
+        finally:
+            store.close_fd(original)
+        caught = False
+        try:
+            store.stream_compare_pages(*outputs)
+        except SnapshotRefused as error:
+            caught = str(error) == "two_backup_outputs_page_one_equal"
+        check("output_corruption_outside_three_header_ranges_refused", caught)
+        store.query(source, "ROLLBACK")
+        source["transaction"] = False
+        report["ok"] = True
+    except BaseException as error:
+        report["errorType"] = type(error).__name__
+        report["errorCode"] = str(error) if isinstance(error, SnapshotRefused) else "snapshot_mechanism_refused"
+    finally:
+        try:
+            store.close()
+        except BaseException:
+            report["ok"] = False
+            report["closureUnknown"] = True
+        report["resources"] = store.public()
+        if not all(report["resources"][name] for name in (
+            "allFileDescriptorsClosedOnce", "allSqliteHandlesClosedOnce", "allExplicitCursorsClosed")):
+            report["ok"] = False
+        if time.monotonic() >= until:
+            report["ok"] = False
+    return report
