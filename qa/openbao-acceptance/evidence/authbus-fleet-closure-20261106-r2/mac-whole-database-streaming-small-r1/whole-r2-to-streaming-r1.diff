+            entry.update(bytes=count, completed=True)
+            return {"bytes": count, "full9": full9(before), "sha256": digest.hexdigest(),
+                    "pageImageSha256": normalized.hexdigest() if sqlite_pages else None,
+                    "pageSize": page_size}
