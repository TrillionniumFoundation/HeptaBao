+        # Only absence is admitted; no attribute name or value is read.
+        original = self.open(path, os.O_RDONLY | os.O_NONBLOCK)
+        record = {"returnValue": None, "errno": None, "sameHeldFileBeforeAfter": False,
+                  "descriptorClosedOnce": False}
