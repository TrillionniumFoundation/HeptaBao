+def alias_binding(path, deadline):
+    """Observe logical lookup components; system file_pin supplies custody."""
+    path = Path(path)
+    need(path.is_absolute() and str(path) == os.path.normpath(path), "absolute_loader_alias")
+    components = []
+    for component in [*reversed(path.parents), path]:
+        need(time.monotonic() < deadline, "capture_absolute_deadline")
+        info = component.lstat()
+        # Directory mtime can change because an unrelated file was created;
+        # its own inode/owner/mode must remain stable. Symlinks bind full stat.
+        row = {"path": str(component), "identity": identity(info)[:5]}
+        if stat.S_ISLNK(info.st_mode):
+            row.update(identity=identity(info), target=os.readlink(component))
+        components.append(row)
+    return {"path": str(path), "resolved_path": str(path.resolve(strict=True)), "components": components}
+
+
+def recheck_alias_bindings(bindings, deadline):
+    for path, original in bindings.items():
+        need(alias_binding(path, deadline) == original, "actual_loader_lookup_alias_changed")
 
 
