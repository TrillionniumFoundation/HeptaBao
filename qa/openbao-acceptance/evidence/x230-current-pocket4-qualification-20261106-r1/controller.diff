+def validate_static_admission(value, terminal, job, receipt, capture, parser):
+    capture["require_terminal"](terminal, job)
+    need(value.get("schema") == "heptabao.current-native-static-abi-capture.v1"
+         and value.get("status") == "passed" and value.get("role") == "receiver"
+         and value.get("hostname") == "qian-ThinkPad-X230"
+         and value.get("source_commit") == BUILD_COMMIT and value.get("source_tree") == BUILD_TREE
+         and value.get("normal107_job_id") == BUILD_JOB_ID
+         and value.get("static_receiver_compatibility_qualified") is True
+         and value.get("inputs_unchanged") is True
+         and value.get("controller", {}).get("sha256") == ABI_CAPTURE_SHA256
+         and value.get("parser", {}).get("sha256") == ABI_PARSER_SHA256
+         and type(value.get("target_binary_executions")) is int and value["target_binary_executions"] == 0
+         and value.get("production_changed") is False
+         and value.get("actual_x230_runtime_qualified") is False
+         and value.get("full_replacement_qualified") is False
+         and value.get("deadline_renewed") is False and value.get("automatic_retry") is False,
+         "completed_current_receiver_static_capture_required")
+    need(set(value.get("inputs", {})) == {"producer_receipt", "producer_terminal"}
+         and set(value.get("tools", {})) == {"readelf", "ldconfig"}, "closed_static_capture_input_set")
+    expected = {name: receipt["artifacts"][name] for name in ("heptabao-server", "heptabao-seed")}
+    comparison = parser["verify_compatibility"](value["artifacts"], value["providers"],
+        expected_artifact_pins=expected, interpreter_path="/lib64/ld-linux-x86-64.so.2",
+        interpreter_resolved_path=value["interpreter_pin"]["path"])
+    need(comparison == value.get("compatibility"), "original_static_compatibility_recomputed")
+    aliases = value.get("provider_alias_bindings", {})
+    candidates = {path for paths in value.get("provider_lookup_candidates", {}).values() for path in paths}
+    need(set(value.get("provider_lookup_candidates", {})) == set(value["providers"])
+         and set(aliases) == candidates and candidates, "complete_original_provider_alias_set")
+    for name, paths in value["provider_lookup_candidates"].items():
+        need(paths and len(paths) == len(set(paths))
+             and all(aliases[path].get("path") == path
+                     and aliases[path].get("resolved_path") == value["providers"][name]["pin"]["path"]
+                     for path in paths), "provider_alias_to_canonical_file_binding")
+    # Hash and stat all current receiver libraries/tools/input originals, check
+    # every logical loader alias, and recheck interpreter/cache immediately
+    # before the real fixtures. This launches no system or candidate program.
+    fresh = capture["Capture"]({"role": "receiver", "interpreter_path": "/lib64/ld-linux-x86-64.so.2"},
+                               None, time.monotonic() + 60, parser)
+    fresh.inputs, fresh.tools = value["inputs"], value["tools"]
+    fresh.recheck(value)
+    return {"static_compatibility": comparison, "provider_alias_bindings": aliases,
+            "receiver_terminal_job_id": job, "receiver_current_pins_rechecked": True,
+            "actual_x230_runtime_qualified_by_admission": False}
