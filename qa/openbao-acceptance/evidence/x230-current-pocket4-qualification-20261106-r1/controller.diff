+def load_abi_guards(dr):
+    """Use the already reviewed capture/parser bytes, never cached bytecode."""
+    modules, pins = {}, {}
+    for name, expected in (("x230_native_abi_capture", ABI_CAPTURE_SHA256),
+                           ("x230_native_abi_admission", ABI_PARSER_SHA256)):
+        path = Path(__file__).resolve().with_name(name + ".py")
+        pin = dr.file_pin(path)
+        need(pin["uid"] == os.geteuid() and not pin["mode"] & 0o022 and pin["bytes"] <= 65536,
+             "owned_reviewed_abi_source_custody")
+        raw = path.read_bytes()
+        need(hashlib.sha256(raw).hexdigest() == expected == pin["sha256"],
+             "reviewed_adjacent_abi_guard_required")
+        need(dr.file_pin(path) == pin, "abi_guard_source_changed_while_reading")
+        namespace = {"__name__": "bound_" + name, "__file__": str(path)}
+        exec(compile(raw, str(path), "exec"), namespace)
+        modules[name], pins[name] = namespace, pin
+    return modules["x230_native_abi_capture"], modules["x230_native_abi_admission"], pins
+
