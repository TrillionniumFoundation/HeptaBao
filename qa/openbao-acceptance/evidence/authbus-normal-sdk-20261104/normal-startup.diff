+class NormalInstance(smoke.Instance):
+    """Original startup/request budgets on the configured normal file backend."""
+    def __init__(self, binary, root):
+        super().__init__(binary, root)
+        config = json.loads((root / 'server.json').read_bytes())
+        if 'storage' in config:
+            raise CanaryFailure('fresh_normal_storage_selection')
+        config['storage'] = {'native_v6_file': {'path': config['data_dir']}}
+        private(root / 'server.json', json.dumps(config), replace=True)
+
+    def start(self):
+        self.log = open(self.root / "server.log", "ab")
+        self.process = owned_process.popen(
+            [str(self.binary), "--config", str(self.root / "server.json")],
+            stdout=self.log, stderr=self.log, label="native-authbus.normal-server", action="KILL", stop_timeout=5,
+        )
+        try:
+            deadline = time.monotonic() + 12
+            while time.monotonic() < deadline:
+                if self.process.poll() is not None:
+                    raise CanaryFailure("native_server_startup_exit")
+                try:
+                    status, _ = self.call("GET", "sys/health")
+                    if status in (200, 501, 503):
+                        return
+                except urllib.error.URLError as error:
+                    if isinstance(error.reason, ssl.SSLCertVerificationError):
+                        raise CanaryFailure("server_ca_verification_failed") from None
+                except OSError:
+                    pass
+                time.sleep(0.05)
+            raise CanaryFailure("native_server_readiness_timeout")
+        except BaseException:
+            self.stop()
+            raise
 
 
