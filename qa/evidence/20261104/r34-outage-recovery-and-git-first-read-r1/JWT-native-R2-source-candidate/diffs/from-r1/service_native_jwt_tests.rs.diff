+#[test]
+fn native_jwt_and_userpass_token_api_targets_keep_real_owner_and_renewal_in_both_directions() -> TestResult {
+    let mut f = Fixture::new()?;
+    allow_delegation(&mut f)?;
+    status(&f.admin("POST", "sys/auth/native-up", json!({"type":"userpass"}))?, 204);
+    status(&f.admin("POST", "auth/native-up/users/bob", json!({
+        "password":"native-jwt-cross-owner-synthetic","token_policies":["native-jwt"],
+        "token_ttl":300,"token_max_ttl":600
+    }))?, 204);
+    let mut response = f.actor("", "POST", "auth/native-up/login/bob",
+        json!({"password":"native-jwt-cross-owner-synthetic"}))?;
+    status(&response, 200);
+    let userpass = secret(&mut response, "/auth/client_token")?;
+    let assertion = f.assertion(f.now + 60);
+    let (jwt, _) = f.login(&assertion)?;
+    let (other_jwt, _) = f.login(&assertion)?;
+    let mut first = f.actor(&jwt, "POST", "auth/token/renew",
+        json!({"token":userpass.as_str(),"increment":120}))?;
+    status(&first, 200);
+    let echo = secret(&mut first, "/auth/client_token")?;
+    assert!(echo.as_str() == userpass.as_str());
+    let mut second = f.actor(&userpass, "POST", "auth/token/renew",
+        json!({"token":jwt.as_str(),"increment":120}))?;
+    status(&second, 200);
+    let echo = secret(&mut second, "/auth/client_token")?;
+    assert!(echo.as_str() == jwt.as_str());
+    let mut f = f.restart()?;
+    status(&f.actor(&userpass, "POST", "auth/token/revoke", json!({"token":jwt.as_str()}))?, 204);
+    status(&f.actor(&jwt, "GET", "auth/token/lookup-self", json!({}))?, 403);
+    status(&f.actor(&other_jwt, "POST", "auth/token/revoke",
+        json!({"token":userpass.as_str()}))?, 204);
+    let mut f = f.restart()?;
+    status(&f.actor(&userpass, "GET", "auth/token/lookup-self", json!({}))?, 403);
+    status(&f.actor(&jwt, "GET", "auth/token/lookup-self", json!({}))?, 403);
+    status(&f.actor(&other_jwt, "GET", "auth/token/lookup-self", json!({}))?, 200);
+    Ok(())
+}
