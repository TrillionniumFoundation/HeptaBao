+#[test]
+fn native_jwt_token_api_revoke_orphan_keeps_own_issuer_but_mount_retirement_still_revokes() -> TestResult {
+    let mut f = Fixture::new()?;
+    allow_delegation(&mut f)?;
+    let assertion = f.assertion(f.now + 60);
+    let (parent, _) = f.login(&assertion)?;
+    let child = create_service_child(&mut f, &parent, 250)?;
+    status(&f.admin("POST", "auth/token/revoke-orphan", json!({"token":parent.as_str()}))?, 204);
+    status(&f.admin("DELETE", ROLE, json!({}))?, 204);
+    let mut f = f.restart()?;
+    status(&f.actor(&parent, "GET", "auth/token/lookup-self", json!({}))?, 403);
+    let lookup = f.actor(&child, "GET", "auth/token/lookup-self", json!({}))?;
+    status(&lookup, 200);
+    assert_eq!(lookup.body["data"]["orphan"], true);
+    let mut renewed = f.actor(&child, "POST", "auth/token/renew-self", json!({"increment":120}))?;
+    status(&renewed, 200);
+    let echo = secret(&mut renewed, "/auth/client_token")?;
+    assert!(echo.as_str() == child.as_str());
+    status(&f.admin("DELETE", "sys/auth/native-jwt", json!({}))?, 204);
+    let mut f = f.restart()?;
+    status(&f.actor(&child, "GET", "auth/token/lookup-self", json!({}))?, 403);
+    Ok(())
+}
