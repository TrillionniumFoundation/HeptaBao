    "before": "    pub(crate) fn begin_forwarded(&mut self, request: ServiceRequest<'_>) -> RequestExecution {\n        let started = std::time::Instant::now();\n        let observed = SystemTime::now()\n            .duration_since(UNIX_EPOCH)\n            .unwrap_or(Duration::MAX);\n        let clock = match RequestClock::anchored(observed, started) {\n            Ok(clock) => clock,\n            Err(_) => {\n                return RequestExecution::Complete(Response::error(\n                    503,\n                    \"trusted token clock is unavailable\",\n                ));\n            }\n        };\n        let now = observed.as_secs();\n        let _publication_clock = external_pki::PublicationClockScope::enter(\n            clock.admitted_at().duration_since_epoch(),\n            started,\n        );\n        let ServiceRequest {\n            method,\n            path,\n            namespace,\n            token,\n            body,\n            wrap_ttl_seconds,\n            origin_peer,\n            client_certificates,\n        } = request;\n        self.begin_at_mode_precise(\n            RequestDispatch {\n                method,\n                path,\n                namespace,\n                token,\n                body,\n                now,\n                allow_forward: false,\n                enforce_namespace: true,\n                wrap_ttl_seconds,\n                origin_peer,\n                client_certificates,\n            },\n            clock,\n        )\n        .with_realtime_remote_jwt()\n    }\n",
    "after": "    pub(crate) fn begin_forwarded(&mut self, request: ServiceRequest<'_>) -> RequestExecution {\n        let (started, observed) = self.native_snapshot_clock.unwrap_or_else(|| {\n            (\n                std::time::Instant::now(),\n                SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or(Duration::MAX),\n            )\n        });\n        let clock = match RequestClock::anchored(observed, started) {\n            Ok(clock) => clock,\n            Err(_) => {\n                return RequestExecution::Complete(Response::error(\n                    503,\n                    \"trusted token clock is unavailable\",\n                ));\n            }\n        };\n        let now = observed.as_secs();\n        let _publication_clock = external_pki::PublicationClockScope::enter(\n            clock.admitted_at().duration_since_epoch(),\n            started,\n        );\n        let ServiceRequest {\n            method,\n            path,\n            namespace,\n            token,\n            body,\n            wrap_ttl_seconds,\n            origin_peer,\n            client_certificates,\n        } = request;\n        let execution = self.begin_at_mode_precise(\n            RequestDispatch {\n                method,\n                path,\n                namespace,\n                token,\n                body,\n                now,\n                allow_forward: false,\n                enforce_namespace: true,\n                wrap_ttl_seconds,\n                origin_peer,\n                client_certificates,\n            },\n            clock,\n        );\n        if self.native_snapshot_clock.is_some() {\n            execution\n        } else {\n            execution.with_realtime_remote_jwt()\n        }\n    }\n",
