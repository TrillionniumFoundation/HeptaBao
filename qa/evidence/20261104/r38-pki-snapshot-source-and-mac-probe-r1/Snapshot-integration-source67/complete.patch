+    let limits = SnapshotBodyLimits::new(1024)?;
+    let request = SnapshotPeerRequest::new(
+        b"public synthetic request", &pins, (limits, limits), Instant::now() + TEST_TIMEOUT,
+    )?;
+    let done = Arc::new(AtomicBool::new(false));
+    let server_done = done.clone();
+    let calls = Arc::new(AtomicUsize::new(0));
+    let server_calls = calls.clone();
+    let consumer_calls = Arc::new(AtomicUsize::new(0));
+    let consumed = consumer_calls.clone();
+    let completed = Arc::new(AtomicUsize::new(0));
+    let published = completed.clone();
+    let server = fixture.server.clone();
+    let worker = thread::spawn(move || {
+        serve_snapshot_once(listener, server, identities, server_done, |mut peer| {
+            server_calls.fetch_add(1, Ordering::SeqCst);
+            let original = peer.deadline();
+            let shorter = peer.accepted_at() + TEST_TIMEOUT / 2;
+            peer.restrict_deadline(shorter)?;
+            let fixed = peer.deadline();
+            peer.restrict_deadline(peer.accepted_at() + TEST_TIMEOUT)?;
+            if fixed > shorter || fixed > original || peer.deadline() != fixed {
+                return Err(HaError::InvalidFrame);
+            }
+            let (parsed, _) = peer.accept_body(limits, b"rejected original owner", |reader| {
+                consumed.fetch_add(1, Ordering::SeqCst);
+                io::copy(reader, &mut io::sink())
+            })?;
+            parsed.map_err(|_| HaError::Transport)?;
+            published.fetch_add(1, Ordering::SeqCst);
+            peer.complete(204, b"not permitted", &mut io::empty(), limits)?;
+            Ok(())
+        })
+    });
+    let mut upload = io::Cursor::new(b"never read by transport");
+    let mut received = Vec::new();
+    let admission_calls = AtomicUsize::new(0);
+    let result = transport.exchange_snapshot_before(
+        &target, request, &mut upload, &mut received, |metadata| {
+            admission_calls.fetch_add(1, Ordering::SeqCst);
+            if metadata != b"rejected original owner" {
+                return Err(HaError::InvalidFrame);
+            }
+            Err(HaError::PeerAuthenticationFailed)
+        },
+    );
+    done.store(true, Ordering::SeqCst);
+    let (served, listener) = worker.join().map_err(|_| "ready veto receiver panic")?;
+    assert_eq!(result.err(), Some(HaError::PeerAuthenticationFailed));
+    assert_eq!(served, Err(HaError::Transport));
+    assert_eq!(admission_calls.load(Ordering::SeqCst), 1);
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert_eq!(consumer_calls.load(Ordering::SeqCst), 0);
+    assert_eq!(completed.load(Ordering::SeqCst), 0);
+    assert_eq!(upload.position(), 0);
+    assert!(received.is_empty());
+    assert!(listener.accept().is_err_and(|error| error.kind() == io::ErrorKind::WouldBlock));
+    Ok(())
+}
