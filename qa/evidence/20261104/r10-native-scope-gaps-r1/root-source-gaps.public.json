  "gaps": [
    {
      "id": "native_snapshot_standby",
      "status": "requires_current_real_cli_archive_evidence_and_native_owner_implementation",
      "next": "Use Phase B real A/B native archives and current normal binaries; CLI success requires actual API/audit/state and cold reopen proof. Keep bounded authenticated streaming work under source review."
    },
    {
      "id": "native_rekey_and_system_owners",
      "status": "explicit_native_route_refusal",
      "next": "Add a native operation owner covering seal generation, original request/audit authority, durable pending verification, crash reconciliation and cluster consistency before admitting rekey. The existing legacy filesystem rekey functions do not establish native HA ownership."
    },
    {
      "id": "external_auth_mfa_password_policy",
      "status": "native_profile_requires_unsupported_state_empty",
      "next": "Add native persistence/authority ownership and same-version real oracle for JWT/OIDC and other configured auth providers, MFA and password policy. Existing local token/AppRole/cert/userpass proofs remain scoped."
    },
    {
      "id": "database_plugins_external_kms",
      "status": "explicit_native_startup_and_engine_profile_refusal",
      "next": "Implement configuration, issue, renew, revoke and unknown external effect recovery in native owners; then verify real providers. Do not re-enable an OpenBao wrapper as replacement evidence."
    },
    {
      "id": "namespace_and_identity_completion",
      "status": "partial_native_owners",
      "next": "Preserve existing KV1 retirement and local identity; add nonempty namespace retirement, remaining child owners and alias/merge/MFA/OIDC identity semantics with isolation and reopen checks."
    },
    {
      "id": "all_asset_migration_and_tooling",
      "status": "no_full_current_candidate_evidence",
      "next": "For each actual client and backup path, migrate its owned assets and prove read/write, restart and rollback. KV2/Transit archives do not prove policies, identity, active leases, external effects or full CLI/Agent/Proxy coverage."
    }
