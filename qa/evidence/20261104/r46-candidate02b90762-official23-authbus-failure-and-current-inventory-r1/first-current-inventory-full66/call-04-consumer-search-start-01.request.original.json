{
  "host": "x230",
  "root": "/home/qian",
  "kind": "files",
  "query": "(heptabao|openbao|vault|(^|[._-])bao([._-]|$))",
  "query_mode": "regex",
  "ignore_case": true,
  "include_hidden": true,
  "early_termination": false,
  "context_lines": 0,
  "exclude_patterns": [
    "**/.git/**",
    "**/.ssh/**",
    "**/.gnupg/**",
    "**/.cache/**",
    "**/node_modules/**",
    "**/target/**",
    "**/target-*/**",
    "**/*token*",
    "**/*credential*",
    "**/*capsule*",
    "**/*.key",
    "**/*.pem",
    "heptabao-same-root-publication-normal-20261105-r1/**"
  ],
  "max_entries": 4096,
  "max_results": 128,
  "max_bytes": 1048576,
  "timeout_seconds": 15
}
