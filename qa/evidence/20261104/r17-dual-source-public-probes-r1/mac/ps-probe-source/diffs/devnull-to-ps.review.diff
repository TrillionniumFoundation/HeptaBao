+                row['directChildReaped']=p.returncode is not None;row['exitCode']=p.returncode
+        row['cleanupDelegatedToOuterRetainedGroup']=bool(p is not None and p.returncode is None)
+        row['outcomeUnknown']=bool(row['outcomeUnknown'] or not row['streamsClosed']
+            or row['cleanupDelegatedToOuterRetainedGroup'])
+        row['completedBeforeOriginalPsDeadline']=time.monotonic()<deadline
+        if not row['completedBeforeOriginalPsDeadline']:row['knownObservation']=False
+    return row
