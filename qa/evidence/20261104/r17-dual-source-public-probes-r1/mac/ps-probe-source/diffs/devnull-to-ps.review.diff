+                                 int(expected['identity'][6]),expected['identity'])
+    row=None
+    with guard.parent(COPIED_PS) as (parent,name):
+        try:
+            with critical():
+                fd=os.open(name,os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,
+                           0o500,dir_fd=parent)
+                row={'fd':fd,'closeAttempted':False,'closed':False};fds.append(row)
+            before=os.fstat(fd)
+            need(stat.S_ISREG(before.st_mode) and before.st_uid==501
+                 and before.st_gid==20 and before.st_nlink==1
+                 and before.st_dev==int(json.loads(ANCHOR_RAW)['expectedVolumeDevice']),
+                 'new_owned_ps_inode')
+            offset=0
