+            row['knownObservation']=bool(row['communicateReturned'] and row['directChildReaped']
+                                         and not isinstance(error,KeyboardInterrupt))
+        row['outcomeUnknown']=bool(isinstance(error,KeyboardInterrupt)
+            or (p is not None and p.returncode is None))
+    finally:
