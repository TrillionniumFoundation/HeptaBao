+    tests_raw, evidence['exact44'] = read_bound(output / 'result.public.json',
+        '28f47931ad644e610d45af00545b343a8d5867546ea8d00a44cae0a3de13c961', 40000)
+    build, native, tests = map(json.loads, (build_raw, native_raw, tests_raw))
