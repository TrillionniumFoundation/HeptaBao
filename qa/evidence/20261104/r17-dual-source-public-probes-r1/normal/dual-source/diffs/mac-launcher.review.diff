+    assert tests['binary']['sha256'] == 'b36998def7d3642f78a00dffbd3390f10d2b8f9ed1fcdeb8739ea4a6a7230549'
+    assert tests['binary']['bytes'] == 155908848
+    assert len(tests['cleanup']) == 14
