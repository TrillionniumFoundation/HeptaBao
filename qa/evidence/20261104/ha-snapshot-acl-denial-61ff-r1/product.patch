+                self.recovery_required = true;
+                self.ha_activation = None;
+                return unavailable();
+            }
+            return error;
+        }
+        crate::ha_forward_completion::audited(Some(denied.clock));
+        self.stamp_consistency_index(&mut denied.response);
+        denied.response
+    }
