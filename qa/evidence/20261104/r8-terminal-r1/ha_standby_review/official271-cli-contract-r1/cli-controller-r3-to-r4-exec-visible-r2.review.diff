+    def await_owned_cmdline(self, child: subprocess.Popen, captured: dict,
+                            expected_executable: str, until: int) -> bytes:
+        # Linux may publish the new executable before create_elf_tables has
+        # made cmdline visible. Empty is pending, never an accepted argv.
+        # This observes the one existing child; it cannot launch or replay it.
+        started = time.monotonic_ns()
+        trace = {'pid': child.pid, 'start_ticks': captured['start_ticks'],
+                 'pgid': captured['pgid'], 'original_deadline_monotonic_ns': until,
+                 'initial_cmdline_bytes': 0, 'empty_reads': 1, 'additional_reads': 0,
+                 'state_counts': {}, 'nonempty_observed': False, 'failure_type': None}
+        self.child_exec_visibility.append(trace)
+
+        def verify_current() -> dict:
+            remaining(until)
+            if child.poll() is not None:
+                raise Refused('owned_child_exited_before_cmdline_visible')
+            current = process_identity(child.pid)
+            if (current is None or current['pid'] != child.pid
+                    or current['start_ticks'] != captured['start_ticks']
+                    or current['pgid'] != child.pid or current['pgid'] != captured['pgid']
+                    or current['ppid'] != os.getpid() or current['ppid'] != captured['ppid']
+                    or current['exe'] != expected_executable or current['state'] in ('Z', 'X', 'x')):
+                raise Refused('owned_child_identity_changed_while_cmdline_pending')
+            state = current['state'] if current['state'] in ('R', 'S', 'D', 'T', 't', 'I', 'P', 'W') else 'other'
+            trace['state_counts'][state] = trace['state_counts'].get(state, 0) + 1
+            return current
+
+        try:
+            while True:
+                verify_current()
+                time.sleep(min(0.001, remaining(until)))
+                verify_current()
+                actual = (Path('/proc') / str(child.pid) / 'cmdline').read_bytes()
+                trace['additional_reads'] += 1
+                if actual:
+                    verify_current()
+                    trace['nonempty_observed'] = True
+                    trace['final_cmdline_bytes'] = len(actual)
+                    return actual
+                trace['empty_reads'] += 1
+        except Exception as exc:
+            trace['failure_type'] = str(exc) if isinstance(exc, Refused) else type(exc).__name__
+            raise
+        finally:
+            trace['elapsed_ms'] = (time.monotonic_ns() - started) / 1e6
 
