    "label": "explicit_test_delegate_parameter",
    "before": "    capabilities: &[&str],\n) -> TestResult<Zeroizing<String>> {",
    "after": "    capabilities: &[&str],\n    delegate_default: bool,\n) -> TestResult<Zeroizing<String>> {"
  },
  {
    "label": "explicit_actor_policy_set",
    "before": "    let mut issued = f.admin(\n        \"POST\",\n        \"auth/token/create\",\n        json!({\"policies\":[name],\"no_default_policy\":true,\"ttl\":\"600s\"}),\n    )?;\n    status(&issued, 200);\n    assert_eq!(issued.body[\"auth\"][\"token_type\"], \"service\");\n    assert_eq!(issued.body[\"auth\"][\"policies\"], json!([name]));\n    assert_eq!(issued.body[\"auth\"][\"token_policies\"], json!([name]));\n",
    "after": "    // JWT role parsing currently retains the default policy. A role manager\n    // must explicitly own that delegated policy; other ACL actors omit it.\n    // no_default_policy still forbids implicit policy injection at issuance.\n    let token_policies = if delegate_default {\n        vec![\"default\", name]\n    } else {\n        vec![name]\n    };\n    let mut issued = f.admin(\n        \"POST\",\n        \"auth/token/create\",\n        json!({\"policies\":&token_policies,\"no_default_policy\":true,\"ttl\":\"600s\"}),\n    )?;\n    status(&issued, 200);\n    assert_eq!(issued.body[\"auth\"][\"token_type\"], \"service\");\n    assert_eq!(issued.body[\"auth\"][\"policies\"], json!(&token_policies));\n    assert_eq!(issued.body[\"auth\"][\"token_policies\"], json!(&token_policies));\n"
  },
  {
    "label": "verify_exact_issued_and_lookup_policies",
    "before": "    assert_eq!(looked.body[\"data\"][\"policies\"], json!([name]));",
    "after": "    assert_eq!(looked.body[\"data\"][\"policies\"], json!(&token_policies));"
  },
