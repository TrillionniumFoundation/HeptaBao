+def sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def fixed_error(error: BaseException) -> str:
+    value = str(error)
+    if re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{0,159}", value or ""):
+        return value
+    return type(error).__name__
+
