+         and proof.get('sameHeldFdUriCode') is True and proof.get('readonlyImmutableConnection') is True
+         and proof.get('absentSidecarsStayedAbsent') is True and proof.get('emptyWalStayedEmpty') is True
+         and proof.get('nonemptyWalRefusedBeforeConnect') is True and proof.get('journalRefusedBeforeConnect') is True
+         and proof.get('oversizeRowRefused') is True and proof.get('driftRefused') is True
