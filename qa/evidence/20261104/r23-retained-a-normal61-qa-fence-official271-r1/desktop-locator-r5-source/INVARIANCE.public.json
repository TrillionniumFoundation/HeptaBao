      "after": "JOB_NAME = re.compile(r\"([0-9a-f]{1,32})-([0-9a-f]{1,8})-([0-9a-f]{1,16})\\Z\")\nDESKTOP_QUERY_WINDOWS = {\n    \"01\": (1793865024255, 1793865624254),\n    \"02\": (1793865624255, 1793866224254),\n    \"03\": (1793866224255, 1793866824254),\n    \"04\": (1793866824255, 1793867424254),\n    \"05\": (1793867424255, 1793868024254),\n    \"06\": (1793868024255, 1793868624254),\n    \"07\": (1793868624255, 1793869224254),\n    \"08\": (1793869224255, 1793869824254),\n    \"09\": (1793869824255, 1793870424254),\n    \"10\": (1793870424255, 1793871024254),\n    \"11\": (1793871024255, 1793871624254),\n    \"12\": (1793871624255, 1793871896027),\n}\n",
      "reason": "fixed twelve intervals"
    },
    {
      "before": "def main():\n",
      "after": "def fixed_query_window(window_id, observed_ceiling):\n    need(type(window_id) is str and window_id in DESKTOP_QUERY_WINDOWS,\n         \"fixed_window_index\")\n    query_start, fixed_query_end = DESKTOP_QUERY_WINDOWS[window_id]\n    need(type(observed_ceiling) is int and observed_ceiling >= query_start,\n         \"query_window_not_reached\")\n    return query_start, min(fixed_query_end, observed_ceiling), fixed_query_end\n\n\ndef main():\n",
      "reason": "pure fixed interval selector"
    },
    {
      "before": "        need(len(sys.argv) == 5 and sys.argv[1] == \"--scope\"\n             and sys.argv[3] == \"--self-sha256\", \"argv_contract\")\n        scope = sys.argv[2]\n        need(scope in CONFIGS, \"scope_not_fixed\")\n",
      "after": "        need(len(sys.argv) == 7 and sys.argv[1] == \"--scope\"\n             and sys.argv[3] == \"--self-sha256\"\n             and sys.argv[5] == \"--window-index\", \"argv_contract\")\n        scope = sys.argv[2]\n        need(scope in CONFIGS, \"scope_not_fixed\")\n        need(scope == \"desktop-fence\", \"fixed_desktop_window_scope\")\n",
      "reason": "bounded canonical window argument"
    },
    {
      "before": "        if scope == \"desktop-fence\":\n            ceiling = min(ceiling, 1793865024254)\n",
      "after": "        query_start, query_end, fixed_query_end = fixed_query_window(\n            sys.argv[6], ceiling)\n",
      "reason": "replace old single cutoff with fixed selected interval"
    },
    {
      "before": "        report[\"ceiling_unix_ms\"] = ceiling\n",
      "after": "        report[\"ceiling_unix_ms\"] = ceiling\n        report[\"window_index\"] = sys.argv[6]\n        report[\"query_start_unix_ms\"] = query_start\n        report[\"query_end_unix_ms\"] = query_end\n        report[\"fixed_query_end_unix_ms\"] = fixed_query_end\n",
      "reason": "explicit original observation ceiling and candidate interval"
    },
    {
      "before": "        names, count, name_bytes = reader.candidates(\n            jobs_fd, config[\"floor_unix_ms\"], ceiling)\n",
      "after": "        names, count, name_bytes = reader.candidates(\n            jobs_fd, query_start, query_end)\n",
      "reason": "candidate-only selected interval after unchanged anchor"
    }
