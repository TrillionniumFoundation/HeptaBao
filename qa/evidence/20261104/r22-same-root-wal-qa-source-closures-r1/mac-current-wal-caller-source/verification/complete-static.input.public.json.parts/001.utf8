e_json')))\n\nclass Context:\n    def __init__(self):\n        self.until=START+NEW_OUTER_SECONDS\n        self.signals=None;self.cleanup_mode=False;self.cleanup_until=None\n        self.rows=[];self.close_errors=[];self.unknown=False\n        self.port_reservation=None\n        self.capture_attempts=[]\n    def remaining(self,until=None):\n        if self.cleanup_mode:\n            bound=self.cleanup_until\n        else:\n            need(self.signals is None or self.signals.pending is None,'outer_cancelled')\n            bound=self.until\n        if until is not None:bound=min(bound,until)\n        left=bound-time.monotonic();need(left>0,'original_outer_or_exact_step_deadline');return left\n    def critical(self):\n        from contextlib import nullcontext\n        return self.signals.critical() if self.signals is not None else nullcontext()\n    def fd(self,fd,label):\n        row={'fd':fd,'label':label,'attempted':False,'closed':False};self.rows.append(row);return row\n    def close(self,row):\n        if row['attempted']:return\n        with self.critical():\n            row['attempted']=True\n            try:os.close(row['fd']);row['closed']=True\n            except BaseException as error:\n                row['errorType']=type(error).__name__;self.close_errors.append(type(error).__name__);self.unknown=True\n    def close_all(self):\n        for row in reversed(self.rows):self.close(row)\n    def public(self):\n        reservation=self.port_reservation\n        return {'allOuterReadDescriptorsClosed':all(x['closed'] for x in self.rows),\n            'descriptorCount':len(self.rows),'closeErrors':list(self.close_errors),\n            'portReservation':None if reservation is None else dict(reservation),\n            'allEphemeralPortReservationSocketsClosed':bool(reservation is None or not reservation['created']\n                or (reservation['closeAttempted'] and reservation['closed'])),\n            'newOuterSeconds':NEW_OUTER_SECONDS,'newFailureCleanupSeconds':NEW_OUTER_FAILURE_CLEANUP_SECONDS}\n\ndef read_public_source(ctx,path,pin):\n    need(Path(path).parent==QA and Path(path).name in NAMES and valid_pin(pin),'fixed_outer_public_source')\n    row=None\n    try:\n        with ctx.critical():row=ctx.fd(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'public-qa')\n        first=os.fstat(row['fd'])\n        need(stat.S_ISREG(first.st_mode) and first.st_uid==501 and first.st_nlink==1\n             and stat.S_IMODE(first.st_mode)==0o600 and 0<first.st_size<=1024*1024,\n             'public_qa_custody')\n        out=bytearray()\n        while len(out)<=first.st_size:\n            ctx.remaining();part=os.read(row['fd'],min(65536,first.st_size+1-len(out)))\n            if not part:break\n            out.extend(part)\n        need(len(out)==first.st_size and sha(out)==pin and ident(first)==ident(os.fstat(row['fd']))\n             ==ident(Path(path).lstat()),'public_qa_whole_pin_and_named_fd')\n        return list(ident(first))\n    finally:\n        if row is not None:ctx.close(row)\n        need(row is None or row['closed'],'public_qa_close')\n\ndef read_system_tool(ctx,path,expected):\n    need(str(path) in FIXED_UTILITIES and expected==FIXED_UTILITIES[str(path)],\n         'six_actual_system_tool_inputs_only')\n    path=Path(path);need(path.resolve(strict=True)==path,'observed_system_tool_has_no_alias')\n    row=None\n    try:\n        before=path.lstat()\n        need(ident(before)==tuple(expected['identity']) and stat.S_ISREG(before.st_mode),\n             'actual_system_tool_full_stat_identity')\n        with ctx.critical():\n            row=ctx.fd(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'actual-public-system-tool')\n        need(ident(os.fstat(row['fd']))==tuple(expected['identity']),'same_actual_tool_open_fd')\n        h=hashlib.sha256();count=0\n        while count<=expected['bytes']:\n            ctx.remaining();part=os.read(row['fd'],min(65536,expected['bytes']+1-count))\n            if not part:break\n            count+=len(part);h.update(part)\n        need(count==expected['bytes'] and h.hexdigest()==expected['sha256']\n             and ident(os.fstat(row['fd']))==ident(path.lstat())==tuple(expected['identity'])\n             and path.resolve(strict=True)==path,'actual_system_tool_full_sha_name_and_fd')\n        return list(expected['identity'])\n    finally:\n        if row is not None:ctx.close(row)\n        need(row is None or row['closed'],'system_tool_read_descriptor_closed')\n\nclass LoopbackHTTP:\n    \"\"\"One TLS connection per explicit request, no redirect or retry.\n\n    Nonblocking socket/SSL operations and all framing share one original ten\n    second absolute deadline. A full, typed response and actual socket closure\n    must precede clearing the operation record.\n    \"\"\"\n    def __init__(self,ctx,port,ca_pem,peer_sha):\n        need(type(port) is int and 1024<=port<=65535 and valid_pin(peer_sha),'fixed_loopback_tls')\n        self.ctx=ctx;self.port=port;self.peer_sha=peer_sha\n        self.ssl=ssl.create_default_context(cadata=ca_pem.decode('ascii'))\n        self.ssl.check_hostname=True;self.ssl.verify_mode=ssl.CERT_REQUIRED\n        self.ssl.set_alpn_protocols(['http/1.1'])\n        self.rows=[];self.sockets=[];self.inflight=None;self.unknown=False\n        self.root_token=None;self.secrets=[]\n    def left(self,until):return self.ctx.remaining(until)\n    def wait(self,sock,until,reading):\n        left=self.left(until)\n        r,w,e=select.select([sock] if reading else [],[] if reading else [sock],[sock],left)\n        self.left(until);need(not e and bool(r or w),'loopback_socket_readiness')\n    def close(self,row):\n        if row['attempted']:return\n        with self.ctx.critical():\n            row['attempted']=True\n            try:row['socket'].close();row['closed']=row['socket'].fileno()==-1\n            except BaseException as error:row['errorType']=type(error).__name__\n        if not row['closed']:self.unknown=True\n    def recv(self,sock,until):\n        while True:\n            self.left(until)\n            try:return sock.recv(65536)\n            except ssl.SSLWantReadError:self.wait(sock,until,True)\n            except ssl.SSLWantWriteError:self.wait(sock,until,False)\n    def send(self,sock,raw,until):\n        offset=0\n        while offset<len(raw):\n            self.left(until)\n            try:\n                n=sock.send(memoryview(raw)[offset:]);need(n>0,'tls_write_progress');offset+=n\n            except ssl.SSLWantReadError:self.wait(sock,until,True)\n            except ssl.SSLWantWriteError:self.wait(sock,until,False)\n    def response(self,sock,until):\n        buffer=bytearray()\n        while b'\\r\\n\\r\\n' not in buffer:\n            need(len(buffer)<=65536,'http_head_bound')\n            part=self.recv(sock,until);need(bool(part),'http_head_complete');buffer.extend(part)\n        boundary=buffer.index(b'\\r\\n\\r\\n')\n        need(boundary<=65536,'http_head_bound')\n        head=bytes(buffer[:boundary]);buffer=buffer[boundary+4:]\n        lines=head.split(b'\\r\\n')\n        match=re.fullmatch(rb'HTTP/1[.]1 ([0-9]{3}) [\\x20-\\x7e]*',lines[0])\n        need(match is not None,'one_http11_response')\n        status=int(match.group(1));need(200<=status<=599,'no_interim_or_upgrade_profile')\n        headers={}\n        for line in lines[1:]:\n            name,separator,value=line.partition(b':')\n            need(separator and re.fullmatch(rb\"[!#$%&'*+.^_\\x60|~0-9A-Za-z-]+\",name)\n                 and b'\\x00' not in value,'unfolded_http_header')\n            headers.setdefault(name.lower(),[]).append(value.strip())\n        lengths=headers.get(b'content-length',[]);transfer=headers.get(b'transfer-encoding',[])\n        need(len(lengths)<=1 and len(transfer)<=1 and not(lengths and transfer),'unambiguous_http_framing')\n        need(headers.get(b'content-encoding',[]) in ([],[b'identity']),'uncompressed_json_response')\n        def append_more():\n            part=self.recv(sock,until);need(bool(part),'http_body_complete')\n            buffer.extend(part);need(len(buffer)<=MAX_HTTP_BODY+65536,'bounded_http_buffer')\n        if status in (204,304):\n            need(not transfer and lengths in ([],[b'0']) and not buffer,'empty_status_frame')\n            return status,b'','no-body'\n        if lengths:\n            need(re.fullmatch(rb'[0-9]{1,10}',lengths[0]) is not None,'decimal_content_length')\n            length=int(lengths[0]);need(length<=MAX_HTTP_BODY,'http_body_bound')\n            while len(buffer)<length:append_more()\n            need(len(buffer)==length,'one_content_length_response_no_surplus')\n            return status,bytes(buffer),'content-length'\n        if transfer:\n            need(transfer==[b'chunked'],'only_explicit_chunked_transfer')\n            body=bytearray();chunks=0\n            while True:\n                while b'\\r\\n' not in buffer:\n                    need(len(buffer)<=128,'chunk_size_line_bound');append_more()\n                end=buffer.index(b'\\r\\n');line=bytes(buffer[:end]);del buffer[:end+2]\n                need(len(line)<=128 and re.fullmatch(rb'[0-9a-fA-F]{1,8}(?:;[\\x20-\\x7e]*)?',line),\n                     'typed_chunk_size')\n                size=int(line.split(b';')[0],16);chunks+=1\n                need(chunks<=32768 and len(body)+size<=MAX_HTTP_BODY,'bounded_chunked_body')\n                if size==0:\n                    # No trailers are needed by this API. Reject unreviewed\n                    # trailing metadata rather than infer successful framing.\n                    while len(buffer)<2:append_more()\n                    need(bytes(buffer)==b'\\r\\n','empty_exact_chunk_trailer')\n                    return status,bytes(body),'chunked'\n                while len(buffer)<size+2:append_more()\n                need(buffer[size:size+2]==b'\\r\\n','chunk_data_crlf')\n                body.extend(buffer[:size]);del buffer[:size+2]\n        need(headers.get(b'connection',[])==[b'close'],'explicit_close_delimited_response')\n        while True:\n            part=self.recv(sock,until)\n            if not part:break\n            buffer.extend(part);need(len(buffer)<=MAX_HTTP_BODY,'http_body_bound')\n        return status,bytes(buffer),'tls-close-notify'\n    def call(self,label,method,route,body=None,*,token=None,expected=200,validate=None,until=None):\n        need(self.inflight is None and not self.unknown,'no_http_after_unknown')\n        need(re.fullmatch('[a-zA-Z0-9_.-]{1,100}',label) and method in ('GET','POST','PUT','LIST')\n             and re.fullmatch('[a-zA-Z0-9_./:-]{1,512}',route) and not route.startswith('/'),\n             'explicit_safe_control_method_route')\n        allowed_prefix=('sys/','auth/','openclaw-auth/')\n        need(route.startswith(allowed_prefix),'owned_api_control_scope')\n        started=time.monotonic();deadline=min(self.ctx.until,started+HTTP_SECONDS,\n            until if until is not None else self.ctx.until)\n        self.left(deadline);socks=[];result=None\n        row={'name':label,'method':method,'route':route,'dispatched':False,\n             'responseComplete':False,'responseValidated':False,'socketClosuresComplete':False,\n             'originalRequestSeconds':10,'outcomeUnknown':False}\n        self.rows.append(row);self.inflight=row\n        try:\n            with self.ctx.critical():\n                raw=socket.socket(socket.AF_INET,socket.SOCK_STREAM)\n                raw_row={'socket':raw,'attempted':False,'closed':False,'transferred':False}\n                self.sockets.append(raw_row);socks.append(raw_row)\n            raw.setblocking(False)\n            code=raw.connect_ex(('127.0.0.1',self.port))\n            if code not in (0,errno.EINPROGRESS,errno.EWOULDBLOCK,errno.EALREADY):\n                raise OSError(code,os.strerror(code))\n            if code:\n                self.wait(raw,deadline,False)\n                error=raw.getsockopt(socket.SOL_SOCKET,socket.SO_ERROR)\n                if error:raise OSError(error,os.strerror(error))\n            self.left(deadline)\n            with self.ctx.critical():\n                tls=self.ssl.wrap_socket(raw,server_hostname='localhost',\n                    do_handshake_on_connect=False,suppress_ragged_eofs=False)\n                tls_row={'socket':tls,'attempted':False,'closed':False,'transferred':False}\n                self.sockets.append(tls_row);socks.append(tls_row)\n                need(raw.fileno()==-1,'raw_socket_transferred_to_registered_tls')\n                raw_row['transferred']=True\n            while True:\n                self.left(deadline)\n                try:tls.do_handshake();break\n                except ssl.SSLWantReadError:self.wait(tls,deadline,True)\n                except ssl.SSLWantWriteError:self.wait(tls,deadline,False)\n            self.left(deadline)\n            need(tls.selected_alpn_protocol() in (None,'http/1.1')\n                 and sha(tls.getpeercert(binary_form=True))==self.peer_sha,'actual_trusted_tls_peer')\n            row['tlsVerified']=True;row['peerSha256']=self.peer_sha\n            payload=b'' if body is None else canonical(body)\n            need(len(payload)<=MAX_HTTP_BODY,'control_request_body_bound')\n            actual_token=self.root_token if token is None else token\n            headers=[method+' /v1/'+route+' HTTP/1.1','Host: 127.0.0.1:'+str(self.port),\n                     'Connection: close','Content-Length: '+str(len(payload))]\n            if body is not None:headers.append('Content-Type: application/json')\n            if actual_token:\n                need(isinstance(actual_token,str) and len(actual_token)<=8192\n                     and re.fullmatch('[\\x21-\\x7e]+',actual_token),'private_token_header_shape')\n                headers.append('X-Vault-Token: '+actual_token)\n            request=('\\r\\n'.join(headers)+'\\r\\n\\r\\n').encode('ascii')+payload\n            row['dispatched']=True\n            self.send(tls,request,deadline)\n            status,reply,framing=self.response(tls,deadline)\n            self.left(deadline)\n            row.update(status=status,responseBytes=len(reply),responseSha256=sha(reply),\n                       framing=framing,responseComplete=True)\n            result={} if not reply else exact_json(reply)\n            need(isinstance(result,dict),'typed_json_response_object')\n            need(status==expected,'exact_expected_http_status')\n            if validate is not None:validate(result)\n            self.left(deadline);row['responseValidated']=True\n        except BaseException as error:\n            row['errorType']=type(error).__name__\n            row['errorCode']=str(error) if isinstance(error,Refused) else None\n            if row['dispatched']:self.unknown=True\n            raise\n        finally:\n            for sock in reversed(socks):self.close(sock)\n            row['socketClosuresComplete']=all(s['closed'] for s in socks)\n            completed_at=time.monotonic()\n            row['elapsedSeconds']=completed_at-started\n            row['completedWithinOriginalDeadline']=completed_at<deadline\n            row['outcomeUnknown']=bool((row['dispatched'] and (not row['responseValidated']\n                or not row['completedWithinOriginalDeadline'])) or not row['socketClosuresComplete'])\n            self.unknown=bool(self.unknown or row['outcomeUnknown'])\n            if row['responseValidated'] and row['socketClosuresComplete'] and row['completedWithinOriginalDeadline']:\n                self.inflight=None\n            elif not row['dispatched'] and row['socketClosuresComplete']:\n                # A known refused TCP connection before sending is only usable\n                # by the explicit bounded readiness loop, not a mutation retry.\n                self.inflight=None\n            else:self.unknown=True\n        need(not self.unknown and row['completedWithinOriginalDeadline'],'complete_http_terminal_deadline')\n        return result\n    def ready(self,status):\n        deadline=min(self.ctx.until,time.monotonic()+NEW_LISTENER_READY_SECONDS)\n        for attempt in range(120):\n            self.left(deadline)\n            try:return self.call('listener-ready-'+str(attempt),'GET','sys/health',\n                                 token='',expected=status,until=deadline)\n            except ConnectionRefusedError:\n                need(not self.unknown and self.inflight is None,'known_not_sent_ready_refusal')\n                time.sleep(min(0.05,self.left(deadline)))\n        raise Refused('finite_listener_readiness_exhausted')\n    def close_all(self):\n        for row in reversed(self.sockets):self.close(row)\n    def public(self):\n        return {'requests':list(self.rows),'requestCount':len(self.rows),\n            'inflight':None if self.inflight is None else {\n                k:self.inflight[k] for k in ('name','method','route','dispatched')},\n            'outcomeUnknown':self.unknown,\n            'allOwnedSocketsClosed':all(row['closed'] for row in self.sockets),\n            'onlyEndpoint':'127.0.0.1:'+str(self.port),'originalPerRequestSeconds':10,\n            'newListenerReadySeconds':NEW_LISTENER_READY_SECONDS,'redirectsFollowed':0,\n            'businessRequestsReplayed':0}\n\ndef add_secrets(values,value):\n    if isinstance(value,dict):\n        for key,item in value.items():\n            if isinstance(item,str) and len(item)>=8 and key not in ('provider','type','chatgptPlanType'):\n                values.add(item)\n            elif isinstance(item,(dict,list)):add_secrets(values,item)\n    elif isinstance(value,list):\n        for item in value:add_secrets(values,item)\n\ndef reserve_port(ctx):\n    need(ctx.port_reservation is None,'one_owned_ephemeral_port_reservation')\n    row={'created':False,'closeAttempted':False,'closed':False};sock=None\n    ctx.port_reservation=row\n    try:\n        with ctx.critical():\n            sock=socket.socket(socket.AF_INET,socket.SOCK_STREAM);row['created']=True\n        sock.bind(('127.0.0.1',0));port=sock.getsockname()[1]\n        need(1024<=port<=65535,'one_owned_ephemeral_port');ctx.remaining();return port\n    finally:\n        if sock is not None:\n            with ctx.critical():\n                row['closeAttempted']=True\n                try:\n                    sock.close();row['closed']=sock.fileno()==-1\n                except BaseException as error:\n                    row['closeErrorType']=type(error).__name__\n                if not row['closed']:ctx.unknown=True\n            need(row['closed'],'ephemeral_port_reservation_closed')\n\ndef generated_read_fsync(ctx,guard,path,maximum):\n    row=None\n    with guard.parent(path) as (parent,name):\n        try:\n            with ctx.critical():\n                row=ctx.fd(os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent),'owned-generated')\n            first=os.fstat(row['fd'])\n            need(stat.S_ISREG(first.st_mode) and first.st_uid==501 and first.st_nlink==1\n                 and stat.S_IMODE(first.st_mode)==0o600 and 0<first.st_size<=maximum,\n                 'owned_generated_file_custody')\n            raw=bytearray()\n            while len(raw)<=first.st_size:\n                ctx.remaining();part=os.read(row['fd'],min(65536,first.st_size+1-len(raw)))\n                if not part:break\n                raw.extend(part)\n            os.fsync(row['fd']);os.fsync(parent)\n            need(len(raw)==first.st_size and ident(first)==ident(os.fstat(row['fd']))\n                 ==ident(os.stat(name,dir_fd=parent,follow_symlinks=False)),'owned_generated_whole_read_and_fsync')\n            return bytes(raw)\n        finally:\n            if row is not None:ctx.close(row)\n            need(row is None or row['closed'],'owned_generated_close')\n\ndef tls_material(ctx,guard,commands):\n    tls=ROOT/'server/tls'\n    extension=b'basicConstraints=critical,CA:FALSE\\nkeyUsage=critical,digitalSignature,keyEncipherment\\nextendedKeyUsage=serverAuth\\nsubjectAltName=DNS:localhost,IP:127.0.0.1\\nsubjectKeyIdentifier=hash\\nauthorityKeyIdentifier=keyid:always\\n'\n    guard.write_new(tls/'leaf.ext',extension)\n    calls=(\n      ('owned-ca',['/usr/bin/openssl','req','-x509','-newkey','rsa:2048','-nodes',\n        '-keyout',str(tls/'ca.key'),'-out',str(tls/'ca.crt'),'-days','2','-subj','/CN=heptabao-mac-owned-ca',\n        '-addext','basicConstraints=critical,CA:TRUE','-addext','keyUsage=critical,keyCertSign,cRLSign',\n        '-addext','subjectKeyIdentifier=hash','-addext','authorityKeyIdentifier=keyid:always']),\n      ('owned-leaf-request',['/usr/bin/openssl','req','-new','-newkey','rsa:2048','-nodes',\n        '-keyout',str(tls/'server.key'),'-out',str(tls/'server.csr'),'-subj','/CN=localhost']),\n      ('owned-leaf-sign',['/usr/bin/openssl','x509','-req','-in',str(tls/'server.csr'),\n        '-CA',str(tls/'ca.crt'),'-CAkey',str(tls/'ca.key'),'-CAcreateserial',\n        '-out',str(tls/'server.crt'),'-days','2','-extfile',str(tls/'leaf.ext')]))\n    for label,argv in calls:\n        row,out,err=commands.run(label,argv,until=min(ctx.until,time.monotonic()+30),maximum=262144)\n        need(row['exitCode']==0 and row['completeBeforeDeadline'] and not row['outcomeUnknown'],\n             'owned_tls_material_command')\n        ctx.remaining()\n    files={}\n    for name in ('ca.key','ca.crt','server.key','server.csr','server.crt','ca.srl'):\n        files[name]=generated_read_fsync(ctx,guard,tls/name,65536)\n    ca=files['ca.crt'];certificate=files['server.crt']\n    peer=sha(ssl.PEM_cert_to_DER_cert(certificate.decode('ascii')))\n    need(all(b'PRIVATE KEY' not in value for name,value in files.items() if name in ('ca.crt','server.crt')),\n         'public_certificates_not_keys')\n    return ca,peer,{name:sha(value) for name,value in files.items()}\n\ndef capture_once(ctx,guard,commands,stage,pins,anchor_raw,anchor_sha):\n    from mac_current_capture_entry_wal_r1 import (\n        capture_profile,capture_envelope,library_resources_closed)\n    need(stage in ('before','after')\n         and not any(x['stage']==stage for x in ctx.capture_attempts),\n         'two_named_capture_stages_once')\n    base=ROOT/'captures'/stage\n    for path in (base,base/'probe',base/'output'):guard.mkdir_new(path)\n    guard.write_new(base/'probe/writable-owned-main',b'owned capture kernel-write fence r1\\n')\n    policy=capture_profile(stage);guard.write_new(base/'capture.sb',policy)\n    source_raw=encoded({name:pins[name] for name in ENTRY_NAMES})\n    synthetic_raw=encoded(SYNTHETIC);native_raw=encoded(NATIVE_BINDING);wal_raw=encoded(WAL_BINDING)\n    deadline=min(ctx.until,time.monotonic()+CAPTURE_SECONDS)\n    argv=['/usr/bin/sandbox-exec','-f',str(base/'capture.sb'),'/opt/homebrew/bin/python3','-I','-S','-B',\n        str(QA/'mac_current_capture_entry_wal_r1.py'),'--stage',stage,'--absolute-until',repr(deadline),\n        '--public-volume-anchor-base64',base64.b64encode(anchor_raw).decode(),\n        '--public-volume-anchor-sha256',anchor_sha,'--source-pins-base64',base64.b64encode(source_raw).decode(),\n        '--source-pins-sha256',sha(source_raw),'--synthetic-binding-base64',base64.b64encode(synthetic_raw).decode(),\n        '--synthetic-binding-sha256',sha(synthetic_raw),\n        '--native-binding-base64',base64.b64encode(native_raw).decode(),\n        '--native-binding-sha256',sha(native_raw),\n        '--wal-binding-base64',base64.b64encode(wal_raw).decode(),\n        '--wal-binding-sha256',sha(wal_raw),'--sandbox-profile-sha256',sha(policy)]\n    attempt={'stage':stage,'commandAttempted':True,'terminalKnown':False,\n        'typedReportAvailable':False,'captureLibraryResourcesClosed':False,\n        'entryDescriptorsClosed':False,'child':None,'report':None}\n    ctx.capture_attempts.append(attempt)\n    try:\n        row,out,err=commands.run('current-capture-'+stage,argv,until=deadline,maximum=262144)\n        attempt.update(child=row,stdoutSha256=sha(out),stdoutBytes=len(out),\n                       stderrSha256=sha(err),stderrBytes=len(err))\n        guard.write_new(base/'stdout.public.json',out);guard.write_new(base/'stderr.private',err)\n        value=exact_json(out)\n        need(type(value) is dict and value.get('schema')=='heptabao.mac-guarded-current-capture-entry.wal-r1'\n             and value.get('stage')==stage and all(type(value.get(key)) is bool for key in\n                 ('ok','outcomeUnknown','captureLibraryAttempted','captureLibraryLedgerAvailable',\n                  'allCaptureLibraryResourcesClosed','entryOwnedDescriptorsClosed')),\n             'typed_capture_terminal_report')\n        attempt['report']=value;attempt['typedReportAvailable']=True\n        if value['outcomeUnknown']:ctx.unknown=True\n        if value['captureLibraryAttempted']:\n            observation=capture_envelope(value.get('observation'))\n            attempt['captureLibraryResourcesClosed']=bool(\n                value['captureLibraryLedgerAvailable'] and library_resources_closed(observation)\n                and value['allCaptureLibraryResourcesClosed'])\n        else:\n            attempt['captureLibraryResourcesClosed']=value['allCaptureLibraryResourcesClosed']\n        attempt['entryDescriptorsClosed']=bool(value['entryOwnedDescriptorsClosed']\n                                               and value.get('allOwnedDescriptorsClosed') is True)\n        attempt['terminalKnown']=bool(type(row.get('exitCode')) is int\n            and row.get('completeBeforeDeadline') is True and row.get('outcomeUnknown') is False\n            and row.get('streamsClosed') is True and row.get('cleanup',{}).get('ok') is True)\n        need(row['exitCode']==0 and row['completeBeforeDeadline'] and not row['outcomeUnknown']\n             and not err,'actual_sandbox_capture_child_terminal')\n        need(value.get('ok') is True and value.get('outcomeUnknown') is False\n             and value.get('productionWriteAttempted') is False\n             and value.get('captureLibraryReturned') is True\n             and value.get('captureLibraryLedgerAvailable') is True\n             and attempt['captureLibraryResourcesClosed'] and attempt['entryDescriptorsClosed']\n             and value.get('originalDeadlineMetAfterPrivatePublicationAndClosure') is True\n             and value.get('originalAbsoluteDeadlineMonotonic')==deadline\n             and value.get('syntheticProofSha256')==SYNTHETIC['stdoutSha256']\n             and value.get('walSyntheticProofSha256')==WAL_BINDING['stdoutSha256']\n             and value.get('walSyntheticAuthoritySha256')==WAL_BINDING['authoritySha256']\n             and value.get('nativePublicProofSha256')==NATIVE_BINDING['stdoutSha256']\n             and value.get('nativePublicAuthoritySha256')==NATIVE_BINDING['authoritySha256']\n             and value.get('nativePublicChildSha256')==NATIVE_BINDING['childStdoutSha256']\n             and value.get('actualNativeRuntimeCompatible') is True\n             and value.get('nativeProjection',{}).get('selfQualified') is True,\n             'whole_successful_sandbox_capture_report')\n        held=value.get('heldT5Final',{});owned=value.get('ownedCommands',{})\n        need(held.get('allDescriptorsClosed') is True and held.get('closeErrors')==[]\n             and held.get('lastAnchorCheckPassed') is True and owned.get('allOwnedCommandsStopped') is True\n             and owned.get('unknownCommandCount')==0 and value.get('kernelSandboxProof',{}).get('allFourDenied') is True,\n             'capture_held_volume_kernel_and_command_closure')\n        capsule=guard.read(base/'output/capsule.private.json',4*1024*1024)\n        need(value.get('capsule',{}).get('path')==str(base/'output/capsule.private.json')\n             and value['capsule'].get('bytes')==len(capsule) and value['capsule'].get('sha256')==sha(capsule),\n             'whole_private_capture_capsule')\n        attempt.update(privateCapsuleSha256=sha(capsule),privateCapsuleBytes=len(capsule))\n        ctx.remaining(deadline)\n        return exact_json(capsule),attempt\n    except BaseException:\n        if (not attempt['terminalKnown'] or not attempt['typedReportAvailable']\n            or not attempt['captureLibraryResourcesClosed'] or not attempt['entryDescriptorsClosed']):\n            ctx.unknown=True\n        raise\n\ndef seed_documents(packet):\n    ids=packet['targetProfileIds'];credentials=packet['credentials'];profiles={};entries=[];managed=[]\n    for pid in ids:\n        credential=credentials[pid];pin=digest(credential);key='sha256-'+pin\n        identity=digest({name:credential.get(name) for name in ('provider','type','email','accountId','projectId')})\n        payload={'schemaVersion':1,'profileId':pid,'credential':copy.deepcopy(credential),'digest':pin,'identity':identity}\n        entry={k:v for k,v in payload.items() if k not in ('credential','schemaVersion')}\n        entry.update(key=key,provider=credential['provider'],type=credential['type'],\n                     expires=credential['expires'],quarantined=False,status='active')\n        profiles['profiles/'+key]=payload;entries.append(entry)\n        managed.append({'profileId':pid,'key':key,'credentialSha256':pin,\n            'identityDigest':digest({name:credential[name] for name in ('provider','type','accountId','email')\n                                     if name in credential})})\n    now=int(time.time()*1000)\n    order={'schemaVersion':1,'generation':1,'providers':{'openai':{'candidates':[\n        {'profileId':pid,'digest':digest(credentials[pid]),'enrolledAt':now} for pid in reversed(ids)],\n        'activeProfile':None,'enforceManagedOrder':False}}}\n    docs={**profiles,'order-policy':order,'scheduler-assignments':{\n        'schemaVersion':1,'generation':1,'assignments':[]},'manifest':{'schemaVersion':1,'generation':1,'profiles':entries}}\n    return docs,managed\n\ndef exact_data(value):\n    need(isinstance(value.get('data'),dict),'response_data_object')\n    return value['data']\n\ndef bootstrap_api(client,guard,docs,secrets):\n    def initialization(value):\n        need(isinstance(value.get('root_token'),str) and value['root_token']\n             and isinstance(value.get('keys_base64'),list) and len(value['keys_base64'])==1\n             and isinstance(value['keys_base64'][0],str),'actual_init_credentials')\n    init=client.call('initialize','POST','sys/init',{'secret_shares':1,'secret_threshold':1},\n                     token='',validate=initialization)\n    root=init['root_token'];unseal=init['keys_base64'][0];secrets.update((root,unseal));client.root_token=root\n    guard.write_new(ROOT/'outer-native-r1/recovery.private.json',encoded({'rootToken':root,'unsealKey':unseal}))\n    client.call('unseal','POST','sys/unseal',{'key':unseal},token='',\n                validate=lambda v:need(v.get('sealed') is False,'actual_unsealed'))\n    client.call('kv2-mount','POST','sys/mounts/openclaw-auth',{'type':'kv','options':{'version':'2'}},expected=204)\n    client.call('approle-mount','POST','sys/auth/approle',{'type':'approle'},expected=204)\n    client.call('formal-native-activation','POST','sys/storage/native-v6/activate',{},expected=204)\n    client.call('formal-format-two','GET','sys/internal/capacity',\n        validate=lambda v:need(exact_data(v).get('native_kv2_reader_format')==2,'actual_native_format_two'))\n    for index,(name,data) in enumerate(docs.items()):\n        client.call('canonical-seed-'+str(index),'POST','openclaw-auth/data/'+name,\n            {'data':data,'options':{'cas':0}},\n            validate=lambda v:need(exact_data(v).get('version')==1,'actual_cas_zero_created_once'))\n    policy='\\n'.join('path \"openclaw-auth/data/'+name+'\" { capabilities=[\"read\"] }' for name in docs)\n    policy+='\\npath \"openclaw-auth/data/inbox/mac/*\" { capabilities=[\"create\",\"update\"] }\\n'\n    policy+='\\n'.join('path \"auth/token/'+name+'\" { capabilities=[\"'+verb+'\"] }'\n        for name,verb in (('lookup-self','read'),('renew-self','update'),('revoke-self','update')))\n    client.call('consumer-policy','PUT','sys/policies/acl/mac-five-current',{'policy':policy},expected=204)\n    route='auth/approle/role/mac-five-current'\n    client.call('consumer-role','POST',route,{'token_policies':['mac-five-current'],\n        'token_ttl':'180s','token_max_ttl':'600s','secret_id_ttl':'1200s','secret_id_num_uses':0},expected=204)\n    role=client.call('consumer-role-id','GET',route+'/role-id',\n        validate=lambda v:need(isinstance(exact_data(v).get('role_id'),str) and v['data']['role_id'],\n                                'actual_role_id'))['data']['role_id']\n    secret=client.call('consumer-secret-id','POST',route+'/secret-id',{},\n        validate=lambda v:need(isinstance(exact_data(v).get('secret_id'),str) and v['data']['secret_id'],\n                                'actual_secret_id'))['data']['secret_id']\n    secrets.update((role,secret))\n    guard.write_new(ROOT/'credentials-consumer/role_id',role.encode())\n    guard.write_new(ROOT/'credentials-consumer/secret_id',secret.encode())\n    return unseal\n\ndef canonical_and_inbox(client,docs,phases):\n    for index,(name,data) in enumerate(docs.items()):\n        client.call('canonical-readback-'+str(len(phases))+'-'+str(index),'GET','openclaw-auth/data/'+name,\n            validate=lambda v,data=data:need(exact_data(v).get('data')==data\n                and v['data'].get('metadata',{}).get('version')==1,'canonical_scope_and_original_cas_exact'))\n    paths=[]\n    for phase in phases:\n        cycle=phase['records'][0]['report']\n        need(cycle.get('publishNewFlagPreserved') is True and cycle.get('workerManifestWriteRouteAllowed') is False,\n             'original_publish_flag_and_canonical_scope')\n        for item in cycle['wire']:\n            if item['method']=='POST' and item['path'].startswith('/v1/openclaw-auth/data/inbox/mac/'):\n                suffix=item['path'].split('/inbox/mac/',1)[1]\n                need(re.fullmatch('[A-Za-z0-9_-]{1,128}',suffix) and item.get('complete') is True\n                     and item.get('status')==200,'actual_complete_inbox_post')\n                paths.append(suffix)\n    need(len(paths)==len(set(paths))<=256,'finite_distinct_observed_inbox_events')\n    if paths:\n        listed=client.call('inbox-list-'+str(len(phases)),'LIST','openclaw-auth/metadata/inbox/mac',\n            validate=lambda v:need(isinstance(exact_data(v).get('keys'),list)\n                and sorted(v['data']['keys'])==sorted(paths),'exact_observed_inbox_keyset'))\n        for index,key in enumerate(sorted(paths)):\n            client.call('inbox-read-'+str(len(phases))+'-'+str(index),'GET','openclaw-auth/data/inbox/mac/'+key,\n                validate=lambda v:need(isinstance(exact_data(v).get('data'),dict),'actual_proposal_document'))\n    else:\n        client.call('inbox-absent-'+str(len(phases)),'LIST','openclaw-auth/metadata/inbox/mac',expected=404)\n    return {'observedInboxPosts':len(paths),'canonicalDocumentCount':len(docs),\n        'canonicalAllVersionOneAndWholePayloadExact':True,'publishNewUnchanged':True,\n        'canonicalGrantAddedByConsumer':False,'coordinatorExecuted':False,\n        'proposalPresenceNotInterpretedAsCanonicalGrant':True}\n\ndef token_lifecycle(client,guard,phase,secrets):\n    raw=guard.read(ROOT/phase/'workers/authbus-five-agent-cycle.auth.private.json',65536)\n    value=exact_json(raw)\n    need(isinstance(value,dict) and set(value)=={'tokens'} and isinstance(value['tokens'],list)\n         and len(value['tokens'])==1 and isinstance(value['tokens'][0],str),'actual_cycle_token_custody')\n    token=value['tokens'][0];secrets.add(token)\n    client.call('unassigned-denied-'+phase,'GET','openclaw-auth/data/profiles/unassigned',token=token,expected=403)\n    client.call('renew-self-'+phase,'POST','auth/token/renew-self',{},token=token)\n    client.call('revoke-self-'+phase,'POST','auth/token/revoke-self',{},token=token,expected=204)\n    client.call('revoked-denied-'+phase,'GET','openclaw-auth/data/manifest',token=token,expected=403)\n    return {'phase':phase,'actualTokenCaptured':True,'renewed':True,'revoked':True,\n            'unassignedAndRevokedRequestsRejected':True}\n\ndef scan_owned_plaintext(ctx,guard,packet):\n    literals=[v.encode() for c in packet['credentials'].values() for key,v in c.items()\n              if key in ('access','refresh') and isinstance(v,str) and v]\n    roots=[ROOT/'server/data',*[ROOT/phase/'state/agents'/agent/'agent/codex-home'\n           for phase in ('initial','cold-new-process') for agent in AGENTS]]\n    seen=0;total=0;directories=0;server_files=0\n    def fail(error):raise error\n    for root in roots:\n        if root!=ROOT/'server/data':\n            try:(root/'auth.json').lstat()\n            except FileNotFoundError:pass\n            else:raise Refused('native_auth_json_must_remain_absent')\n        for directory,subdirs,files in os.walk(root,followlinks=False,onerror=fail):\n            ctx.remaining();directories+=1;need(directories<=512,'finite_owned_plaintext_directories')\n            for name in subdirs:\n                need(stat.S_ISDIR((Path(directory)/name).lstat().st_mode),'no_owned_scan_symlink_directories')\n            for name in files:\n                seen+=1;need(seen<=512,'finite_owned_plaintext_files')\n                if root==ROOT/'server/data':server_files+=1\n                path=Path(directory)/name;info=path.lstat()\n                need(stat.S_ISREG(info.st_mode) and not path.is_symlink() and info.st_size<=16*1024*1024,\n                     'bounded_owned_plaintext_file')\n                raw=guard.read(path,16*1024*1024);total+=len(raw)\n                need(total<=64*1024*1024 and all(value not in raw for value in literals),\n                     'no_managed_provider_plaintext_in_server_or_native_homes')\n    need(seen>0 and server_files>0,'actual_owned_server_disk_files_observed')\n    return {'files':seen,'serverFiles':server_files,'directories':directories,'bytesRead':total,\n            'providerAccessRefreshAbsent':True,'allTenNativeAuthFilesAbsent':True,\n            'wholeProductionBackupClaimed':False}\n\ndef main():\n    os.umask(0o077);ctx=Context()\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--candidate',type=Path,required=True)\n    parser.add_argument('--candidate-sha256',required=True)\n    parser.add_argument('--public-source-pins-base64',required=True)\n    parser.add_argument('--public-source-pins-sha256',required=True)\n    parser.add_argument('--public-volume-anchor-base64',required=True)\n    parser.add_argument('--public-volume-anchor-sha256',required=True)\n    args=parser.parse_args()\n    guard=None;commands=None;inputs=None;materializer=None;manager=None;client=None\n    public_proof_inputs=None\n    manager_terminal=None;candidate_result=None;completed=False;capsule_before=None;output_created=False\n    secrets=set();qa_identities={};proof=None;packet=None;capture_reports=ctx.capture_attempts;phase_results=[]\n    report={'schema':'heptabao.mac-current-five-agent-owned-launchd-outer.wal-r1','ok':False,\n        'outcomeUnknown':False,'sourceCommit':COMMIT,'sourceTree':TREE,'checks':[],\n        'productionCaptureAttempted':False,'productionChangedByController':False,\n        'productionServiceOperationDispatched':False,'providerRequested':False,'j3160Contacted':False,\n        'currentProviderAvailabilityQualified':False,'allAccountsQualified':False,\n        'productionManagerQualification':False,'fullReplacementQualified':False,\n        'automaticBusinessRetry':False,'credentialValuesPublished':False,\n        'sourceGeneration':'new_registry_readonly_wal_df026_successor',\n        'newOuterSeconds':900,'newManagerSeconds':600,'newManagerCleanupSeconds':60,\n        'originalPhaseSeconds':120,'originalNativeSeconds':[15,8,3],\n        'originalHttpSeconds':10,'originalCaptureSeconds':45}\n    def check(name,value):\n        need(isinstance(value,bool),'boolean_outer_check')\n        report['checks'].append({'case':name,'passed':value});need(value,name)\n    try:\n        need(sys.platform=='darwin' and os.getuid()==501 and os.getgid()==20,'actual_mac_owner')\n        pins_raw=base64.b64decode(args.public_source_pins_base64,validate=True)\n        need(len(pins_raw)<=8192 and sha(pins_raw)==args.public_source_pins_sha256,'exact_public_qa_pin_input')\n        pins=exact_json(pins_raw)\n        need(isinstance(pins,dict) and set(pins)==set(NAMES) and all(valid_pin(v) for v in pins.values()),\n             'complete_exact_qa_source_inventory')\n        for name,pin in pins.items():qa_identities[name]=read_public_source(ctx,QA/name,pin)\n        sys.path.insert(0,str(QA))\n        from mac_owned_commands_r1 import Signals,Commands\n        from mac_t5_volume_guard_r1 import HeldT5\n        from mac_registry_readonly_wal_r1 import WalInputs,validate_original_immutable_proof\n        from mac_current_capture_entry_wal_r1 import (\n            admitted_synthetic,admitted_native,admitted_wal,library_resources_closed)\n        from mac_current_outer_inputs_r2 import Inputs,PLUGIN_FILES\n        from mac_current_fixture_materializer_r1 import Materializer\n        from mac_owned_launchd_r3 import OwnedLaunchd\n        ctx.signals=Signals();ctx.signals.install();commands=Commands(ctx.signals)\n        for path,value in FIXED_UTILITIES.items():read_system_tool(ctx,Path(path),value)\n        anchor_raw=base64.b64decode(args.public_volume_anchor_base64,validate=True)\n        guard=HeldT5(anchor_raw,args.public_volume_anchor_sha256,ctx.remaining,ctx.critical)\n        row,out,err=commands.run('outer-t5-volume',['/usr/sbin/diskutil','info','-plist','/Volumes/T5'],\n            until=min(ctx.until,time.monotonic()+30),maximum=262144)\n        need(row['exitCode']==0 and row['completeBeforeDeadline'] and not row['outcomeUnknown'],\n             'actual_t5_before_private_outer_io');guard.accept_diskutil(out)\n        need(args.candidate==ROOT/'candidate-current-manager-wal-r1.public.json' and valid_pin(args.candidate_sha256),\n             'fixed_public_manager_candidate')\n        candidate_raw=guard.read(args.candidate,65536);need(sha(candidate_raw)==args.candidate_sha256,'whole_public_candidate')\n        candidate=exact_json(candidate_raw)\n        need(isinstance(candidate,dict) and set(candidate)=={'schema','sourceCommit','sourceTree','sourcePins',\n            'syntheticBinding','nativeBinding','walBinding','publicVolumeAnchorSha256','utilityPins','budgets'}\n            and candidate['schema']=='heptabao.mac-current-manager-candidate.wal-r1'\n            and candidate['sourceCommit']==COMMIT and candidate['sourceTree']==TREE\n            and candidate['sourcePins']==pins and candidate['syntheticBinding']==SYNTHETIC\n            and candidate['nativeBinding']==NATIVE_BINDING and candidate['walBinding']==WAL_BINDING\n            and candidate['utilityPins']=={path:value['sha256'] for path,value in FIXED_UTILITIES.items()}\n            and candidate['publicVolumeAnchorSha256']==args.public_volume_anchor_sha256\n            and candidate['budgets']=={'outer':900,'manager':600,'managerFailureCleanup':60,\n                'phase':120,'native':[15,8,3],'http':10,'capture':45,'listenerReady':30,'tlsCommand':30},\n            'entire_reviewed_public_candidate_contract')\n        native_proof_raw,native_proof=admitted_native(guard,NATIVE_BINDING)\n        report['nativePublicProof']={\n            'jobId':NATIVE_BINDING['jobId'],'stdoutSha256':sha(native_proof_raw),\n            'authoritySha256':NATIVE_BINDING['authoritySha256'],\n            'childStdoutSha256':NATIVE_BINDING['childStdoutSha256'],\n            'modulePins':NATIVE_BINDING['modulePins'],\n            'actualRuntimeIdentity':native_proof['nativeProjection']['identity']}\n        ctx.remaining()\n        proof_raw,proof=admitted_synthetic(guard,SYNTHETIC)\n        wal_proof_raw,wal_proof=admitted_wal(guard,WAL_BINDING)\n        need(wal_proof.get('runtime',{}).get('runtime')==proof['runtime'],\n             'same_original_immutable_and_registry_wal_public_runtime')\n        report['walPublicProof']={'jobId':WAL_BINDING['jobId'],\n            'stdoutSha256':sha(wal_proof_raw),'authoritySha256':WAL_BINDING['authoritySha256'],\n            'librarySha256':WAL_BINDING['librarySha256'],'tenPublicCasesQualified':True}\n        public_proof_inputs=WalInputs(until=ctx.until,critical=ctx.critical,\n                                     cancelled=lambda:ctx.signals.pending is not None)\n        try:\n            validate_original_immutable_proof(public_proof_inputs,proof_raw,SYNTHETIC['stdoutSha256'])\n        finally:public_proof_inputs.close()\n        report['publicProofClosure']=public_proof_inputs.public()\n        need(library_resources_closed(report['publicProofClosure']),'tracked_public_proof_code_closure')\n        ctx.remaining()\n        inputs=Inputs(guard,ctx.signals,ctx.until)\n        report['utilityPins']=inputs.admit_utilities(candidate['utilityPins'])\n        runtime,report['normalSourceBinding']=inputs.normal_and_base_sources()\n        packet,report['frozenSourceProjection']=inputs.project_frozen()\n        add_secrets(secrets,packet);secrets.update(packet['targetProfileIds'])\n        guard.mkdir_new(ROOT/'outer-native-r1');output_created=True\n        for path in (ROOT/'captures',ROOT/'launchd',ROOT/'server',\n                     ROOT/'server/data',ROOT/'server/tls',ROOT/'installed-plugin-copy',\n                     ROOT/'installed-plugin-copy/node_modules',ROOT/'credentials-consumer'):\n            guard.mkdir_new(path)\n        guard.write_new(ROOT/'outer-native-r1/intent.public.json',encoded({\n            'schema':report['schema'],'candidateSha256':args.candidate_sha256,'sourcePins':pins,\n            'syntheticBinding':SYNTHETIC,'nativeBinding':NATIVE_BINDING,'walBinding':WAL_BINDING,\n            'budgets':candidate['budgets'],'twoOwnedLaunchdLabelsOnly':True,\n            'productionWriteAuthorized':False,'providerAuthorized':False,'businessReplaysAuthorized':False}))\n        guard.write_new(ROOT/'outer-native-r1/managed12.private.json',encoded(packet))\n        report['productionCaptureAttempted']=True\n        capsule_before,before_public=capture_once(ctx,guard,commands,'before',pins,\n            anchor_raw,args.public_volume_anchor_sha256)\n        for document in capsule_before['authDocuments']:\n            for values in document['rows'].values():\n                for raw_row in values:\n                    decoded=exact_json(raw_row[1]);add_secrets(secrets,decoded)\n                    if isinstance(decoded.get('profiles'),dict):secrets.update(decoded['profiles'])\n        runtime=inputs.admit_actual_harnesses(capsule_before['registry'],runtime)\n        source_pins=inputs.public_pins()\n        for name in PLUGIN_FILES:\n            data=inputs.pin_code(Path('/Users/qianqi/.openclaw/extensions/openclaw-authbus')/name,collect=True)\n            path=ROOT/'installed-plugin-copy'/name;guard.write_new(path,data);source_pins[str(path)]=sha(data)\n        link=ROOT/'installed-plugin-copy/node_modules/openclaw'\n        with guard.parent(link) as (parent,name):\n            os.symlink(runtime['sdkRoot'],name,dir_fd=parent);os.fsync(parent)\n            info=os.stat(name,dir_fd=parent,follow_symlinks=False)\n            need(stat.S_ISLNK(info.st_mode) and info.st_uid==501 and info.st_nlink==1\n                 and os.readlink(name,dir_fd=parent)==runtime['sdkRoot'],'single_explicit_owned_sdk_symlink')\n            link_identity=list(ident(info))\n        report['ownedSdkLink']={'path':str(link),'target':runtime['sdkRoot'],'identity':link_identity}\n        port=reserve_port(ctx);ca,peer_sha,report['ownedTlsPins']=tls_material(ctx,guard,commands)\n        guard.write_new(ROOT/'credentials-consumer/ca.crt',ca)\n        config={'listen':'127.0.0.1:'+str(port),'data_dir':str(ROOT/'server/data'),\n            'audit_file':str(ROOT/'server/audit.jsonl'),'tls_cert_file':str(ROOT/'server/tls/server.crt'),\n            'tls_key_file':str(ROOT/'server/tls/server.key'),\n            'storage':{'native_v6_file':{'path':str(ROOT/'server/data')}}}\n        config_raw=encoded(config);guard.write_new(ROOT/'server/server.json',config_raw)\n        for generation in ('server-initial','server-cold-new-process'):\n            guard.write_new(ROOT/'launchd'/(generation+'.private.json'),encoded({\n                'schema':'heptabao.mac-owned-launchd-server-plan.private.r1','generation':generation,\n                'binaryPath':str(BINARY),'binarySha256':BINARY_SHA,'binaryBytes':BINARY_BYTES,\n                'configPath':str(ROOT/'server/server.json'),'configSha256':sha(config_raw),\n                'port':port,'workRoot':str(ROOT)}))\n        manager=OwnedLaunchd(guard=guard,commands=commands,signals=ctx.signals,\n            until=min(ctx.until,time.monotonic()+600),anchor_raw=anchor_raw,\n            anchor_sha256=args.public_volume_anchor_sha256,qa_pins=pins,\n            python_runtime=proof['runtime']['pythonExecutable'])\n        manager.start_server('server-initial')\n        client=LoopbackHTTP(ctx,port,ca,peer_sha);client.ready(501)\n        docs,managed=seed_documents(packet)\n        unseal=bootstrap_api(client,guard,docs,secrets)\n        original_cfg=exact_json(base64.b64decode(capsule_before['configBase64'],validate=True))\n        original_plugin=original_cfg['plugins']['entries']['openclaw-authbus']['config']\n        plugin=copy.deepcopy(original_plugin)\n        plugin.update(address='https://127.0.0.1:'+str(port),\n            caFile=str(ROOT/'credentials-consumer/ca.crt'),roleIdFile=str(ROOT/'credentials-consumer/role_id'),\n            secretIdFile=str(ROOT/'credentials-consumer/secret_id'))\n        materializer=Materializer(guard,ctx.signals,ctx.until)\n        report['materialization']=materializer.materialize(capsule_before,plugin_config=plugin,\n            managed_profiles=managed,runtime=runtime,source_pins=source_pins,qa_pins=pins,\n            port=port,server_certificate_sha256=peer_sha)\n        first=manager.run_phase('initial');phase_results.append(first)\n        report['initialCanonicalAndInbox']=canonical_and_inbox(client,docs,phase_results)\n        report['initialTokenLifecycle']=token_lifecycle(client,guard,'initial',secrets)\n        manager.kill_server_for_cold_or_inverse('server-initial')\n        manager.start_server('server-cold-new-process')\n        client.ready(503)\n        client.call('cold-unseal','POST','sys/unseal',{'key':unseal},token='',\n            validate=lambda v:need(v.get('sealed') is False,'actual_cold_unsealed'))\n        second=manager.run_phase('cold-new-process');phase_results.append(second)\n        report['coldCanonicalAndInbox']=canonical_and_inbox(client,docs,phase_results)\n        report['coldTokenLifecycle']=token_lifecycle(client,guard,'cold-new-process',secrets)\n        manager.kill_server_for_cold_or_inverse('server-cold-new-process')\n        phase_results.append(manager.run_phase('initial-inverse'))\n        phase_results.append(manager.run_phase('cold-new-process-inverse'))\n        manager_terminal=manager.finish()\n        check('four_independent_phase_generations',\n              [p['generation'] for p in phase_results]==[\n                'initial','cold-new-process','initial-inverse','cold-new-process-inverse'])\n        check('two_independent_baselines_and_complete_five_agent_inverse',\n              all(phase_results[i]['records'][0]['report'].get('inverseCompleted') is True\n                  and phase_results[i]['records'][0]['report'].get('rollbackAttemptedOnce') is True\n                  and phase_results[i]['records'][0]['report'].get('effectiveStoresOnlyRecomputedAndVerified') is True\n                  for i in (2,3)))\n        report['ownedDiskPlaintextScan']=scan_owned_plaintext(ctx,guard,packet)\n        after,after_public=capture_once(ctx,guard,commands,'after',pins,\n            anchor_raw,args.public_volume_anchor_sha256)\n        check('two_complete_bounded_current_observations_exact',canonical(after)==canonical(capsule_before))\n        check('all_frozen_and_selected_public_sources_after',inputs.verify())\n        check('six_actual_system_tools_whole_identity_after',all(\n            read_system_tool(ctx,Path(path),value)==value['identity']\n            for path,value in FIXED_UTILITIES.items()))\n        check('owned_sdk_symlink_exact_after',list(ident(link.lstat()))==link_identity\n              and os.readlink(link)==runtime['sdkRoot'])\n        check('all_public_qa_sources_same_identity_after',\n            all(read_public_source(ctx,QA/name,pin)==qa_identities[name] for name,pin in pins.items()))\n        report['ownedPhases']=phase_results\n        report['manager']=manager_terminal\n        report['currentObservationScope']='two_bounded_nonatomic_observations_primary_rows_and_fixed_files_only'\n        report['wholeDatabaseBackupQualified']=False;report['crossAgentAtomicSnapshotClaimed']=False\n        report['nativeFactoryCountObserved']=sum(p['nativeWorkerCount'] for p in phase_results)\n        check('ten_actual_separate_native_lineages',report['nativeFactoryCountObserved']==10)\n        ctx.remaining();guard.check();completed=True\n    except BaseException as error:\n        report['errorType']=type(error).__name__\n        report['errorCode']=str(error) if isinstance(error,Refused) else None\n        report['errorFrames']=[{'file':Path(f.filename).name,'line':f.lineno}\n            for f in traceback.extract_tb(error.__traceback__)[-6:]]\n        report['outcomeUnknown']=bool(ctx.unknown or isinstance(error,KeyboardInterrupt)\n            or (client is not None and (client.unknown or client.inflight is not None))\n            or (manager is not None and manager.unknown))\n    finally:\n        if ctx.signals is not None:\n            signal.signal(signal.SIGTERM,signal.SIG_IGN);signal.signal(signal.SIGINT,signal.SIG_IGN)\n        if manager is not None and not manager.finished:\n            ctx.cleanup_mode=True;ctx.cleanup_until=time.monotonic()+NEW_OUTER_FAILURE_CLEANUP_SECONDS\n            try:manager_terminal=manager.abort_cleanup_once()\n            except BaseException as error:\n                report['managerCleanupErrorType']=type(error).__name__;report['outcomeUnknown']=True\n            finally:ctx.cleanup_mode=False\n        if client is not None:client.close_all();report['controlHttp']=client.public()\n        if materializer is not None:materializer.close();report['materializerClosure']=materializer.public()\n        if inputs is not None:inputs.close();report['finiteInputClosure']=inputs.public()\n        if public_proof_inputs is not None:\n            public_proof_inputs.close();report['publicProofClosure']=public_proof_inputs.public()\n        if manager_terminal is not None:report['manager']=manager_terminal\n        report['captureReports']=capture_reports\n        if not report.get('ownedPhases'):report['ownedPhases']=phase_results\n        report['ownedCommands']=commands.public() if commands is not None else None\n        manager_closed=(manager is None or (manager_terminal is not None\n            and manager_terminal.get('allRegistrationsClosed') is True\n            and manager_terminal.get('allKnownLineagesClosed') is True\n            and manager_terminal.get('allManagerReadDescriptorsClosed') is True))\n        helpers_closed=(commands is not None and report['ownedCommands']['allOwnedCommandsStopped']\n                        and report['ownedCommands']['unknownCommandCount']==0)\n        input_closed=(inputs is None or (report['finiteInputClosure']['allOwnedInputDescriptorsClosed']\n                       and not report['finiteInputClosure']['closeErrors']))\n        materializer_closed=(materializer is None or (report['materializerClosure']['allOwnedDescriptorsClosed']\n                             and not report['materializerClosure']['closeErrors']))\n        public_proof_closed=(public_proof_inputs is None or\n            library_resources_closed(report.get('publicProofClosure')))\n        captures_closed=all(x['terminalKnown'] and x['typedReportAvailable']\n            and x['captureLibraryResourcesClosed'] and x['entryDescriptorsClosed']\n            for x in capture_reports)\n        report['allPublicProofAndCaptureLibraryClosuresKnown']=bool(public_proof_closed and captures_closed)\n        socket_closed=(ctx.public()['allEphemeralPortReservationSocketsClosed']\n            and (client is None or report['controlHttp']['allOwnedSocketsClosed']))\n        report['outcomeUnknown']=bool(report['outcomeUnknown'] or ctx.unknown\n            or not manager_closed or not helpers_closed or not input_closed\n            or not materializer_closed or not socket_closed or not public_proof_closed or not captures_closed\n            or (client is not None and client.unknown)\n            or (manager_terminal is not None and manager_terminal.get('outcomeUnknown') is True))\n        report['allOwnedRegistrationsLineagesHelpersClosed']=bool(\n            manager_closed and helpers_closed and input_closed and materializer_closed and socket_closed and public_proof_closed and captures_closed)\n        report['ok']=bool(completed and not report['outcomeUnknown'] and time.monotonic()<ctx.until)\n        try:\n            raw=encoded(report)\n            need(len(raw)<=MAX_PUBLIC_REPORT and all(value.encode() not in raw for value in secrets),\n                 'public_outer_report_contains_no_secret_values')\n            if guard is not None and output_created and time.monotonic()<ctx.until and not ctx.signals.pending:\n                candidate_result=guard.write_new(ROOT/'outer-native-r1/result.public.json',raw)\n        except BaseException as error:\n            report={'schema':'heptabao.mac-current-five-agent-owned-launchd-outer.wal-r1','ok':False,\n                'outcomeUnknown':True,'errorType':type(error).__name__,\n                'errorCode':'public_report_or_candidate_publication_refused',\n                'productionManagerQualification':False,'automaticBusinessRetry':False,\n                'allOwnedRegistrationsLineagesHelpersClosed':bool(\n                    manager_closed and helpers_closed and input_closed and materializer_closed and socket_closed and public_proof_closed and captures_closed)}\n        ctx.close_all()\n        if guard is not None:guard.close();report['heldT5Final']=guard.public_state()\n        report['outerDescriptorClosure']=ctx.public()\n        final_closed=(guard is not None and report['heldT5Final']['allDescriptorsClosed']\n            and report['heldT5Final']['lastAnchorCheckPassed'] and report['heldT5Final']['closeErrors']==[]\n            and report['outerDescriptorClosure']['allOuterReadDescriptorsClosed']\n            and report['outerDescriptorClosure']['closeErrors']==[])\n        report['outcomeUnknown']=bool(report['outcomeUnknown'] or not final_closed or ctx.unknown)\n        completed_at=time.monotonic()\n        report['elapsedSeconds']=completed_at-START\n        report['originalOuterDeadlineMetAfterAllClosure']=completed_at<ctx.until\n        report['candidateResultSha256']=None if candidate_result is None else candidate_result['sha256']\n        report['candidateFileAloneIsNotQualification']=True\n        report['authoritativeExitZeroAndCompleteFinalStdoutRequired']=True\n        report['ok']=bool(report.get('ok') and final_closed and not report['outcomeUnknown']\n            and candidate_result is not None and completed_at<ctx.until)\n        raw=encoded(report)\n        if len(raw)>MAX_PUBLIC_REPORT or any(value.encode() in raw for value in secrets):\n            raw=encoded({'schema':report['schema'],'ok':False,'outcomeUnknown':True,\n                'errorCode':'final_public_projection_refused','authoritativeExitZeroAndCompleteFinalStdoutRequired':True})\n            report['ok']=False\n        sys.stdout.buffer.write(raw);sys.stdout.buffer.flush()\n    return 0 if report.get('ok') is True and time.monotonic()<ctx.until else 1\n\nif __name__=='__main__':sys.exit(main())\n","mac_darwin_owned_projection_r1.py":"#!/usr/bin/env python3\n\"\"\"Closed Darwin numeric projection for a new public custody probe.\n\nApple exact source is a reference ABI, never a pin of the installed kernel.\nNo library is loaded at import time. Runtime uses two fixed install names and\nrecords dladdr image names, the actual kernel/build, structure layout and an\nown-process behavioral cross-check. It never lists all host PIDs or names.\n\"\"\"\nfrom __future__ import annotations\nimport ctypes, errno, os, re, sys, time\n\nREFERENCE_XNU='f6217f891ac0bb64f3d375211650a4c1ff8ca1ea'\nREFERENCE_DYLD='fd8d0c4d52320ebf64db34f3cb280310d905c5ae'\nKERNEL_INSTALL_NAME='/usr/lib/system/libsystem_kernel.dylib'\nSYSTEM_INSTALL_NAME='/usr/lib/libSystem.B.dylib'\nPROJECTION_SCHEMA='heptabao.darwin-proc-bsdinfo-numeric.r1'\nPROC_PGRP_ONLY=2\nPROC_PIDTBSDINFO=3\nINCLUDE_RETAINED_ZOMBIES=1\nMAX_GROUP_MEMBERS=64\nGROUP_CAPACITY=MAX_GROUP_MEMBERS+1\nMAX_CALLS=4096\nQUERY_SECONDS=4.0\nBSD_SIZE=136\nSTATE_CODES={1:'SIDL',2:'SRUN',3:'SSLEEP',4:'SSTOP',5:'SZOMB'}\n\nclass NativeProjectionRefused(RuntimeError):\n    def __init__(self,code,errno_value=None):\n        super().__init__(code)\n        self.code=code\n        self.public_errno=(errno_value if type(errno_value) is int and 0<errno_value<=4095 else None)\n\ndef need(condition,code,errno_value=None):\n    if not condition:raise NativeProjectionRefused(code,errno_value)\n\nclass ProcBSDInfo(ctypes.Structure):\n    _fields_=[\n        ('pbi_flags',ctypes.c_uint32),('pbi_status',ctypes.c_uint32),\n        ('pbi_xstatus',ctypes.c_uint32),('pbi_pid',ctypes.c_uint32),\n        ('pbi_ppid',ctypes.c_uint32),('pbi_uid',ctypes.c_uint32),\n        ('pbi_gid',ctypes.c_uint32),('pbi_ruid',ctypes.c_uint32),\n        ('pbi_rgid',ctypes.c_uint32),('pbi_svuid',ctypes.c_uint32),\n        ('pbi_svgid',ctypes.c_uint32),('rfu_1',ctypes.c_uint32),\n        ('pbi_comm',ctypes.c_char*16),('pbi_name',ctypes.c_char*32),\n        ('pbi_nfiles',ctypes.c_uint32),('pbi_pgid',ctypes.c_uint32),\n        ('pbi_pjobc',ctypes.c_uint32),('e_tdev',ctypes.c_uint32),\n        ('e_tpgid',ctypes.c_uint32),('pbi_nice',ctypes.c_int32),\n        ('pbi_start_tvsec',ctypes.c_uint64),('pbi_start_tvusec',ctypes.c_uint64)]\n\nclass DlInfo(ctypes.Structure):\n    _fields_=[('dli_fname',ctypes.c_char_p),('dli_fbase',ctypes.c_void_p),\n              ('dli_sname',ctypes.c_char_p),('dli_saddr',ctypes.c_void_p)]\n\nEXPECTED_OFFSETS={\n    'pbi_flags':0,'pbi_status':4,'pbi_xstatus':8,'pbi_pid':12,'pbi_ppid':16,\n    'pbi_uid':20,'pbi_gid':24,'pbi_ruid':28,'pbi_rgid':32,'pbi_svuid':36,\n    'pbi_svgid':40,'rfu_1':44,'pbi_comm':48,'pbi_name':64,'pbi_nfiles':96,\n    'pbi_pgid':100,'pbi_pjobc':104,'e_tdev':108,'e_tpgid':112,'pbi_nice':116,\n    'pbi_start_tvsec':120,'pbi_start_tvusec':128}\n\ndef abi_layout():\n    sizes={'int':ctypes.sizeof(ctypes.c_int),'int32':ctypes.sizeof(ctypes.c_int32),\n           'uint32':ctypes.sizeof(ctypes.c_uint32),'uint64':ctypes.sizeof(ctypes.c_uint64),\n           'pointer':ctypes.sizeof(ctypes.c_void_p),'size_t':ctypes.sizeof(ctypes.c_size_t),\n           'proc_bsdinfo':ctypes.sizeof(ProcBSDInfo),'Dl_info':ctypes.sizeof(DlInfo)}\n    offsets={name:getattr(ProcBSDInfo,name).offset for name,_ in ProcBSDInfo._fields_}\n    need(sizes=={'int':4,'int32':4,'uint32':4,'uint64':8,'pointer':8,\n                 'size_t':8,'proc_bsdinfo':136,'Dl_info':32},\n         'reference_abi_size_mismatch')\n    need(offsets==EXPECTED_OFFSETS and ctypes.alignment(ProcBSDInfo)==8\n         and [getattr(DlInfo,name).offset for name,_ in DlInfo._fields_]==[0,8,16,24],\n         'reference_abi_offset_mismatch')\n    need(sys.byteorder=='little','reference_abi_endianness')\n    return {'sizes':sizes,'offsets':offsets,'alignment':8,'endianness':'little'}\n\ndef stable(row):\n    return {key:row[key] for key in ('pid','ppid','pgid','uid','birthSeconds','birthMicroseconds')}\n\ndef project_bsdinfo(value,expected_pid):\n    pid=int(value.pbi_pid);ppid=int(value.pbi_ppid);pgid=int(value.pbi_pgid)\n    state=int(value.pbi_status);sec=int(value.pbi_start_tvsec);usec=int(value.pbi_start_tvusec)\n    need(type(expected_pid) is int and 0<expected_pid<=0x7fffffff and pid==expected_pid,\n         'native_pid_identity_mismatch')\n    need(0<ppid<=0x7fffffff and 0<pgid<=0x7fffffff,'native_parent_or_group_malformed')\n    need(state in STATE_CODES,'native_process_state_unsupported')\n    need(0<sec<2**63 and 0<=usec<1000000,'native_birth_malformed')\n    # comm/name/exit details and all other struct bytes are never published.\n    return {'pid':pid,'ppid':ppid,'pgid':pgid,'uid':int(value.pbi_uid),\n            'stateCode':state,'stateName':STATE_CODES[state],'isZombie':state==5,\n            'birthSeconds':str(sec),'birthMicroseconds':str(usec)}\n\nclass NativeProjection:\n    def __init__(self,*,until):\n        need(sys.platform=='darwin' and os.uname().machine=='arm64' and os.geteuid()==501,\n             'fixed_darwin_arm64_operator')\n        self.layout=abi_layout();self.calls=0;self.pid_calls=0;self.group_calls=0\n        self.last_call=None;self.self_qualified=False;self.identity=None\n        self._check_deadline(until)\n        self.kernel=ctypes.CDLL(KERNEL_INSTALL_NAME,use_errno=True)\n        self.system=ctypes.CDLL(SYSTEM_INSTALL_NAME,use_errno=True)\n        self._check_deadline(until)\n        self._list=self.kernel.proc_listpids\n        self._list.argtypes=[ctypes.c_uint32,ctypes.c_uint32,ctypes.c_void_p,ctypes.c_int]\n        self._list.restype=ctypes.c_int\n        self._info=self.kernel.proc_pidinfo\n        self._info.argtypes=[ctypes.c_int,ctypes.c_int,ctypes.c_uint64,ctypes.c_void_p,ctypes.c_int]\n        self._info.restype=ctypes.c_int\n        self._sysctl=self.system.sysctlbyname\n        self._sysctl.argtypes=[ctypes.c_char_p,ctypes.c_void_p,ctypes.POINTER(ctypes.c_size_t),\n                              ctypes.c_void_p,ctypes.c_size_t]\n        self._sysctl.restype=ctypes.c_int\n        self._dladdr=self.system.dladdr\n        self._dladdr.argtypes=[ctypes.c_void_p,ctypes.POINTER(DlInfo)]\n        self._dladdr.restype=ctypes.c_int\n        images={}\n        for name,function in (('proc_listpids',self._list),('proc_pidinfo',self._info),\n                              ('sysctlbyname',self._sysctl),('dladdr',self._dladdr)):\n            images[name]=self._symbol_image(name,function,until)\n        build=self._os_build(until)\n        uname=os.uname()\n        self.identity={'referenceXnuCommit':REFERENCE_XNU,'referenceDyldCommit':REFERENCE_DYLD,\n            'referenceIsInstalledWholePin':False,\n            'requestedInstallNames':[KERNEL_INSTALL_NAME,SYSTEM_INSTALL_NAME],\n            'loadedSymbolImages':images,'libraryWholeFileHashClaimed':False,\n            'sharedCacheMaterializationAttempted':False,\n            'dylibHandlesRetainedUntilProcessExit':True,\n            'actualKernel':{'sysname':uname.sysname,'release':uname.release,\n                            'version':uname.version,'machine':uname.machine},\n            'actualOsBuild':build,'abi':self.layout}\n        self._check_deadline(until)\n\n    @staticmethod\n    def _check_deadline(until):\n        need(type(until) in (int,float) and time.monotonic()<until,\n             'original_projection_deadline_expired')\n\n    def _begin(self,kind,until):\n        self._check_deadline(until)\n        need(self.calls<MAX_CALLS,'native_projection_call_bound')\n        self.calls+=1\n        end=min(until,time.monotonic()+QUERY_SECONDS)\n        self.last_call={'kind':kind,'call':self.calls,'returned':False,'errno':None}\n        self._check_deadline(end)\n        return end\n\n    def _end(self,result,deadline):\n        error=ctypes.get_errno()\n        self.last_call.update({'returned':True,'result':int(result),\n                              'errno':error if 0<error<=4095 else None})\n        self._check_deadline(deadline)\n        return error\n\n    def _symbol_image(self,name,function,until):\n        deadline=self._begin('fixed_symbol_dladdr',until);info=DlInfo()\n        ctypes.set_errno(0)\n        result=self._dladdr(ctypes.cast(function,ctypes.c_void_p),ctypes.byref(info))\n        self._end(result,deadline)\n        need(result!=0 and info.dli_fname is not None,'fixed_symbol_image_unavailable')\n        image=bytes(info.dli_fname)\n        symbol=bytes(info.dli_sname) if info.dli_sname is not None else b''\n        need(0<len(image)<=512 and image.startswith(b'/usr/lib/')\n             and b'\\0' not in image and 0<len(symbol)<=128,'fixed_system_symbol_image_shape')\n        need(symbol.lstrip(b'_')==name.encode('ascii'),'fixed_symbol_name_mismatch')\n        return {'requestedSymbol':name,'observedImagePath':image.decode('ascii'),\n                'observedSymbolName':symbol.decode('ascii'),\n                'addressesPublished':False,'imageWholeBytesPinned':False}\n\n    def _os_build(self,until):\n        deadline=self._begin('kern.osversion',until)\n        buf=ctypes.create_string_buffer(128);size=ctypes.c_size_t(128)\n        ctypes.set_errno(0)\n        result=self._sysctl(b'kern.osversion',buf,ctypes.byref(size),None,0)\n        error=self._end(result,deadline)\n        need(result==0 and error==0 and 2<=size.value<=128,'fixed_os_build_query',error)\n        raw=bytes(buf.raw[:size.value])\n        need(raw[-1:]==b'\\0' and re.fullmatch(rb'[A-Za-z0-9.()-]{1,64}',raw[:-1]) is not None,\n             'fixed_os_build_shape')\n        return raw[:-1].decode('ascii')\n\n    def pid_row(self,pid,*,until):\n        need(type(pid) is int and 0<pid<=0x7fffffff,'closed_numeric_pid_argument')\n        deadline=self._begin('owned_pid_tbsdinfo',until)\n        info=ProcBSDInfo();self.pid_calls+=1;ctypes.set_errno(0)\n        size=self._info(pid,PROC_PIDTBSDINFO,INCLUDE_RETAINED_ZOMBIES,ctypes.byref(info),BSD_SIZE)\n        error=self._end(size,deadline)\n        need(error==0 and size==BSD_SIZE,'native_pid_info_not_complete',error)\n        row=project_bsdinfo(info,pid)\n        self._check_deadline(deadline)\n        return row\n\n    def _group_ids(self,pgid,*,until):\n        need(type(pgid) is int and 0<pgid<=0x7fffffff,'closed_numeric_group_argument')\n        deadline=self._begin('retained_pgrp_only',until)\n        self.group_calls+=1\n        buffer=(ctypes.c_int32*GROUP_CAPACITY)(*([-1]*GROUP_CAPACITY))\n        capacity=ctypes.sizeof(buffer);ctypes.set_errno(0)\n        size=self._list(PROC_PGRP_ONLY,pgid,ctypes.byref(buffer),capacity)\n        error=self._end(size,deadline)\n        # A full buffer may be truncated. Never grow it, retry, or enumerate all PIDs.\n        need(error==0 and 0<=size<capacity and size%4==0,\n             'native_group_error_short_or_truncated',error)\n        ids=[int(buffer[i]) for i in range(size//4)]\n        need(len(ids)<=MAX_GROUP_MEMBERS and len(set(ids))==len(ids)\n             and all(0<pid<=0x7fffffff for pid in ids),'native_group_pid_shape')\n        self._check_deadline(deadline)\n        return sorted(ids)\n\n    def group_rows(self,pgid,*,until):\n        deadline=min(until,time.monotonic()+QUERY_SECONDS)\n        self._check_deadline(deadline)\n        before=self._group_ids(pgid,until=deadline)\n        rows=[self.pid_row(pid,until=deadline) for pid in before]\n        need(all(row['pgid']==pgid and row['uid']==os.geteuid() for row in rows),\n             'native_group_scope_or_uid_changed')\n        after=self._group_ids(pgid,until=deadline)\n        need(before==after,'native_group_members_changed')\n        self._check_deadline(deadline)\n        return rows\n\n    def qualify_self(self,*,until):\n        pid=os.getpid();pgid=os.getpgrp()\n        need(pid==pgid,'sandbox_owner_must_be_group_leader')\n        first=self.pid_row(pid,until=until)\n        need(first['ppid']==os.getppid() and first['pgid']==pgid\n             and first['uid']==os.geteuid() and not first['isZombie'],\n             'native_self_behavioral_crosscheck')\n        rows=self.group_rows(pgid,until=until)\n        # No child has been started in this sandbox at qualification.\n        need(len(rows)==1 and stable(rows[0])==stable(first),'native_self_group_crosscheck')\n        last=self.pid_row(pid,until=until)\n        need(stable(first)==stable(last) and not last['isZombie'],'native_self_birth_stable')\n        self.self_qualified=True\n        return {'projectionSchema':PROJECTION_SCHEMA,'first':first,'last':last,\n                'groupRows':rows,'pidUidPpidPgidMatchedIndependentOsApis':True}\n\n    def public(self):\n        return {'schema':PROJECTION_SCHEMA,'identity':self.identity,\n                'selfQualified':self.self_qualified,'nativeCalls':self.calls,\n                'pidQueries':self.pid_calls,'groupQueries':self.group_calls,\n                'lastCall':self.last_call,'maxGroupMembers':MAX_GROUP_MEMBERS,\n                'pidListNullBufferUsed':False,'allHostEnumerationUsed':False,\n                'commandNamesOrPathsProjected':False,'querySeconds':QUERY_SECONDS,\n                'lateNativeReturnRejected':True,\n                'synchronousKernelCallHasNoSeparateKillableWorker':True}\n","mac_native_owned_unreaped_r1.py":"#!/usr/bin/env python3\n\"\"\"New public-probe custody adapter using scoped Darwin numeric projection.\n\nThe original QA helper remains unchanged. WNOWAIT/direct-Popen retention,\nTERM1/wait5/group3 and signal-before-double-observation control flow are\npreserved. The schema explicitly replaces ps lstart with second/microsecond\nbirth fields; this source alone is not actual Darwin runtime qualification.\n\"\"\"\nimport os, signal, time\nfrom mac_darwin_owned_projection_r1 import NativeProjection, NativeProjectionRefused, PROJECTION_SCHEMA\n\n_projection=None\nclass Refusal(RuntimeError): pass\ndef need(value,code):\n    if not value:raise Refusal(code)\n\ndef require_waitid():\n    need(all(hasattr(os, name) for name in (\"waitid\", \"P_PID\", \"WEXITED\", \"WNOHANG\", \"WNOWAIT\",\n                                          \"CLD_EXITED\", \"CLD_KILLED\", \"CLD_DUMPED\")),\n         \"wnowait_required_no_child_started\")\n    need(signal.getsignal(signal.SIGCHLD) == signal.SIG_DFL,\n         \"direct_child_reaping_policy_changed\")\n\ndef exit_observation(child):\n    \"\"\"This is an observation, never Popen.poll/wait/communicate.\"\"\"\n    need(child.returncode is None, \"child_already_reaped_no_signal\")\n    event = os.waitid(os.P_PID, child.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)\n    if event is None:\n        return None\n    need(event.si_pid == child.pid and event.si_signo == signal.SIGCHLD\n         and event.si_code in (os.CLD_EXITED, os.CLD_KILLED, os.CLD_DUMPED),\n         \"child_exit_identity_changed\")\n    # Darwin reports si_uid=0 even for an observed uid501 child. Actual UID is\n    # bound independently by the native projection; si_uid never grants ownership here.\n    return {\"pid\": event.si_pid, \"signo\": event.si_signo, \"code\": event.si_code, \"status\": event.si_status}\n\ndef stable(row):\n    return {key: row[key] for key in (\"pid\", \"ppid\", \"pgid\", \"uid\", \"birthSeconds\", \"birthMicroseconds\")}\n\ndef bind_projection(api):\n    global _projection\n    need(_projection is None and type(api) is NativeProjection and api.self_qualified,\n         \"native_projection_once_actual_self_qualification\")\n    _projection=api\n\ndef native_rows(pid=None, *, pgid=None, seconds=4.0, until=None):\n    need(_projection is not None and _projection.self_qualified,\n         \"native_projection_not_qualified\")\n    need(until is not None and type(seconds) in (int,float) and 0<seconds<=4.0,\n         \"native_projection_original_bound\")\n    remaining=until-time.monotonic()\n    need(remaining>0,\"original_stop_deadline_expired\")\n    end=min(until,time.monotonic()+seconds)\n    need((pid is None)!=(pgid is None),\"scoped_pid_or_pgid_required\")\n    try:\n        rows=([_projection.pid_row(pid,until=end)] if pid is not None\n              else _projection.group_rows(pgid,until=end))\n    except NativeProjectionRefused as error:\n        code=error.code\n        if code==\"original_projection_deadline_expired\":\n            code=(\"original_stop_deadline_expired\" if time.monotonic()>=until\n                  else \"process_projection_deadline_expired\")\n        raise Refusal(code) from error\n    need(time.monotonic()<end,\"original_stop_deadline_expired\")\n    return rows\n\ndef capture_child(child, *, until):\n    require_waitid()\n    rows = native_rows(child.pid, until=until)\n    need(len(rows) == 1, \"owned_child_identity_missing\")\n    row = rows[0]\n    need(row[\"ppid\"] == os.getpid() and row[\"pgid\"] == child.pid\n         and row[\"uid\"] == os.geteuid(), \"owned_child_scope_mismatch\")\n    # Darwin keeps an unreaped zombie in the native arg=1 projection but getpgid/getsid return ESRCH.\n    # Use the real live APIs only for a still-live child; otherwise independently\n    # repeat WNOWAIT and retain native birth plus Popen direct-parent custody.\n    event, live_sid = exit_observation(child), None\n    if event is None and not row[\"isZombie\"]:\n        try:\n            need(os.getpgid(child.pid) == child.pid and os.getsid(child.pid) == child.pid,\n                 \"owned_live_session_mismatch\")\n            live_sid = child.pid\n        except ProcessLookupError:\n            # A fast exit between the first native projection/waitid and a live API call is\n            # not loss of Popen custody, nor proof that the group is empty.\n            event = exit_observation(child)\n            need(event is not None, \"owned_live_api_failed_without_retained_exit\")\n    if event is not None or row[\"isZombie\"]:\n        event = exit_observation(child)\n        fresh = native_rows(child.pid, until=until)\n        need(event is not None and len(fresh) == 1 and stable(fresh[0]) == stable(row)\n             and fresh[0][\"isZombie\"] and exit_observation(child) == event,\n             \"owned_exit_not_retained\")\n        row = fresh[0]\n    return {\"projection\": stable(row), \"projectionSchema\": PROJECTION_SCHEMA,\n            \"sid_observed_while_live\": live_sid,\"captured_exit\": event}\n\ndef verify_unreaped(child, owner, *, until=None):\n    event = exit_observation(child)\n    rows = native_rows(child.pid, until=until)\n    need(len(rows) == 1 and stable(rows[0]) == owner[\"projection\"]\n         and rows[0][\"ppid\"] == os.getpid(), \"owned_child_identity_changed_no_signal\")\n    if event is None and not rows[0][\"isZombie\"]:\n        # Exact native PGID/birth plus direct Popen/WNOWAIT custody keeps the\n        # originally observed session leader reserved. Do not race a normal\n        # exit by consulting Darwin's zombie-unsupported getpgid/getsid here.\n        need(owner[\"projection\"][\"pgid\"] == child.pid, \"owned_live_session_changed_no_signal\")\n    else:\n        event = exit_observation(child)\n        need(event is not None and rows[0][\"isZombie\"] and exit_observation(child) == event,\n             \"owned_zombie_identity_changed_no_signal\")\n    return event\n\ndef live_group(child, owner, *, until):\n    need(time.monotonic() < until, \"original_stop_deadline_expired\")\n    verify_unreaped(child, owner, until=until)\n    rows = native_rows(pgid=child.pid, until=until)\n    selected = [row for row in rows if row[\"pgid\"] == child.pid and not row[\"isZombie\"]]\n    need(all(row[\"uid\"] == os.geteuid() for row in selected), \"owned_group_uid_changed_no_signal\")\n    need(time.monotonic() < until, \"original_stop_deadline_expired\")\n    return [stable(row) for row in selected]\n\ndef observed_returncode(event):\n    if event is None:return None\n    return event['status'] if event['code']==os.CLD_EXITED else -event['status']\n\ndef stop_once_unreaped(child, owner):\n    \"\"\"Called once by the wrapper's protected ledger; never calls Popen.poll.\"\"\"\n    require_waitid()\n    started=time.monotonic()\n    receipt={'pid':child.pid,'pgid':child.pid,'stopAttempted':True,'signals':[],\n             'directChildReaped':False,'ownedLiveGroupEmptyBeforeReap':False,\n             'allGroupRowsEmptyAfterReap':False,'cleanupCaps':{'term':1,'wait':5,'group':3,'psMax':4},\n             'postReapSignalSent':False,'custody':owner}\n    try:\n        need(child.returncode is None,'already_reaped_no_group_signal')\n        term_until=time.monotonic()+1.0\n        if owner is None:\n            owner=capture_child(child,until=term_until)\n            receipt['custody']=owner\n        members=live_group(child,owner,until=term_until)\n        receipt['initialLiveGroup']=members\n        if members:\n            verify_unreaped(child,owner,until=term_until)\n            need(time.monotonic()<term_until,'original_stop_deadline_expired')\n            os.killpg(child.pid,signal.SIGTERM);receipt['signals'].append('SIGTERM')\n            while time.monotonic()<term_until:\n                try:\n                    members=live_group(child,owner,until=term_until)\n                    if not members:break\n                except Refusal as error:\n                    if str(error)!='original_stop_deadline_expired' or time.monotonic()<term_until:\n                        raise\n                    break\n                time.sleep(min(0.02,max(0,term_until-time.monotonic())))\n        wait_until=time.monotonic()+5.0\n        members=live_group(child,owner,until=wait_until)\n        if members:\n            verify_unreaped(child,owner,until=wait_until)\n            need(time.monotonic()<wait_until,'original_stop_deadline_expired')\n            os.killpg(child.pid,signal.SIGKILL);receipt['signals'].append('SIGKILL')\n        event=exit_observation(child)\n        while event is None:\n            verify_unreaped(child,owner,until=wait_until)\n            need(time.monotonic()<wait_until,'original_stop_deadline_expired')\n            time.sleep(min(0.02,max(0,wait_until-time.monotonic())))\n            event=exit_observation(child)\n        need(time.monotonic()<wait_until,'original_stop_deadline_expired')\n        receipt['retainedExit']=event\n        # The old post-exit group3 interval now precedes the first reap.\n        # This retains actual Popen PID custody while other live members leave.\n        group_until=time.monotonic()+3.0\n        while True:\n            members=live_group(child,owner,until=group_until)\n            if not members and exit_observation(child)==event:break\n            need(time.monotonic()<group_until,'original_stop_deadline_expired')\n            time.sleep(min(0.02,max(0,group_until-time.monotonic())))\n        receipt['ownedLiveGroupEmptyBeforeReap']=True\n        need(time.monotonic()<group_until,'original_stop_deadline_expired')\n        child.wait(timeout=group_until-time.monotonic())\n        receipt['directChildReaped']=True\n        receipt['exitCode']=child.returncode\n        need(child.returncode==observed_returncode(event),'actual_reap_matches_retained_exit')\n        # After the first reap, only observe. No signal or ownership claim is\n        # derived from this now-reusable numeric PGID.\n        while True:\n            rows=[row for row in native_rows(pgid=child.pid,until=group_until) if row['pgid']==child.pid]\n            receipt['remainingGroupRows']=rows\n            if not rows:break\n            need(time.monotonic()<group_until,'original_stop_deadline_expired')\n            time.sleep(min(0.02,max(0,group_until-time.monotonic())))\n        receipt['allGroupRowsEmptyAfterReap']=True\n        need(time.monotonic()<group_until,'original_stop_deadline_expired')\n        receipt['ok']=True\n    except BaseException as error:\n        receipt['ok']=False\n        receipt['errorType']=type(error).__name__\n        receipt['errorCode']=str(error) if isinstance(error,Refusal) else None\n        receipt['directChildReaped']=child.returncode is not None\n        receipt['exitCode']=child.returncode\n        # No second signal sequence, no renewed deadline, no automatic retry.\n    receipt['elapsedSeconds']=time.monotonic()-started\n    receipt['outcomeUnknown']=not(receipt.get('ok') is True\n       and receipt['directChildReaped'] and receipt['allGroupRowsEmptyAfterReap'])\n    return receipt\n","mac_native_owned_commands_r1.py":"#!/usr/bin/env python3\n\"\"\"Bounded foreground commands with retained direct-child custody.\n\nNo import-time I/O. The caller supplies exact reviewed argv and an absolute\ncommand deadline. Pipe reads, exit observation and metadata capture share it.\nCleanup uses the separate once-only TERM1/wait5/group3 custody contract.\n\"\"\"\nfrom __future__ import annotations\nfrom contextlib import contextmanager\nimport hashlib, os, select, signal, subprocess, time\nfrom mac_native_owned_unreaped_r1 import require_waitid, capture_child, exit_observation, observed_returncode, stop_once_unreaped\n\nclass CommandRefused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise CommandRefused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\n\nclass Signals:\n    def __init__(self):\n        self.protected=0;self.pending=None\n    def receive(self,signum,_frame):\n        self.pending=signum\n        if not self.protected:raise KeyboardInterrupt()\n    def install(self):\n        signal.signal(signal.SIGTERM,self.receive);signal.signal(signal.SIGINT,self.receive)\n    @contextmanager\n    def critical(self):\n        self.protected+=1\n        try:yield\n        finally:self.protected-=1\n\nclass Commands:\n    def __init__(self,signals):\n        self.signals=signals;self.rows=[]\n    def run(self,label,argv,*,until,allow_cancelled_cleanup=False,maximum=2*1024*1024):\n        need(isinstance(label,str) and label.replace('-','').replace('_','').isalnum(),'safe_command_label')\n        need(type(maximum) is int and 0<maximum<=2*1024*1024,'fixed_command_output_bound')\n        need(isinstance(argv,list) and argv and all(isinstance(x,str) for x in argv),'explicit_argv')\n        def remaining():\n            if not allow_cancelled_cleanup:need(self.signals.pending is None,'command_cancelled')\n            n=until-time.monotonic();need(n>0,'original_command_deadline_exhausted');return n\n        require_waitid();remaining()\n        started=time.monotonic();row=None;out=bytearray();err=bytearray()\n        try:\n            with self.signals.critical():\n                remaining()\n                p=subprocess.Popen(argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,\n                    env={'PATH':'/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin','LANG':'C','LC_ALL':'C'},\n                    start_new_session=True,close_fds=True)\n                row={'label':label,'argv':list(argv),'process':p,'custody':None,\n                     'stopAttempted':False,'streamsCloseAttempted':False,'streamsClosed':False,\n                     'completeBeforeDeadline':False,'errorType':None,'errorCode':None}\n                self.rows.append(row)\n            row['custody']=capture_child(p,until=until)\n            streams={p.stdout.fileno():out,p.stderr.fileno():err}\n            for fd in streams:os.set_blocking(fd,False)\n            event=None\n            while streams or event is None:\n                left=remaining()\n                ready,_,_=select.select(list(streams),[],[],min(left,0.025))\n                for fd in ready:\n                    data=os.read(fd,65536)\n                    if not data:del streams[fd]\n                    else:\n                        target=streams[fd];target.extend(data)\n                        need(len(target)<=maximum,'command_output_bound')\n                event=exit_observation(p)\n            remaining()\n            row['completeBeforeDeadline']=True\n            row['observedExit']=event\n            row['observedExitCode']=observed_returncode(event)\n        except BaseException as error:\n            if row is None:raise\n            row['errorType']=type(error).__name__\n            row['errorCode']=str(error) if isinstance(error,CommandRefused) else None\n        finally:\n            if row is not None:\n                with self.signals.critical():\n                    row['stopAttempted']=True\n                    try:row['cleanup']=stop_once_unreaped(row['process'],row['custody'])\n                    except BaseException as error:\n                        row['cleanup']={'ok':False,'outcomeUnknown':True,\n                            'errorType':type(error).__name__,'directChildReaped':row['process'].returncode is not None,\n                            'allGroupRowsEmptyAfterReap':False}\n                    row['streamsCloseAttempted']=True\n                    errors=[]\n                    for stream in (row['process'].stdout,row['process'].stderr):\n                        try:stream.close()\n                        except BaseException as error:errors.append(type(error).__name__)\n                    row['streamsClosed']=not errors\n                    row['streamCloseErrors']=errors\n        p=row['process'];cleanup=row['cleanup']\n        public={'label':label,'argv':list(argv),'pid':p.pid,'exitCode':p.returncode,\n            'completeBeforeDeadline':row['completeBeforeDeadline'],\n            'commandDeadlineMonotonic':until,'elapsedSeconds':time.monotonic()-started,\n            'errorType':row['errorType'],'errorCode':row['errorCode'],'cleanup':cleanup,\n            'stdoutBytes':len(out),'stdoutSha256':sha(out),'stderrBytes':len(err),'stderrSha256':sha(err),\n            'streamsClosed':row['streamsClosed'],\n            'outcomeUnknown':not(row['completeBeforeDeadline'] and cleanup.get('ok') is True\n                and cleanup.get('directChildReaped') is True and cleanup.get('allGroupRowsEmptyAfterReap') is True\n                and row['streamsClosed'] and row['errorType'] is None)}\n        row['public']=public\n        return public,bytes(out),bytes(err)\n    def public(self):\n        values=[r.get('public') for r in self.rows]\n        return {'commands':values,'allOwnedCommandsStopped':all(v is not None\n            and v['cleanup'].get('directChildReaped') is True\n            and v['cleanup'].get('allGroupRowsEmptyAfterReap') is True\n            and v['streamsClosed'] for v in values),\n            'unknownCommandCount':sum(v is None or v['outcomeUnknown'] for v in values)}\n","mac_registry_readonly_wal_r1.py":"#!/usr/bin/env python3\n\"\"\"Registry-only readonly WAL observation, candidate R1.\n\nLibrary only. No import-time I/O or SQL. The exact old capture module remains\nan independently pinned dependency; its database()/immutable_query() and five\nagent route are not modified. This module adds an explicit registry path and a\nfailure envelope. The caller must establish the reviewed deny-write sandbox\nand bind an actual same-runtime owned proof before any current capture.\n\"\"\"\nfrom __future__ import annotations\nimport base64, hashlib, json, os, re, sqlite3, stat, sys, time\nfrom pathlib import Path\nfrom urllib.parse import quote\nimport mac_guarded_current_capture_r3 as base\n\nLIVE=base.LIVE\nSYNTHETIC_ROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-current-registry-readonly-wal-synthetic-r1')\nCASES=tuple('W%02d'%x for x in range(1,11))\nWAL_MAXIMUM=5969912\nSQLITE_SOURCE_UUID='bf7c7f30031888f4e796e429ab3978879485813aaca6f641c7b33e4e09459bcc'\nURI_OPTIONS='mode=ro&cache=private&vfs=unix-posix&readonly_shm=1'\nSCHEMA='heptabao.mac-registry-readonly-wal-attempt.r1'\nSOURCE_SCHEMA='heptabao.mac-registry-readonly-wal-runtime.r1'\nneed=base.need\nencoded=base.encoded\nidentity=base.identity\n\ndef failure_record(error):\n    allowed={'CaptureRefused','OperationalError','DatabaseError','ProgrammingError',\n             'IntegrityError','DataError','InterfaceError','NotSupportedError',\n             'ValueError','TypeError','OSError','PermissionError','FileNotFoundError',\n             'KeyboardInterrupt','TimeoutError','MemoryError','RuntimeError'}\n    kind=type(error).__name__\n    row={'errorType':kind if kind in allowed else 'OtherError','code':None,\n         'sqliteCode':None,'sqliteName':None,'errno':None}\n    if isinstance(error,base.CaptureRefused):\n        code=str(error)\n        row['code']=code if re.fullmatch(r'[a-z][a-z0-9_]{0,95}',code) else 'unclassified_capture_refusal'\n    if isinstance(error,sqlite3.Error):\n        value=getattr(error,'sqlite_errorcode',None)\n        if type(value) is int and 0<=value<=0x7fffffff:row['sqliteCode']=value\n        name=getattr(error,'sqlite_errorname',None)\n        if isinstance(name,str) and re.fullmatch(r'SQLITE_[A-Z0-9_]{1,80}',name):row['sqliteName']=name\n    if isinstance(error,OSError) and type(error.errno) is int and 0<=error.errno<=4095:\n        row['errno']=error.errno\n    return row\n\nclass CaptureAttemptFailure(base.CaptureRefused):\n    def __init__(self,public):\n        super().__init__('registry_wal_capture_attempt_failed')\n        self.public=public\n\nclass WalInputs(base.FixedInputs):\n    def __init__(self,*,until,critical,cancelled,live=LIVE,synthetic=False):\n        need(callable(critical) and callable(cancelled),'descriptor_signal_and_cancellation_guards_required')\n        live=Path(live)\n        owned={SYNTHETIC_ROOT/'cases'/name/'live' for name in CASES}\n        need((not synthetic and live==LIVE) or (synthetic and live in owned),\n             'exact_registry_wal_input_namespace')\n        need(os.geteuid()==501,'actual_mac_uid')\n        self.live=live;self.synthetic=synthetic;self.until=until\n        self.critical=critical;self.cancelled=cancelled;self.uid=os.geteuid()\n        self.fds=[];self.parents={};self.files={};self.absent={};self.connections=[]\n        self.byte_count=0;self.closed=False;self.close_errors=[];self.verified=False\n        self.connect_attempts=[];self.cursors=[];self.queries=[];self.bundles=[]\n        self.code_fds=[];self.returned_rows=[]\n        self.current_phase='before_input_admission';self.failure=None\n        self.original_immutable_route_invoked=False\n    def connect(self,uri,*,until,label):\n        self.remaining(until)\n        attempt={'label':label,'started':True,'handleReturned':False,\n                 'error':None,'connectionIndex':None}\n        with self.critical():\n            self.connect_attempts.append(attempt)\n            try:\n                db=sqlite3.connect(uri,uri=True,timeout=0.0,isolation_level=None)\n                row={'db':db,'label':label,'closeAttempted':False,'closed':False,'closeError':None}\n                self.connections.append(row)\n                attempt['handleReturned']=True;attempt['connectionIndex']=len(self.connections)-1\n            except BaseException as error:\n                attempt['error']=failure_record(error)\n                raise\n        return row\n    def close_connection_once(self,row):\n        if row['closeAttempted']:return row['closed']\n        with self.critical():\n            row['closeAttempted']=True\n            try:row['db'].close();row['closed']=True\n            except BaseException as error:\n                row['closeError']=failure_record(error);self.close_errors.append(type(error).__name__)\n        return row['closed']\n    def close_cursor_once(self,row):\n        if row['closeAttempted']:return row['closed']\n        with self.critical():\n            row['closeAttempted']=True\n            try:row['cursor'].close();row['closed']=True\n            except BaseException as error:\n                row['closeError']=failure_record(error);self.close_errors.append(type(error).__name__)\n        return row['closed']\n    def close_code_fd_once(self,row):\n        if row['closeAttempted']:return row['closed']\n        with self.critical():\n            row['closeAttempted']=True\n            try:os.close(row['fd']);row['closed']=True\n            except BaseException as error:\n                row['closeError']=failure_record(error);self.close_errors.append(type(error).__name__)\n        return row['closed']\n    def code_pin(self,path,*,until=None):\n        self.remaining(until);path=Path(path).resolve(strict=True);row=None;result=None\n        with self.critical():\n            fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n            row={'fd':fd,'path':str(path),'closeAttempted':False,'closed':False,'closeError':None}\n            self.code_fds.append(row)\n        try:\n            before=os.fstat(fd)\n            need(stat.S_ISREG(before.st_mode) and 0<before.st_size<=64*base.MIB\n                 and not stat.S_IMODE(before.st_mode)&0o022,'public_runtime_code_custody')\n            h=hashlib.sha256();count=0\n            while count<=before.st_size:\n                self.remaining(until)\n                raw=os.read(fd,min(base.MIB,before.st_size+1-count))\n                if not raw:break\n                count+=len(raw);h.update(raw)\n            need(count==before.st_size and identity(before)==identity(os.fstat(fd))==identity(path.lstat()),\n                 'public_runtime_code_changed')\n            self.remaining(until)\n            result={'path':str(path),'bytes':count,'sha256':h.hexdigest()}\n        finally:self.close_code_fd_once(row)\n        need(row['closed'],'public_code_fd_close_unconfirmed')\n        self.remaining(until)\n        return result\n    def execute(self,connection,sql,args=(),*,until,limit=16,label):\n        self.remaining(until);row=None;answer=None;error=None\n        try:\n            # SQLite LENGTH bounds a complete encoded SQL row. Before prepare\n            # and each fetch, reserve sixfold JSON escaping plus fixed framing\n            # for these fixed queries (at most thirteen result columns). The\n            # limit stays fixed through the cursor, including SQLite prefetch.\n            available=base.MAX_RETURNED_AND_READ_BYTES-self.byte_count\n            sql_row_limit=min(base.MAX_ROW_BYTES+65536,(available-4096)//6)\n            need(sql_row_limit>0,'returned_budget_pre_execute_admission')\n            reserve=6*sql_row_limit+4096\n            connection['db'].setlimit(sqlite3.SQLITE_LIMIT_LENGTH,sql_row_limit)\n            with self.critical():\n                cursor=connection['db'].cursor()\n                row={'cursor':cursor,'label':label,'closeAttempted':False,'closed':False,'closeError':None,\n                     'rowsReturned':0,'returnedBytes':0,'sqliteRowLimit':sql_row_limit,'perFetchReservation':reserve}\n                self.cursors.append(row)\n            cursor.execute(sql,args)\n            answer=[]\n            if cursor.description is not None:\n                while True:\n                    self.remaining(until)\n                    need(base.MAX_RETURNED_AND_READ_BYTES-self.byte_count>=reserve,\n                         'returned_budget_pre_fetch_admission')\n                    fetched=cursor.fetchone()\n                    if fetched is None:break\n                    # These are actual default sqlite3 scalar types. BLOBs are\n                    # counted even though the registry's later shape rejects\n                    # them. No returned value is put in the public ledger.\n                    normalized=[{'sqliteBlobBase64':base64.b64encode(x).decode('ascii')} if isinstance(x,bytes)\n                                else x for x in fetched]\n                    raw=encoded(normalized)\n                    item={'label':label,'ordinal':row['rowsReturned'],'bytes':len(raw),'countedInAggregate':False}\n                    with self.critical():\n                        self.returned_rows.append(item);row['rowsReturned']+=1;row['returnedBytes']+=len(raw)\n                        before_count=self.byte_count\n                        try:self.account(len(raw))\n                        finally:item['countedInAggregate']=self.byte_count==before_count+len(raw)\n                    need(len(fetched)<=13,'fixed_sql_maximum_columns')\n                    answer.append(fetched)\n                    need(len(answer)<=limit,'fixed_sql_result_count')\n        except BaseException as caught:error=caught\n        finally:\n            if row is not None:self.close_cursor_once(row)\n        if error is not None:raise error\n        need(row is not None and row['closed'],'query_cursor_close_unconfirmed')\n        self.remaining(until)\n        return answer\n    def close(self):\n        if self.closed:return\n        # Explicit cursor closes precede connection closes. An uncertain close\n        # consumes its one attempt; it is not retried by the cleanup pass.\n        for row in reversed(self.cursors):self.close_cursor_once(row)\n        for row in reversed(self.connections):self.close_connection_once(row)\n        # Public code is a distinct inode scope and may be closed even when\n        # an unrelated SQLite connection's close is unconfirmed.\n        for row in reversed(self.code_fds):self.close_code_fd_once(row)\n        connections_closed=all(row['closed'] for row in self.connections)\n        for row in reversed(self.fds):\n            if row['closeAttempted']:continue\n            if not connections_closed:\n                row['closeBlockedByUnconfirmedConnection']=True\n                continue\n            with self.critical():\n                row['closeAttempted']=True\n                try:os.close(row['fd']);row['closed']=True\n                except BaseException as error:\n                    row['closeError']=failure_record(error);self.close_errors.append(type(error).__name__)\n        self.closed=True\n    def public(self):\n        value=super().public()\n        value.update(schema=SCHEMA,phase=self.current_phase,\n            originalImmutableRouteInvoked=self.original_immutable_route_invoked,\n            originalImmutableConnectAttemptCount=None if self.original_immutable_route_invoked else 0,\n            connectAttemptLedgerScope='new_runtime_and_registry_only_original_returned_handles_are_in_connections',\n            allHeldDescriptorsClosed=self.closed and all(row['closed'] for row in self.fds),\n            allReturnedConnectionsClosed=all(row['closed'] for row in self.connections),\n            allExplicitCursorsClosed=all(row['closed'] for row in self.cursors),\n            internalSqliteDescriptorsIndividuallyObserved=False,\n            publicCodeHashDescriptorsIndividuallyEnumerated=True,\n            allPublicCodeDescriptorsClosed=all(row['closed'] for row in self.code_fds),\n            publicCodeDescriptors=[dict(row) for row in self.code_fds],\n            sqlReturnedRows=[dict(row) for row in self.returned_rows],\n            sqlReturnedAccounting='canonical_json_per_returned_row_before_shape_count_and_row_cap_checks',\n            sqliteInternalOrPageReadBytesMeasured=False,\n            connectAttempts=[dict(row) for row in self.connect_attempts],\n            descriptors=[{key:row.get(key) for key in ('fd','path','closeAttempted','closed',\n                'closeError','closeBlockedByUnconfirmedConnection')} for row in self.fds],\n            connections=[{key:row.get(key) for key in ('label','closeAttempted','closed','closeError')}\n                for row in self.connections],\n            cursors=[{key:row.get(key) for key in ('label','closeAttempted','closed','closeError',\n                'rowsReturned','returnedBytes','sqliteRowLimit','perFetchReservation')}\n                for row in self.cursors],queries=[dict(row) for row in self.queries])\n        value['allOwnedDescriptorsClosed']=(value['allHeldDescriptorsClosed'] and value['allReturnedConnectionsClosed']\n            and value['allExplicitCursorsClosed'] and value['allPublicCodeDescriptorsClosed'])\n        return value\n\ndef _full_parent(row):\n    named=os.lstat('/') if row['parent'] is None else os.stat(\n        row['name'],dir_fd=row['parent']['fd'],follow_symlinks=False)\n    held=os.fstat(row['fd'])\n    need(identity(named)==identity(held),'registry_wal_parent_held_name_changed')\n    return identity(held)\n\ndef registry_wal_database(inputs):\n    inputs.current_phase='registry_wal_input_admission'\n    path=inputs.live/'state/openclaw.sqlite'\n    main=inputs.hold(path)\n    need(int(main['expected'][6])>=512,'current_database_header_bound')\n    wal=inputs.hold(Path(str(path)+'-wal'),maximum=WAL_MAXIMUM)\n    need(int(wal['expected'][6])>=32,'registry_wal_header_bound')\n    shm=inputs.hold(Path(str(path)+'-shm'),optional=True,maximum=8*base.MIB)\n    need(shm is not None and int(shm['expected'][6])>0,'registry_wal_required_shm')\n    journal=inputs.hold(Path(str(path)+'-journal'),optional=True,maximum=0)\n    need(journal is None,'registry_wal_journal_refused')\n    need(all(row['expected'][3]=='20' for row in (main,wal,shm)),'registry_wal_exact_group')\n    inputs.verify()\n    wanted=set(path.parents)\n    parents=[{'row':row,'expected':_full_parent(row)} for key,row in inputs.parents.items()\n             if Path(key) in wanted]\n    need(len(parents)==len(wanted),'registry_wal_complete_parent_chain')\n    bundle={'main':main,'wal':wal,'shm':shm,'parents':parents,\n            'journal':str(path)+'-journal','verified':False,'checks':0}\n    inputs.bundles.append(bundle)\n    verify_bundle(inputs,bundle,until=inputs.until)\n    return bundle\n\ndef verify_bundle(inputs,bundle,*,until):\n    inputs.remaining(until);bundle['verified']=False\n    for item in bundle['parents']:\n        need(_full_parent(item['row'])==item['expected'],'registry_wal_full_parent_changed')\n    for key in ('main','wal','shm'):\n        row=bundle[key]\n        named=os.stat(row['name'],dir_fd=row['parent']['fd'],follow_symlinks=False)\n        need(identity(named)==identity(os.fstat(row['fd']))==row['expected'],\n             'registry_wal_full_leaf_changed')\n    absent=inputs.absent[bundle['journal']]\n    try:os.stat(absent['name'],dir_fd=absent['parent']['fd'],follow_symlinks=False)\n    except FileNotFoundError:pass\n    else:raise base.CaptureRefused('registry_wal_journal_appeared')\n    inputs.remaining(until);bundle['verified']=True;bundle['checks']+=1\n\ndef uri_for(bundle):\n    return 'file:'+quote(bundle['main']['path'],safe='/')+'?'+URI_OPTIONS\n\ndef configure_connection(inputs,connection,*,until):\n    inputs.remaining(until)\n    db=connection['db']\n    need(hasattr(db,'setlimit'),'actual_sqlite_length_limit_support_required')\n    db.setlimit(sqlite3.SQLITE_LIMIT_LENGTH,base.MAX_ROW_BYTES+65536)\n    db.setlimit(sqlite3.SQLITE_LIMIT_SQL_LENGTH,8192)\n    db.enable_load_extension(False)\n    db.set_progress_handler(lambda:1 if time.monotonic()>=until else 0,1000)\n    inputs.execute(connection,'PRAGMA query_only=ON',until=until,label='query-only-set')\n    inputs.execute(connection,'PRAGMA temp_store=MEMORY',until=until,label='memory-temp-set')\n    need(inputs.execute(connection,'PRAGMA query_only',until=until,limit=1,label='query-only-check')==[(1,)],\n         'connection_query_only')\n\ndef read_registry(inputs,connection,*,until):\n    db=connection['db']\n    allowed={'installed_plugin_index':None,'sqlite_master':{'sql','type','name'}}\n    def authorize(action,arg1,arg2,_database,_trigger):\n        if action==sqlite3.SQLITE_SELECT:return sqlite3.SQLITE_OK\n        if action==sqlite3.SQLITE_READ and arg1 in allowed and (allowed[arg1] is None or arg2 in allowed[arg1]):return sqlite3.SQLITE_OK\n        if action==sqlite3.SQLITE_PRAGMA and arg1=='table_info' and arg2=='installed_plugin_index':return sqlite3.SQLITE_OK\n        if action==sqlite3.SQLITE_TRANSACTION and arg1=='ROLLBACK':return sqlite3.SQLITE_OK\n        return sqlite3.SQLITE_DENY\n    db.set_authorizer(authorize)\n    schema=inputs.execute(connection,\"SELECT sql FROM sqlite_master WHERE type='table' AND name=? LIMIT 2\",\n        ('installed_plugin_index',),until=until,limit=2,label='registry-schema')\n    need(len(schema)==1 and isinstance(schema[0][0],str) and len(schema[0][0].encode())<=16384,\n         'bounded_actual_registry_schema')\n    info=inputs.execute(connection,'PRAGMA table_info(installed_plugin_index)',until=until,limit=13,label='registry-columns')\n    names=[row[1] for row in info]\n    need(len(names)==len(set(names))==13 and all(isinstance(x,str) and re.fullmatch('[a-z_]+',x) for x in names)\n         and 'index_key' in names,'actual_installed_registry_thirteen_named_columns')\n    allowed['installed_plugin_index']=set(names)\n    sql='SELECT '+','.join('\"'+name+'\"' for name in names)+' FROM installed_plugin_index WHERE index_key=? LIMIT 2'\n    args=('installed-plugin-index',)\n    plan=inputs.execute(connection,'EXPLAIN QUERY PLAN '+sql,args,until=until,limit=4,label='registry-key-plan')\n    need(len(plan)==1 and len(plan[0])==4 and all(type(x) is int for x in plan[0][:3]),'fixed_key_query_plan_shape')\n    detail=plan[0][3]\n    need(isinstance(detail,str) and re.fullmatch(\n        r'SEARCH installed_plugin_index USING (?:COVERING )?INDEX [A-Za-z0-9_]+ \\(index_key=\\?\\)',detail),\n        'fixed_key_search_required_no_data_scan')\n    rows=inputs.execute(connection,sql,args,until=until,limit=2,label='registry-fixed-row')\n    need(len(rows)==1 and len(rows[0])==13,'one_actual_installed_registry_row')\n    need(all(x is None or type(x) in (str,int,float) for x in rows[0]),'registry_scalar_columns')\n    record={'schema':schema[0][0],'columns':names,'row':list(rows[0]),'tableInfo':[list(x) for x in info]}\n    # execute() already counted every returned schema/info/plan/data row,\n    # including rows later refused. Do not count this assembly a second time.\n    raw=encoded(record);need(len(raw)<=base.MIB,'registry_returned_byte_cap')\n    return record\n\ndef readonly_wal_query(inputs,bundle,*,after_read=None):\n    # Only the public synthetic driver may supply the fixed pipe barrier.\n    need(after_read is None or inputs.synthetic,'no_private_query_hook')\n    started=time.monotonic();until=min(inputs.until,started+base.MAX_QUERY_SECONDS)\n    row={'route':'registry_named_readonly_wal','startedMonotonic':started,'deadlineMonotonic':until,\n         'connectionIndex':None,'completedMonotonic':None,'success':False,'error':None,\n         'dataResultPublished':False,'rolledBack':False,'queryClosureKnown':False}\n    row['errorStage']=None\n    inputs.queries.append(row);connection=None;value=None;error=None\n    try:\n        inputs.current_phase='registry_wal_preconnect_fence'\n        verify_bundle(inputs,bundle,until=until)\n        inputs.current_phase='registry_wal_connect'\n        connection=inputs.connect(uri_for(bundle),until=until,label='registry-wal')\n        row['connectionIndex']=len(inputs.connections)-1\n        configure_connection(inputs,connection,until=until)\n        actual=inputs.execute(connection,'PRAGMA database_list',until=until,limit=1,label='database-list')\n        need(len(actual)==1 and actual[0][1]=='main' and actual[0][2]==bundle['main']['path'],'registry_canonical_named_open')\n        inputs.execute(connection,'BEGIN',until=until,label='registry-begin')\n        verify_bundle(inputs,bundle,until=until)\n        inputs.current_phase='registry_wal_fixed_read'\n        value=read_registry(inputs,connection,until=until)\n        if after_read is not None:after_read(until)\n        inputs.current_phase='registry_wal_postread_fence'\n        verify_bundle(inputs,bundle,until=until)\n        inputs.execute(connection,'ROLLBACK',until=until,label='registry-rollback')\n        row['rolledBack']=True\n    except BaseException as caught:\n        error=caught;row['errorStage']=inputs.current_phase\n    finally:\n        inputs.current_phase='registry_wal_connection_close'\n        if connection is not None:inputs.close_connection_once(connection)\n        row['queryClosureKnown']=(connection is None or connection['closed']) and all(x['closed'] for x in inputs.cursors)\n    try:\n        need(row['queryClosureKnown'],'registry_query_close_unconfirmed')\n        if error is None:\n            inputs.current_phase='registry_wal_final_fence'\n            verify_bundle(inputs,bundle,until=until)\n    except BaseException as caught:\n        if error is None:error=caught\n    # This one completion sample covers SQL, ROLLBACK, close and the query ledger.\n    completed=time.monotonic();row['completedMonotonic']=completed\n    if inputs.cancelled() and error is None:error=base.CaptureRefused('capture_cancelled')\n    if completed>=until and error is None:error=base.CaptureRefused('original_query_deadline_after_close_and_ledger')\n    if error is not None:\n        row['error']=failure_record(error)\n        raise error\n    row['success']=True\n    return value\n\ndef public_runtime_identity(inputs,*,until=None):\n    return {'pythonExecutable':inputs.code_pin(sys.executable,until=until),\n            'sqliteExtension':inputs.code_pin(base._sqlite3.__file__,until=until),\n            'pythonVersion':sys.version,'sqliteVersion':sqlite3.sqlite_version,\n            'sqliteVersionInfo':list(sqlite3.sqlite_version_info)}\n\ndef validate_original_immutable_proof(inputs,raw,expected_sha):\n    # The original predicates are retained, with tracked public code readers.\n    # The original module and database()/immutable_query() remain byte-identical.\n    inputs.remaining()\n    need(isinstance(raw,bytes) and len(raw)<=65536 and base.sha(raw)==expected_sha,\n         'actual_synthetic_proof_original_bytes')\n    proof=json.loads(raw)\n    need(isinstance(proof,dict)\n         and proof.get('schema')=='heptabao.mac-immutable-capture-synthetic.r1'\n         and proof.get('ok') is True and proof.get('runtime')==public_runtime_identity(inputs)\n         and proof.get('captureSourceSha256')==inputs.code_pin(base.__file__)['sha256'],\n         'actual_same_runtime_synthetic_proof_required')\n    need(proof.get('ownedDatabaseOnly') is True and proof.get('productionOpened') is False\n         and proof.get('sameHeldFdUriCode') is True and proof.get('readonlyImmutableConnection') is True\n         and proof.get('absentSidecarsStayedAbsent') is True and proof.get('emptyWalStayedEmpty') is True\n         and proof.get('nonemptyWalRefusedBeforeConnect') is True and proof.get('journalRefusedBeforeConnect') is True\n         and proof.get('oversizeRowRefused') is True and proof.get('driftRefused') is True\n         and proof.get('allOwnedDescriptorsClosed') is True,'synthetic_negative_boundaries_required')\n    inputs.remaining()\n\ndef observed_runtime(inputs):\n    started=time.monotonic();until=min(inputs.until,started+base.MAX_QUERY_SECONDS)\n    connection=None;error=None;value=None\n    try:\n        connection=inputs.connect('file::memory:?cache=private',until=until,label='public-runtime-source-id')\n        rows=inputs.execute(connection,'SELECT sqlite_source_id()',until=until,limit=1,label='source-id')\n        need(len(rows)==1 and len(rows[0])==1 and isinstance(rows[0][0],str),'sqlite_source_id_shape')\n        source_id=rows[0][0]\n        need(re.fullmatch(r'\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2} [0-9a-f]{64}',source_id)\n             and source_id.endswith(' '+SQLITE_SOURCE_UUID),'actual_sqlite_source_uuid')\n        runtime=public_runtime_identity(inputs,until=until)\n        need(runtime['sqliteVersion']=='3.53.4' and runtime['sqliteVersionInfo']==[3,53,4],'actual_sqlite_version')\n        value={'schema':SOURCE_SCHEMA,'runtime':runtime,'sqliteSourceId':source_id,\n               'uriOptions':URI_OPTIONS,'dylibDependencyClosureClaimed':False}\n    except BaseException as caught:error=caught\n    finally:\n        if connection is not None:inputs.close_connection_once(connection)\n    completed=time.monotonic()\n    if error is not None:raise error\n    need(connection is not None and connection['closed'],'public_runtime_connection_close')\n    need(completed<until,'public_runtime_original_query_deadline')\n    return value\n\ndef attempt_registry(inputs,*,after_read=None):\n    value=None;error=None;runtime=None\n    try:\n        runtime=observed_runtime(inputs)\n        bundle=registry_wal_database(inputs)\n        value=readonly_wal_query(inputs,bundle,after_read=after_read)\n        inputs.verify()\n        for held in inputs.bundles:verify_bundle(inputs,held,until=inputs.until)\n    except BaseException as caught:error=caught\n    finally:inputs.close()\n    public=inputs.public();completed=time.monotonic()\n    public.update(runtime=runtime,completedMonotonic=completed,originalDeadlineMonotonic=inputs.until,\n        originalDeadlineMetAfterClosure=completed<inputs.until,error=failure_record(error) if error else None,\n        observationComplete=error is None,observationUnknown=error is not None,\n        libraryFailureLedgerAvailable=True,privateResultPublished=False)\n    if not public['allOwnedDescriptorsClosed'] or public['closeErrors'] or completed>=inputs.until or inputs.cancelled():\n        public['observationComplete']=False;public['observationUnknown']=True\n        if public['error'] is None:public['error']={'errorType':'CaptureRefused','code':'registry_attempt_closure_or_deadline'}\n    public['ok']=public['observationComplete'] and not public['observationUnknown']\n    return value if public['ok'] else None,public\n\ndef validate_wal_proof(inputs,raw,expected_sha,runtime):\n    inputs.remaining()\n    need(isinstance(raw,bytes) and len(raw)<=256*1024 and base.sha(raw)==expected_sha,\n         'actual_owned_wal_proof_whole_bytes')\n    proof=json.loads(raw)\n    need(isinstance(proof,dict) and proof.get('schema')=='heptabao.mac-owned-registry-wal-synthetic.r1'\n         and proof.get('ok') is True and proof.get('outcomeUnknown') is False\n         and proof.get('runtime')==runtime and proof.get('sourcePins',{}).get('mac_registry_readonly_wal_r1.py')==\n             inputs.code_pin(__file__)['sha256']\n         and proof.get('caseIds')==list(CASES) and proof.get('allCasesMatched') is True\n         and proof.get('allOwnedClosed') is True and proof.get('originalDeadlineAfterClosure') is True\n         and proof.get('productionInputsRead') is False and proof.get('privateCaptureAuthorized') is False,\n         'actual_same_runtime_and_source_wal_proof_required')\n    # The executable caller must separately pin the original raw stdout and\n    # authoritative exit-zero receipt. This library cannot mint that authority.\n    inputs.remaining()\n\ndef capture_current_with_wal(*,critical,cancelled,synthetic_proof,synthetic_proof_sha,\n                             wal_proof,wal_proof_sha,until):\n    need(sys.platform=='darwin' and os.getuid()==501,'exact_current_mac')\n    need(until<=time.monotonic()+base.NEW_CAPTURE_SECONDS,'one_capture_budget_no_reset')\n    inputs=WalInputs(until=until,critical=critical,cancelled=cancelled)\n    document=None;error=None;runtime=None\n    try:\n        inputs.current_phase='public_proof_admission'\n        validate_original_immutable_proof(inputs,synthetic_proof,synthetic_proof_sha)\n        runtime=observed_runtime(inputs)\n        validate_wal_proof(inputs,wal_proof,wal_proof_sha,runtime)\n        inputs.current_phase='current_config'\n        raw_config=inputs.read(LIVE/'openclaw.json')\n        need(base.sha(raw_config)==base.CONFIG_SHA,'actual_current_config_pin')\n        cfg=json.loads(raw_config);models=base.current_models(cfg)\n        inputs.current_phase='five_original_zero_wal_agent_queries'\n        inputs.original_immutable_route_invoked=True\n        documents=[base.auth_rows(inputs,agent) for agent in base.AGENTS]\n        inputs.current_phase='current_cache_and_native_files'\n        caches={};cache_directory=inputs.directory(LIVE/'authbus',optional=True)\n        for name in base.CACHE_NAMES:\n            raw=None if cache_directory is None else inputs.read(LIVE/'authbus'/name,optional=True)\n            caches[name]={'present':False} if raw is None else {'present':True,'mode':0o600,\n                'bytes':len(raw),'sha256':base.sha(raw),'base64':base64.b64encode(raw).decode('ascii')}\n        native={}\n        for agent in base.AGENTS:\n            directory=LIVE/'agents'/agent/'agent/codex-home';values={}\n            native_directory=inputs.directory(directory,optional=True)\n            values['directoryPresent']=native_directory is not None\n            for name in ('config.toml','requirements.toml','auth.json'):\n                raw=None if native_directory is None else inputs.read(directory/name,optional=True,private=name=='auth.json')\n                values[name]={'present':False} if raw is None else {'present':True,'bytes':len(raw),'sha256':base.sha(raw)}\n                if raw is not None and name!='auth.json':values[name]['base64']=base64.b64encode(raw).decode('ascii')\n            native[agent]=values\n        bundle=registry_wal_database(inputs)\n        registry=readonly_wal_query(inputs,bundle)\n        inputs.verify();verify_bundle(inputs,bundle,until=until)\n        document={'schema':'heptabao.mac-guarded-current-inputs.private.r1',\n            'sourceConfigSha256':base.CONFIG_SHA,'configBase64':base64.b64encode(raw_config).decode('ascii'),\n            'agentIds':list(base.AGENTS),'models':models,'authDocuments':documents,\n            'authbusCaches':{'directoryPresent':cache_directory is not None,'files':caches},\n            'nativeHomes':native,'registry':registry,'runtime':runtime['runtime'],\n            'syntheticProofSha256':synthetic_proof_sha,'walSyntheticProofSha256':wal_proof_sha,\n            'scope':'bounded_point_in_time_observation_not_database_or_cross_agent_snapshot'}\n        need(len(encoded(document))<=4*base.MIB,'combined_private_capsule_bound')\n        inputs.verify();verify_bundle(inputs,bundle,until=until)\n    except BaseException as caught:error=caught\n    finally:inputs.close()\n    public=inputs.public();completed=time.monotonic()\n    public.update(runtime=runtime,completedMonotonic=completed,originalDeadlineMonotonic=until,\n        originalDeadlineMetAfterClosure=completed<until,error=failure_record(error) if error else None,\n        observationComplete=error is None,observationUnknown=error is not None,\n        libraryFailureLedgerAvailable=True,privateResultPublished=False,\n        originalFiveAgentRouteUnchanged=True,outerMustRecheckAfterPrivatePublication=True)\n    if not public['allOwnedDescriptorsClosed'] or public['closeErrors'] or completed>=until or inputs.cancelled():\n        public['observationComplete']=False;public['observationUnknown']=True\n        if public['error'] is None:public['error']={'errorType':'CaptureRefused','code':'current_capture_closure_or_deadline'}\n    public['ok']=public['observationComplete'] and not public['observationUnknown']\n    if not public['ok']:raise CaptureAttemptFailure(public)\n    return document,public\n"},"base":{"mac_current_fixture_materializer_r1.py":"#!/usr/bin/env python3\n\"\"\"Create two independent auth-only Mac fixtures from an admitted bounded capsule.\n\nLibrary only. No source database is opened here. All SQLite writes target new,\nexclusive files below the two fixed phase roots. Effective auth is never a\nmaterialization or inverse input. Models and flags come from captured config.\n\"\"\"\nfrom __future__ import annotations\nimport base64, copy, hashlib, json, math, os, re, sqlite3, stat, time\nfrom pathlib import Path\n\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-r10-current-native-custody-r1')\nLIVE=Path('/Users/qianqi/.openclaw')\nSDK=Path('/opt/homebrew/lib/node_modules/openclaw')\nCODEX=LIVE/'npm/projects/openclaw-codex-8902d781d4__openclaw-generation__g-49fd4dbfde2c5057/node_modules/@openclaw/codex'\nAGENTS=('main','trnm','hepta-ui','hepta','hepta-backend')\nPHASES=('initial','cold-new-process')\nTABLES=(('store','auth_profile_store','store_key','store_json'),\n        ('state','auth_profile_state','state_key','state_json'))\nCACHE_NAMES=('applied-profiles.json','publish-baseline.json','bad-refresh-quarantine.json',\n             'refresh-backoff.json','lease-epochs.json','status.json')\nCONFIG_SHA='ca2dd7d7879fa901dfb24e00837b56a4e0fd230600d7ed1e3086eda194187d4d'\nMAX_ROW=1024*1024\n\nclass Refused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise Refused(code)\ndef encoded(value):\n    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef digest(value):return sha(encoded(value))\ndef ident(s):\n    return tuple(str(v) for v in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n        s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\ndef no_nonfinite(value):\n    if type(value) is float:need(math.isfinite(value),'finite_captured_json_number')\n    elif isinstance(value,list):\n        for item in value:no_nonfinite(item)\n    elif isinstance(value,dict):\n        need(all(isinstance(k,str) for k in value),'json_object_keys')\n        for item in value.values():no_nonfinite(item)\n\ndef consumer_profile(phase,port,source_pins,ca_file,harness_roots):\n    need(phase in PHASES and type(port) is int and 1024<=port<=65535,'fixed_consumer_sandbox')\n    root=ROOT/phase\n    need(Path(ca_file)==ROOT/'credentials-consumer/ca.crt','only_owned_ca')\n    # The exact installed code and the new phase are readable; production\n    # current DB/config/auth/cache values and other phase/control roots are not.\n    q=lambda value:json.dumps(str(value))\n    lines=['(version 1)','(deny default)','(allow process*)',\n        '(allow signal (target children))','(allow sysctl-read)','(allow mach-lookup)',\n        '(allow file-read-metadata)']\n    for path in ('/System','/usr','/bin','/sbin','/Library','/private/etc','/opt/homebrew','/dev/fd'):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in (ROOT/'qa',ROOT/'installed-plugin-copy',root):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    # Installed immutable package roots are public code. Reading their package\n    # modules is necessary for the real Node loader and its transitive imports.\n    need(isinstance(harness_roots,list) and 1<=len(harness_roots)<=8\n         and len(set(harness_roots))==len(harness_roots),'actual_finite_harness_root_set')\n    for value in sorted(set([str(CODEX),*harness_roots])):\n        path=Path(value)\n        need(path.is_absolute() and path==Path(os.path.normpath(str(path)))\n             and path.is_relative_to(LIVE/'npm/projects'),'public_installed_harness_code_scope')\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in sorted(source_pins):\n        lines.append('(allow file-read* (literal '+q(path)+'))')\n    for path in (ROOT/'credentials-consumer/ca.crt',\n                 ROOT/'credentials-consumer/role_id',ROOT/'credentials-consumer/secret_id'):\n        lines.append('(allow file-read* (literal '+q(path)+'))')\n    lines.extend(['(allow file-read* (literal \"/dev/urandom\"))',\n        '(allow file-read* (literal \"/dev/random\"))',\n        '(allow file-write* (subpath '+q(root)+'))',\n        '(allow file-write* (literal \"/dev/null\"))',\n        '(allow network-outbound (remote ip '+q('localhost:'+str(port))+'))'])\n    return ('\\n'.join(lines)+'\\n').encode()\n\nclass Materializer:\n    def __init__(self,guard,signals,until):\n        need(guard.uuid_verified and not guard.closed,'held_t5_before_materialization')\n        self.guard=guard;self.signals=signals;self.until=until\n        self.connections=[];self.fds=[];self.started=False;self.completed=False\n        self.created=[];self.phase_public=[];self.close_errors=[]\n\n    def remaining(self,until=None):\n        need(self.signals.pending is None,'materialization_cancelled')\n        left=min(self.until,until if until is not None else self.until)-time.monotonic()\n        need(left>0,'original_outer_or_owned_sqlite_deadline');return left\n\n    def mkdir(self,path):\n        self.remaining();self.guard.mkdir_new(path);self.created.append(str(path))\n\n    def write(self,path,raw):\n        self.remaining();result=self.guard.write_new(path,raw);self.remaining();return result\n\n    def close_fd(self,row):\n        if row['closeAttempted']:return\n        with self.signals.critical():\n            row['closeAttempted']=True\n            try:os.close(row['fd']);row['closed']=True\n            except BaseException as error:\n                row['closeErrorType']=type(error).__name__;self.close_errors.append(type(error).__name__)\n\n    def close_connection(self,row):\n        if row['closeAttempted']:return\n        with self.signals.critical():\n            row['closeAttempted']=True\n            try:row['db'].close();row['closed']=True\n            except BaseException as error:\n                row['closeErrorType']=type(error).__name__;self.close_errors.append(type(error).__name__)\n\n    def owned_database(self,path,create_and_verify):\n        self.remaining()\n        need(any(path.is_relative_to(ROOT/phase/'state') for phase in PHASES),\n             'only_new_phase_databases')\n        fdrow=None;connection=None\n        with self.guard.parent(path) as (parent,name):\n            try:\n                with self.signals.critical():\n                    fd=os.open(name,os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=parent)\n                    fdrow={'fd':fd,'closeAttempted':False,'closed':False};self.fds.append(fdrow)\n                before=os.fstat(fd)\n                need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n                     and stat.S_IMODE(before.st_mode)==0o600 and before.st_size==0\n                     and ident(before)==ident(os.stat(name,dir_fd=parent,follow_symlinks=False)),\n                     'new_empty_owned_database')\n                query_until=min(self.until,time.monotonic()+3.0)\n                self.remaining(query_until)\n                with self.signals.critical():\n                    db=sqlite3.connect(str(path),timeout=0.0,isolation_level=None)\n                    connection={'db':db,'closeAttempted':False,'closed':False}\n                    self.connections.append(connection)\n                db.enable_load_extension(False)\n                need(hasattr(db,'setlimit'),'same_runtime_sqlite_limits_required')\n                db.setlimit(sqlite3.SQLITE_LIMIT_LENGTH,MAX_ROW+65536)\n                db.setlimit(sqlite3.SQLITE_LIMIT_SQL_LENGTH,32768)\n                db.set_progress_handler(lambda:1 if time.monotonic()>=query_until else 0,1000)\n                db.execute('PRAGMA journal_mode=DELETE')\n                db.execute('PRAGMA synchronous=FULL')\n                db.execute('PRAGMA temp_store=MEMORY')\n                db.execute('PRAGMA max_page_count=8192')\n                db.execute('BEGIN IMMEDIATE')\n                create_and_verify(db,query_until)\n                self.remaining(query_until);db.execute('COMMIT')\n                self.close_connection(connection);need(connection['closed'],'owned_database_connection_closed')\n                self.remaining(query_until)\n                after=os.fstat(fd);named=os.stat(name,dir_fd=parent,follow_symlinks=False)\n                need(ident(after)==ident(named) and ident(before)[:6]==ident(after)[:6]\n                     and 512<=after.st_size<=32*1024*1024,'same_created_database_inode')\n                os.fsync(fd);os.fsync(parent)\n                for suffix in ('-wal','-shm','-journal'):\n                    try:os.stat(name+suffix,dir_fd=parent,follow_symlinks=False)\n                    except FileNotFoundError:pass\n                    else:raise Refused('owned_materialized_database_sidecar_remaining')\n                self.remaining()\n                return {'path':str(path),'bytes':after.st_size,'identity':list(ident(after))}\n            finally:\n                if connection is not None:self.close_connection(connection)\n                if fdrow is not None:self.close_fd(fdrow)\n\n    def auth_database(self,path,rows):\n        need(isinstance(rows,dict) and set(rows)=={'store','state'},'two_primary_table_documents')\n        for kind,_,_,_ in TABLES:\n            values=rows[kind]\n            need(isinstance(values,list) and len(values)<=1,'captured_primary_only')\n            for row in values:\n                need(isinstance(row,list) and len(row)==3 and row[0]=='primary'\n                     and isinstance(row[1],str) and len(row[1].encode())<=MAX_ROW\n                     and type(row[2]) is int and 0<=row[2]<=9007199254740991,\n                     'exact_auth_row_shape_and_timestamp')\n                need(isinstance(json.loads(row[1]),dict),'auth_payload_object')\n        def create(db,until):\n            for kind,table,key,column in TABLES:\n                self.remaining(until)\n                db.execute('CREATE TABLE '+table+' ('+key+' TEXT PRIMARY KEY,'+\n                           column+' TEXT NOT NULL,updated_at INTEGER NOT NULL)')\n                db.executemany('INSERT INTO '+table+' VALUES (?,?,?)',rows[kind])\n                actual=[list(row) for row in db.execute('SELECT '+key+','+column+\n                    ',updated_at FROM '+table+' ORDER BY '+key)]\n                need(actual==rows[kind],'original_primary_payload_and_timestamp_exact')\n        return self.owned_database(path,create)\n\n    def registry_database(self,path,registry):\n        need(isinstance(registry,dict) and set(registry)=={'schema','columns','row','tableInfo'},\n             'complete_captured_registry_shape')\n        columns=registry['columns'];row=registry['row'];ddl=registry['schema']\n        need(isinstance(columns,list) and len(columns)==len(set(columns))==13\n             and all(isinstance(x,str) and re.fullmatch('[a-z_]+',x) for x in columns)\n             and 'index_key' in columns and isinstance(row,list) and len(row)==13\n             and row[columns.index('index_key')]=='installed-plugin-index'\n             and isinstance(ddl,str) and len(ddl.encode())<=16384\n             and re.match(r'(?is)^\\s*CREATE\\s+TABLE\\s+(?:\"installed_plugin_index\"|installed_plugin_index)\\s*\\(',ddl),\n             'one_actual_thirteen_column_registry')\n        no_nonfinite(registry)\n        def create(db,until):\n            self.remaining(until)\n            # execute accepts one statement. No ATTACH, virtual table, extension,\n            # function invocation or second statement is authorized.\n            forbidden={sqlite3.SQLITE_ATTACH,sqlite3.SQLITE_DETACH,sqlite3.SQLITE_FUNCTION,\n                       sqlite3.SQLITE_CREATE_VTABLE,sqlite3.SQLITE_DROP_VTABLE}\n            db.set_authorizer(lambda action,*_args:sqlite3.SQLITE_DENY if action in forbidden else sqlite3.SQLITE_OK)\n            db.execute(ddl)\n            names=','.join('\"'+name+'\"' for name in columns)\n            db.execute('INSERT INTO installed_plugin_index ('+names+') VALUES ('+\n                       ','.join('?' for _ in columns)+')',row)\n            actual=db.execute('SELECT '+names+' FROM installed_plugin_index WHERE index_key=?',\n                              ('installed-plugin-index',)).fetchall()\n            need([list(x) for x in actual]==[row],'whole_captured_registry_row')\n            need([list(x) for x in db.execute('PRAGMA table_info(installed_plugin_index)')]\n                 ==registry['tableInfo'],'whole_registry_column_contract')\n            stored=db.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name='installed_plugin_index'\").fetchall()\n            need(stored==[(ddl,)],'registry_ddl_preserved_exact')\n            self.remaining(until)\n        return self.owned_database(path,create)\n\n    def validate_capsule(self,document):\n        need(isinstance(document,dict) and document.get('schema')=='heptabao.mac-guarded-current-inputs.private.r1'\n             and document.get('sourceConfigSha256')==CONFIG_SHA and document.get('agentIds')==list(AGENTS)\n             and document.get('scope')=='bounded_point_in_time_observation_not_database_or_cross_agent_snapshot',\n             'admitted_current_capsule_shape')\n        no_nonfinite(document)\n        config_raw=base64.b64decode(document['configBase64'],validate=True)\n        need(len(config_raw)<=MAX_ROW and sha(config_raw)==CONFIG_SHA,'captured_config_whole_pin')\n        cfg=json.loads(config_raw)\n        declared=cfg.get('agents',{}).get('list')\n        need(isinstance(declared,list) and [x.get('id') for x in declared]==list(AGENTS),\n             'all_actual_five_agents')\n        docs=document['authDocuments']\n        need(isinstance(docs,list) and len(docs)==5 and [x.get('agent') for x in docs]==list(AGENTS),\n             'five_ordered_current_primary_documents')\n        for item in docs:\n            need(item.get('captureScope')=='two_fixed_primary_keys_only'\n                 and item.get('nonprimaryRowsCaptured') is False,'honest_primary_materialization_scope')\n        cache=document['authbusCaches']\n        need(isinstance(cache,dict) and set(cache)=={'directoryPresent','files'}\n             and type(cache['directoryPresent']) is bool and set(cache['files'])==set(CACHE_NAMES),\n             'all_six_current_cache_bytes_or_absence')\n        for value in cache['files'].values():\n            need(isinstance(value,dict) and type(value.get('present')) is bool,'typed_cache_presence')\n            if value['present']:\n                raw=base64.b64decode(value['base64'],validate=True)\n                need(cache['directoryPresent'] and value['mode']==0o600\n                     and type(value['bytes']) is int and len(raw)==value['bytes']<=MAX_ROW\n                     and sha(raw)==value['sha256'],'current_cache_whole_bytes')\n        return cfg,{item['agent']:item for item in docs}\n\n    def materialize(self,document,*,plugin_config,managed_profiles,runtime,source_pins,\n                    qa_pins,port,server_certificate_sha256):\n        need(not self.started,'materialization_once')\n        self.started=True\n        cfg,documents=self.validate_capsule(document)\n        need(set(document['nativeHomes'])==set(AGENTS)\n             and set(document['models'])==set(AGENTS),'all_current_model_native_inputs')\n        original_plugin=cfg['plugins']['entries']['openclaw-authbus']['config']\n        without=lambda obj:{k:v for k,v in obj.items() if k not in ('address','caFile','roleIdFile','secretIdFile')}\n        need(without(plugin_config)==without(original_plugin)\n             and original_plugin.get('hostId')=='mac' and original_plugin.get('leader') is False\n             and original_plugin.get('publishNew') is True and original_plugin.get('manageOrder') is True,\n             'complete_actual_authbus_flags_preserved')\n        need(isinstance(managed_profiles,list) and len(managed_profiles)==2\n             and len({x['profileId'] for x in managed_profiles})==2,'two_same_identity_managed_generations')\n        need(runtime['sdkRoot']==str(SDK) and runtime['codexRoot']==str(CODEX)\n             and runtime['pluginEntry']==str(ROOT/'installed-plugin-copy/index.js')\n             and isinstance(runtime['harnessOwnerPluginIds'],list)\n             and runtime['harnessOwnerPluginIds'],'fixed_installed_runtime_paths')\n        need(all(isinstance(path,str) and isinstance(pin,str) and re.fullmatch('[0-9a-f]{64}',pin)\n                 for path,pin in source_pins.items()),'fixed_installed_source_pins')\n        plans=[]\n        for phase in PHASES:\n            self.remaining();work=ROOT/phase;state=work/'state'\n            for path in (work,state,state/'agents',state/'oauth',state/'home',state/'state',\n                         work/'tmp',work/'workers',work/'inverse',work/'native-tmp',work/'workspaces'):\n                self.mkdir(path)\n            scoped=copy.deepcopy(cfg)\n            scoped['agents']['defaults']['workspace']=str(work/'workspaces/main')\n            phase_pins=dict(source_pins);native_workers={};database_records=[]\n            for item in scoped['agents']['list']:\n                agent=item['id'];directory=state/'agents'/agent/'agent'\n                for path in (state/'agents'/agent,directory,directory/'codex-home',\n                             work/'native-tmp'/agent,work/'workspaces'/agent):\n                    self.mkdir(path)\n                item['agentDir']=str(directory);item['workspace']=str(work/'workspaces'/agent)\n                database_records.append(self.auth_database(directory/'openclaw-agent.sqlite',\n                                                           documents[agent]['rows']))\n                native=document['nativeHomes'][agent]\n                for name in ('config.toml','requirements.toml'):\n                    value=native[name]\n                    if value['present']:\n                        raw=base64.b64decode(value['base64'],validate=True)\n                        need(len(raw)==value['bytes']<=MAX_ROW and sha(raw)==value['sha256'],\n                             'actual_native_config_bytes')\n                        destination=directory/'codex-home'/name\n                        self.write(destination,raw);phase_pins[str(destination)]=sha(raw)\n                need(not (directory/'codex-home/auth.json').exists(),'no_production_native_auth_copy')\n                declared=next(x for x in cfg['agents']['list'] if x['id']==agent)\n                selected=declared.get('model',cfg['agents']['defaults'].get('model'))\n                model_string=selected.get('primary') if isinstance(selected,dict) else selected\n                need(isinstance(model_string,str) and '/' in model_string,'actual_agent_model')\n                provider,model_id=model_string.split('/',1)\n                model={'provider':provider,'id':model_id,'api':cfg['models']['providers'][provider]['api']}\n                captured=document['models'][agent]\n                need(captured['provider']==provider and captured['id']==model_id\n                     and captured['sourceConfigSha256']==CONFIG_SHA\n                     and captured['declaredModelSha256']==sha(encoded(selected)+b'\\n'),'actual_per_agent_model_binding')\n                prefix=work/'workers'/('native-'+agent)\n                native_workers[agent]={\n                    'model':model,'nativeHome':str(directory/'codex-home'),\n                    'nativeTmp':str(work/'native-tmp'/agent),'workspace':str(work/'workspaces'/agent),\n                    'selectionOutput':str(prefix)+'.selection.private.json',\n                    'nativeDiagnosticOutput':str(prefix)+'.diagnostic.private.json',\n                    'nativeErrorOutput':str(prefix)+'.error.private.json',\n                    'nativeIdentityOutput':str(prefix)+'.identity.private.json',\n                    'nativeAccountOutput':str(prefix)+'.account.private.json'}\n            scoped['plugins']['entries']['openclaw-authbus']['config']=copy.deepcopy(plugin_config)\n            self.write(state/'openclaw.json',encoded(scoped))\n            self.registry_database(state/'state/openclaw.sqlite',document['registry'])\n            if document['authbusCaches']['directoryPresent']:\n                self.mkdir(state/'authbus')\n                for name,value in document['authbusCaches']['files'].items():\n                    if value['present']:self.write(state/'authbus'/name,base64.b64decode(value['base64'],validate=True))\n            sandbox=work/'consumer.sb'\n            policy=consumer_profile(phase,port,phase_pins,plugin_config['caFile'],runtime['harnessCodeRoots'])\n            self.write(sandbox,policy);phase_pins[str(sandbox)]=sha(policy)\n            common={**runtime,'workRoot':str(ROOT),'phaseRoot':str(work),'stateRoot':str(state),\n                'pluginConfig':copy.deepcopy(plugin_config),'originalPluginConfig':copy.deepcopy(original_plugin),\n                'serverCertificateSha256':server_certificate_sha256,'managedProfiles':copy.deepcopy(managed_profiles),\n                'model':native_workers['main']['model'],'sourcePins':phase_pins,\n                'originalAuthRowsDigestByAgent':{agent:digest(documents[agent]['rows']) for agent in AGENTS},\n                'originalCacheContentSha256':digest(document['authbusCaches']),\n                'baselineOutput':str(work/'baseline.private.json'),\n                'candidateOutput':str(work/'candidate.private.json'),\n                'rollbackCheckpointOutput':str(work/'candidate.private.json'),\n                'rollbackOnce':str(work/'inverse/rollback-once.private.json'),\n                'parentSandbox':str(sandbox)}\n            for mode,generation in (('consume',phase),('inverse',phase+'-inverse')):\n                plan={'schema':'heptabao.mac-five-agent-phase-plan.private.r1','generation':generation,\n                    'phase':phase,'mode':mode,'agentIds':list(AGENTS),'phaseSeconds':120,\n                    'phaseRoot':str(work),'stateRoot':str(state),\n                    'expectedVolumeDevice':self.guard.expected['expectedVolumeDevice'],\n                    'qaPins':dict(qa_pins),'workerCommon':copy.deepcopy(common),\n                    'nativeWorkers':copy.deepcopy(native_workers)}\n                binding=self.write(ROOT/'launchd'/(generation+'.private.json'),encoded(plan))\n                plans.append({'generation':generation,**binding})\n            self.phase_public.append({'phase':phase,'agents':list(AGENTS),'authOnlyDatabases':database_records,\n                'rawRowsDigests':common['originalAuthRowsDigestByAgent'],\n                'originalCacheContentSha256':common['originalCacheContentSha256'],\n                'originalConfigSha256':CONFIG_SHA,'ownedConfigSha256':sha(encoded(scoped)),\n                'perAgentModelsBoundToActualConfig':True,'inheritedEffectiveProfilesMaterialized':False,\n                'productionNativeAuthCopied':False,'nonprimaryDatabaseTablesCopied':False})\n        self.remaining();self.guard.check()\n        need(not self.close_errors and all(x['closed'] for x in self.fds)\n             and all(x['closed'] for x in self.connections),'all_materialization_descriptors_closed')\n        self.completed=True\n        return {'plans':plans,'phases':self.phase_public,'sameCapturedBaselineForBothIndependentPhases':True,\n                'crossAgentAtomicSnapshotClaimed':False}\n\n    def close(self):\n        for row in reversed(self.connections):self.close_connection(row)\n        for row in reversed(self.fds):self.close_fd(row)\n\n    def public(self):\n        return {'started':self.started,'completed':self.completed,'createdDirectoryCount':len(self.created),\n            'ownedDatabaseConnections':len(self.connections),\n            'allOwnedDescriptorsClosed':all(x['closed'] for x in self.fds)\n                and all(x['closed'] for x in self.connections),\n            'closeErrors':list(self.close_errors),'productionDatabaseOpened':False}\n","mac_current_capture_entry_native_r1.py":"#!/usr/bin/env python3\n\"\"\"Guarded current-Mac capture entry, after successful owned synthetic admission.\n\nSource-only. The outer owner must execute this exact entry under its generated\nsandbox profile. The entry itself verifies that exact profile and demonstrates\nowned-file/sidecar write and loopback-connect refusal before any current input\nis opened. Immutable observations are not database or cross-agent snapshots.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, base64, errno, hashlib, json, math, os, signal, socket, stat, sys, time\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-r10-current-native-custody-r1')\nQA=ROOT/'qa'\nLIVE=Path('/Users/qianqi/.openclaw')\nAGENTS=('main','trnm','hepta-ui','hepta','hepta-backend')\nCACHE_NAMES=('applied-profiles.json','publish-baseline.json','bad-refresh-quarantine.json',\n             'refresh-backoff.json','lease-epochs.json','status.json')\nNAMES=('mac_current_capture_entry_native_r1.py','mac_guarded_current_capture_r3.py',\n       'mac_t5_volume_guard_r1.py','mac_darwin_owned_projection_r1.py',\n       'mac_native_owned_commands_r1.py','mac_native_owned_unreaped_r1.py')\nSYNTHETIC_SOURCE_SHA='f3c6bb336814411aa4a24490f0904cdbd0fac2bb89dbcc36d6151ada13a51ba2'\nCAPTURE_SOURCE_SHA='606b5df58909ebedc035ebbff6a4aa5e754d19c6a7e0f5e4e88c9ddfc57c2693'\nNATIVE_BINDING={\n  \"schema\": \"heptabao.mac-native-proc-input-binding.r1\",\n  \"jobId\": \"1a1aa0eabee-fc05-3c36\",\n  \"stdoutBytes\": 24032,\n  \"stdoutSha256\": \"7a1b715e595a2badf18e4f01506cca2ee7c4c0a760c5ef3c86708a435ace9c4f\",\n  \"authorityBytes\": 733,\n  \"authoritySha256\": \"411ea26371219c49547abc014464585551ba4a69b70bb906b92561a8d5bddf23\",\n  \"childStdoutBytes\": 11066,\n  \"childStdoutSha256\": \"bb5717753866c0d7e647e4fd5c18a3342db0f530016cc7d92cb508c955ff8644\",\n  \"controllerSha256\": \"4dc7cc28869ff4cd78bd4d442619e79a44d82b0ae46c5040dcd9b59e0e17921d\",\n  \"modulePins\": {\n    \"mac_darwin_owned_projection_r1.py\": \"77b63286d79827671009d56d238494c472f37e3674bf903ab2da092b42733740\",\n    \"mac_native_owned_unreaped_r1.py\": \"880794d5e0f01f45e9c559688b2ebd33c2c96399124ea3ecb9e58720a2424d0c\",\n    \"mac_native_owned_commands_r1.py\": \"717feff0a8719a6c208b14aa1598cefd59881fffa09d19c781a89689b025b9cd\"\n  },\n  \"probeProfileSha256\": {\n    \"original\": \"d31751dc8da537121b3f1ccce832a666cc6499bdef4d956ab3208dec86daf35e\",\n    \"patched\": \"58a8f52a66b0e6136b786857cb72e3f775837907bf382850320673342750c6bd\"\n  },\n  \"additionalReadOnlyDirectoryLiteral\": \"/Volumes/T5/hepta-vnext-recovery-20261013\",\n  \"additionalReadRuleSha256\": \"f591502879fc5b1f579d5d8ced77ce375b37269725c5dd3531f650e4c46676ef\"\n}\nPROBE_CONTENT=b'owned capture kernel-write fence r1\\n'\nSTART=time.monotonic()\nuntil=None\nprotected=0\npending=None\nfds=[]\nsockets=[]\n\nclass Refused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise Refused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef encoded(value):return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\\n').encode()\ndef ident(s):\n    return tuple(str(v) for v in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n        s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\n@contextmanager\ndef critical():\n    global protected\n    protected+=1\n    try:yield\n    finally:protected-=1\ndef interrupted(signum,_frame):\n    global pending\n    pending=signum\n    if not protected:raise KeyboardInterrupt()\ndef remaining():\n    need(pending is None,'capture_entry_cancelled')\n    need(until is not None,'capture_entry_deadline_not_bound')\n    left=until-time.monotonic();need(left>0,'original_capture_entry_deadline');return left\n\ndef close_fd(row):\n    if row['closeAttempted']:return row['closed']\n    with critical():\n        row['closeAttempted']=True\n        try:os.close(row['fd']);row['closed']=True\n        except BaseException as error:row['closeErrorType']=type(error).__name__\n    return row['closed']\n\ndef source_bytes(path):\n    remaining();row=None\n    try:\n        with critical():\n            fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n            row={'fd':fd,'closeAttempted':False,'closed':False};fds.append(row)\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n             and stat.S_IMODE(before.st_mode)==0o600 and 0<before.st_size<=1024*1024,\n             'fixed_public_source_custody')\n        chunks=[];count=0\n        while True:\n            remaining();chunk=os.read(fd,min(65536,1024*1024+1-count))\n            if not chunk:break\n            count+=len(chunk);need(count<=1024*1024,'source_bound');chunks.append(chunk)\n        need(count==before.st_size and ident(before)==ident(os.fstat(fd))==ident(path.lstat()),\n             'source_fd_name_stable')\n        return b''.join(chunks),ident(before)\n    finally:\n        if row is not None:need(close_fd(row),'public_source_fd_close_failed')\n\ndef capture_profile(stage):\n    need(stage in ('before','after'),'fixed_capture_stage')\n    read_paths={Path('/'),Path('/Volumes'),Path('/Volumes/T5'),ROOT.parent,ROOT,QA,ROOT/'proofs',\n                ROOT/'captures',ROOT/'captures'/stage}\n    files={LIVE/'openclaw.json'}\n    for database in [LIVE/'state/openclaw.sqlite',*[\n        LIVE/'agents'/agent/'agent/openclaw-agent.sqlite' for agent in AGENTS]]:\n        for suffix in ('','-wal','-shm','-journal'):files.add(Path(str(database)+suffix))\n    files.add(LIVE/'authbus')\n    files.update(LIVE/'authbus'/name for name in CACHE_NAMES)\n    for agent in AGENTS:\n        native=LIVE/'agents'/agent/'agent/codex-home';files.add(native)\n        files.update(native/name for name in ('config.toml','requirements.toml','auth.json'))\n    for path in files:\n        read_paths.add(path);read_paths.update(path.parents)\n    q=lambda value:json.dumps(str(value))\n    lines=['(version 1)','(deny default)','(allow process*)',\n        '(allow signal (target children))','(allow sysctl-read)','(allow mach-lookup)',\n        '(allow file-read-metadata)']\n    for path in ('/System','/usr','/bin','/sbin','/Library','/private/etc','/opt/homebrew','/dev/fd'):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in (QA,ROOT/'proofs',ROOT/'captures'/stage):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in sorted(read_paths,key=str):\n        lines.append('(allow file-read* (literal '+q(path)+'))')\n    lines.extend(['(allow file-read* (literal \"/dev/null\"))',\n        '(allow file-read* (literal \"/dev/urandom\"))',\n        '(allow file-read* (literal \"/dev/random\"))',\n        '(allow file-write* (subpath '+q(ROOT/'captures'/stage/'output')+'))',\n        '(allow file-write* (literal \"/dev/null\"))'])\n    # No network rule. The only write exception is the new capture output root.\n    return ('\\n'.join(lines)+'\\n').encode()\n\ndef admitted_synthetic(guard,binding):\n    expected={'schema','jobId','stdoutSha256','stdoutBytes','authoritySha256',\n              'authorityBytes','controllerSha256'}\n    need(isinstance(binding,dict) and set(binding)==expected\n         and binding['schema']=='heptabao.mac-capture-synthetic-input-binding.r1'\n         and isinstance(binding['jobId'],str) and 1<=len(binding['jobId'])<=128\n         and binding['controllerSha256']==SYNTHETIC_SOURCE_SHA,\n         'fixed_actual_synthetic_binding')\n    for key in ('stdoutSha256','authoritySha256'):\n        need(isinstance(binding[key],str) and len(binding[key])==64\n             and all(c in '0123456789abcdef' for c in binding[key]),'synthetic_binding_sha')\n    for key in ('stdoutBytes','authorityBytes'):\n        need(type(binding[key]) is int and 0<binding[key]<=65536,'synthetic_binding_size')\n    raw=guard.read(ROOT/'proofs/synthetic-r2.stdout.public.json',65536)\n    authority_raw=guard.read(ROOT/'proofs/synthetic-r2.authority.public.json',65536)\n    need(len(raw)==binding['stdoutBytes'] and sha(raw)==binding['stdoutSha256']\n         and len(authority_raw)==binding['authorityBytes']\n         and sha(authority_raw)==binding['authoritySha256'],'actual_original_synthetic_bytes')\n    authority=json.loads(authority_raw);proof=json.loads(raw)\n    need(isinstance(authority,dict) and authority.get('job_id')==binding['jobId']\n         and type(authority.get('exit_code')) is int and authority['exit_code']==0\n         and authority.get('state')=='succeeded'\n         and all(authority.get(k) is True for k in\n             ('output_complete','output_durable','terminal_publication_confirmed'))\n         and all(authority.get(k) is False for k in ('timed_out','cancelled','automatic_retry')),\n         'successful_authoritative_synthetic_terminal')\n    for stream,size in (('stdout',len(raw)),('stderr',0)):\n        need(authority.get('log_bytes',{}).get(stream)=={'seen':size,'stored':size}\n             and authority.get('log_errors',{}).get(stream) is None\n             and authority.get('log_synced',{}).get(stream) is True\n             and authority.get('log_truncated',{}).get(stream) is False,\n             'complete_original_synthetic_log_'+stream)\n    need(isinstance(proof,dict) and proof.get('ok') is True\n         and proof.get('outcomeUnknown') is False and proof.get('controllerGeneration')=='r2'\n         and proof.get('productionOpened') is False\n         and proof.get('originalDeadlineMetAfterClosure') is True\n         and proof.get('sameRuntimeBeforeAfter') is True\n         and type(proof.get('elapsedSeconds')) in (int,float)\n         and 0<=proof['elapsedSeconds']<45\n         and proof.get('sourcePins',{}).get('mac_capture_sqlite_synthetic_r2.py')==SYNTHETIC_SOURCE_SHA\n         and proof.get('captureSourceSha256')==CAPTURE_SOURCE_SHA,\n         'successful_complete_r2_synthetic_report')\n    cases=proof.get('cases')\n    need(isinstance(cases,list) and len(cases)==7\n         and all(isinstance(row,dict) and row.get('passed') is True for row in cases),\n         'all_seven_original_synthetic_cases')\n    held=proof.get('heldT5Final',{});owned=proof.get('ownedCommands',{})\n    need(proof.get('allOwnedDescriptorsClosed') is True\n         and held.get('allDescriptorsClosed') is True and held.get('lastAnchorCheckPassed') is True\n         and held.get('closeErrors')==[] and owned.get('allOwnedCommandsStopped') is True\n         and owned.get('unknownCommandCount')==0,'synthetic_complete_owned_closure')\n    return raw,proof\n\ndef admitted_native(guard,binding):\n    \"\"\"Admit three exact original public records; never accept a template.\"\"\"\n    need(type(binding) is dict and binding==NATIVE_BINDING,'exact_actual_native_binding')\n    originals={}\n    for role,name,size_key,sha_key in (\n        ('stdout','native-proc-r2.stdout.public.json','stdoutBytes','stdoutSha256'),\n        ('authority','native-proc-r2.authority.public.json','authorityBytes','authoritySha256'),\n        ('child','native-proc-r2.child-stdout.public.json','childStdoutBytes','childStdoutSha256')):\n        raw=guard.read(ROOT/'proofs'/name,65536)\n        need(len(raw)==binding[size_key] and sha(raw)==binding[sha_key],\n             'whole_original_native_'+role)\n        originals[role]=raw\n    authority=json.loads(originals['authority'])\n    proof=json.loads(originals['stdout']);child=json.loads(originals['child'])\n    need(type(authority) is dict and authority.get('job_id')==binding['jobId']\n         and type(authority.get('exit_code')) is int and authority['exit_code']==0\n         and authority.get('state')=='succeeded'\n         and all(authority.get(k) is True for k in\n             ('output_complete','output_durable','terminal_publication_confirmed'))\n         and all(authority.get(k) is False for k in ('timed_out','cancelled','automatic_retry')),\n         'successful_authoritative_native_terminal')\n    for stream,size in (('stdout',binding['stdoutBytes']),('stderr',0)):\n        need(authority.get('log_bytes',{}).get(stream)=={'seen':size,'stored':size}\n             and authority.get('log_errors',{}).get(stream) is None\n             and authority.get('log_synced',{}).get(stream) is True\n             and authority.get('log_truncated',{}).get(stream) is False,\n             'complete_original_native_log_'+stream)\n    need(type(proof) is dict and proof.get('schema')=='heptabao.mac-native-proc-sandbox-probe.r2'\n         and type(child) is dict and child.get('schema')=='heptabao.mac-native-proc-sandbox-child.r2',\n         'exact_public_native_report_schemas')\n    cases=proof.get('cases')\n    need(type(cases) is list and len(cases)==1 and type(cases[0]) is dict\n         and cases[0].get('variant')=='native' and type(cases[0].get('exitCode')) is int\n         and cases[0]['exitCode']==0 and cases[0].get('report')==child\n         and cases[0].get('stdoutBytes')==binding['childStdoutBytes']\n         and cases[0].get('stdoutSha256')==binding['childStdoutSha256']\n         and cases[0].get('stderrBytes')==0\n         and cases[0].get('stderrSha256')==sha(b''),'exact_original_native_child_terminal')\n    for value,count in ((proof,2),(child,1)):\n        need(value.get('ok') is True and value.get('outcomeUnknown') is False\n             and value.get('sourceSha256')==binding['controllerSha256']\n             and value.get('originalCaptureSeconds')==45\n             and value.get('originalDeadlineMetAfterClosure') is True\n             and type(value.get('elapsedSeconds')) in (int,float)\n             and math.isfinite(value['elapsedSeconds']) and 0<=value['elapsedSeconds']<45,\n             'successful_original_native_report')\n        need(all(value.get(k) is False for k in (\n            'productionReadAttempted','productionWriteAttempted','sqliteImported',\n            'consumerStarted','providerRequested','j3160Contacted','businessReplay',\n            'failedCaptureBeforePathUsed','systemUtilitiesCopiedOrChanged')),\n             'public_native_probe_scope_only')\n        held=value.get('heldT5Final',{});owned=value.get('ownedCommands',{})\n        need(value.get('allOwnedDescriptorsClosed') is True\n             and held.get('allDescriptorsClosed') is True\n             and held.get('lastAnchorCheckPassed') is True\n             and held.get('volumeUUIDVerified') is True and held.get('closeErrors')==[]\n             and owned.get('allOwnedCommandsStopped') is True and owned.get('unknownCommandCount')==0\n             and type(owned.get('commands')) is list and len(owned['commands'])==count,\n             'complete_public_native_fd_and_owned_closure')\n        for row in owned['commands']:\n            need(type(row) is dict and type(row.get('exitCode')) is int and row['exitCode']==0\n                 and row.get('completeBeforeDeadline') is True and row.get('outcomeUnknown') is False\n                 and row.get('streamsClosed') is True,'public_native_command_known_complete')\n            closed=row.get('cleanup',{})\n            need(closed.get('ok') is True and closed.get('outcomeUnknown') is False\n                 and closed.get('directChildReaped') is True\n                 and closed.get('ownedLiveGroupEmptyBeforeReap') is True\n                 and closed.get('allGroupRowsEmptyAfterReap') is True\n                 and closed.get('remainingGroupRows')==[] and closed.get('signals')==[]\n                 and closed.get('postReapSignalSent') is False,\n                 'public_native_retained_custody_terminal')\n        modules=value.get('nativeModulesBefore')\n        need(type(modules) is dict and set(modules)==set(binding['modulePins'])\n             and modules==value.get('nativeModulesAfter')\n             and all(type(modules[name]) is dict and modules[name].get('sha256')==pin\n                     for name,pin in binding['modulePins'].items()),\n             'public_native_three_module_whole_pins')\n        need(type(value.get('sourceBefore')) is dict and len(value['sourceBefore'])==4\n             and value['sourceBefore']==value.get('sourceAfter'),\n             'public_native_old_sources_unchanged')\n        need(value.get('profileSha256')==binding['probeProfileSha256']\n             and value.get('policyPermissionsAddedBeyondDevnull') is True\n             and value.get('additionalReadOnlyDirectoryLiteral')==binding['additionalReadOnlyDirectoryLiteral']\n             and value.get('additionalReadRuleSha256')==binding['additionalReadRuleSha256'],\n             'explicit_public_native_policy_delta')\n    need(type(proof.get('utilityBefore')) is dict and len(proof['utilityBefore'])==3\n         and proof['utilityBefore']==proof.get('utilityAfter'),'public_native_utilities_unchanged')\n    kernel=child.get('kernelSandboxProof',{});checks=kernel.get('checks')\n    need(kernel.get('allFourDenied') is True and type(checks) is list and len(checks)==4\n         and [row.get('case') for row in checks]==[\n             'main_write_open','sidecar_create','sidecar_create','loopback_connect']\n         and all(row.get('denied') is True and row.get('errno') in (errno.EACCES,errno.EPERM)\n                 for row in checks),'all_four_original_native_kernel_refusals')\n    projection=child.get('nativeProjection',{})\n    need(projection.get('selfQualified') is True and type(projection.get('identity')) is dict\n         and projection.get('allHostEnumerationUsed') is False\n         and projection.get('commandNamesOrPathsProjected') is False\n         and projection.get('pidListNullBufferUsed') is False\n         and projection.get('maxGroupMembers')==64 and projection.get('querySeconds')==4,\n         'public_native_bounded_projection_qualified')\n    need(child.get('nativeSelfBefore')==child.get('nativeSelfAfter')\n         and type(child.get('nativeSelfBefore')) is dict\n         and child['nativeSelfBefore'].get('pidUidPpidPgidMatchedIndependentOsApis') is True,\n         'public_native_same_self_birth_qualified')\n    guard.check()\n    return originals['stdout'],child\n\ndef kernel_refusals(guard,stage):\n    directory=ROOT/'captures'/stage/'probe';main=directory/'writable-owned-main'\n    need(guard.read(main,4096)==PROBE_CONTENT,'owned_probe_exact_initial_bytes')\n    original=ident(main.lstat());rows=[]\n    for path,create in ((main,False),(Path(str(main)+'-wal'),True),(Path(str(main)+'-shm'),True)):\n        remaining();refusal=None;opened=None\n        with guard.parent(path) as (parent,name):\n            if create:\n                try:os.stat(name,dir_fd=parent,follow_symlinks=False)\n                except FileNotFoundError:pass\n                else:raise Refused('owned_probe_sidecar_preexisting')\n            try:\n                with critical():\n                    flags=os.O_WRONLY|os.O_NOFOLLOW|(os.O_CREAT|os.O_EXCL if create else os.O_APPEND)\n                    fd=os.open(name,flags,0o600,dir_fd=parent)\n                    opened={'fd':fd,'closeAttempted':False,'closed':False};fds.append(opened)\n            except OSError as error:refusal=error.errno\n            finally:\n                if opened is not None:need(close_fd(opened),'owned_probe_fd_close')\n            need(opened is None and refusal in (errno.EACCES,errno.EPERM),'kernel_owned_write_not_refused')\n            if create:\n                try:os.stat(name,dir_fd=parent,follow_symlinks=False)\n                except FileNotFoundError:pass\n                else:raise Refused('owned_probe_sidecar_created')\n        rows.append({'case':'sidecar_create' if create else 'main_write_open',\n                     'name':path.name,'denied':True,'errno':refusal})\n    need(ident(main.lstat())==original and guard.read(main,4096)==PROBE_CONTENT,\n         'owned_probe_no_file_change')\n    endpoint=('127.0.0.1',9);sock=None;refusal=None;socket_row=None\n    try:\n        with critical():\n            sock=socket.socket(socket.AF_INET,socket.SOCK_STREAM)\n            socket_row={'socket':sock,'closeAttempted':False,'closed':False};sockets.append(socket_row)\n        sock.settimeout(min(3.0,remaining()))\n        sock.connect(endpoint)\n    except OSError as error:refusal=error.errno\n    finally:\n        if socket_row is not None:\n            with critical():\n                socket_row['closeAttempted']=True\n                try:sock.close();socket_row['closed']=True\n                except BaseException as error:socket_row['closeErrorType']=type(error).__name__\n    need(refusal in (errno.EACCES,errno.EPERM),'kernel_loopback_connect_not_refused')\n    need(socket_row is None or socket_row['closed'],'owned_probe_socket_close')\n    rows.append({'case':'loopback_connect','endpoint':'127.0.0.1:9','denied':True,'errno':refusal})\n    remaining()\n    return {'allFourDenied':True,'onlyOwnedWriteProbes':True,'externalAddressAttempted':False,\n            'profileWriteScope':'fresh_capture_output_only','checks':rows}\n\ndef main():\n    global until\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--stage',choices=('before','after'),required=True)\n    parser.add_argument('--absolute-until',type=float,required=True)\n    parser.add_argument('--public-volume-anchor-base64',required=True)\n    parser.add_argument('--public-volume-anchor-sha256',required=True)\n    parser.add_argument('--source-pins-base64',required=True)\n    parser.add_argument('--source-pins-sha256',required=True)\n    parser.add_argument('--synthetic-binding-base64',required=True)\n    parser.add_argument('--synthetic-binding-sha256',required=True)\n    parser.add_argument('--native-binding-base64',required=True)\n    parser.add_argument('--native-binding-sha256',required=True)\n    parser.add_argument('--sandbox-profile-sha256',required=True)\n    args=parser.parse_args();os.umask(0o077)\n    need(math.isfinite(args.absolute_until) and START<args.absolute_until<=START+45,\n         'one_original_capture_deadline')\n    until=args.absolute_until\n    for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,interrupted)\n    report={'schema':'heptabao.mac-guarded-current-capture-entry.native-r1','stage':args.stage,\n        'ok':False,'outcomeUnknown':False,'productionReadAttempted':False,\n        'productionWriteAttempted':False,'captureLibraryReturned':False,\n        'providerRequestSent':False,'j3160Contacted':False,\n        'wholeDatabaseBackupQualified':False,'crossAgentAtomicSnapshotClaimed':False,\n        'originalCaptureSeconds':45}\n    guard=None;commands=None;cap=None;complete=False;capsule=None;native_api=None\n    try:\n        need(sys.platform=='darwin' and os.getuid()==501,'actual_mac_capture_owner')\n        pins_raw=base64.b64decode(args.source_pins_base64,validate=True)\n        need(len(pins_raw)<=8192 and sha(pins_raw)==args.source_pins_sha256,'exact_entry_source_pins')\n        pins=json.loads(pins_raw)\n        need(isinstance(pins,dict) and set(pins)==set(NAMES)\n             and all(isinstance(v,str) and len(v)==64 and all(c in '0123456789abcdef' for c in v)\n                     for v in pins.values()) and pins['mac_guarded_current_capture_r3.py']==CAPTURE_SOURCE_SHA,\n             'fixed_public_capture_modules')\n        need(all(pins.get(name)==pin for name,pin in NATIVE_BINDING['modulePins'].items()),\n             'exact_qualified_native_capture_modules')\n        source_ids={}\n        for name,pin in pins.items():\n            raw,source_ids[name]=source_bytes(QA/name);need(sha(raw)==pin,'capture_public_source_pin')\n        sys.path.insert(0,str(QA))\n        from mac_t5_volume_guard_r1 import HeldT5\n        need(all(name[:-3] not in sys.modules for name in NATIVE_BINDING['modulePins']),\n             'new_native_capture_modules_not_preloaded')\n        from mac_darwin_owned_projection_r1 import NativeProjection\n        from mac_native_owned_unreaped_r1 import bind_projection\n        from mac_native_owned_commands_r1 import Commands\n        import mac_guarded_current_capture_r3 as capture\n        cap=capture\n        class SignalState:\n            @property\n            def pending(self):return pending\n            def critical(self):return critical()\n        remaining()\n        native_api=NativeProjection(until=until)\n        report['nativeSelfBefore']=native_api.qualify_self(until=until)\n        bind_projection(native_api)\n        commands=Commands(SignalState())\n        anchor=base64.b64decode(args.public_volume_anchor_base64,validate=True)\n        guard=HeldT5(anchor,args.public_volume_anchor_sha256,remaining,critical)\n        row,out,_=commands.run('capture-t5-volume',\n            ['/usr/sbin/diskutil','info','-plist','/Volumes/T5'],\n            until=min(until,time.monotonic()+30),maximum=262144)\n        need(row['exitCode']==0 and not row['outcomeUnknown'] and row['completeBeforeDeadline'],\n             'capture_volume_probe_complete')\n        guard.accept_diskutil(out)\n        native_raw=base64.b64decode(args.native_binding_base64,validate=True)\n        need(len(native_raw)<=8192 and sha(native_raw)==args.native_binding_sha256,\n             'actual_native_public_binding')\n        _,native_proof=admitted_native(guard,json.loads(native_raw))\n        need(native_api.public()['identity']==native_proof['nativeProjection']['identity'],\n             'same_actual_native_abi_os_and_loaded_image_observations')\n        report['nativePublicProofSha256']=NATIVE_BINDING['stdoutSha256']\n        report['nativePublicAuthoritySha256']=NATIVE_BINDING['authoritySha256']\n        report['nativePublicChildSha256']=NATIVE_BINDING['childStdoutSha256']\n        report['actualNativeRuntimeCompatible']=True\n        remaining()\n        binding_raw=base64.b64decode(args.synthetic_binding_base64,validate=True)\n        need(len(binding_raw)<=8192 and sha(binding_raw)==args.synthetic_binding_sha256,\n             'actual_synthetic_public_binding')\n        proof,proof_value=admitted_synthetic(guard,json.loads(binding_raw))\n        capture.validate_synthetic_proof(proof,sha(proof),remaining=remaining,critical=critical)\n        profile=guard.read(ROOT/'captures'/args.stage/'capture.sb',65536)\n        need(profile==capture_profile(args.stage) and sha(profile)==args.sandbox_profile_sha256,\n             'exact_reviewed_capture_sandbox')\n        report['kernelSandboxProof']=kernel_refusals(guard,args.stage)\n        remaining();guard.check()\n        report['productionReadAttempted']=True\n        document,observation=capture.capture_current(critical=critical,cancelled=lambda:pending is not None,\n            synthetic_proof=proof,synthetic_proof_sha=sha(proof),until=until)\n        report['captureLibraryReturned']=True\n        report['observation']=observation;report['runtime']=document['runtime']\n        report['syntheticProofSha256']=sha(proof)\n        need(document['runtime']==proof_value['runtime'],'same_actual_capture_runtime')\n        remaining()\n        capsule_raw=capture.encoded(document)\n        need(len(capsule_raw)<=4*1024*1024,'private_capsule_bound')\n        output=ROOT/'captures'/args.stage/'output/capsule.private.json'\n        capsule=guard.write_new(output,capsule_raw)\n        report['capsule']={'path':str(output),**capsule}\n        for name,pin in pins.items():\n            raw,observed=source_bytes(QA/name)\n            need(sha(raw)==pin and observed==source_ids[name],'capture_sources_after')\n        report['nativeSelfAfter']=native_api.qualify_self(until=until)\n        before_self=report['nativeSelfBefore']['first'];after_self=report['nativeSelfAfter']['last']\n        need(all(before_self[key]==after_self[key] for key in\n             ('pid','ppid','pgid','uid','birthSeconds','birthMicroseconds')),\n             'same_current_capture_native_self_birth')\n        guard.check();remaining();complete=True\n    except BaseException as error:\n        report['errorType']=type(error).__name__\n        report['errorCode']=str(error) if isinstance(error,Refused) or (\n            cap is not None and isinstance(error,cap.CaptureRefused)) else None\n        report['outcomeUnknown']=bool(report['productionReadAttempted']\n            and not report['captureLibraryReturned']) or isinstance(error,KeyboardInterrupt)\n    finally:\n        for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,signal.SIG_IGN)\n        for row in reversed(fds):close_fd(row)\n        for row in reversed(sockets):\n            if not row['closeAttempted']:\n                with critical():\n                    row['closeAttempted']=True\n                    try:row['socket'].close();row['closed']=True\n                    except BaseException as error:row['closeErrorType']=type(error).__name__\n        if commands is not None:report['ownedCommands']=commands.public()\n        if native_api is not None:report['nativeProjection']=native_api.public()\n        if guard is not None:\n            guard.close();report['heldT5Final']=guard.public_state()\n        closed=(all(row['closed'] for row in fds) and all(row['closed'] for row in sockets)\n            and guard is not None and report['heldT5Final']['allDescriptorsClosed']\n            and report['heldT5Final']['lastAnchorCheckPassed']\n            and report['heldT5Final']['closeErrors']==[])\n        stopped=(commands is not None and report['ownedCommands']['allOwnedCommandsStopped']\n                 and report['ownedCommands']['unknownCommandCount']==0)\n        report['allOwnedDescriptorsClosed']=closed\n        report['outcomeUnknown']=bool(report['outcomeUnknown'] or not closed or not stopped or pending is not None)\n        done=time.monotonic()\n        report['elapsedSeconds']=done-START\n        report['originalAbsoluteDeadlineMonotonic']=until\n        report['originalDeadlineMetAfterPrivatePublicationAndClosure']=done<until\n        report['ok']=bool(complete and capsule is not None and closed and stopped\n                          and not report['outcomeUnknown'] and done<until)\n        report['authoritativeExitZeroAndOriginalDeadlineRequired']=True\n        raw=encoded(report);need(len(raw)<=262144,'public_capture_report_bound')\n        sys.stdout.buffer.write(raw);sys.stdout.buffer.flush()\n    return 0 if report['ok'] and time.monotonic()<until else 1\n\nif __name__=='__main__':sys.exit(main())\n","mac_owned_launchd_r3.py":"#!/usr/bin/env python3\n\"\"\"Finite owned launchd control for the isolated five-agent Mac candidate.\n\nLibrary only, source-only. Launchd owns wrappers; wrappers own their actual\nPopen children. This manager never claims those children are its direct children\nand never sends a signal to a numeric PID or process group. Unknown state stops\nthe operation graph. Failed cleanup cannot become a successful generation.\n\"\"\"\nfrom __future__ import annotations\nimport base64, hashlib, json, os, plistlib, re, stat, time\nfrom pathlib import Path\nfrom mac_native_process_observer_r1 import ProcessReader\n\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-r10-current-native-custody-r1')\nQA=ROOT/