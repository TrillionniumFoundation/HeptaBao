{"sources":{"mac_current_fixture_materializer_r1.py":"#!/usr/bin/env python3\n\"\"\"Create two independent auth-only Mac fixtures from an admitted bounded capsule.\n\nLibrary only. No source database is opened here. All SQLite writes target new,\nexclusive files below the two fixed phase roots. Effective auth is never a\nmaterialization or inverse input. Models and flags come from captured config.\n\"\"\"\nfrom __future__ import annotations\nimport base64, copy, hashlib, json, math, os, re, sqlite3, stat, time\nfrom pathlib import Path\n\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-df026-current-registry-wal-r1')\nLIVE=Path('/Users/qianqi/.openclaw')\nSDK=Path('/opt/homebrew/lib/node_modules/openclaw')\nCODEX=LIVE/'npm/projects/openclaw-codex-8902d781d4__openclaw-generation__g-49fd4dbfde2c5057/node_modules/@openclaw/codex'\nAGENTS=('main','trnm','hepta-ui','hepta','hepta-backend')\nPHASES=('initial','cold-new-process')\nTABLES=(('store','auth_profile_store','store_key','store_json'),\n        ('state','auth_profile_state','state_key','state_json'))\nCACHE_NAMES=('applied-profiles.json','publish-baseline.json','bad-refresh-quarantine.json',\n             'refresh-backoff.json','lease-epochs.json','status.json')\nCONFIG_SHA='ca2dd7d7879fa901dfb24e00837b56a4e0fd230600d7ed1e3086eda194187d4d'\nMAX_ROW=1024*1024\n\nclass Refused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise Refused(code)\ndef encoded(value):\n    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef digest(value):return sha(encoded(value))\ndef ident(s):\n    return tuple(str(v) for v in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n        s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\ndef no_nonfinite(value):\n    if type(value) is float:need(math.isfinite(value),'finite_captured_json_number')\n    elif isinstance(value,list):\n        for item in value:no_nonfinite(item)\n    elif isinstance(value,dict):\n        need(all(isinstance(k,str) for k in value),'json_object_keys')\n        for item in value.values():no_nonfinite(item)\n\ndef consumer_profile(phase,port,source_pins,ca_file,harness_roots):\n    need(phase in PHASES and type(port) is int and 1024<=port<=65535,'fixed_consumer_sandbox')\n    root=ROOT/phase\n    need(Path(ca_file)==ROOT/'credentials-consumer/ca.crt','only_owned_ca')\n    # The exact installed code and the new phase are readable; production\n    # current DB/config/auth/cache values and other phase/control roots are not.\n    q=lambda value:json.dumps(str(value))\n    lines=['(version 1)','(deny default)','(allow process*)',\n        '(allow signal (target children))','(allow sysctl-read)','(allow mach-lookup)',\n        '(allow file-read-metadata)']\n    for path in ('/System','/usr','/bin','/sbin','/Library','/private/etc','/opt/homebrew','/dev/fd'):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in (ROOT/'qa',ROOT/'installed-plugin-copy',root):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    # Installed immutable package roots are public code. Reading their package\n    # modules is necessary for the real Node loader and its transitive imports.\n    need(isinstance(harness_roots,list) and 1<=len(harness_roots)<=8\n         and len(set(harness_roots))==len(harness_roots),'actual_finite_harness_root_set')\n    for value in sorted(set([str(CODEX),*harness_roots])):\n        path=Path(value)\n        need(path.is_absolute() and path==Path(os.path.normpath(str(path)))\n             and path.is_relative_to(LIVE/'npm/projects'),'public_installed_harness_code_scope')\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in sorted(source_pins):\n        lines.append('(allow file-read* (literal '+q(path)+'))')\n    for path in (ROOT/'credentials-consumer/ca.crt',\n                 ROOT/'credentials-consumer/role_id',ROOT/'credentials-consumer/secret_id'):\n        lines.append('(allow file-read* (literal '+q(path)+'))')\n    lines.extend(['(allow file-read* (literal \"/dev/urandom\"))',\n        '(allow file-read* (literal \"/dev/random\"))',\n        '(allow file-write* (subpath '+q(root)+'))',\n        '(allow file-write* (literal \"/dev/null\"))',\n        '(allow network-outbound (remote ip '+q('localhost:'+str(port))+'))'])\n    return ('\\n'.join(lines)+'\\n').encode()\n\nclass Materializer:\n    def __init__(self,guard,signals,until):\n        need(guard.uuid_verified and not guard.closed,'held_t5_before_materialization')\n        self.guard=guard;self.signals=signals;self.until=until\n        self.connections=[];self.fds=[];self.started=False;self.completed=False\n        self.created=[];self.phase_public=[];self.close_errors=[]\n\n    def remaining(self,until=None):\n        need(self.signals.pending is None,'materialization_cancelled')\n        left=min(self.until,until if until is not None else self.until)-time.monotonic()\n        need(left>0,'original_outer_or_owned_sqlite_deadline');return left\n\n    def mkdir(self,path):\n        self.remaining();self.guard.mkdir_new(path);self.created.append(str(path))\n\n    def write(self,path,raw):\n        self.remaining();result=self.guard.write_new(path,raw);self.remaining();return result\n\n    def close_fd(self,row):\n        if row['closeAttempted']:return\n        with self.signals.critical():\n            row['closeAttempted']=True\n            try:os.close(row['fd']);row['closed']=True\n            except BaseException as error:\n                row['closeErrorType']=type(error).__name__;self.close_errors.append(type(error).__name__)\n\n    def close_connection(self,row):\n        if row['closeAttempted']:return\n        with self.signals.critical():\n            row['closeAttempted']=True\n            try:row['db'].close();row['closed']=True\n            except BaseException as error:\n                row['closeErrorType']=type(error).__name__;self.close_errors.append(type(error).__name__)\n\n    def owned_database(self,path,create_and_verify):\n        self.remaining()\n        need(any(path.is_relative_to(ROOT/phase/'state') for phase in PHASES),\n             'only_new_phase_databases')\n        fdrow=None;connection=None\n        with self.guard.parent(path) as (parent,name):\n            try:\n                with self.signals.critical():\n                    fd=os.open(name,os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=parent)\n                    fdrow={'fd':fd,'closeAttempted':False,'closed':False};self.fds.append(fdrow)\n                before=os.fstat(fd)\n                need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n                     and stat.S_IMODE(before.st_mode)==0o600 and before.st_size==0\n                     and ident(before)==ident(os.stat(name,dir_fd=parent,follow_symlinks=False)),\n                     'new_empty_owned_database')\n                query_until=min(self.until,time.monotonic()+3.0)\n                self.remaining(query_until)\n                with self.signals.critical():\n                    db=sqlite3.connect(str(path),timeout=0.0,isolation_level=None)\n                    connection={'db':db,'closeAttempted':False,'closed':False}\n                    self.connections.append(connection)\n                db.enable_load_extension(False)\n                need(hasattr(db,'setlimit'),'same_runtime_sqlite_limits_required')\n                db.setlimit(sqlite3.SQLITE_LIMIT_LENGTH,MAX_ROW+65536)\n                db.setlimit(sqlite3.SQLITE_LIMIT_SQL_LENGTH,32768)\n                db.set_progress_handler(lambda:1 if time.monotonic()>=query_until else 0,1000)\n                db.execute('PRAGMA journal_mode=DELETE')\n                db.execute('PRAGMA synchronous=FULL')\n                db.execute('PRAGMA temp_store=MEMORY')\n                db.execute('PRAGMA max_page_count=8192')\n                db.execute('BEGIN IMMEDIATE')\n                create_and_verify(db,query_until)\n                self.remaining(query_until);db.execute('COMMIT')\n                self.close_connection(connection);need(connection['closed'],'owned_database_connection_closed')\n                self.remaining(query_until)\n                after=os.fstat(fd);named=os.stat(name,dir_fd=parent,follow_symlinks=False)\n                need(ident(after)==ident(named) and ident(before)[:6]==ident(after)[:6]\n                     and 512<=after.st_size<=32*1024*1024,'same_created_database_inode')\n                os.fsync(fd);os.fsync(parent)\n                for suffix in ('-wal','-shm','-journal'):\n                    try:os.stat(name+suffix,dir_fd=parent,follow_symlinks=False)\n                    except FileNotFoundError:pass\n                    else:raise Refused('owned_materialized_database_sidecar_remaining')\n                self.remaining()\n                return {'path':str(path),'bytes':after.st_size,'identity':list(ident(after))}\n            finally:\n                if connection is not None:self.close_connection(connection)\n                if fdrow is not None:self.close_fd(fdrow)\n\n    def auth_database(self,path,rows):\n        need(isinstance(rows,dict) and set(rows)=={'store','state'},'two_primary_table_documents')\n        for kind,_,_,_ in TABLES:\n            values=rows[kind]\n            need(isinstance(values,list) and len(values)<=1,'captured_primary_only')\n            for row in values:\n                need(isinstance(row,list) and len(row)==3 and row[0]=='primary'\n                     and isinstance(row[1],str) and len(row[1].encode())<=MAX_ROW\n                     and type(row[2]) is int and 0<=row[2]<=9007199254740991,\n                     'exact_auth_row_shape_and_timestamp')\n                need(isinstance(json.loads(row[1]),dict),'auth_payload_object')\n        def create(db,until):\n            for kind,table,key,column in TABLES:\n                self.remaining(until)\n                db.execute('CREATE TABLE '+table+' ('+key+' TEXT PRIMARY KEY,'+\n                           column+' TEXT NOT NULL,updated_at INTEGER NOT NULL)')\n                db.executemany('INSERT INTO '+table+' VALUES (?,?,?)',rows[kind])\n                actual=[list(row) for row in db.execute('SELECT '+key+','+column+\n                    ',updated_at FROM '+table+' ORDER BY '+key)]\n                need(actual==rows[kind],'original_primary_payload_and_timestamp_exact')\n        return self.owned_database(path,create)\n\n    def registry_database(self,path,registry):\n        need(isinstance(registry,dict) and set(registry)=={'schema','columns','row','tableInfo'},\n             'complete_captured_registry_shape')\n        columns=registry['columns'];row=registry['row'];ddl=registry['schema']\n        need(isinstance(columns,list) and len(columns)==len(set(columns))==13\n             and all(isinstance(x,str) and re.fullmatch('[a-z_]+',x) for x in columns)\n             and 'index_key' in columns and isinstance(row,list) and len(row)==13\n             and row[columns.index('index_key')]=='installed-plugin-index'\n             and isinstance(ddl,str) and len(ddl.encode())<=16384\n             and re.match(r'(?is)^\\s*CREATE\\s+TABLE\\s+(?:\"installed_plugin_index\"|installed_plugin_index)\\s*\\(',ddl),\n             'one_actual_thirteen_column_registry')\n        no_nonfinite(registry)\n        def create(db,until):\n            self.remaining(until)\n            # execute accepts one statement. No ATTACH, virtual table, extension,\n            # function invocation or second statement is authorized.\n            forbidden={sqlite3.SQLITE_ATTACH,sqlite3.SQLITE_DETACH,sqlite3.SQLITE_FUNCTION,\n                       sqlite3.SQLITE_CREATE_VTABLE,sqlite3.SQLITE_DROP_VTABLE}\n            db.set_authorizer(lambda action,*_args:sqlite3.SQLITE_DENY if action in forbidden else sqlite3.SQLITE_OK)\n            db.execute(ddl)\n            names=','.join('\"'+name+'\"' for name in columns)\n            db.execute('INSERT INTO installed_plugin_index ('+names+') VALUES ('+\n                       ','.join('?' for _ in columns)+')',row)\n            actual=db.execute('SELECT '+names+' FROM installed_plugin_index WHERE index_key=?',\n                              ('installed-plugin-index',)).fetchall()\n            need([list(x) for x in actual]==[row],'whole_captured_registry_row')\n            need([list(x) for x in db.execute('PRAGMA table_info(installed_plugin_index)')]\n                 ==registry['tableInfo'],'whole_registry_column_contract')\n            stored=db.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name='installed_plugin_index'\").fetchall()\n            need(stored==[(ddl,)],'registry_ddl_preserved_exact')\n            self.remaining(until)\n        return self.owned_database(path,create)\n\n    def validate_capsule(self,document):\n        need(isinstance(document,dict) and document.get('schema')=='heptabao.mac-guarded-current-inputs.private.r1'\n             and document.get('sourceConfigSha256')==CONFIG_SHA and document.get('agentIds')==list(AGENTS)\n             and document.get('scope')=='bounded_point_in_time_observation_not_database_or_cross_agent_snapshot',\n             'admitted_current_capsule_shape')\n        no_nonfinite(document)\n        config_raw=base64.b64decode(document['configBase64'],validate=True)\n        need(len(config_raw)<=MAX_ROW and sha(config_raw)==CONFIG_SHA,'captured_config_whole_pin')\n        cfg=json.loads(config_raw)\n        declared=cfg.get('agents',{}).get('list')\n        need(isinstance(declared,list) and [x.get('id') for x in declared]==list(AGENTS),\n             'all_actual_five_agents')\n        docs=document['authDocuments']\n        need(isinstance(docs,list) and len(docs)==5 and [x.get('agent') for x in docs]==list(AGENTS),\n             'five_ordered_current_primary_documents')\n        for item in docs:\n            need(item.get('captureScope')=='two_fixed_primary_keys_only'\n                 and item.get('nonprimaryRowsCaptured') is False,'honest_primary_materialization_scope')\n        cache=document['authbusCaches']\n        need(isinstance(cache,dict) and set(cache)=={'directoryPresent','files'}\n             and type(cache['directoryPresent']) is bool and set(cache['files'])==set(CACHE_NAMES),\n             'all_six_current_cache_bytes_or_absence')\n        for value in cache['files'].values():\n            need(isinstance(value,dict) and type(value.get('present')) is bool,'typed_cache_presence')\n            if value['present']:\n                raw=base64.b64decode(value['base64'],validate=True)\n                need(cache['directoryPresent'] and value['mode']==0o600\n                     and type(value['bytes']) is int and len(raw)==value['bytes']<=MAX_ROW\n                     and sha(raw)==value['sha256'],'current_cache_whole_bytes')\n        return cfg,{item['agent']:item for item in docs}\n\n    def materialize(self,document,*,plugin_config,managed_profiles,runtime,source_pins,\n                    qa_pins,port,server_certificate_sha256):\n        need(not self.started,'materialization_once')\n        self.started=True\n        cfg,documents=self.validate_capsule(document)\n        need(set(document['nativeHomes'])==set(AGENTS)\n             and set(document['models'])==set(AGENTS),'all_current_model_native_inputs')\n        original_plugin=cfg['plugins']['entries']['openclaw-authbus']['config']\n        without=lambda obj:{k:v for k,v in obj.items() if k not in ('address','caFile','roleIdFile','secretIdFile')}\n        need(without(plugin_config)==without(original_plugin)\n             and original_plugin.get('hostId')=='mac' and original_plugin.get('leader') is False\n             and original_plugin.get('publishNew') is True and original_plugin.get('manageOrder') is True,\n             'complete_actual_authbus_flags_preserved')\n        need(isinstance(managed_profiles,list) and len(managed_profiles)==2\n             and len({x['profileId'] for x in managed_profiles})==2,'two_same_identity_managed_generations')\n        need(runtime['sdkRoot']==str(SDK) and runtime['codexRoot']==str(CODEX)\n             and runtime['pluginEntry']==str(ROOT/'installed-plugin-copy/index.js')\n             and isinstance(runtime['harnessOwnerPluginIds'],list)\n             and runtime['harnessOwnerPluginIds'],'fixed_installed_runtime_paths')\n        need(all(isinstance(path,str) and isinstance(pin,str) and re.fullmatch('[0-9a-f]{64}',pin)\n                 for path,pin in source_pins.items()),'fixed_installed_source_pins')\n        plans=[]\n        for phase in PHASES:\n            self.remaining();work=ROOT/phase;state=work/'state'\n            for path in (work,state,state/'agents',state/'oauth',state/'home',state/'state',\n                         work/'tmp',work/'workers',work/'inverse',work/'native-tmp',work/'workspaces'):\n                self.mkdir(path)\n            scoped=copy.deepcopy(cfg)\n            scoped['agents']['defaults']['workspace']=str(work/'workspaces/main')\n            phase_pins=dict(source_pins);native_workers={};database_records=[]\n            for item in scoped['agents']['list']:\n                agent=item['id'];directory=state/'agents'/agent/'agent'\n                for path in (state/'agents'/agent,directory,directory/'codex-home',\n                             work/'native-tmp'/agent,work/'workspaces'/agent):\n                    self.mkdir(path)\n                item['agentDir']=str(directory);item['workspace']=str(work/'workspaces'/agent)\n                database_records.append(self.auth_database(directory/'openclaw-agent.sqlite',\n                                                           documents[agent]['rows']))\n                native=document['nativeHomes'][agent]\n                for name in ('config.toml','requirements.toml'):\n                    value=native[name]\n                    if value['present']:\n                        raw=base64.b64decode(value['base64'],validate=True)\n                        need(len(raw)==value['bytes']<=MAX_ROW and sha(raw)==value['sha256'],\n                             'actual_native_config_bytes')\n                        destination=directory/'codex-home'/name\n                        self.write(destination,raw);phase_pins[str(destination)]=sha(raw)\n                need(not (directory/'codex-home/auth.json').exists(),'no_production_native_auth_copy')\n                declared=next(x for x in cfg['agents']['list'] if x['id']==agent)\n                selected=declared.get('model',cfg['agents']['defaults'].get('model'))\n                model_string=selected.get('primary') if isinstance(selected,dict) else selected\n                need(isinstance(model_string,str) and '/' in model_string,'actual_agent_model')\n                provider,model_id=model_string.split('/',1)\n                model={'provider':provider,'id':model_id,'api':cfg['models']['providers'][provider]['api']}\n                captured=document['models'][agent]\n                need(captured['provider']==provider and captured['id']==model_id\n                     and captured['sourceConfigSha256']==CONFIG_SHA\n                     and captured['declaredModelSha256']==sha(encoded(selected)+b'\\n'),'actual_per_agent_model_binding')\n                prefix=work/'workers'/('native-'+agent)\n                native_workers[agent]={\n                    'model':model,'nativeHome':str(directory/'codex-home'),\n                    'nativeTmp':str(work/'native-tmp'/agent),'workspace':str(work/'workspaces'/agent),\n                    'selectionOutput':str(prefix)+'.selection.private.json',\n                    'nativeDiagnosticOutput':str(prefix)+'.diagnostic.private.json',\n                    'nativeErrorOutput':str(prefix)+'.error.private.json',\n                    'nativeIdentityOutput':str(prefix)+'.identity.private.json',\n                    'nativeAccountOutput':str(prefix)+'.account.private.json'}\n            scoped['plugins']['entries']['openclaw-authbus']['config']=copy.deepcopy(plugin_config)\n            self.write(state/'openclaw.json',encoded(scoped))\n            self.registry_database(state/'state/openclaw.sqlite',document['registry'])\n            if document['authbusCaches']['directoryPresent']:\n                self.mkdir(state/'authbus')\n                for name,value in document['authbusCaches']['files'].items():\n                    if value['present']:self.write(state/'authbus'/name,base64.b64decode(value['base64'],validate=True))\n            sandbox=work/'consumer.sb'\n            policy=consumer_profile(phase,port,phase_pins,plugin_config['caFile'],runtime['harnessCodeRoots'])\n            self.write(sandbox,policy);phase_pins[str(sandbox)]=sha(policy)\n            common={**runtime,'workRoot':str(ROOT),'phaseRoot':str(work),'stateRoot':str(state),\n                'pluginConfig':copy.deepcopy(plugin_config),'originalPluginConfig':copy.deepcopy(original_plugin),\n                'serverCertificateSha256':server_certificate_sha256,'managedProfiles':copy.deepcopy(managed_profiles),\n                'model':native_workers['main']['model'],'sourcePins':phase_pins,\n                'originalAuthRowsDigestByAgent':{agent:digest(documents[agent]['rows']) for agent in AGENTS},\n                'originalCacheContentSha256':digest(document['authbusCaches']),\n                'baselineOutput':str(work/'baseline.private.json'),\n                'candidateOutput':str(work/'candidate.private.json'),\n                'rollbackCheckpointOutput':str(work/'candidate.private.json'),\n                'rollbackOnce':str(work/'inverse/rollback-once.private.json'),\n                'parentSandbox':str(sandbox)}\n            for mode,generation in (('consume',phase),('inverse',phase+'-inverse')):\n                plan={'schema':'heptabao.mac-five-agent-phase-plan.private.r1','generation':generation,\n                    'phase':phase,'mode':mode,'agentIds':list(AGENTS),'phaseSeconds':120,\n                    'phaseRoot':str(work),'stateRoot':str(state),\n                    'expectedVolumeDevice':self.guard.expected['expectedVolumeDevice'],\n                    'qaPins':dict(qa_pins),'workerCommon':copy.deepcopy(common),\n                    'nativeWorkers':copy.deepcopy(native_workers)}\n                binding=self.write(ROOT/'launchd'/(generation+'.private.json'),encoded(plan))\n                plans.append({'generation':generation,**binding})\n            self.phase_public.append({'phase':phase,'agents':list(AGENTS),'authOnlyDatabases':database_records,\n                'rawRowsDigests':common['originalAuthRowsDigestByAgent'],\n                'originalCacheContentSha256':common['originalCacheContentSha256'],\n                'originalConfigSha256':CONFIG_SHA,'ownedConfigSha256':sha(encoded(scoped)),\n                'perAgentModelsBoundToActualConfig':True,'inheritedEffectiveProfilesMaterialized':False,\n                'productionNativeAuthCopied':False,'nonprimaryDatabaseTablesCopied':False})\n        self.remaining();self.guard.check()\n        need(not self.close_errors and all(x['closed'] for x in self.fds)\n             and all(x['closed'] for x in self.connections),'all_materialization_descriptors_closed')\n        self.completed=True\n        return {'plans':plans,'phases':self.phase_public,'sameCapturedBaselineForBothIndependentPhases':True,\n                'crossAgentAtomicSnapshotClaimed':False}\n\n    def close(self):\n        for row in reversed(self.connections):self.close_connection(row)\n        for row in reversed(self.fds):self.close_fd(row)\n\n    def public(self):\n        return {'started':self.started,'completed':self.completed,'createdDirectoryCount':len(self.created),\n            'ownedDatabaseConnections':len(self.connections),\n            'allOwnedDescriptorsClosed':all(x['closed'] for x in self.fds)\n                and all(x['closed'] for x in self.connections),\n            'closeErrors':list(self.close_errors),'productionDatabaseOpened':False}\n","mac_current_capture_entry_wal_r1.py":"#!/usr/bin/env python3\n\"\"\"Guarded current-Mac capture entry, after successful owned synthetic admission.\n\nSource-only. The outer owner must execute this exact entry under its generated\nsandbox profile. The entry itself verifies that exact profile and demonstrates\nowned-file/sidecar write and loopback-connect refusal before any current input\nis opened. Immutable observations are not database or cross-agent snapshots.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, base64, errno, hashlib, json, math, os, signal, socket, stat, sys, time\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-df026-current-registry-wal-r1')\nQA=ROOT/'qa'\nLIVE=Path('/Users/qianqi/.openclaw')\nAGENTS=('main','trnm','hepta-ui','hepta','hepta-backend')\nCACHE_NAMES=('applied-profiles.json','publish-baseline.json','bad-refresh-quarantine.json',\n             'refresh-backoff.json','lease-epochs.json','status.json')\nNAMES=('mac_current_capture_entry_wal_r1.py','mac_guarded_current_capture_r3.py',\n       'mac_t5_volume_guard_r1.py','mac_darwin_owned_projection_r1.py',\n       'mac_native_owned_commands_r1.py','mac_native_owned_unreaped_r1.py',\n       'mac_registry_readonly_wal_r1.py')\nSYNTHETIC_SOURCE_SHA='f3c6bb336814411aa4a24490f0904cdbd0fac2bb89dbcc36d6151ada13a51ba2'\nCAPTURE_SOURCE_SHA='606b5df58909ebedc035ebbff6a4aa5e754d19c6a7e0f5e4e88c9ddfc57c2693'\nNATIVE_BINDING={\n  \"schema\": \"heptabao.mac-native-proc-input-binding.r1\",\n  \"jobId\": \"1a1aa0eabee-fc05-3c36\",\n  \"stdoutBytes\": 24032,\n  \"stdoutSha256\": \"7a1b715e595a2badf18e4f01506cca2ee7c4c0a760c5ef3c86708a435ace9c4f\",\n  \"authorityBytes\": 733,\n  \"authoritySha256\": \"411ea26371219c49547abc014464585551ba4a69b70bb906b92561a8d5bddf23\",\n  \"childStdoutBytes\": 11066,\n  \"childStdoutSha256\": \"bb5717753866c0d7e647e4fd5c18a3342db0f530016cc7d92cb508c955ff8644\",\n  \"controllerSha256\": \"4dc7cc28869ff4cd78bd4d442619e79a44d82b0ae46c5040dcd9b59e0e17921d\",\n  \"modulePins\": {\n    \"mac_darwin_owned_projection_r1.py\": \"77b63286d79827671009d56d238494c472f37e3674bf903ab2da092b42733740\",\n    \"mac_native_owned_unreaped_r1.py\": \"880794d5e0f01f45e9c559688b2ebd33c2c96399124ea3ecb9e58720a2424d0c\",\n    \"mac_native_owned_commands_r1.py\": \"717feff0a8719a6c208b14aa1598cefd59881fffa09d19c781a89689b025b9cd\"\n  },\n  \"probeProfileSha256\": {\n    \"original\": \"d31751dc8da537121b3f1ccce832a666cc6499bdef4d956ab3208dec86daf35e\",\n    \"patched\": \"58a8f52a66b0e6136b786857cb72e3f775837907bf382850320673342750c6bd\"\n  },\n  \"additionalReadOnlyDirectoryLiteral\": \"/Volumes/T5/hepta-vnext-recovery-20261013\",\n  \"additionalReadRuleSha256\": \"f591502879fc5b1f579d5d8ced77ce375b37269725c5dd3531f650e4c46676ef\"\n}\nWAL_BINDING={\n  \"schema\": \"heptabao.mac-registry-readonly-wal-input-binding.r1\",\n  \"jobId\": \"1a1aaaaa6cd-fc05-45dd\",\n  \"stdoutBytes\": 62662,\n  \"stdoutSha256\": \"7d08a18c21a5d754ea9fbe7711e6315daf8fbd80c7b5a6937756fea7ba4d1c82\",\n  \"authorityBytes\": 733,\n  \"authoritySha256\": \"b564093e2300cdc44b2ae4724e869d5b24bfe3d94d269f8ebfa977e08b07505f\",\n  \"controllerSha256\": \"88a6abdc02c71b0cb25f6b85a4494f0b44a30c2f8a4936bb511948f258737cdc\",\n  \"librarySha256\": \"60d5e5874c281af2e19fee55bc4b2242627f69b500f1af1d6b5b22e16120bfed\",\n  \"cases\": {\n    \"W01\": {\n      \"stdoutBytes\": 11923,\n      \"stdoutSha256\": \"65c7881d113e1922f47d514eeb2260d3fd5c29c26fb67f654219ff5d373a1961\"\n    },\n    \"W02\": {\n      \"stdoutBytes\": 7222,\n      \"stdoutSha256\": \"15e3a834a5b283f5d1bf229e9c927cbc93b9b75ce0cad5d7a1a9964a1fde69f6\"\n    },\n    \"W03\": {\n      \"stdoutBytes\": 8025,\n      \"stdoutSha256\": \"ec2ced80293abcb4e5bd6d28fa6155076565cd5fb8e3dddfb5425695e4689293\"\n    },\n    \"W04\": {\n      \"stdoutBytes\": 8078,\n      \"stdoutSha256\": \"0fe9136fa7e654e841b63fd377b17abe11fafef7bbb1b9ae24af4d31701be4fa\"\n    },\n    \"W05\": {\n      \"stdoutBytes\": 11300,\n      \"stdoutSha256\": \"39476829ff2ec1610894721f3f29bed8801e49833df1e0988e1e112a82111fb7\"\n    },\n    \"W06\": {\n      \"stdoutBytes\": 11300,\n      \"stdoutSha256\": \"f7c5e84d6fe464b285bec0a5418e757aa87c2d3755f6af0ef6411b53acf026bc\"\n    },\n    \"W07\": {\n      \"stdoutBytes\": 11296,\n      \"stdoutSha256\": \"aeca9311147e86b45ff3f70ff5227b1318b12aefa464fb78fa6734a41e4da62f\"\n    },\n    \"W08\": {\n      \"stdoutBytes\": 11298,\n      \"stdoutSha256\": \"d24ae166653df4c8ad209a3998afb6924d9287877321fc2046e4f125c6a36cb6\"\n    },\n    \"W09\": {\n      \"stdoutBytes\": 11049,\n      \"stdoutSha256\": \"a47c06c90261e1d8a2e1d7d1075a06ab33b577f27056ef66c28e3815c97ae9c0\"\n    },\n    \"W10\": {\n      \"stdoutBytes\": 11302,\n      \"stdoutSha256\": \"dad92e8055161be45c826bc1178a0b545250493e8d436edfe84753fa33d07a88\"\n    }\n  }\n}\nPROBE_CONTENT=b'owned capture kernel-write fence r1\\n'\nSTART=time.monotonic()\nuntil=None\nprotected=0\npending=None\nfds=[]\nsockets=[]\n\nclass Refused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise Refused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef encoded(value):return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\\n').encode()\ndef ident(s):\n    return tuple(str(v) for v in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n        s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\n@contextmanager\ndef critical():\n    global protected\n    protected+=1\n    try:yield\n    finally:protected-=1\ndef interrupted(signum,_frame):\n    global pending\n    pending=signum\n    if not protected:raise KeyboardInterrupt()\ndef remaining():\n    need(pending is None,'capture_entry_cancelled')\n    need(until is not None,'capture_entry_deadline_not_bound')\n    left=until-time.monotonic();need(left>0,'original_capture_entry_deadline');return left\n\ndef close_fd(row):\n    if row['closeAttempted']:return row['closed']\n    with critical():\n        row['closeAttempted']=True\n        try:os.close(row['fd']);row['closed']=True\n        except BaseException as error:row['closeErrorType']=type(error).__name__\n    return row['closed']\n\ndef source_bytes(path):\n    remaining();row=None\n    try:\n        with critical():\n            fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n            row={'fd':fd,'closeAttempted':False,'closed':False};fds.append(row)\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n             and stat.S_IMODE(before.st_mode)==0o600 and 0<before.st_size<=1024*1024,\n             'fixed_public_source_custody')\n        chunks=[];count=0\n        while True:\n            remaining();chunk=os.read(fd,min(65536,1024*1024+1-count))\n            if not chunk:break\n            count+=len(chunk);need(count<=1024*1024,'source_bound');chunks.append(chunk)\n        need(count==before.st_size and ident(before)==ident(os.fstat(fd))==ident(path.lstat()),\n             'source_fd_name_stable')\n        return b''.join(chunks),ident(before)\n    finally:\n        if row is not None:need(close_fd(row),'public_source_fd_close_failed')\n\ndef capture_profile(stage):\n    need(stage in ('before','after'),'fixed_capture_stage')\n    read_paths={Path('/'),Path('/Volumes'),Path('/Volumes/T5'),ROOT.parent,ROOT,QA,ROOT/'proofs',\n                ROOT/'captures',ROOT/'captures'/stage}\n    files={LIVE/'openclaw.json'}\n    for database in [LIVE/'state/openclaw.sqlite',*[\n        LIVE/'agents'/agent/'agent/openclaw-agent.sqlite' for agent in AGENTS]]:\n        for suffix in ('','-wal','-shm','-journal'):files.add(Path(str(database)+suffix))\n    files.add(LIVE/'authbus')\n    files.update(LIVE/'authbus'/name for name in CACHE_NAMES)\n    for agent in AGENTS:\n        native=LIVE/'agents'/agent/'agent/codex-home';files.add(native)\n        files.update(native/name for name in ('config.toml','requirements.toml','auth.json'))\n    for path in files:\n        read_paths.add(path);read_paths.update(path.parents)\n    q=lambda value:json.dumps(str(value))\n    lines=['(version 1)','(deny default)','(allow process*)',\n        '(allow signal (target children))','(allow sysctl-read)','(allow mach-lookup)',\n        '(allow file-read-metadata)']\n    for path in ('/System','/usr','/bin','/sbin','/Library','/private/etc','/opt/homebrew','/dev/fd'):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in (QA,ROOT/'proofs',ROOT/'captures'/stage):\n        lines.append('(allow file-read* (subpath '+q(path)+'))')\n    for path in sorted(read_paths,key=str):\n        lines.append('(allow file-read* (literal '+q(path)+'))')\n    lines.extend(['(allow file-read* (literal \"/dev/null\"))',\n        '(allow file-read* (literal \"/dev/urandom\"))',\n        '(allow file-read* (literal \"/dev/random\"))',\n        '(allow file-write* (subpath '+q(ROOT/'captures'/stage/'output')+'))',\n        '(allow file-write* (literal \"/dev/null\"))'])\n    # No network rule. The only write exception is the new capture output root.\n    return ('\\n'.join(lines)+'\\n').encode()\n\ndef admitted_synthetic(guard,binding):\n    expected={'schema','jobId','stdoutSha256','stdoutBytes','authoritySha256',\n              'authorityBytes','controllerSha256'}\n    need(isinstance(binding,dict) and set(binding)==expected\n         and binding['schema']=='heptabao.mac-capture-synthetic-input-binding.r1'\n         and isinstance(binding['jobId'],str) and 1<=len(binding['jobId'])<=128\n         and binding['controllerSha256']==SYNTHETIC_SOURCE_SHA,\n         'fixed_actual_synthetic_binding')\n    for key in ('stdoutSha256','authoritySha256'):\n        need(isinstance(binding[key],str) and len(binding[key])==64\n             and all(c in '0123456789abcdef' for c in binding[key]),'synthetic_binding_sha')\n    for key in ('stdoutBytes','authorityBytes'):\n        need(type(binding[key]) is int and 0<binding[key]<=65536,'synthetic_binding_size')\n    raw=guard.read(ROOT/'proofs/synthetic-r2.stdout.public.json',65536)\n    authority_raw=guard.read(ROOT/'proofs/synthetic-r2.authority.public.json',65536)\n    need(len(raw)==binding['stdoutBytes'] and sha(raw)==binding['stdoutSha256']\n         and len(authority_raw)==binding['authorityBytes']\n         and sha(authority_raw)==binding['authoritySha256'],'actual_original_synthetic_bytes')\n    authority=json.loads(authority_raw);proof=json.loads(raw)\n    need(isinstance(authority,dict) and authority.get('job_id')==binding['jobId']\n         and type(authority.get('exit_code')) is int and authority['exit_code']==0\n         and authority.get('state')=='succeeded'\n         and all(authority.get(k) is True for k in\n             ('output_complete','output_durable','terminal_publication_confirmed'))\n         and all(authority.get(k) is False for k in ('timed_out','cancelled','automatic_retry')),\n         'successful_authoritative_synthetic_terminal')\n    for stream,size in (('stdout',len(raw)),('stderr',0)):\n        need(authority.get('log_bytes',{}).get(stream)=={'seen':size,'stored':size}\n             and authority.get('log_errors',{}).get(stream) is None\n             and authority.get('log_synced',{}).get(stream) is True\n             and authority.get('log_truncated',{}).get(stream) is False,\n             'complete_original_synthetic_log_'+stream)\n    need(isinstance(proof,dict) and proof.get('ok') is True\n         and proof.get('outcomeUnknown') is False and proof.get('controllerGeneration')=='r2'\n         and proof.get('productionOpened') is False\n         and proof.get('originalDeadlineMetAfterClosure') is True\n         and proof.get('sameRuntimeBeforeAfter') is True\n         and type(proof.get('elapsedSeconds')) in (int,float)\n         and 0<=proof['elapsedSeconds']<45\n         and proof.get('sourcePins',{}).get('mac_capture_sqlite_synthetic_r2.py')==SYNTHETIC_SOURCE_SHA\n         and proof.get('captureSourceSha256')==CAPTURE_SOURCE_SHA,\n         'successful_complete_r2_synthetic_report')\n    cases=proof.get('cases')\n    need(isinstance(cases,list) and len(cases)==7\n         and all(isinstance(row,dict) and row.get('passed') is True for row in cases),\n         'all_seven_original_synthetic_cases')\n    held=proof.get('heldT5Final',{});owned=proof.get('ownedCommands',{})\n    need(proof.get('allOwnedDescriptorsClosed') is True\n         and held.get('allDescriptorsClosed') is True and held.get('lastAnchorCheckPassed') is True\n         and held.get('closeErrors')==[] and owned.get('allOwnedCommandsStopped') is True\n         and owned.get('unknownCommandCount')==0,'synthetic_complete_owned_closure')\n    return raw,proof\n\ndef admitted_native(guard,binding):\n    \"\"\"Admit three exact original public records; never accept a template.\"\"\"\n    need(type(binding) is dict and binding==NATIVE_BINDING,'exact_actual_native_binding')\n    originals={}\n    for role,name,size_key,sha_key in (\n        ('stdout','native-proc-r2.stdout.public.json','stdoutBytes','stdoutSha256'),\n        ('authority','native-proc-r2.authority.public.json','authorityBytes','authoritySha256'),\n        ('child','native-proc-r2.child-stdout.public.json','childStdoutBytes','childStdoutSha256')):\n        raw=guard.read(ROOT/'proofs'/name,65536)\n        need(len(raw)==binding[size_key] and sha(raw)==binding[sha_key],\n             'whole_original_native_'+role)\n        originals[role]=raw\n    authority=json.loads(originals['authority'])\n    proof=json.loads(originals['stdout']);child=json.loads(originals['child'])\n    need(type(authority) is dict and authority.get('job_id')==binding['jobId']\n         and type(authority.get('exit_code')) is int and authority['exit_code']==0\n         and authority.get('state')=='succeeded'\n         and all(authority.get(k) is True for k in\n             ('output_complete','output_durable','terminal_publication_confirmed'))\n         and all(authority.get(k) is False for k in ('timed_out','cancelled','automatic_retry')),\n         'successful_authoritative_native_terminal')\n    for stream,size in (('stdout',binding['stdoutBytes']),('stderr',0)):\n        need(authority.get('log_bytes',{}).get(stream)=={'seen':size,'stored':size}\n             and authority.get('log_errors',{}).get(stream) is None\n             and authority.get('log_synced',{}).get(stream) is True\n             and authority.get('log_truncated',{}).get(stream) is False,\n             'complete_original_native_log_'+stream)\n    need(type(proof) is dict and proof.get('schema')=='heptabao.mac-native-proc-sandbox-probe.r2'\n         and type(child) is dict and child.get('schema')=='heptabao.mac-native-proc-sandbox-child.r2',\n         'exact_public_native_report_schemas')\n    cases=proof.get('cases')\n    need(type(cases) is list and len(cases)==1 and type(cases[0]) is dict\n         and cases[0].get('variant')=='native' and type(cases[0].get('exitCode')) is int\n         and cases[0]['exitCode']==0 and cases[0].get('report')==child\n         and cases[0].get('stdoutBytes')==binding['childStdoutBytes']\n         and cases[0].get('stdoutSha256')==binding['childStdoutSha256']\n         and cases[0].get('stderrBytes')==0\n         and cases[0].get('stderrSha256')==sha(b''),'exact_original_native_child_terminal')\n    for value,count in ((proof,2),(child,1)):\n        need(value.get('ok') is True and value.get('outcomeUnknown') is False\n             and value.get('sourceSha256')==binding['controllerSha256']\n             and value.get('originalCaptureSeconds')==45\n             and value.get('originalDeadlineMetAfterClosure') is True\n             and type(value.get('elapsedSeconds')) in (int,float)\n             and math.isfinite(value['elapsedSeconds']) and 0<=value['elapsedSeconds']<45,\n             'successful_original_native_report')\n        need(all(value.get(k) is False for k in (\n            'productionReadAttempted','productionWriteAttempted','sqliteImported',\n            'consumerStarted','providerRequested','j3160Contacted','businessReplay',\n            'failedCaptureBeforePathUsed','systemUtilitiesCopiedOrChanged')),\n             'public_native_probe_scope_only')\n        held=value.get('heldT5Final',{});owned=value.get('ownedCommands',{})\n        need(value.get('allOwnedDescriptorsClosed') is True\n             and held.get('allDescriptorsClosed') is True\n             and held.get('lastAnchorCheckPassed') is True\n             and held.get('volumeUUIDVerified') is True and held.get('closeErrors')==[]\n             and owned.get('allOwnedCommandsStopped') is True and owned.get('unknownCommandCount')==0\n             and type(owned.get('commands')) is list and len(owned['commands'])==count,\n             'complete_public_native_fd_and_owned_closure')\n        for row in owned['commands']:\n            need(type(row) is dict and type(row.get('exitCode')) is int and row['exitCode']==0\n                 and row.get('completeBeforeDeadline') is True and row.get('outcomeUnknown') is False\n                 and row.get('streamsClosed') is True,'public_native_command_known_complete')\n            closed=row.get('cleanup',{})\n            need(closed.get('ok') is True and closed.get('outcomeUnknown') is False\n                 and closed.get('directChildReaped') is True\n                 and closed.get('ownedLiveGroupEmptyBeforeReap') is True\n                 and closed.get('allGroupRowsEmptyAfterReap') is True\n                 and closed.get('remainingGroupRows')==[] and closed.get('signals')==[]\n                 and closed.get('postReapSignalSent') is False,\n                 'public_native_retained_custody_terminal')\n        modules=value.get('nativeModulesBefore')\n        need(type(modules) is dict and set(modules)==set(binding['modulePins'])\n             and modules==value.get('nativeModulesAfter')\n             and all(type(modules[name]) is dict and modules[name].get('sha256')==pin\n                     for name,pin in binding['modulePins'].items()),\n             'public_native_three_module_whole_pins')\n        need(type(value.get('sourceBefore')) is dict and len(value['sourceBefore'])==4\n             and value['sourceBefore']==value.get('sourceAfter'),\n             'public_native_old_sources_unchanged')\n        need(value.get('profileSha256')==binding['probeProfileSha256']\n             and value.get('policyPermissionsAddedBeyondDevnull') is True\n             and value.get('additionalReadOnlyDirectoryLiteral')==binding['additionalReadOnlyDirectoryLiteral']\n             and value.get('additionalReadRuleSha256')==binding['additionalReadRuleSha256'],\n             'explicit_public_native_policy_delta')\n    need(type(proof.get('utilityBefore')) is dict and len(proof['utilityBefore'])==3\n         and proof['utilityBefore']==proof.get('utilityAfter'),'public_native_utilities_unchanged')\n    kernel=child.get('kernelSandboxProof',{});checks=kernel.get('checks')\n    need(kernel.get('allFourDenied') is True and type(checks) is list and len(checks)==4\n         and [row.get('case') for row in checks]==[\n             'main_write_open','sidecar_create','sidecar_create','loopback_connect']\n         and all(row.get('denied') is True and row.get('errno') in (errno.EACCES,errno.EPERM)\n                 for row in checks),'all_four_original_native_kernel_refusals')\n    projection=child.get('nativeProjection',{})\n    need(projection.get('selfQualified') is True and type(projection.get('identity')) is dict\n         and projection.get('allHostEnumerationUsed') is False\n         and projection.get('commandNamesOrPathsProjected') is False\n         and projection.get('pidListNullBufferUsed') is False\n         and projection.get('maxGroupMembers')==64 and projection.get('querySeconds')==4,\n         'public_native_bounded_projection_qualified')\n    need(child.get('nativeSelfBefore')==child.get('nativeSelfAfter')\n         and type(child.get('nativeSelfBefore')) is dict\n         and child['nativeSelfBefore'].get('pidUidPpidPgidMatchedIndependentOsApis') is True,\n         'public_native_same_self_birth_qualified')\n    guard.check()\n    return originals['stdout'],child\n\ndef admitted_wal(guard,binding):\n    \"\"\"Pin the actual public ten-case stdout and its authoritative terminal.\"\"\"\n    need(type(binding) is dict and binding==WAL_BINDING,'exact_actual_registry_wal_binding')\n    raw=guard.read(ROOT/'proofs/registry-wal-r1.stdout.public.json',262144)\n    authority_raw=guard.read(ROOT/'proofs/registry-wal-r1.authority.public.json',65536)\n    need(len(raw)==binding['stdoutBytes'] and sha(raw)==binding['stdoutSha256']\n         and len(authority_raw)==binding['authorityBytes']\n         and sha(authority_raw)==binding['authoritySha256'],'actual_original_registry_wal_bytes')\n    authority=json.loads(authority_raw);proof=json.loads(raw)\n    need(type(authority) is dict and authority.get('job_id')==binding['jobId']\n         and type(authority.get('exit_code')) is int and authority['exit_code']==0\n         and authority.get('state')=='succeeded'\n         and all(authority.get(k) is True for k in\n             ('output_complete','output_durable','terminal_publication_confirmed'))\n         and all(authority.get(k) is False for k in ('timed_out','cancelled','automatic_retry')),\n         'successful_authoritative_registry_wal_terminal')\n    for stream,size in (('stdout',len(raw)),('stderr',0)):\n        need(authority.get('log_bytes',{}).get(stream)=={'seen':size,'stored':size}\n             and authority.get('log_errors',{}).get(stream) is None\n             and authority.get('log_synced',{}).get(stream) is True\n             and authority.get('log_truncated',{}).get(stream) is False,\n             'complete_original_registry_wal_log_'+stream)\n    need(type(proof) is dict and proof.get('schema')=='heptabao.mac-owned-registry-wal-synthetic.r1'\n         and proof.get('ok') is True and proof.get('outcomeUnknown') is False\n         and proof.get('allCasesMatched') is True and proof.get('allOwnedClosed') is True\n         and proof.get('originalDeadlineAfterClosure') is True\n         and proof.get('sourceAndRuntimeAfterVerified') is True\n         and proof.get('sharedSeconds')==45 and proof.get('querySeconds')==3\n         and proof.get('supervisorSeconds')==60 and proof.get('applicationRetries')==0\n         and type(proof.get('elapsedSeconds')) in (int,float)\n         and math.isfinite(proof['elapsedSeconds']) and 0<=proof['elapsedSeconds']<45\n         and all(proof.get(k) is False for k in\n             ('productionInputsRead','privateCaptureAuthorized','wholeDatabaseBackupQualified')),\n         'successful_complete_public_registry_wal_report')\n    wanted=list(binding['cases'])\n    need(proof.get('caseIds')==wanted and type(proof.get('cases')) is list\n         and [x.get('case') for x in proof['cases']]==wanted,\n         'all_ten_exact_registry_wal_cases')\n    for row in proof['cases']:\n        item=binding['cases'][row['case']];command=row.get('command',{})\n        need(row.get('matched') is True and row.get('mainUnchangedAcrossWalCommit') is True\n             and row.get('writerClosedBeforeHeldFdClose') is True\n             and row.get('readerStdoutBytes')==item['stdoutBytes']\n             and row.get('readerStdoutSha256')==item['stdoutSha256']\n             and command.get('stdoutBytes')==item['stdoutBytes']\n             and command.get('stdoutSha256')==item['stdoutSha256']\n             and command.get('controlPipesClosed') is True,'exact_public_registry_wal_case')\n    owned=proof.get('ownedCommands',{});volume=owned.get('commands');readers=proof.get('ownedReaders')\n    need(owned.get('allOwnedCommandsStopped') is True and owned.get('unknownCommandCount')==0\n         and type(volume) is list and len(volume)==1\n         and volume[0].get('label')=='owned-wal-volume'\n         and volume[0].get('argv')==['/usr/sbin/diskutil','info','-plist','/Volumes/T5']\n         and type(readers) is list and len(readers)==10\n         and [row.get('case') for row in readers]==wanted\n         and all(row['command']==reader for row,reader in zip(proof['cases'],readers)),\n         'public_registry_wal_one_volume_and_ten_reader_set')\n    for row in [*volume,*readers]:\n        closed=row.get('cleanup',{})\n        need(type(row.get('exitCode')) is int and row['exitCode']==0\n             and row.get('completeBeforeDeadline') is True and row.get('outcomeUnknown') is False\n             and row.get('streamsClosed') is True and closed.get('ok') is True\n             and closed.get('outcomeUnknown') is False and closed.get('directChildReaped') is True\n             and closed.get('ownedLiveGroupEmptyBeforeReap') is True\n             and closed.get('allGroupRowsEmptyAfterReap') is True\n             and closed.get('remainingGroupRows')==[] and closed.get('postReapSignalSent') is False,\n             'public_registry_wal_retained_child_closure')\n    writers=proof.get('writerConnections');fds=proof.get('ownedFdLedger');held=proof.get('heldT5Final',{})\n    need(type(writers) is list and len(writers)==10\n         and all(x.get('closeAttempted') is True and x.get('closed') is True\n             and x.get('closeErrorType') is None and x.get('cursorsClosed') is True\n             and x.get('heldDescriptorsClosed') is True for x in writers)\n         and type(fds) is list and fds and all(x.get('closeAttempted') is True\n             and x.get('closed') is True for x in fds)\n         and held.get('allDescriptorsClosed') is True and held.get('lastAnchorCheckPassed') is True\n         and held.get('volumeUUIDVerified') is True and held.get('closeErrors')==[],\n         'public_registry_wal_writer_fd_volume_closure')\n    pins=proof.get('sourcePins',{})\n    need(pins.get('mac_wal_owned_synthetic_r1.py')==binding['controllerSha256']\n         and pins.get('mac_registry_readonly_wal_r1.py')==binding['librarySha256']\n         and pins.get('mac_guarded_current_capture_r3.py')==CAPTURE_SOURCE_SHA\n         and all(pins.get(name)==pin for name,pin in NATIVE_BINDING['modulePins'].items()),\n         'actual_registry_wal_source_and_native_pins')\n    guard.check()\n    return raw,proof\n\ndef library_resources_closed(value):\n    \"\"\"Returned-handle/registered-FD evidence, never SQLite internal-FD inference.\"\"\"\n    if type(value) is not dict or value.get('schema')!='heptabao.mac-registry-readonly-wal-attempt.r1':\n        return False\n    if not all(value.get(key) is True for key in (\n        'allOwnedDescriptorsClosed','allHeldDescriptorsClosed','allReturnedConnectionsClosed',\n        'allExplicitCursorsClosed','allPublicCodeDescriptorsClosed',\n        'publicCodeHashDescriptorsIndividuallyEnumerated')) or value.get('closeErrors')!=[]:\n        return False\n    for key in ('descriptors','connections','cursors','publicCodeDescriptors'):\n        rows=value.get(key)\n        if type(rows) is not list or not all(type(row) is dict\n            and row.get('closeAttempted') is True and row.get('closed') is True\n            and row.get('closeError') is None for row in rows):\n            return False\n    return True\n\ndef capture_envelope(value):\n    need(type(value) is dict and value.get('schema')=='heptabao.mac-registry-readonly-wal-attempt.r1'\n         and value.get('libraryFailureLedgerAvailable') is True\n         and value.get('originalFiveAgentRouteUnchanged') is True\n         and value.get('privateResultPublished') is False\n         and all(type(value.get(key)) is bool for key in\n             ('ok','observationComplete','observationUnknown','originalDeadlineMetAfterClosure')),\n         'typed_current_capture_library_envelope')\n    need(len(encoded(value))<=196608,'bounded_current_capture_library_envelope')\n    if value['ok']:\n        need(value['observationComplete'] and not value['observationUnknown']\n             and value['originalDeadlineMetAfterClosure'] and value.get('error') is None\n             and library_resources_closed(value),'successful_current_capture_library_envelope')\n    return value\n\ndef kernel_refusals(guard,stage):\n    directory=ROOT/'captures'/stage/'probe';main=directory/'writable-owned-main'\n    need(guard.read(main,4096)==PROBE_CONTENT,'owned_probe_exact_initial_bytes')\n    original=ident(main.lstat());rows=[]\n    for path,create in ((main,False),(Path(str(main)+'-wal'),True),(Path(str(main)+'-shm'),True)):\n        remaining();refusal=None;opened=None\n        with guard.parent(path) as (parent,name):\n            if create:\n                try:os.stat(name,dir_fd=parent,follow_symlinks=False)\n                except FileNotFoundError:pass\n                else:raise Refused('owned_probe_sidecar_preexisting')\n            try:\n                with critical():\n                    flags=os.O_WRONLY|os.O_NOFOLLOW|(os.O_CREAT|os.O_EXCL if create else os.O_APPEND)\n                    fd=os.open(name,flags,0o600,dir_fd=parent)\n                    opened={'fd':fd,'closeAttempted':False,'closed':False};fds.append(opened)\n            except OSError as error:refusal=error.errno\n            finally:\n                if opened is not None:need(close_fd(opened),'owned_probe_fd_close')\n            need(opened is None and refusal in (errno.EACCES,errno.EPERM),'kernel_owned_write_not_refused')\n            if create:\n                try:os.stat(name,dir_fd=parent,follow_symlinks=False)\n                except FileNotFoundError:pass\n                else:raise Refused('owned_probe_sidecar_created')\n        rows.append({'case':'sidecar_create' if create else 'main_write_open',\n                     'name':path.name,'denied':True,'errno':refusal})\n    need(ident(main.lstat())==original and guard.read(main,4096)==PROBE_CONTENT,\n         'owned_probe_no_file_change')\n    endpoint=('127.0.0.1',9);sock=None;refusal=None;socket_row=None\n    try:\n        with critical():\n            sock=socket.socket(socket.AF_INET,socket.SOCK_STREAM)\n            socket_row={'socket':sock,'closeAttempted':False,'closed':False};sockets.append(socket_row)\n        sock.settimeout(min(3.0,remaining()))\n        sock.connect(endpoint)\n    except OSError as error:refusal=error.errno\n    finally:\n        if socket_row is not None:\n            with critical():\n                socket_row['closeAttempted']=True\n                try:sock.close();socket_row['closed']=True\n                except BaseException as error:socket_row['closeErrorType']=type(error).__name__\n    need(refusal in (errno.EACCES,errno.EPERM),'kernel_loopback_connect_not_refused')\n    need(socket_row is None or socket_row['closed'],'owned_probe_socket_close')\n    rows.append({'case':'loopback_connect','endpoint':'127.0.0.1:9','denied':True,'errno':refusal})\n    remaining()\n    return {'allFourDenied':True,'onlyOwnedWriteProbes':True,'externalAddressAttempted':False,\n            'profileWriteScope':'fresh_capture_output_only','checks':rows}\n\ndef main():\n    global until\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--stage',choices=('before','after'),required=True)\n    parser.add_argument('--absolute-until',type=float,required=True)\n    parser.add_argument('--public-volume-anchor-base64',required=True)\n    parser.add_argument('--public-volume-anchor-sha256',required=True)\n    parser.add_argument('--source-pins-base64',required=True)\n    parser.add_argument('--source-pins-sha256',required=True)\n    parser.add_argument('--synthetic-binding-base64',required=True)\n    parser.add_argument('--synthetic-binding-sha256',required=True)\n    parser.add_argument('--native-binding-base64',required=True)\n    parser.add_argument('--native-binding-sha256',required=True)\n    parser.add_argument('--wal-binding-base64',required=True)\n    parser.add_argument('--wal-binding-sha256',required=True)\n    parser.add_argument('--sandbox-profile-sha256',required=True)\n    args=parser.parse_args();os.umask(0o077)\n    need(math.isfinite(args.absolute_until) and START<args.absolute_until<=START+45,\n         'one_original_capture_deadline')\n    until=args.absolute_until\n    for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,interrupted)\n    report={'schema':'heptabao.mac-guarded-current-capture-entry.wal-r1','stage':args.stage,\n        'ok':False,'outcomeUnknown':False,'productionReadAttempted':False,\n        'productionWriteAttempted':False,'captureLibraryReturned':False,\n        'providerRequestSent':False,'j3160Contacted':False,\n        'wholeDatabaseBackupQualified':False,'crossAgentAtomicSnapshotClaimed':False,\n        'originalCaptureSeconds':45,'captureLibraryAttempted':False,\n        'captureLibraryLedgerAvailable':False,'captureLibraryFailureLedgerAvailable':False}\n    guard=None;commands=None;cap=None;wal=None;complete=False;capsule=None;native_api=None\n    try:\n        need(sys.platform=='darwin' and os.getuid()==501,'actual_mac_capture_owner')\n        pins_raw=base64.b64decode(args.source_pins_base64,validate=True)\n        need(len(pins_raw)<=8192 and sha(pins_raw)==args.source_pins_sha256,'exact_entry_source_pins')\n        pins=json.loads(pins_raw)\n        need(isinstance(pins,dict) and set(pins)==set(NAMES)\n             and all(isinstance(v,str) and len(v)==64 and all(c in '0123456789abcdef' for c in v)\n                     for v in pins.values()) and pins['mac_guarded_current_capture_r3.py']==CAPTURE_SOURCE_SHA,\n             'fixed_public_capture_modules')\n        need(pins.get('mac_registry_readonly_wal_r1.py')==WAL_BINDING['librarySha256'],\n             'exact_qualified_registry_wal_library')\n        need(all(pins.get(name)==pin for name,pin in NATIVE_BINDING['modulePins'].items()),\n             'exact_qualified_native_capture_modules')\n        source_ids={}\n        for name,pin in pins.items():\n            raw,source_ids[name]=source_bytes(QA/name);need(sha(raw)==pin,'capture_public_source_pin')\n        sys.path.insert(0,str(QA))\n        from mac_t5_volume_guard_r1 import HeldT5\n        need(all(name[:-3] not in sys.modules for name in NATIVE_BINDING['modulePins']),\n             'new_native_capture_modules_not_preloaded')\n        from mac_darwin_owned_projection_r1 import NativeProjection\n        from mac_native_owned_unreaped_r1 import bind_projection\n        from mac_native_owned_commands_r1 import Commands\n        import mac_guarded_current_capture_r3 as capture\n        import mac_registry_readonly_wal_r1 as wal_capture\n        cap=capture;wal=wal_capture\n        class SignalState:\n            @property\n            def pending(self):return pending\n            def critical(self):return critical()\n        remaining()\n        native_api=NativeProjection(until=until)\n        report['nativeSelfBefore']=native_api.qualify_self(until=until)\n        bind_projection(native_api)\n        commands=Commands(SignalState())\n        anchor=base64.b64decode(args.public_volume_anchor_base64,validate=True)\n        guard=HeldT5(anchor,args.public_volume_anchor_sha256,remaining,critical)\n        row,out,_=commands.run('capture-t5-volume',\n            ['/usr/sbin/diskutil','info','-plist','/Volumes/T5'],\n            until=min(until,time.monotonic()+30),maximum=262144)\n        need(row['exitCode']==0 and not row['outcomeUnknown'] and row['completeBeforeDeadline'],\n             'capture_volume_probe_complete')\n        guard.accept_diskutil(out)\n        native_raw=base64.b64decode(args.native_binding_base64,validate=True)\n        need(len(native_raw)<=8192 and sha(native_raw)==args.native_binding_sha256,\n             'actual_native_public_binding')\n        _,native_proof=admitted_native(guard,json.loads(native_raw))\n        need(native_api.public()['identity']==native_proof['nativeProjection']['identity'],\n             'same_actual_native_abi_os_and_loaded_image_observations')\n        report['nativePublicProofSha256']=NATIVE_BINDING['stdoutSha256']\n        report['nativePublicAuthoritySha256']=NATIVE_BINDING['authoritySha256']\n        report['nativePublicChildSha256']=NATIVE_BINDING['childStdoutSha256']\n        report['actualNativeRuntimeCompatible']=True\n        remaining()\n        binding_raw=base64.b64decode(args.synthetic_binding_base64,validate=True)\n        need(len(binding_raw)<=8192 and sha(binding_raw)==args.synthetic_binding_sha256,\n             'actual_synthetic_public_binding')\n        proof,proof_value=admitted_synthetic(guard,json.loads(binding_raw))\n        wal_binding_raw=base64.b64decode(args.wal_binding_base64,validate=True)\n        need(len(wal_binding_raw)<=8192 and sha(wal_binding_raw)==args.wal_binding_sha256,\n             'actual_registry_wal_public_binding')\n        wal_proof,wal_proof_value=admitted_wal(guard,json.loads(wal_binding_raw))\n        need(wal_proof_value.get('runtime',{}).get('runtime')==proof_value['runtime'],\n             'same_original_immutable_and_registry_wal_runtime')\n        report['walSyntheticProofSha256']=WAL_BINDING['stdoutSha256']\n        report['walSyntheticAuthoritySha256']=WAL_BINDING['authoritySha256']\n        # Both original immutable predicates and the WAL runtime/source gate\n        # execute with tracked public-code descriptors inside the one library\n        # attempt, before it opens any current config or database.\n        profile=guard.read(ROOT/'captures'/args.stage/'capture.sb',65536)\n        need(profile==capture_profile(args.stage) and sha(profile)==args.sandbox_profile_sha256,\n             'exact_reviewed_capture_sandbox')\n        report['kernelSandboxProof']=kernel_refusals(guard,args.stage)\n        remaining();guard.check()\n        report['productionReadAttempted']=True\n        report['captureLibraryAttempted']=True\n        document,observation=wal.capture_current_with_wal(\n            critical=critical,cancelled=lambda:pending is not None,\n            synthetic_proof=proof,synthetic_proof_sha=sha(proof),\n            wal_proof=wal_proof,wal_proof_sha=sha(wal_proof),until=until)\n        report['captureLibraryReturned']=True\n        report['observation']=capture_envelope(observation)\n        report['captureLibraryLedgerAvailable']=True\n        report['runtime']=document['runtime']\n        need(document.get('walSyntheticProofSha256')==WAL_BINDING['stdoutSha256'],\n             'private_capsule_actual_wal_proof_binding')\n        report['syntheticProofSha256']=sha(proof)\n        need(document['runtime']==proof_value['runtime'],'same_actual_capture_runtime')\n        remaining()\n        capsule_raw=capture.encoded(document)\n        need(len(capsule_raw)<=4*1024*1024,'private_capsule_bound')\n        output=ROOT/'captures'/args.stage/'output/capsule.private.json'\n        capsule=guard.write_new(output,capsule_raw)\n        report['capsule']={'path':str(output),**capsule}\n        for name,pin in pins.items():\n            raw,observed=source_bytes(QA/name)\n            need(sha(raw)==pin and observed==source_ids[name],'capture_sources_after')\n        report['nativeSelfAfter']=native_api.qualify_self(until=until)\n        before_self=report['nativeSelfBefore']['first'];after_self=report['nativeSelfAfter']['last']\n        need(all(before_self[key]==after_self[key] for key in\n             ('pid','ppid','pgid','uid','birthSeconds','birthMicroseconds')),\n             'same_current_capture_native_self_birth')\n        guard.check();remaining();complete=True\n    except BaseException as error:\n        if wal is not None and isinstance(error,wal.CaptureAttemptFailure):\n            try:\n                report['observation']=capture_envelope(error.public)\n                report['captureLibraryLedgerAvailable']=True\n                report['captureLibraryFailureLedgerAvailable']=True\n            except BaseException:\n                report['captureLibraryLedgerAvailable']=False\n                report['captureLibraryFailureLedgerAvailable']=False\n        report['errorType']=type(error).__name__\n        report['errorCode']=str(error) if isinstance(error,Refused) or (\n            cap is not None and isinstance(error,cap.CaptureRefused)) else None\n        observation=report.get('observation',{})\n        report['outcomeUnknown']=bool(\n            (report['captureLibraryAttempted'] and\n             (not report['captureLibraryLedgerAvailable']\n              or observation.get('observationUnknown') is not False\n              or not library_resources_closed(observation)))\n            or isinstance(error,KeyboardInterrupt))\n    finally:\n        for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,signal.SIG_IGN)\n        for row in reversed(fds):close_fd(row)\n        for row in reversed(sockets):\n            if not row['closeAttempted']:\n                with critical():\n                    row['closeAttempted']=True\n                    try:row['socket'].close();row['closed']=True\n                    except BaseException as error:row['closeErrorType']=type(error).__name__\n        if commands is not None:report['ownedCommands']=commands.public()\n        if native_api is not None:report['nativeProjection']=native_api.public()\n        if guard is not None:\n            guard.close();report['heldT5Final']=guard.public_state()\n        closed=(all(row['closed'] for row in fds) and all(row['closed'] for row in sockets)\n            and guard is not None and report['heldT5Final']['allDescriptorsClosed']\n            and report['heldT5Final']['lastAnchorCheckPassed']\n            and report['heldT5Final']['closeErrors']==[])\n        stopped=(commands is not None and report['ownedCommands']['allOwnedCommandsStopped']\n                 and report['ownedCommands']['unknownCommandCount']==0)\n        library_closed=(not report['captureLibraryAttempted'] or\n            (report['captureLibraryLedgerAvailable'] and library_resources_closed(report.get('observation'))))\n        report['entryOwnedDescriptorsClosed']=closed\n        report['allCaptureLibraryResourcesClosed']=library_closed\n        report['allOwnedDescriptorsClosed']=bool(closed and library_closed)\n        report['outcomeUnknown']=bool(report['outcomeUnknown'] or not closed or not library_closed\n                                     or not stopped or pending is not None)\n        done=time.monotonic()\n        report['elapsedSeconds']=done-START\n        report['originalAbsoluteDeadlineMonotonic']=until\n        report['originalDeadlineMetAfterPrivatePublicationAndClosure']=done<until\n        report['ok']=bool(complete and capsule is not None and closed and library_closed and stopped\n                          and not report['outcomeUnknown'] and done<until)\n        report['authoritativeExitZeroAndOriginalDeadlineRequired']=True\n        raw=encoded(report);need(len(raw)<=262144,'public_capture_report_bound')\n        sys.stdout.buffer.write(raw);sys.stdout.buffer.flush()\n    return 0 if report['ok'] and time.monotonic()<until else 1\n\nif __name__=='__main__':sys.exit(main())\n","mac_owned_launchd_r3.py":"#!/usr/bin/env python3\n\"\"\"Finite owned launchd control for the isolated five-agent Mac candidate.\n\nLibrary only, source-only. Launchd owns wrappers; wrappers own their actual\nPopen children. This manager never claims those children are its direct children\nand never sends a signal to a numeric PID or process group. Unknown state stops\nthe operation graph. Failed cleanup cannot become a successful generation.\n\"\"\"\nfrom __future__ import annotations\nimport base64, hashlib, json, os, plistlib, re, stat, time\nfrom pathlib import Path\nfrom mac_native_process_observer_r1 import ProcessReader\n\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-df026-current-registry-wal-r1')\nQA=ROOT/'qa'\nDOMAIN='gui/501'\nLABELS={'server':'org.heptabao.qa.mac-authbus-df026-wal-r1.server',\n        'consumer':'org.heptabao.qa.mac-authbus-df026-wal-r1.consumer'}\nSERVER=Path('/Volumes/T5/hepta-vnext-recovery-20261013/continuation-20261105-cold-h2-normal-r1/normal-release-tests-r1/artifacts/heptabao-server')\nSERVER_SHA='ef8ec2e21c8c610e34489695a6c0efa126d39dfda5eddbd36db01870d1d4a1f0'\nGRAPH=(('server-start','server-initial'),('phase','initial'),\n       ('server-kill','server-initial'),('server-start','server-cold-new-process'),\n       ('phase','cold-new-process'),('server-kill','server-cold-new-process'),\n       ('phase','initial-inverse'),('phase','cold-new-process-inverse'))\nAGENTS=('main','trnm','hepta-ui','hepta','hepta-backend')\nNEW_MANAGER_SECONDS=600.0\nNEW_CLEANUP_SECONDS=60.0\nNEW_WRAPPER_READY_SECONDS=30.0\nNEW_EXEC_OBSERVATION_SECONDS=10.0\nNEW_FAILURE_TERM_GRACE_SECONDS=20.0\nMAX_COMMANDS=4096\nNEW_MANAGER_POLL_SECONDS=0.25\nQUERY_SECONDS=10.0\nPS_SECONDS=4.0\n\nclass ManagerRefused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise ManagerRefused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef encoded(value):return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\\n').encode()\ndef file_identity(s):\n    return tuple(str(x) for x in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n        s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\n\ndef parse_print(raw,target):\n    need(isinstance(raw,bytes) and len(raw)<=262144,'bounded_launchctl_print')\n    lines=raw.decode('utf-8','strict').splitlines()\n    need(1<=len(lines)<=4096 and lines[0].strip()==target+' = {','exact_launchctl_target')\n    fields={};arguments=[];depth=1;in_arguments=False;arguments_seen=False\n    allowed=('path','program','pid','state','runs','last exit code','last terminating signal')\n    for line in lines[1:]:\n        text=line.strip()\n        if in_arguments:\n            if text=='}':\n                in_arguments=False;depth-=1;continue\n            need(depth==2 and text and '{' not in text and '}' not in text\n                 and len(text)<=16384,'plain_fixed_launchctl_argument')\n            arguments.append(text)\n            need(len(arguments)<=32,'bounded_launchctl_arguments')\n            continue\n        if depth==1 and text=='arguments = {':\n            need(not arguments_seen,'one_launchctl_arguments_block')\n            arguments_seen=True;in_arguments=True;depth+=1;continue\n        if depth==1 and ' = ' in text and not text.endswith('{'):\n            name,value=text.split(' = ',1)\n            if name in allowed:\n                need(name not in fields,'unique_launchctl_field');fields[name]=value\n        depth+=text.count('{')-text.count('}')\n        need(depth>=0,'balanced_launchctl_print')\n        if depth==0:\n            need(text=='}' and line==lines[-1],'one_complete_launchctl_record')\n    need(depth==0 and not in_arguments and arguments_seen,'complete_launchctl_arguments')\n    for name in ('pid','runs','last exit code'):\n        if name in fields:\n            need(re.fullmatch(r'-?[0-9]{1,10}',fields[name]) is not None,'typed_launchctl_integer')\n            fields[name]=int(fields[name])\n    need('pid' not in fields or fields['pid']>1,'actual_launchctl_pid')\n    fields['arguments']=arguments\n    return fields\n\ndef missing_service(code,out,err,label):\n    if code not in (3,113) or out:return False\n    try:lines=err.decode('utf-8','strict').splitlines()\n    except UnicodeError:return False\n    exact='Could not find service \"'+label+'\" in domain for user gui: 501'\n    return lines in ([exact],['Bad request.',exact])\n\nclass OwnedLaunchd:\n    def __init__(self,*,guard,commands,signals,until,anchor_raw,anchor_sha256,qa_pins,python_runtime):\n        now=time.monotonic()\n        need(now<until<=now+NEW_MANAGER_SECONDS,'one_new_manager_deadline')\n        need(guard.uuid_verified and not guard.closed,'held_t5_before_manager')\n        need(isinstance(anchor_raw,bytes) and sha(anchor_raw)==anchor_sha256,'exact_public_anchor')\n        need(isinstance(qa_pins,dict) and all(isinstance(k,str) and isinstance(v,str)\n             and re.fullmatch(r'[0-9a-f]{64}',v) for k,v in qa_pins.items()),'typed_qa_pins')\n        self.guard=guard;self.commands=commands;self.signals=signals;self.until=until\n        self.started=now;self.anchor_raw=anchor_raw;self.anchor_sha=anchor_sha256\n        self.qa_pins=dict(qa_pins);self.reader=ProcessReader()\n        self.entries=[];self.graph_index=0;self.events=[];self.unknown=False\n        self.failure_cleanup_attempted=False;self.cleanup_until=None\n        self.command_count=0;self.finished=False;self.fd_rows=[]\n        self._remaining()\n        from mac_guarded_current_capture_r3 import public_code_pin\n        actual_python=public_code_pin('/opt/homebrew/bin/python3',remaining=self._remaining,\n                                      critical=self.signals.critical)\n        need(actual_python==python_runtime,'same_actual_synthetic_python_for_wrappers')\n        self.python_runtime=dict(actual_python)\n        for kind in ('server','consumer'):\n            need(self._query(LABELS[kind],None) is None,'owned_label_initially_absent')\n\n    def _remaining(self,until=None,*,cleanup=False):\n        if not cleanup:need(self.signals.pending is None,'manager_cancelled')\n        bound=self.cleanup_until if cleanup else self.until\n        need(bound is not None,'cleanup_deadline_exists')\n        if until is not None:bound=min(bound,until)\n        left=bound-time.monotonic();need(left>0,'original_manager_or_cleanup_deadline')\n        return left\n\n    def _call(self,label,argv,*,until=None,cleanup=False,ps=False):\n        self._remaining(until,cleanup=cleanup)\n        need(self.command_count<MAX_COMMANDS,'finite_manager_command_count')\n        self.command_count+=1\n        limit=PS_SECONDS if ps else QUERY_SECONDS\n        bound=min(self.cleanup_until if cleanup else self.until,time.monotonic()+limit)\n        if until is not None:bound=min(bound,until)\n        row,out,err=self.commands.run(label,argv,until=bound,\n                                      allow_cancelled_cleanup=cleanup,maximum=262144)\n        if row['outcomeUnknown'] or not row['completeBeforeDeadline']:\n            self.unknown=True\n            raise ManagerRefused('owned_manager_command_unknown')\n        self._remaining(until,cleanup=cleanup)\n        return row,out,err\n\n    def _query(self,label,entry,*,until=None,cleanup=False):\n        need(label in LABELS.values(),'only_two_owned_labels')\n        target=DOMAIN+'/'+label\n        row,out,err=self._call('launchd-print',['/bin/launchctl','print',target],\n                              until=until,cleanup=cleanup)\n        if missing_service(row['exitCode'],out,err,label):return None\n        need(row['exitCode']==0 and not err,'known_launchctl_query')\n        value=parse_print(out,target)\n        if entry is not None:\n            need(value.get('path')==str(entry['plist'])\n                 and value.get('program')==entry['arguments'][0]\n                 and value['arguments']==entry['arguments'],'exact_registered_generation')\n            need(value.get('runs') in (0,1),'one_launchd_run_only')\n        return value\n\n    def _record(self,kind,generation,detail):\n        self._remaining()\n        value={'schema':'heptabao.mac-owned-launchd-event.r3','index':len(self.events),\n               'kind':kind,'generation':generation,'detail':detail}\n        path=ROOT/'launchd'/('%03d-%s-%s.public.json'%(len(self.events),generation,kind))\n        binding=self.guard.write_new(path,encoded(value))\n        self.events.append({'kind':kind,'generation':generation,'path':str(path),**binding})\n\n    def _expect_action(self,kind,generation):\n        self._remaining()\n        need(not self.finished and self.graph_index<len(GRAPH)\n             and GRAPH[self.graph_index]==(kind,generation),'finite_launchd_operation_graph')\n        need(not self.unknown,'no_business_after_unknown')\n\n    def _advance(self):\n        self._remaining();self.graph_index+=1\n\n    def _plan(self,generation):\n        path=ROOT/'launchd'/(generation+'.private.json')\n        named_before=file_identity(path.lstat())\n        raw=self.guard.read(path)\n        need(named_before==file_identity(path.lstat()),'plan_identity_around_whole_read')\n        value=json.loads(raw)\n        need(isinstance(value,dict) and value.get('generation')==generation,'fixed_generation_plan')\n        return path,raw,value\n\n    def _args(self,kind,path,plan_sha):\n        common=['--plan',str(path),'--plan-sha256',plan_sha,\n            '--public-volume-anchor-base64',base64.b64encode(self.anchor_raw).decode('ascii'),\n            '--public-volume-anchor-sha256',self.anchor_sha]\n        if kind=='consumer':\n            wrapper=QA/'mac_current_phase_owner_r2.py'\n            common+=['--volume-guard-source-sha256',self.qa_pins['mac_t5_volume_guard_r1.py']]\n        else:\n            wrapper=QA/'mac_current_server_owner_r1.py'\n            names=('mac_owned_unreaped_r1.py','mac_owned_commands_r1.py',\n                   'mac_t5_volume_guard_r1.py','mac_native_process_observer_r1.py')\n            raw=encoded({n:self.qa_pins[n] for n in names})\n            common+=['--public-source-pins-base64',base64.b64encode(raw).decode('ascii'),\n                     '--public-source-pins-sha256',sha(raw)]\n        need(sha(self.guard.read(wrapper,1024*1024))==self.qa_pins[wrapper.name],\n             'exact_wrapper_before_registration')\n        return ['/opt/homebrew/bin/python3','-I','-S','-B',str(wrapper),*common]\n\n    def _new_entry(self,kind,generation):\n        label=LABELS[kind]\n        need(not any(e['label']==label and not e['registrationClosed'] for e in self.entries),\n             'previous_owned_registration_closed')\n        need(self._query(label,None) is None,'label_absent_before_new_generation')\n        path,raw,plan=self._plan(generation)\n        argv=self._args(kind,path,sha(raw))\n        stdout=ROOT/'launchd'/(generation+'.stdout.private')\n        stderr=ROOT/'launchd'/(generation+'.stderr.private')\n        plist=ROOT/'launchd'/(generation+'.plist')\n        expected={'Label':label,'ProgramArguments':argv,'RunAtLoad':True,'KeepAlive':False,\n            'AbandonProcessGroup':False,'ProcessType':'Background','ExitTimeOut':10,'Umask':0o077,\n            'WorkingDirectory':str(ROOT),'StandardOutPath':str(stdout),\n            'StandardErrorPath':str(stderr),\n            'EnvironmentVariables':{'PATH':'/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin',\n                                    'LANG':'C','LC_ALL':'C'}}\n        self.guard.write_new(plist,plistlib.dumps(expected,fmt=plistlib.FMT_XML,sort_keys=True))\n        named_before=file_identity(plist.lstat())\n        actual=self.guard.read(plist)\n        need(named_before==file_identity(plist.lstat()),'plist_identity_around_whole_read')\n        need(plistlib.loads(actual)==expected,'exact_owned_plist_no_keepalive')\n        # Precreate both append targets with exact private modes before launchd.\n        self.guard.write_new(stdout,b'');self.guard.write_new(stderr,b'')\n        # Mode, symlink, owner and stable whole-read checks are enforced by HeldT5.\n        entry={'kind':kind,'generation':generation,'label':label,'target':DOMAIN+'/'+label,\n            'plan':path,'planSha256':sha(raw),'plist':plist,'plistSha256':sha(actual),\n            'arguments':argv,'stdout':stdout,'stderr':stderr,'wrapperIdentity':None,\n            'execIdentity':None,'groups':set(),'registrationClosed':False,\n            'lineagesClosed':False,'completeKnownSuccess':False,'attempts':{},\n            'planIdentity':file_identity(path.lstat()),'plistIdentity':file_identity(plist.lstat())}\n        cleanup_plan={'schema':'heptabao.mac-owned-launchd-cleanup-intent.r3',\n            'generation':generation,'label':label,'target':entry['target'],\n            'termArgv':['/bin/launchctl','kill','SIGTERM',entry['target']],\n            'killArgv':['/bin/launchctl','kill','SIGKILL',entry['target']],\n            'bootoutArgv':['/bin/launchctl','bootout',entry['target']],\n            'newCleanupSeconds':NEW_CLEANUP_SECONDS,'noNumericPidOrGroupSignals':True}\n        self.guard.write_new(ROOT/'launchd'/(generation+'.cleanup-intent.public.json'),\n                             encoded(cleanup_plan))\n        self._record('bootstrap-intent',generation,{'planSha256':entry['planSha256'],\n            'plistSha256':entry['plistSha256'],'argv':['/bin/launchctl','bootstrap',DOMAIN,str(plist)]})\n        self.entries.append(entry)\n        return entry\n\n    def _dispatch_once(self,entry,operation,argv,*,until=None,cleanup=False):\n        need(operation in ('bootstrap','term','kill','bootout'),'fixed_manager_operation')\n        expected={'bootstrap':['/bin/launchctl','bootstrap',DOMAIN,str(entry['plist'])],\n            'term':['/bin/launchctl','kill','SIGTERM',entry['target']],\n            'kill':['/bin/launchctl','kill','SIGKILL',entry['target']],\n            'bootout':['/bin/launchctl','bootout',entry['target']]}[operation]\n        need(argv==expected and operation not in entry['attempts'],'once_exact_manager_dispatch')\n        with self.signals.critical():\n            self._remaining(until,cleanup=cleanup)\n            entry['attempts'][operation]={'attempted':True,'complete':False}\n        try:\n            row,out,err=self._call('launchd-'+operation,argv,until=until,cleanup=cleanup)\n            entry['attempts'][operation].update(complete=True,exitCode=row['exitCode'],\n                stdoutSha256=sha(out),stderrSha256=sha(err),command=row)\n            need(row['exitCode']==0,'known_launchctl_mutation_success')\n            return row\n        except BaseException:\n            self.unknown=True\n            raise\n\n    def _ready(self,entry):\n        until=min(self.until,time.monotonic()+NEW_WRAPPER_READY_SECONDS)\n        path=ROOT/'launchd'/(entry['generation']+'.ready.public.json')\n        while True:\n            self._remaining(until)\n            state=self._query(entry['label'],entry,until=until)\n            need(state is not None,'registration_present_while_waiting_ready')\n            try:raw=self.guard.read(path)\n            except FileNotFoundError:\n                need(state.get('pid') is not None or state.get('runs')==0,'wrapper_did_not_exit_before_ready')\n                time.sleep(min(NEW_MANAGER_POLL_SECONDS,self._remaining(until)));continue\n            ready=json.loads(raw)\n            expected_schema=('heptabao.mac-phase-wrapper-ready.r1' if entry['kind']=='consumer'\n                             else 'heptabao.mac-server-wrapper-ready.r1')\n            need(isinstance(ready,dict) and ready.get('schema')==expected_schema\n                 and ready.get('generation')==entry['generation']\n                 and ready.get('planSha256')==entry['planSha256'],'typed_wrapper_ready')\n            identity=ready.get('wrapperIdentity')\n            need(isinstance(identity,dict) and type(identity.get('pid')) is int\n                 and state.get('pid')==identity['pid'] and state.get('runs')==1,\n                 'launchd_actual_wrapper_pid')\n            observed=self.reader.read(identity['pid'])\n            need(observed==identity and observed['uid']==501\n                 and observed['pid']==observed['pgid']\n                 and observed['executable']==self.python_runtime['path'],\n                 'actual_wrapper_birth_executable')\n            entry['wrapperIdentity']=identity;entry['groups'].add(identity['pgid'])\n            entry['readySha256']=sha(raw)\n            admission={'schema':'heptabao.mac-owned-manager-admission.r1',\n                'generation':entry['generation'],'planSha256':entry['planSha256'],\n                'wrapperIdentity':identity}\n            self.guard.write_new(ROOT/'launchd'/(entry['generation']+'.admitted.private.json'),\n                                 encoded(admission))\n            self._record('actual-wrapper-admitted',entry['generation'],\n                         {'wrapperIdentity':identity,'readySha256':sha(raw)})\n            return\n\n    def _rows(self,groups,*,until=None,cleanup=False):\n        row,out,err=self._call('owned-launchd-group-observation',\n            ['/bin/ps','-axo','pid=,ppid=,pgid=,uid=,stat='],until=until,cleanup=cleanup,ps=True)\n        need(row['exitCode']==0 and not err,'complete_group_observation')\n        values=[]\n        for line in out.decode('ascii','strict').splitlines():\n            fields=line.split()\n            need(len(fields)==5 and all(x.isdecimal() for x in fields[:4]),'typed_process_row')\n            pid,ppid,pgid,uid=map(int,fields[:4])\n            if pgid in groups:values.append({'pid':pid,'ppid':ppid,'pgid':pgid,'uid':uid,'state':fields[4]})\n        return values\n\n    def _check_registration_files(self,entry):\n        # Read-only metadata used in cleanup also: no expired private read,\n        # no mutation, and no new business budget is granted.\n        self.guard.check(check_deadline=False)\n        need(file_identity(entry['plan'].lstat())==entry['planIdentity']\n             and file_identity(entry['plist'].lstat())==entry['plistIdentity'],\n             'registration_input_identity_unchanged')\n\n    def _bootout(self,entry,*,cleanup=False,until=None):\n        self._check_registration_files(entry)\n        state=self._query(entry['label'],entry,until=until,cleanup=cleanup)\n        if state is None:\n            need('bootout' in entry['attempts'],'no_unexplained_registration_disappearance')\n        elif 'bootout' not in entry['attempts']:\n            if not cleanup:\n                need(state.get('pid') is None,'known_wrapper_exit_before_bootout')\n                self._record('bootout-intent',entry['generation'],{'argv':['/bin/launchctl','bootout',entry['target']]})\n            self._dispatch_once(entry,'bootout',['/bin/launchctl','bootout',entry['target']],\n                                until=until,cleanup=cleanup)\n        while self._query(entry['label'],entry,until=until,cleanup=cleanup) is not None:\n            self._remaining(until,cleanup=cleanup)\n            time.sleep(min(NEW_MANAGER_POLL_SECONDS,self._remaining(until,cleanup=cleanup)))\n        remaining=self._rows(entry['groups'],until=until,cleanup=cleanup)\n        entry['remainingGroupRows']=remaining\n        need(not remaining,'owned_group_empty_after_label_removal')\n        entry['registrationClosed']=True\n        if not cleanup:self._record('bootout-complete',entry['generation'],{'groupRows':remaining})\n\n    def _server_stdout_prefix(self,entry):\n        \"\"\"Bind the completed wrapper record while the server may append logs.\n\n        This proves only the first LF-terminated record, read twice through one\n        held descriptor. It does not claim a whole stable live server log.\n        \"\"\"\n        self._remaining()\n        with self.guard.parent(entry['stdout']) as (parent,name):\n            with self.signals.critical():\n                fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent)\n                row={'fd':fd,'closeAttempted':False,'closed':False}\n                self.fd_rows.append(row)\n            try:\n                first=os.fstat(fd)\n                need(stat.S_ISREG(first.st_mode) and first.st_uid==501\n                     and first.st_nlink==1 and stat.S_IMODE(first.st_mode)==0o600\n                     and 0<first.st_size<=2*1024*1024,'server_stdout_private_bound')\n                block=os.pread(fd,min(65536,first.st_size),0)\n                position=block.find(b'\\n')\n                need(position>=0,'complete_wrapper_prefix')\n                raw=block[:position+1]\n                self._remaining()\n                need(os.pread(fd,len(raw),0)==raw,'wrapper_prefix_same_fd_exact')\n                after=os.fstat(fd);named=os.stat(name,dir_fd=parent,follow_symlinks=False)\n                need(file_identity(first)[:6]==file_identity(after)[:6]==file_identity(named)[:6]\n                     and first.st_size<=after.st_size<=2*1024*1024\n                     and named.st_size>=len(raw),'server_stdout_name_and_prefix_fence')\n                self.guard.check()\n                return raw\n            finally:\n                with self.signals.critical():\n                    row['closeAttempted']=True\n                    os.close(fd);row['closed']=True\n\n    def start_server(self,generation):\n        self._expect_action('server-start',generation)\n        entry=self._new_entry('server',generation)\n        try:\n            self._dispatch_once(entry,'bootstrap',['/bin/launchctl','bootstrap',DOMAIN,str(entry['plist'])])\n            self._ready(entry)\n            until=min(self.until,time.monotonic()+NEW_EXEC_OBSERVATION_SECONDS)\n            original=entry['wrapperIdentity']\n            while True:\n                self._remaining(until)\n                state=self._query(entry['label'],entry,until=until)\n                need(state is not None and state.get('pid')==original['pid']\n                     and state.get('runs')==1,'same_launchd_pid_before_server_exec')\n                observed=self.reader.read(original['pid'])\n                need(all(observed[k]==original[k] for k in\n                     ('pid','ppid','pgid','uid','birthSec','birthUsec')),'server_exec_same_birth')\n                if observed['executable']==str(SERVER.resolve()):break\n                need(observed['executable']==original['executable'],'no_foreign_executable')\n                time.sleep(min(NEW_MANAGER_POLL_SECONDS,self._remaining(until)))\n            raw=self.guard.read(ROOT/'launchd'/(generation+'.exec-ready.public.json'))\n            candidate=json.loads(raw)\n            stdout=self._server_stdout_prefix(entry)\n            terminal=json.loads(stdout)\n            need(isinstance(candidate,dict) and isinstance(terminal,dict)\n                 and candidate.get('schema')=='heptabao.mac-owned-launchd-server-wrapper.r1'\n                 and terminal.get('schema')==candidate['schema']\n                 and terminal.get('generation')==generation\n                 and terminal.get('ok') is True and terminal.get('readyToExec') is True\n                 and terminal.get('outcomeUnknown') is False\n                 and terminal.get('candidateReceiptSha256')==sha(raw)\n                 and terminal.get('wrapperIdentity')==original\n                 and terminal.get('binaryPath')==str(SERVER) and terminal.get('binarySha256')==SERVER_SHA\n                 and terminal.get('elapsedSeconds',31)<30,'server_wrapper_completion_before_exec')\n            closure=terminal.get('volumeGuardClosed',{});commands=terminal.get('commands',{})\n            need(closure.get('allDescriptorsClosed') is True\n                 and closure.get('lastAnchorCheckPassed') is True and closure.get('closeErrors')==[]\n                 and commands.get('allOwnedCommandsStopped') is True\n                 and commands.get('unknownCommandCount')==0,'server_wrapper_closure')\n            entry['execIdentity']=observed\n            entry['serverWrapperClosed']=True\n            entry['execReceiptSha256']=sha(raw)\n            entry['wrapperTerminalPrefixSha256']=sha(stdout)\n            self._record('actual-server-exec',generation,{'identity':observed,\n                'binarySha256':SERVER_SHA,'execReceiptSha256':sha(raw)})\n            self._advance()\n            return {'generation':generation,'serverIdentity':observed,'execReceiptSha256':sha(raw)}\n        except BaseException:\n            self.unknown=True\n            raise\n\n    def kill_server_for_cold_or_inverse(self,generation):\n        self._expect_action('server-kill',generation)\n        entry=next((e for e in self.entries if e['generation']==generation),None)\n        need(entry is not None and entry['execIdentity'] is not None,'actual_server_before_kill')\n        state=self._query(entry['label'],entry)\n        need(state is not None and state.get('pid')==entry['execIdentity']['pid']\n             and self.reader.read(state['pid'])==entry['execIdentity'],'exact_server_before_sigkill')\n        self._record('server-sigkill-intent',generation,{'argv':['/bin/launchctl','kill','SIGKILL',entry['target']]})\n        self._dispatch_once(entry,'kill',['/bin/launchctl','kill','SIGKILL',entry['target']])\n        until=min(self.until,time.monotonic()+QUERY_SECONDS)\n        while True:\n            state=self._query(entry['label'],entry,until=until)\n            need(state is not None and state.get('runs')==1,'same_registration_after_sigkill')\n            if state.get('pid') is None:break\n            need(state['pid']==entry['execIdentity']['pid'],'no_server_restart')\n            time.sleep(min(NEW_MANAGER_POLL_SECONDS,self._remaining(until)))\n        need(state.get('last terminating signal') in ('9','SIGKILL','Killed: 9','9 (Killed: 9)'),\n             'actual_launchd_sigkill_terminal')\n        need(not self._rows(entry['groups'],until=until),'server_group_empty_after_sigkill')\n        entry['lineagesClosed']=entry.get('serverWrapperClosed') is True\n        entry['completeKnownSuccess']=True\n        self._bootout(entry,until=until)\n        self._record('server-sigkill-complete',generation,\n                     {'actualSignal':'SIGKILL','samePid':entry['execIdentity']['pid'],'groupRows':[]})\n        self._advance()\n\n    def run_phase(self,generation):\n        self._expect_action('phase',generation)\n        entry=self._new_entry('consumer',generation)\n        try:\n            self._dispatch_once(entry,'bootstrap',['/bin/launchctl','bootstrap',DOMAIN,str(entry['plist'])])\n            self._ready(entry)\n            while True:\n                state=self._query(entry['label'],entry)\n                need(state is not None and state.get('runs')==1,'same_phase_registration')\n                if state.get('pid') is None:break\n                need(state['pid']==entry['wrapperIdentity']['pid']\n                     and self.reader.read(state['pid'])==entry['wrapperIdentity'],'same_phase_process')\n                time.sleep(min(NEW_MANAGER_POLL_SECONDS,self._remaining()))\n            need(state.get('last exit code')==0,'actual_launchd_phase_exit_zero')\n            raw=self.guard.read(ROOT/'launchd'/(generation+'.result.public.json'))\n            result=json.loads(raw)\n            stdout=self.guard.read(entry['stdout'])\n            need(len(stdout.splitlines())==1,'one_final_phase_stdout_record')\n            terminal=json.loads(stdout)\n            need(isinstance(result,dict) and isinstance(terminal,dict)\n                 and result.get('schema')=='heptabao.mac-five-agent-phase-owner.r2'\n                 and result.get('generation')==generation and result.get('ok') is True\n                 and result.get('outcomeUnknown') is False\n                 and result.get('allOwnedStopped') is True\n                 and result.get('allObserverClosuresAttemptedOnce') is True\n                 and result.get('originalSharedPhaseSeconds')==120\n                 and terminal.get('generation')==generation and terminal.get('ok') is True\n                 and terminal.get('outcomeUnknown') is False\n                 and terminal.get('allOwnedStopped') is True and terminal.get('resultSha256')==sha(raw)\n                 and type(terminal.get('elapsedSeconds')) in (int,float)\n                 and 0<=terminal['elapsedSeconds']<120,'phase_raw_result_terminal_exit_conjunction')\n            closure=terminal.get('volumeGuardClosed',{})\n            need(closure.get('allDescriptorsClosed') is True\n                 and closure.get('lastAnchorCheckPassed') is True and closure.get('closeErrors')==[],\n                 'phase_t5_closure_after_candidate_publication')\n            inverse=generation.endswith('-inverse')\n            records=result.get('records')\n            expected=(['inverse-five-agents-and-six-caches'] if inverse else\n                      ['authbus-five-agent-cycle',*['native-'+a for a in AGENTS]])\n            need(isinstance(records,list) and [x.get('name') for x in records]==expected\n                 and result.get('nativeWorkerCount')==(0 if inverse else 5),'exact_four_phase_matrix')\n            for record in records:\n                life=record.get('lifecycle',{});worker=record.get('report',{})\n                need(life.get('exitCode')==0 and life.get('primaryReaped') is True\n                     and life.get('noGroupSurvivors') is True and life.get('outcomeUnknown') is False\n                     and life.get('remainingGroupMembers')==[]\n                     and worker.get('ok') is True and worker.get('outcomeUnknown') is False,\n                     'worker_known_and_actual_lineage_closed')\n                pgid=life.get('ownedProcessGroup')\n                need(type(pgid) is int and pgid>1,'typed_owned_worker_group')\n                entry['groups'].add(pgid)\n                if record.get('agentId') is not None:\n                    observer=life.get('nativeProcessObserver',{})\n                    need(observer.get('verified') is True and observer.get('requests')==1,\n                         'separate_actual_single_native_observer')\n            need(not self._rows(entry['groups']),'all_actual_phase_groups_empty')\n            entry['lineagesClosed']=True;entry['completeKnownSuccess']=True\n            entry['resultSha256']=sha(raw);entry['terminalSha256']=sha(stdout)\n            entry['phaseRecordCount']=len(records)\n            self._bootout(entry)\n            self._record('phase-complete',generation,{'resultSha256':sha(raw),\n                'terminalSha256':sha(stdout),'actualExitCode':0,'phaseRecords':len(records),\n                'allKnownGroupsEmpty':True})\n            self._advance()\n            return result\n        except BaseException:\n            self.unknown=True\n            raise\n\n    def abort_cleanup_once(self):\n        if self.failure_cleanup_attempted:return self.public()\n        with self.signals.critical():\n            self.failure_cleanup_attempted=True\n            self.cleanup_until=time.monotonic()+NEW_CLEANUP_SECONDS\n            self.unknown=True\n            for entry in reversed(self.entries):\n                if entry['registrationClosed']:continue\n                try:\n                    self._check_registration_files(entry)\n                    state=self._query(entry['label'],entry,cleanup=True)\n                    if state is None:\n                        entry['registrationClosed']=True\n                        entry['remainingGroupRows']=self._rows(entry['groups'],cleanup=True)\n                        if entry['remainingGroupRows']:entry['registrationClosed']=False\n                        continue\n                    pid=state.get('pid')\n                    expected=entry['execIdentity'] or entry['wrapperIdentity']\n                    if pid is not None:\n                        need(expected is not None and pid==expected['pid']\n                             and self.reader.read(pid)==expected,'cleanup_exact_current_owned_identity')\n                        operation='kill' if entry['kind']=='server' and entry['execIdentity'] else 'term'\n                        if operation not in entry['attempts']:\n                            signal_name='SIGKILL' if operation=='kill' else 'SIGTERM'\n                            self._dispatch_once(entry,operation,\n                                ['/bin/launchctl','kill',signal_name,entry['target']],cleanup=True)\n                        grace=min(self.cleanup_until,time.monotonic()+NEW_FAILURE_TERM_GRACE_SECONDS)\n                        while self._remaining(grace,cleanup=True):\n                            state=self._query(entry['label'],entry,until=grace,cleanup=True)\n                            if state is None or state.get('pid') is None:break\n                            need(state['pid']==expected['pid'],'cleanup_no_replacement_pid')\n                            time.sleep(min(NEW_MANAGER_POLL_SECONDS,self._remaining(grace,cleanup=True)))\n                    self._bootout(entry,cleanup=True)\n                    if entry['kind']=='server' and entry.get('serverWrapperClosed'):\n                        entry['lineagesClosed']=not entry.get('remainingGroupRows')\n                except BaseException as error:\n                    entry['cleanupErrorType']=type(error).__name__\n                    entry['cleanupErrorCode']=str(error) if isinstance(error,ManagerRefused) else None\n            return self.public()\n\n    def finish(self):\n        self._remaining()\n        need(self.graph_index==len(GRAPH) and not self.failure_cleanup_attempted\n             and not self.unknown and all(e['registrationClosed'] and e['lineagesClosed']\n             and e['completeKnownSuccess'] for e in self.entries),'entire_finite_manager_graph_complete')\n        commands=self.commands.public()\n        need(commands['allOwnedCommandsStopped'] and commands['unknownCommandCount']==0\n             and all(r['closed'] for r in self.fd_rows),'all_manager_helpers_and_descriptors_closed')\n        self.finished=True\n        return self.public()\n\n    def public(self):\n        entries=[]\n        for e in self.entries:\n            entries.append({'kind':e['kind'],'generation':e['generation'],'label':e['label'],\n                'planSha256':e['planSha256'],'plistSha256':e['plistSha256'],\n                'wrapperIdentity':e['wrapperIdentity'],'execIdentity':e['execIdentity'],\n                'knownOwnedGroups':sorted(e['groups']),'attempts':e['attempts'],\n                'registrationClosed':e['registrationClosed'],'lineagesClosed':e['lineagesClosed'],\n                'completeKnownSuccess':e['completeKnownSuccess'],\n                'remainingGroupRows':e.get('remainingGroupRows'),\n                'resultSha256':e.get('resultSha256'),'terminalSha256':e.get('terminalSha256'),\n                'cleanupErrorType':e.get('cleanupErrorType'),'cleanupErrorCode':e.get('cleanupErrorCode')})\n        commands=self.commands.public()\n        return {'schema':'heptabao.mac-owned-launchd-manager.r3','ok':bool(self.finished and not self.unknown and time.monotonic()<self.until),\n            'outcomeUnknown':self.unknown,'newManagerSeconds':NEW_MANAGER_SECONDS,\n            'newFailureCleanupSeconds':NEW_CLEANUP_SECONDS,'originalPhaseSeconds':120,\n            'pythonRuntime':dict(self.python_runtime),\n            'operationGraph':list(GRAPH),'completedOperationCount':self.graph_index,\n            'registrations':entries,'events':list(self.events),'ownedCommands':commands,\n            'allRegistrationsClosed':all(e['registrationClosed'] for e in self.entries),\n            'allKnownLineagesClosed':all(e['lineagesClosed'] for e in self.entries),\n            'allOwnedCommandsStopped':commands['allOwnedCommandsStopped'],\n            'allManagerReadDescriptorsClosed':all(r['closed'] for r in self.fd_rows),\n            'newMaximumCommandCount':MAX_COMMANDS,'newManagerPollSeconds':NEW_MANAGER_POLL_SECONDS,\n            'failureCleanupAttempted':self.failure_cleanup_attempted,\n            'elapsedSeconds':time.monotonic()-self.started,\n            'noNumericPidOrGroupSignals':True,'productionManagerQualification':False}\n","mac_current_server_owner_r1.py":"#!/usr/bin/env python3\n\"\"\"Owned launchd server wrapper; validates custody, then execs the exact R10 binary.\n\nThis is a source-only candidate. It does not own launchd registration. The\nmanager must observe the same PID and birth become the pinned server executable;\nan exec-ready file or stdout record alone is never evidence of server startup.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, base64, hashlib, json, os, signal, stat, sys, time\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-df026-current-registry-wal-r1')\nQA=ROOT/'qa'\nBINARY=Path('/Volumes/T5/hepta-vnext-recovery-20261013/continuation-20261105-cold-h2-normal-r1/normal-release-tests-r1/artifacts/heptabao-server')\nBINARY_SHA='ef8ec2e21c8c610e34489695a6c0efa126d39dfda5eddbd36db01870d1d4a1f0'\nBINARY_BYTES=92408592\nGENERATIONS=('server-initial','server-cold-new-process')\nPUBLIC_MODULES=('mac_owned_unreaped_r1.py','mac_owned_commands_r1.py',\n                'mac_t5_volume_guard_r1.py','mac_native_process_observer_r1.py')\nSTART=time.monotonic()\nUNTIL=START+30.0\nprotected=0\npending=None\n\nclass Refused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise Refused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef encoded(value):return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\\n').encode()\ndef identity(s):\n    return tuple(str(x) for x in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n        s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\ndef remaining():\n    need(pending is None,'server_wrapper_cancelled')\n    left=UNTIL-time.monotonic();need(left>0,'original_server_wrapper_deadline');return left\n@contextmanager\ndef critical():\n    global protected\n    protected+=1\n    try:yield\n    finally:protected-=1\ndef interrupted(signum,_frame):\n    global pending\n    pending=signum\n    if not protected:raise KeyboardInterrupt()\n\ndef stable_public(path,maximum):\n    remaining();path=Path(path)\n    need(path.is_absolute() and path==Path(os.path.normpath(str(path))),'public_path')\n    fd=None\n    try:\n        with critical():fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n             and not stat.S_IMODE(before.st_mode)&0o022 and 0<=before.st_size<=maximum,\n             'public_source_custody')\n        raw=bytearray()\n        while True:\n            remaining();block=os.read(fd,min(65536,maximum+1-len(raw)))\n            if not block:break\n            raw.extend(block);need(len(raw)<=maximum,'public_source_bound')\n        need(len(raw)==before.st_size and identity(before)==identity(os.fstat(fd))\n             ==identity(path.lstat()),'public_source_stable')\n        return bytes(raw),identity(before)\n    finally:\n        if fd is not None:\n            with critical():os.close(fd)\n\ndef binary_pin():\n    remaining()\n    fd=None\n    try:\n        with critical():fd=os.open(BINARY,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n             and stat.S_IMODE(before.st_mode)==0o500 and before.st_size==BINARY_BYTES,\n             'exact_retained_normal_binary')\n        digest=hashlib.sha256();size=0\n        while True:\n            remaining();chunk=os.read(fd,1024*1024)\n            if not chunk:break\n            size+=len(chunk);digest.update(chunk)\n        need(size==BINARY_BYTES and digest.hexdigest()==BINARY_SHA\n             and identity(before)==identity(os.fstat(fd))==identity(BINARY.lstat()),\n             'retained_normal_binary_whole_pin')\n        return identity(before)\n    finally:\n        if fd is not None:\n            with critical():os.close(fd)\n\ndef main():\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--plan',type=Path,required=True)\n    parser.add_argument('--plan-sha256',required=True)\n    parser.add_argument('--public-volume-anchor-base64',required=True)\n    parser.add_argument('--public-volume-anchor-sha256',required=True)\n    parser.add_argument('--public-source-pins-base64',required=True)\n    parser.add_argument('--public-source-pins-sha256',required=True)\n    args=parser.parse_args()\n    os.umask(0o077)\n    for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,interrupted)\n    guard=None;commands=None;generation=None;plan=None;candidate=None\n    report={'schema':'heptabao.mac-owned-launchd-server-wrapper.r1','ok':False,\n        'execObservedByWrapper':False,'managerMustObserveSamePidBirthAndServerExecutable':True,\n        'newWrapperSeconds':30,'outcomeUnknown':False,'productionCurrentPrivateInputsOpened':False,\n        'ownedPrivateInputReadAttempted':False,'ownedPrivateInputReadCompleted':False,\n        'productionChanged':False,'providerRequestSent':False,'j3160Contacted':False}\n    try:\n        need(sys.platform=='darwin' and os.getuid()==501,'exact_mac_owner')\n        raw_pins=base64.b64decode(args.public_source_pins_base64,validate=True)\n        need(len(raw_pins)<=8192 and sha(raw_pins)==args.public_source_pins_sha256,\n             'exact_public_source_pins')\n        pins=json.loads(raw_pins)\n        need(isinstance(pins,dict) and set(pins)==set(PUBLIC_MODULES)\n             and all(isinstance(v,str) and len(v)==64\n                     and all(c in '0123456789abcdef' for c in v) for v in pins.values()),\n             'fixed_public_source_set')\n        source_identities={}\n        for name in PUBLIC_MODULES:\n            raw,source_identities[name]=stable_public(QA/name,1024*1024)\n            need(sha(raw)==pins[name],'reviewed_public_source')\n        sys.path.insert(0,str(QA))\n        from mac_t5_volume_guard_r1 import HeldT5\n        from mac_owned_commands_r1 import Signals,Commands\n        from mac_native_process_observer_r1 import ProcessReader\n        # Commands uses this wrapper's critical section and cancellation state.\n        class CommandSignals:\n            @property\n            def pending(self):return pending\n            def critical(self):return critical()\n        commands=Commands(CommandSignals())\n        anchor=base64.b64decode(args.public_volume_anchor_base64,validate=True)\n        guard=HeldT5(anchor,args.public_volume_anchor_sha256,remaining,critical)\n        row,out,err=commands.run('server-wrapper-t5-volume',\n            ['/usr/sbin/diskutil','info','-plist','/Volumes/T5'],\n            until=min(UNTIL,time.monotonic()+30),maximum=262144)\n        need(row['exitCode']==0 and row['completeBeforeDeadline']\n             and not row['outcomeUnknown'],'actual_volume_probe_complete')\n        guard.accept_diskutil(out)\n        report['ownedPrivateInputReadAttempted']=True\n        raw=guard.read(args.plan)\n        report['ownedPrivateInputReadCompleted']=True\n        need(sha(raw)==args.plan_sha256,'exact_private_server_plan')\n        plan=json.loads(raw);need(isinstance(plan,dict),'server_plan_object');generation=plan.get('generation')\n        need(isinstance(plan,dict) and set(plan)=={'schema','generation','binaryPath',\n            'binarySha256','binaryBytes','configPath','configSha256','port','workRoot'}\n            and plan['schema']=='heptabao.mac-owned-launchd-server-plan.private.r1'\n            and generation in GENERATIONS and args.plan==ROOT/'launchd'/(generation+'.private.json')\n            and plan['binaryPath']==str(BINARY) and plan['binarySha256']==BINARY_SHA\n            and plan['binaryBytes']==BINARY_BYTES and plan['configPath']==str(ROOT/'server/server.json')\n            and plan['workRoot']==str(ROOT) and type(plan['port']) is int\n            and 1024<=plan['port']<=65535,'fixed_owned_server_plan')\n        config_raw=guard.read(Path(plan['configPath']))\n        need(sha(config_raw)==plan['configSha256'],'exact_server_config')\n        config=json.loads(config_raw)\n        need(isinstance(config,dict) and set(config)=={'listen','data_dir','audit_file',\n             'tls_cert_file','tls_key_file','storage'}\n             and config['listen']=='127.0.0.1:'+str(plan['port'])\n             and config['data_dir']==str(ROOT/'server/data')\n             and config['audit_file']==str(ROOT/'server/audit.jsonl'),\n             'actual_normal_flat_loopback_config')\n        need(config['storage']=={'native_v6_file':{'path':str(ROOT/'server/data')}},\n             'formal_owned_native_v6_file')\n        need(config['tls_cert_file']==str(ROOT/'server/tls/server.crt')\n             and config['tls_key_file']==str(ROOT/'server/tls/server.key'),\n             'owned_tls_configuration')\n        before_binary=binary_pin()\n        reader=ProcessReader();self_identity=reader.read(os.getpid())\n        need(self_identity['uid']==501 and self_identity['pid']==self_identity['pgid']\n             and self_identity['executable']==str(Path(sys.executable).resolve()),\n             'actual_launchd_wrapper_identity')\n        ready={'schema':'heptabao.mac-server-wrapper-ready.r1','generation':generation,\n            'planSha256':args.plan_sha256,'wrapperIdentity':self_identity,\n            'wrapperStartMonotonic':START,'originalWrapperDeadlineMonotonic':UNTIL}\n        guard.write_new(ROOT/'launchd'/(generation+'.ready.public.json'),encoded(ready))\n        admitted=ROOT/'launchd'/(generation+'.admitted.private.json')\n        while True:\n            remaining()\n            try:admission=json.loads(guard.read(admitted));break\n            except FileNotFoundError:time.sleep(min(0.025,remaining()))\n        need(admission=={'schema':'heptabao.mac-owned-manager-admission.r1',\n            'generation':generation,'planSha256':args.plan_sha256,'wrapperIdentity':self_identity},\n            'one_exact_actual_manager_admission')\n        need(reader.read(os.getpid())==self_identity,'wrapper_birth_before_exec')\n        need(binary_pin()==before_binary,'binary_name_identity_before_exec')\n        need(sha(guard.read(Path(plan['configPath'])))==plan['configSha256'],\n             'config_after_manager_admission')\n        for name in PUBLIC_MODULES:\n            raw,observed=stable_public(QA/name,1024*1024)\n            need(observed==source_identities[name] and sha(raw)==pins[name],\n                 'public_sources_before_exec')\n        report.update(generation=generation,wrapperIdentity=self_identity,\n            binaryPath=str(BINARY),binarySha256=BINARY_SHA,binaryBytes=BINARY_BYTES,\n            binaryIdentity=before_binary,configSha256=plan['configSha256'],\n            sourcePins=pins,commands=commands.public())\n        need(report['commands']['allOwnedCommandsStopped']\n             and report['commands']['unknownCommandCount']==0,'helpers_closed_before_exec')\n        remaining();guard.check()\n        report['preparedExecCandidate']=True\n        candidate=guard.write_new(ROOT/'launchd'/(generation+'.exec-ready.public.json'),\n                                 encoded(report))\n    except BaseException as error:\n        report['errorType']=type(error).__name__\n        report['errorCode']=str(error) if isinstance(error,Refused) else None\n        report['outcomeUnknown']=isinstance(error,KeyboardInterrupt)\n    finally:\n        for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,signal.SIG_IGN)\n        if commands is not None:report['commands']=commands.public()\n        if guard is not None:\n            guard.close();report['volumeGuardClosed']=guard.public_state()\n        closed=(guard is not None and report['volumeGuardClosed']['allDescriptorsClosed']\n            and report['volumeGuardClosed']['lastAnchorCheckPassed']\n            and not report['volumeGuardClosed']['closeErrors'])\n        owned=(commands is not None and report['commands']['allOwnedCommandsStopped']\n               and report['commands']['unknownCommandCount']==0)\n        ready=bool(candidate is not None and closed and owned and pending is None\n                   and time.monotonic()<UNTIL and 'errorType' not in report)\n        report['ok']=ready;report['readyToExec']=ready\n        report['outcomeUnknown']=bool(report['outcomeUnknown'] or not closed or not owned)\n        report['candidateReceiptSha256']=None if candidate is None else candidate['sha256']\n        report['elapsedSeconds']=time.monotonic()-START\n        print(json.dumps(report,sort_keys=True),flush=True)\n    if not ready or time.monotonic()>=UNTIL:return 1\n    # A successful exec retains PID/birth and consumes this wrapper. The\n    # independent manager must actually observe that transition and pinned file.\n    try:\n        for name in ('SIGTERM','SIGINT','SIGPIPE','SIGXFZ','SIGXFSZ'):\n            sig=getattr(signal,name,None)\n            if sig is not None:signal.signal(sig,signal.SIG_DFL)\n        os.execve(str(BINARY),[str(BINARY),'--config',str(ROOT/'server/server.json')],\n            {'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C',\n             'HOME':str(ROOT/'server/home'),'TMPDIR':str(ROOT/'server/tmp')})\n    except BaseException as error:\n        print(json.dumps({'schema':'heptabao.mac-owned-server-exec-failure.r1',\n            'generation':generation,'ok':False,'execFailureType':type(error).__name__,\n            'outcomeUnknown':False},sort_keys=True),flush=True)\n        return 1\n\nif __name__=='__main__':sys.exit(main())\n","mac_current_phase_owner_r2.py":"#!/usr/bin/env python3\n\"\"\"One launchd-owned wrapper, one original 120s phase, five real native lineages.\n\nLaunchd owns THIS wrapper. It really Popen()s sandbox-exec -> Node; each native\nworker gets its own unchanged single-use anonymous-pipe observer. The outer\nlaunchd manager cannot mint that observer ACK or claim Node as its own child.\nThis draft is source-only. It has not captured current credentials or run a job.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, base64, hashlib, json, os, plistlib, signal, stat, subprocess, sys, time\nfrom pathlib import Path\nfrom contextlib import contextmanager\n\nSTART = time.monotonic()\nUNTIL = START + 120\nROOT = Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-df026-current-registry-wal-r1')\nAGENTS = ('main','trnm','hepta-ui','hepta','hepta-backend')\nUUID = 'FB804D1B-24CB-4D6E-AEA7-A9E180807758'\nNODE = '/opt/homebrew/bin/node'\nprotected = 0\npending_signal = None\nowned = []\nobservers = []\nobserver_close_results = {}\nvolume_guard = None\n\n@contextmanager\ndef critical():\n    global protected\n    protected += 1\n    try: yield\n    finally: protected -= 1\n\nclass Refused(RuntimeError): pass\nclass Cancelled(BaseException): pass\ndef need(value, code):\n    if not value: raise Refused(code)\ndef interrupt(signum, _frame):\n    global pending_signal\n    pending_signal = signum\n    if protected == 0: raise Cancelled()\nfor sig in (signal.SIGTERM, signal.SIGINT): signal.signal(sig, interrupt)\ndef remaining(until=UNTIL):\n    need(pending_signal is None, 'phase_interrupted')\n    value = until - time.monotonic()\n    need(value > 0, 'original_shared_phase_deadline_exhausted')\n    return value\ndef sha(raw): return hashlib.sha256(raw).hexdigest()\ndef encoded(value): return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\\n').encode()\ndef identity(s):\n    return (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)\ndef private_read(path,maximum=2*1024*1024):\n    need(volume_guard is not None,'held_volume_before_private_read')\n    return volume_guard.read(path,maximum,private=True)\ndef put(path,value):\n    need(volume_guard is not None,'held_volume_before_private_write')\n    raw=value if isinstance(value,bytes) else encoded(value)\n    return volume_guard.write_new(path,raw)\ndef file_sha(path,maximum=128*1024*1024):\n    path=Path(path)\n    if volume_guard is not None and path.is_relative_to(ROOT):\n        return sha(volume_guard.read(path,min(maximum,16*1024*1024),private=False))\n    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n    try:\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and 0<=before.st_size<=maximum,'source_regular_bound')\n        h=hashlib.sha256();size=0\n        while True:\n            remaining()\n            block=os.read(fd,1024*1024)\n            if not block:break\n            size+=len(block);h.update(block)\n        need(size==before.st_size and identity(before)==identity(os.fstat(fd))==identity(path.lstat()),'source_changed')\n        return h.hexdigest()\n    finally:os.close(fd)\n\ndef close_observer_once(observer):\n    key=id(observer)\n    if key in observer_close_results:return observer_close_results[key]\n    with critical():\n        observer_close_results[key]=False\n        try:\n            observer_close_results[key]=observer.close() is True\n        except BaseException:pass\n    return observer_close_results[key]\n\ndef run_owned_capture(argv, env, cwd, until, stdout_path, stderr_path, native_observer=None):\n    global protected\n    from mac_owned_unreaped_r1 import (require_waitid, capture_child,\n        exit_observation, observed_returncode, stop_once_unreaped)\n    from mac_native_process_observer_r1 import OwnedNativeObserver, ObservationRefused\n    lifecycle = {'exitCode':None,'timeout':False,'interrupted':False,'primaryReaped':False,\n                 'noGroupSurvivors':False,'outcomeUnknown':False,\n                 'directChildRetainedUntilGroupCleanup':True}\n    remaining(until);require_waitid()\n    observer=None;row=None\n    with critical():\n        observer=OwnedNativeObserver(native_observer,critical=critical) if native_observer else None\n        if observer is not None:observers.append(observer)\n    if pending_signal is not None:raise Cancelled()\n    child_env=dict(env)\n    if observer:\n        need(not any(k in child_env for k in observer.child_env),'fresh_observer_pipe_environment')\n        child_env.update(observer.child_env)\n    need(volume_guard is not None,'held_volume_before_child_output')\n    with volume_guard.capture_sink(stdout_path) as stdout, volume_guard.capture_sink(stderr_path) as stderr:\n        with critical():\n            remaining(until)\n            proc=subprocess.Popen(argv,env=child_env,cwd=str(cwd),start_new_session=True,\n                stdout=stdout,stderr=stderr,close_fds=True,\n                pass_fds=observer.child_fds if observer else ())\n            row={'process':proc,'stopAttempted':False,'lifecycle':lifecycle,'custody':None,\n                 'worker':True,'deliveredReport':False}\n            owned.append(row)\n        lifecycle['ownedProcessGroup']=proc.pid\n        try:\n            if observer:\n                with critical():observer.parent_after_spawn(proc)\n            row['custody']=capture_child(proc,until=until)\n            lifecycle['actualDirectChildCustody']=row['custody']\n            if pending_signal is not None:raise Cancelled()\n            while True:\n                if time.monotonic()>=until:\n                    lifecycle['timeout']=True;break\n                if observer:observer.poll(until)\n                event=exit_observation(proc)\n                if time.monotonic()>=until:\n                    lifecycle['timeout']=True;break\n                if event is not None:\n                    lifecycle['exitCode']=observed_returncode(event)\n                    lifecycle['retainedExit']=event\n                    break\n                remaining(until)\n                time.sleep(min(0.025,remaining(until)))\n        except (KeyboardInterrupt,Cancelled):lifecycle['interrupted']=True\n        except BaseException as error:\n            lifecycle['observationError']=str(error) if isinstance(error,ObservationRefused) else type(error).__name__\n        finally:\n            previous=signal.signal(signal.SIGINT,signal.SIG_IGN)\n            previous_term=signal.signal(signal.SIGTERM,signal.SIG_IGN)\n            try:\n                if observer:\n                    if not close_observer_once(observer):lifecycle['observerCloseError']='ObserverCloseFailed'\n                    lifecycle['nativeProcessObserver']=observer.report\n                row['stopAttempted']=True\n                cleanup=stop_once_unreaped(proc,row['custody'])\n                lifecycle['retainedChildCleanup']=cleanup\n                lifecycle['primaryReaped']=cleanup.get('directChildReaped') is True\n                lifecycle['finalReturnCode']=cleanup.get('exitCode')\n                lifecycle['remainingGroupMembers']=cleanup.get('remainingGroupRows')\n                lifecycle['noGroupSurvivors']=cleanup.get('allGroupRowsEmptyAfterReap') is True\n                lifecycle['outcomeUnknown']=bool(lifecycle['timeout'] or lifecycle['interrupted']\n                    or lifecycle.get('observationError') or lifecycle.get('observerCloseError')\n                    or cleanup.get('outcomeUnknown') or not lifecycle['primaryReaped']\n                    or not lifecycle['noGroupSurvivors'])\n            finally:\n                signal.signal(signal.SIGINT,previous);signal.signal(signal.SIGTERM,previous_term)\n    return lifecycle\n\n\ndef decode_worker_report(raw, phase, mode, agent):\n    unavailable={'ok':False,'outcomeUnknown':True,'error':'worker_report_unavailable'}\n    try:\n        value=json.loads(raw)\n        if not isinstance(value,dict):return False,unavailable\n        expected=('heptabao.mac-five-agent-single-native-worker.r1' if agent is not None\n                  else 'heptabao.mac-five-agent-authbus-cycle-and-inverse.r1')\n        if (value.get('schema')!=expected or type(value.get('ok')) is not bool\n            or type(value.get('outcomeUnknown')) is not bool or value.get('phase')!=phase):\n            return False,unavailable\n        if agent is not None:\n            if mode!='native' or value.get('agentId')!=agent:return False,unavailable\n        elif mode not in ('cycle','rollback') or value.get('mode')!=mode:\n            return False,unavailable\n        checks=value.get('checks')\n        if (not isinstance(checks,list) or not 1<=len(checks)<=512\n            or any(not isinstance(c,dict) or not isinstance(c.get('case'),str)\n                   or not 1<=len(c['case'])<=256 or type(c.get('passed')) is not bool\n                   for c in checks)):\n            return False,unavailable\n        if value['ok'] and (value['outcomeUnknown'] or any(not c['passed'] for c in checks)):\n            return False,unavailable\n        return True,value\n    except Exception:\n        return False,unavailable\n\ndef volume_before_private_state():\n    \"\"\"Actual diskutil under original 30s and phase120, with anchors already held.\"\"\"\n    global protected\n    until=min(UNTIL,time.monotonic()+30)\n    lifecycle={'exitCode':None,'timeout':False,'interrupted':False,'primaryReaped':False,\n               'noGroupSurvivors':False,'outcomeUnknown':False}\n    protected+=1\n    try:\n        remaining(until)\n        proc=subprocess.Popen(['/usr/sbin/diskutil','info','-plist','/Volumes/T5'],\n          env={'PATH':'/usr/bin:/bin:/usr/sbin:/sbin','LANG':'C','LC_ALL':'C'},\n          stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)\n        row={'process':proc,'stopAttempted':False,'lifecycle':lifecycle};owned.append(row)\n    finally:protected-=1\n    out=err=b''\n    try:\n        if pending_signal is not None:raise Cancelled()\n        out,err=proc.communicate(timeout=remaining(until))\n        remaining(until)\n        need(len(out)<=262144 and len(err)<=262144,'bounded_volume_output')\n        lifecycle['exitCode']=proc.returncode\n    except subprocess.TimeoutExpired:lifecycle['timeout']=True\n    except (Cancelled,KeyboardInterrupt):lifecycle['interrupted']=True\n    finally:\n        previous=signal.signal(signal.SIGINT,signal.SIG_IGN)\n        previous_term=signal.signal(signal.SIGTERM,signal.SIG_IGN)\n        row['stopAttempted']=True\n        try:\n            if proc.poll() is None:\n                try:os.killpg(proc.pid,signal.SIGTERM)\n                except ProcessLookupError:pass\n                try:proc.wait(timeout=1)\n                except subprocess.TimeoutExpired:\n                    try:os.killpg(proc.pid,signal.SIGKILL)\n                    except ProcessLookupError:pass\n                    proc.wait(timeout=5)\n            proc.wait(timeout=5)\n            lifecycle['primaryReaped']=True;lifecycle['finalReturnCode']=proc.returncode\n            # Only this exact owned group is retained. This fixed read-only ps\n            # is reaped by subprocess.run; its existing four-second helper cap\n            # is also subject to the enclosing phase success deadline.\n            ps=subprocess.run(['/bin/ps','-axo','pid=,pgid=,stat='],stdin=subprocess.DEVNULL,\n                stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=4,check=True)\n            members=[]\n            for line in ps.stdout.decode('ascii').splitlines():\n                fields=line.split()\n                if len(fields)==3 and int(fields[1])==proc.pid:\n                    members.append({'pid':int(fields[0]),'state':fields[2]})\n            lifecycle['remainingGroupMembers']=members\n            lifecycle['noGroupSurvivors']=not members\n            lifecycle['outcomeUnknown']=lifecycle['timeout'] or lifecycle['interrupted'] or bool(members)\n        finally:\n            if proc.stdout:proc.stdout.close()\n            if proc.stderr:proc.stderr.close()\n            signal.signal(signal.SIGINT,previous);signal.signal(signal.SIGTERM,previous_term)\n    need(lifecycle['exitCode']==0 and lifecycle['primaryReaped']\n      and lifecycle['noGroupSurvivors'] and not lifecycle['outcomeUnknown'],'volume_probe_complete')\n    info=plistlib.loads(out)\n    need(volume_guard is not None,'held_anchors_before_diskutil')\n    volume_guard.accept_diskutil(out)\n    need(info.get('VolumeUUID')==UUID and info.get('MountPoint')=='/Volumes/T5','exact_t5_before_phase')\n    remaining()\n    return {'lifecycle':lifecycle,'stdoutSha256':sha(out),'stderrSha256':sha(err),\n            'volumeUUID':info['VolumeUUID'],'mountPoint':info['MountPoint']}\n\n\ndef main():\n    global volume_guard\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--plan',type=Path,required=True)\n    parser.add_argument('--plan-sha256',required=True)\n    parser.add_argument('--public-volume-anchor-base64',required=True)\n    parser.add_argument('--public-volume-anchor-sha256',required=True)\n    parser.add_argument('--volume-guard-source-sha256',required=True)\n    args=parser.parse_args()\n    os.umask(0o077)\n    report={'schema':'heptabao.mac-five-agent-phase-owner.r2','ok':False,\n      'originalSharedPhaseSeconds':120,'nativeWorkerCount':0,'records':[],\n      'productionChanged':False,'providerRequestSent':False,'j3160Contacted':False,\n      'realLaunchdQualificationSuppliedByOuterManager':False,'outcomeUnknown':False}\n    plan=None;generation=None;published_result=None\n    try:\n        need(sys.platform=='darwin' and os.getuid()==501,'exact_mac_owner')\n        q=ROOT/'qa'\n        # Only public, exact source bytes are opened here. No private plan,\n        # credential, owned output or ready file precedes the held volume gate.\n        guard_module=q/'mac_t5_volume_guard_r1.py'\n        need(file_sha(guard_module,1024*1024)==args.volume_guard_source_sha256,\n             'exact_public_volume_guard_source')\n        sys.path.insert(0,str(q))\n        from mac_t5_volume_guard_r1 import HeldT5\n        volume_guard=HeldT5(base64.b64decode(args.public_volume_anchor_base64,validate=True),\n            args.public_volume_anchor_sha256,remaining,critical)\n        report['volumeGuard']=volume_before_private_state()\n        raw=private_read(args.plan);need(sha(raw)==args.plan_sha256,'exact_phase_plan_pin')\n        plan=json.loads(raw)\n        need(plan['schema']=='heptabao.mac-five-agent-phase-plan.private.r1'\n          and plan['phase'] in ('initial','cold-new-process') and plan['mode'] in ('consume','inverse')\n          and plan['agentIds']==list(AGENTS) and plan['phaseSeconds']==120,'fixed_phase_contract')\n        phase=ROOT/plan['phase'];generation=plan['generation'];report['generation']=generation\n        need(generation in ('initial','cold-new-process','initial-inverse','cold-new-process-inverse')\n          and generation==plan['phase']+('-inverse' if plan['mode']=='inverse' else ''),\n          'unique_phase_generation')\n        need(Path(plan['phaseRoot'])==phase and Path(plan['stateRoot'])==phase/'state',\n             'independent_initial_cold_state')\n        need(str(plan['expectedVolumeDevice'])==volume_guard.expected['expectedVolumeDevice'],\n             'phase_device_matches_public_startup_anchor')\n        volume_guard.check()\n        need(args.plan==ROOT/'launchd'/(generation+'.private.json'),'immutable_manager_phase_plan')\n        for name in ('mac_native_process_observer_r1.py',\n                     'mac_owned_unreaped_r1.py',\n                     'mac_current_phase_owner_r2.py','mac_t5_volume_guard_r1.py',\n                     'mac_current_cycle_r2.mjs','mac_single_native_r2.mjs',\n                     'mac_auth_rows_cas_r1.mjs','mac_authbus_cache_cas_r1.mjs'):\n            need(file_sha(q/name)==plan['qaPins'][name],'reviewed_qa_source.'+name)\n        sys.path.insert(0,str(q))\n        from mac_native_process_observer_r1 import ProcessReader\n        self_identity=ProcessReader().read(os.getpid())\n        need(self_identity['uid']==501 and self_identity['executable']==str(Path(sys.executable).resolve()),\n             'real_wrapper_process_identity')\n        ready={'schema':'heptabao.mac-phase-wrapper-ready.r1','generation':generation,\n               'planSha256':args.plan_sha256,'wrapperIdentity':self_identity,\n               'phaseStartMonotonic':START,'originalPhaseDeadlineMonotonic':UNTIL}\n        put(ROOT/'launchd'/(generation+'.ready.public.json'),ready)\n        # Node/native sandbox rules deny writes to ROOT/launchd. This message\n        # therefore comes from the actual manager after it has read launchctl\n        # and the wrapper's real process identity; it is not a native ACK.\n        admission_path=ROOT/'launchd'/(generation+'.admitted.private.json')\n        while not admission_path.exists():\n            time.sleep(min(0.025,remaining()))\n        admission=json.loads(private_read(admission_path))\n        need(admission=={'schema':'heptabao.mac-owned-manager-admission.r1',\n          'generation':generation,'planSha256':args.plan_sha256,'wrapperIdentity':self_identity},\n          'one_exact_manager_admission_before_credentials')\n        remaining()\n        env={'PATH':'/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin',\n             'HOME':str(phase/'state/home'),'TMPDIR':str(phase/'tmp')}\n        volume_guard.check()\n        common=plan['workerCommon']\n        need(common['workRoot']==str(ROOT) and common['phaseRoot']==str(phase)\n          and common['stateRoot']==str(phase/'state'),'worker_common_owned_scope')\n        # All environment fields outside original owned filesystem isolation are\n        # passed from the reviewed fixed plan; no credential values are added.\n        env.update(OPENCLAW_STATE_DIR=str(phase/'state'),\n                   OPENCLAW_CONFIG_PATH=str(phase/'state/openclaw.json'),\n                   OPENCLAW_OAUTH_DIR=str(phase/'state/oauth'),\n                   OPENCLAW_HOME=str(phase/'state/home'))\n        def invoke(label,mode,agent=None):\n            remaining()\n            worker={**common,'schema':'heptabao.mac-five-agent-worker.private.r1',\n                    'mode':mode,'phase':plan['phase'],'phaseOwnerPid':os.getpid(),\n                    'phaseRemainingMs':int(remaining()*1000)}\n            if agent is not None:\n                worker.update(plan['nativeWorkers'][agent]);worker['agentId']=agent\n                need(worker['nativeHome']==str(phase/'state/agents'/agent/'agent/codex-home'),\n                     'per_agent_native_home')\n            worker_dir=phase/('inverse' if mode=='rollback' else 'workers')\n            need(worker_dir.is_dir() and worker_dir.resolve(strict=True)==worker_dir,'precreated_owned_worker_directory')\n            path=worker_dir/(label+'.plan.private.json')\n            worker['custodyOutput']=str(worker_dir/(label+'.auth.private.json'))\n            put(path,worker)\n            executable=q/('mac_single_native_r2.mjs' if agent else 'mac_current_cycle_r2.mjs')\n            out=worker_dir/(label+'.stdout.private');err=worker_dir/(label+'.stderr.private')\n            child_env=dict(env)\n            if agent is not None: child_env['TMPDIR']=worker['nativeTmp']\n            life=run_owned_capture(['/usr/bin/sandbox-exec','-f',common['parentSandbox'],\n                    NODE,str(executable),str(path)],child_env,phase,UNTIL,out,err,\n                    native_observer=None if agent is None else {\n                      'nodeExecutable':str(Path(NODE).resolve()),'nativeExecutable':worker['nativeBinary']})\n            out_bytes=private_read(out);err_bytes=private_read(err)\n            report_available,value=decode_worker_report(out_bytes,plan['phase'],mode,agent)\n            record={'name':label,'mode':mode,'agentId':agent,'lifecycle':life,\n                    'stdoutSha256':sha(out_bytes),'stderrSha256':sha(err_bytes),\n                    'stdoutBytes':len(out_bytes),'stderrBytes':len(err_bytes),'report':value}\n            report['records'].append(record)\n            owned[-1]['deliveredReport']=report_available\n            # No next worker, inverse, or cold action follows a timeout, unknown\n            # response, missing report, surviving lineage, or unsuccessful gate.\n            if (life['outcomeUnknown'] or value.get('outcomeUnknown')\n                    or value.get('error')=='worker_report_unavailable'):\n                report['outcomeUnknown']=True\n            need(life['exitCode']==0 and life['primaryReaped'] and life['noGroupSurvivors']\n                 and not life['outcomeUnknown'] and value.get('ok') is True\n                 and value.get('outcomeUnknown') is not True,'worker_complete_known_success.'+label)\n            if agent is not None:\n                need(life.get('nativeProcessObserver',{}).get('verified') is True\n                  and life['nativeProcessObserver']['requests']==1,'separate_one_shot_native_observer')\n                report['nativeWorkerCount']+=1\n            remaining()\n        if plan['mode']=='consume':\n            invoke('authbus-five-agent-cycle','cycle')\n            for agent in AGENTS: invoke('native-'+agent,'native',agent)\n            need(report['nativeWorkerCount']==5 and len(report['records'])==6,'one_cycle_and_five_native_lineages')\n        else:\n            invoke('inverse-five-agents-and-six-caches','rollback')\n            need(report['nativeWorkerCount']==0 and len(report['records'])==1,'inverse_no_native_or_network')\n        need(all(file_sha(q/name)==pin for name,pin in plan['qaPins'].items()),'all_qa_pins_after')\n        remaining();report['ok']=True\n    except BaseException as error:\n        report['errorType']=type(error).__name__\n        report['errorCode']=str(error) if isinstance(error,Refused) else None\n        if isinstance(error,(Cancelled,KeyboardInterrupt)):report['outcomeUnknown']=True\n    finally:\n        signal.signal(signal.SIGINT,signal.SIG_IGN)\n        signal.signal(signal.SIGTERM,signal.SIG_IGN)\n        for observer in observers:\n            if not close_observer_once(observer):\n                report['ok']=False;report['outcomeUnknown']=True\n        # Registered but not yet finalized children can occur at a cancellation\n        # boundary. The once marker prevents giving any child a second cleanup.\n        orphan_cleanup=[]\n        for row in owned:\n            if row['stopAttempted']:continue\n            row['stopAttempted']=True;p=row['process']\n            item={'pid':p.pid,'stopAttempted':True}\n            try:\n                from mac_owned_unreaped_r1 import stop_once_unreaped\n                item.update(stop_once_unreaped(p,row.get('custody')))\n                row['lifecycle']['primaryReaped']=item.get('directChildReaped') is True\n                row['lifecycle']['noGroupSurvivors']=item.get('allGroupRowsEmptyAfterReap') is True\n            except BaseException as error:item['cleanupErrorType']=type(error).__name__\n            orphan_cleanup.append(item)\n            report['ok']=False;report['outcomeUnknown']=True\n        report['exceptionBoundaryCleanup']=orphan_cleanup\n        if any(row.get('worker') and not row.get('deliveredReport') for row in owned):\n            report['ok']=False;report['outcomeUnknown']=True\n        report['allObserverClosuresAttemptedOnce']=all(observer_close_results.get(id(o)) is True for o in observers)\n        report['allOwnedStopped']=all(row['lifecycle'].get('primaryReaped') is True\n          and row['lifecycle'].get('noGroupSurvivors') is True for row in owned)\n        if not report['allOwnedStopped'] or time.monotonic()>=UNTIL:report['ok']=False\n        report['elapsedSeconds']=time.monotonic()-START\n        report['authorityExitZeroAndOriginalPhaseDeadlineRequired']=True\n        if volume_guard is not None:\n            try:\n                volume_guard.check(check_deadline=False)\n                report['volumeGuardFinalBeforePublication']=volume_guard.public_state()\n            except BaseException:\n                report['ok']=False;report['outcomeUnknown']=True\n        if plan is not None and generation is not None and volume_guard is not None:\n            try:published_result=put(ROOT/'launchd'/(generation+'.result.public.json'),report)\n            except BaseException:\n                report['ok']=False;report['outcomeUnknown']=True\n        if volume_guard is not None:\n            volume_guard.close()\n            report['volumeGuardClosed']=volume_guard.public_state()\n            if (not report['volumeGuardClosed']['allDescriptorsClosed']\n                or not report['volumeGuardClosed']['lastAnchorCheckPassed']):\n                report['ok']=False;report['outcomeUnknown']=True\n        print(json.dumps({'ok':report['ok'],'generation':generation,\n          'allOwnedStopped':report['allOwnedStopped'],'outcomeUnknown':report['outcomeUnknown'],\n          'elapsedSeconds':time.monotonic()-START,\n          'volumeGuardClosed':report.get('volumeGuardClosed'),\n          'resultSha256':None if published_result is None else published_result['sha256']},sort_keys=True),flush=True)\n    return 0 if report['ok'] and time.monotonic()<UNTIL else 1\n\nif __name__=='__main__':sys.exit(main())\n","mac_native_process_observer_r1.py":"#!/usr/bin/env python3\n\"\"\"Read-only outer-parent custody of one Node -> launcher -> native process chain.\n\nNo credential, application-file or network reads. The response pipe's write end\nis retained exclusively by the outer parent; a shared run directory is not an\nauthority channel. Exact Apple public libproc declarations and proc_bsdinfo ABI:\n  xnu/bsd/sys/proc_info.h Git blob 718a69fcf5340f547893ed8dc85908f253c1ce81\n  xnu/libsyscall/wrappers/libproc/libproc.h 602e4fe897d1fc5a7ceacc372c78f184ea242bfe\n  xnu/libsyscall/wrappers/libproc/libproc.c c3e7369f886fbb7bbc8d77f8fca9ecc943bb5f4e\n\"\"\"\nfrom __future__ import annotations\n\nimport ctypes\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport select\nimport sys\nimport time\n\n\nfrom mac_owned_unreaped_r1 import exit_observation as retained_exit_observation\n\nclass ObservationRefused(RuntimeError):\n    pass\n\n\ndef require(value, code):\n    if not value:\n        raise ObservationRefused(code)\n\n\nclass BsdInfo(ctypes.Structure):\n    _fields_ = [(name, ctypes.c_uint32) for name in (\n        'flags', 'status', 'xstatus', 'pid', 'ppid', 'uid', 'gid',\n        'ruid', 'rgid', 'svuid', 'svgid', 'reserved',\n    )] + [\n        ('comm', ctypes.c_char * 16), ('name', ctypes.c_char * 32),\n        ('nfiles', ctypes.c_uint32), ('pgid', ctypes.c_uint32),\n        ('jobc', ctypes.c_uint32), ('ttydev', ctypes.c_uint32),\n        ('tty_pgid', ctypes.c_uint32), ('nice', ctypes.c_int32),\n        ('birth_sec', ctypes.c_uint64), ('birth_usec', ctypes.c_uint64),\n    ]\n\n\nclass ProcessReader:\n    def __init__(self):\n        require(sys.platform == 'darwin' and ctypes.sizeof(BsdInfo) == 136,\n                'exact_darwin_process_abi')\n        self.lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)\n        self.lib.proc_pidinfo.argtypes = [\n            ctypes.c_int, ctypes.c_int, ctypes.c_uint64,\n            ctypes.c_void_p, ctypes.c_int,\n        ]\n        self.lib.proc_pidinfo.restype = ctypes.c_int\n        self.lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]\n        self.lib.proc_pidpath.restype = ctypes.c_int\n        self.lib.proc_listchildpids.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_int]\n        self.lib.proc_listchildpids.restype = ctypes.c_int\n\n    def read(self, pid):\n        require(type(pid) is int and pid > 1, 'exact_pid_required')\n        info = BsdInfo()\n        count = self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info))\n        require(count == ctypes.sizeof(info) and info.pid == pid, 'process_info_complete')\n        executable = ctypes.create_string_buffer(4096)\n        length = self.lib.proc_pidpath(pid, executable, len(executable))\n        require(0 < length < len(executable), 'process_path_complete')\n        actual_path = executable.value.decode('utf-8', errors='strict')\n        require(actual_path.startswith('/'), 'absolute_process_path')\n        # A second birth read binds path lookup to the same process lifetime.\n        again = BsdInfo()\n        count = self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(again), ctypes.sizeof(again))\n        require(count == ctypes.sizeof(again)\n                and (again.pid, again.ppid, again.pgid, again.uid,\n                     again.birth_sec, again.birth_usec)\n                == (info.pid, info.ppid, info.pgid, info.uid,\n                    info.birth_sec, info.birth_usec), 'process_identity_changed_during_read')\n        return {\n            'pid': pid, 'ppid': info.ppid, 'pgid': info.pgid, 'uid': info.uid,\n            'birthSec': info.birth_sec, 'birthUsec': info.birth_usec,\n            'executable': str(Path(actual_path).resolve()),\n        }\n\n    def children(self, verified_pid):\n        # proc_listchildpids returns a PID count, not bytes. The fixed bound is\n        # fail-closed; it is not a process-wide command/argument enumeration.\n        buffer = (ctypes.c_int * 32)()\n        count = self.lib.proc_listchildpids(verified_pid, buffer, ctypes.sizeof(buffer))\n        require(0 <= count < len(buffer), 'bounded_owned_child_list')\n        return [int(buffer[i]) for i in range(count) if buffer[i] > 1]\n\n\ndef stable_identity(first, second):\n    return first == second\n\n\nclass OwnedNativeObserver:\n    def __init__(self, expected, *, critical):\n        require(callable(critical), 'observer_fd_signal_guard_required')\n        self.critical = critical\n        self.fd_closures = {}\n        self.expected = {\n            'nodeExecutable': str(Path(expected['nodeExecutable']).resolve()),\n            'nativeExecutable': str(Path(expected['nativeExecutable']).resolve()),\n        }\n        self.reader = ProcessReader()\n        self.request_read = self.response_write = None\n        self.child_fds = ()\n        self.child_ends_closed = False\n        self.report = {\n            'required': True, 'verified': False,\n            'ackAuthority': 'outer_parent_only_anonymous_pipe_write_end',\n            'applicationFilesRead': False, 'networkUsed': False,\n            'otherProcessArgumentsRead': False, 'requests': 0,\n        }\n        try:\n            with self.critical():\n                self.request_read, request_write = os.pipe()\n                for fd in (self.request_read, request_write):\n                    self.fd_closures[fd] = {'fd': fd, 'attempted': False, 'closed': False, 'errorType': None}\n                response_read, self.response_write = os.pipe()\n                for fd in (response_read, self.response_write):\n                    self.fd_closures[fd] = {'fd': fd, 'attempted': False, 'closed': False, 'errorType': None}\n                self.child_fds = (request_write, response_read)\n            self.child_env = {\n                'HEPTABAO_NATIVE_OBSERVER_REQUEST_FD': str(request_write),\n                'HEPTABAO_NATIVE_OBSERVER_RESPONSE_FD': str(response_read),\n            }\n            os.set_blocking(self.request_read, False)\n            os.set_blocking(self.response_write, False)\n            self.buffer = bytearray()\n            self.handled = False\n            self.rejected = False\n        except BaseException:\n            self.close()\n            raise\n\n    def close_fd_once(self, fd):\n        require(fd in self.fd_closures, 'unknown_observer_fd_no_close')\n        row = self.fd_closures[fd]\n        if row['attempted']:\n            return row['closed']\n        with self.critical():\n            row['attempted'] = True\n            try:\n                os.close(fd)\n                row['closed'] = True\n            except OSError as error:\n                row['errorType'] = type(error).__name__\n        return row['closed']\n\n    def parent_after_spawn(self, proc):\n        closed = [self.close_fd_once(fd) for fd in self.child_fds]\n        self.child_ends_closed = all(closed)\n        require(self.child_ends_closed, 'observer_child_end_close_unconfirmed')\n        self.proc = proc\n        self.outer_pid = os.getpid()\n\n    def verify_chain(self, request, deadline):\n        require(set(request) == {'schema', 'nonce', 'nodePid', 'launcherPid'},\n                'observer_request_shape')\n        require(request['schema'] == 'heptabao.owned-native-request.v1'\n                and isinstance(request['nonce'], str)\n                and re.fullmatch(r'[0-9a-f]{64}', request['nonce']) is not None,\n                'observer_request_nonce')\n        require(type(request['nodePid']) is int and request['nodePid'] == self.proc.pid\n                and type(request['launcherPid']) is int\n                and request['launcherPid'] > 1, 'observer_owned_request_pids')\n        node_pid, launcher_pid = self.proc.pid, request['launcherPid']\n        node = self.reader.read(node_pid)\n        require(retained_exit_observation(self.proc) is None and node['ppid'] == self.outer_pid\n                and node['pgid'] == node_pid and node['uid'] == os.geteuid()\n                and node['executable'] == self.expected['nodeExecutable'],\n                'owned_node_birth_parent_group_executable')\n        pinned_launcher = None\n        while time.monotonic() < deadline:\n            require(retained_exit_observation(self.proc) is None and stable_identity(node, self.reader.read(node_pid)),\n                    'owned_node_lifetime_changed')\n            launcher = self.reader.read(launcher_pid)\n            require(launcher['ppid'] == node_pid and launcher['pgid'] == node_pid\n                    and launcher['uid'] == node['uid']\n                    and (launcher['birthSec'], launcher['birthUsec'])\n                    >= (node['birthSec'], node['birthUsec']),\n                    'launcher_real_parent_group_birth')\n            # /usr/bin/env may briefly precede the pinned shebang Node runtime.\n            # No ACK is issued until the exact managed Node launcher is live.\n            if launcher['executable'] != self.expected['nodeExecutable']:\n                time.sleep(0.025)\n                continue\n            if pinned_launcher is None:\n                pinned_launcher = launcher\n            require(stable_identity(pinned_launcher, launcher), 'launcher_lifetime_changed')\n            native_candidates = []\n            for pid in self.reader.children(launcher_pid):\n                try:\n                    child = self.reader.read(pid)\n                except ObservationRefused:\n                    continue\n                if child['executable'] == self.expected['nativeExecutable']:\n                    native_candidates.append(child)\n            require(len(native_candidates) <= 1, 'single_exact_native_child')\n            if not native_candidates:\n                time.sleep(0.025)\n                continue\n            native = native_candidates[0]\n            require(native['ppid'] == launcher_pid and native['pgid'] == node_pid\n                    and native['uid'] == node['uid']\n                    and (native['birthSec'], native['birthUsec'])\n                    >= (launcher['birthSec'], launcher['birthUsec']),\n                    'native_real_parent_group_birth')\n            first = {'node': node, 'launcher': launcher, 'native': native}\n            time.sleep(0.02)\n            second = {key: self.reader.read(value['pid']) for key, value in first.items()}\n            require(retained_exit_observation(self.proc) is None and first == second,\n                    'entire_chain_birth_and_executable_recheck')\n            require(time.monotonic() < deadline, 'observer_deadline_after_recheck')\n            return first\n        raise ObservationRefused('owned_native_chain_observation_deadline')\n\n    def poll(self, outer_deadline):\n        if self.handled:\n            return\n        require(time.monotonic() < outer_deadline, 'parent_deadline_before_observation')\n        ready, _, _ = select.select([self.request_read], [], [], 0)\n        if not ready:\n            return\n        part = os.read(self.request_read, 8193)\n        if not part:\n            return\n        self.buffer.extend(part)\n        require(len(self.buffer) <= 8192, 'bounded_observer_request')\n        if b'\\n' not in self.buffer:\n            return\n        self.handled = True\n        self.report['requests'] = 1\n        nonce = None\n        observation_deadline = min(time.monotonic() + 3, outer_deadline)\n        try:\n            line, remaining = self.buffer.split(b'\\n', 1)\n            require(not remaining, 'single_observer_request')\n            request = json.loads(line.decode('utf-8'))\n            nonce = request.get('nonce') if isinstance(request, dict) else None\n            chain = self.verify_chain(request, observation_deadline)\n            require(time.monotonic() < observation_deadline, 'observer_deadline_before_success_ack')\n            ack = {'schema': 'heptabao.owned-native-ack.v1',\n                   'nonce': nonce, 'verified': True, 'identities': chain}\n        except Exception as error:\n            self.rejected = True\n            safe_error = str(error) if isinstance(error, ObservationRefused) else type(error).__name__\n            self.report['error'] = safe_error\n            ack = {'schema': 'heptabao.owned-native-ack.v1',\n                   'nonce': nonce, 'verified': False, 'error': safe_error}\n        data = (json.dumps(ack, separators=(',', ':')) + '\\n').encode()\n        require(len(data) <= 4096, 'bounded_atomic_observer_ack')\n        if ack['verified']:\n            require(time.monotonic() < observation_deadline, 'observer_deadline_at_success_ack')\n        count = os.write(self.response_write, data)\n        require(count == len(data), 'complete_observer_ack')\n        if ack['verified']:\n            self.report.update(verified=True, identities=chain,\n                               birthMicrosecondsBound=True,\n                               beforeFirstNativeRpc=True,\n                               nativeObservationBudgetSeconds=3,\n                               parentAbsoluteDeadlinePreserved=True)\n        require(self.close_fd_once(self.response_write), 'observer_response_end_close_unconfirmed')\n        self.response_write = None\n\n    def close(self):\n        for fd in self.fd_closures:\n            self.close_fd_once(fd)\n        self.child_ends_closed = all(self.fd_closures[fd]['closed'] for fd in self.child_fds)\n        self.request_read = None\n        self.response_write = None\n        self.report['pipeFdClosures'] = [dict(row) for row in self.fd_closures.values()]\n        self.report['allPipeFdsClosed'] = all(row['closed'] for row in self.fd_closures.values())\n        return self.report['allPipeFdsClosed']\n","mac_guarded_current_capture_r3.py":"#!/usr/bin/env python3\n\"\"\"Bounded current Mac credential observation; no whole-database copy.\n\nLibrary only: no import-time I/O, subprocess, SQL, write or CLI entry. Its caller\nmust be an explicitly reviewed sandbox-exec capture process with production\nwrites and all networking denied. Actual synthetic SQLite proof is mandatory.\nImmutable intentionally skips SQLite change detection; our held FD/name fences\ndo not turn this into a SQLite transaction snapshot or a cross-agent snapshot.\n\"\"\"\nfrom __future__ import annotations\nimport base64, hashlib, json, os, re, sqlite3, stat, sys, time, _sqlite3\nfrom pathlib import Path\n\nLIVE=Path('/Users/qianqi/.openclaw')\nAGENTS=('main','trnm','hepta-ui','hepta','hepta-backend')\nCACHE_NAMES=('applied-profiles.json','publish-baseline.json','bad-refresh-quarantine.json',\n             'refresh-backoff.json','lease-epochs.json','status.json')\nTABLES=(('store','auth_profile_store','store_key','store_json'),\n        ('state','auth_profile_state','state_key','state_json'))\nCONFIG_SHA='ca2dd7d7879fa901dfb24e00837b56a4e0fd230600d7ed1e3086eda194187d4d'\nMIB=1024*1024\nMAX_RETURNED_AND_READ_BYTES=8*MIB\nMAX_ROW_BYTES=MIB\nMAX_QUERY_SECONDS=3.0\nNEW_CAPTURE_SECONDS=45.0\n\nclass CaptureRefused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise CaptureRefused(code)\ndef encoded(value):\n    return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False)+'\\n').encode()\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef identity(s):\n    return tuple(str(v) for v in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n                                 s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\ndef parent_identity(s):return identity(s)[:5]\n\nclass FixedInputs:\n    def __init__(self, *, until, critical, cancelled, live=LIVE, synthetic=False):\n        need(callable(critical) and callable(cancelled),'descriptor_signal_and_cancellation_guards_required')\n        synthetic_root=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-r10-current-consumer-r1/capture-sqlite-synthetic-r1')\n        need(live==LIVE or (synthetic and Path(live).is_relative_to(synthetic_root)),\n             'synthetic_root_requires_fixed_owned_component_scope')\n        self.live=Path(live);self.synthetic=synthetic;self.until=until;self.critical=critical;self.cancelled=cancelled\n        self.fds=[];self.parents={};self.files={};self.absent={};self.connections=[];self.byte_count=0\n        self.closed=False;self.close_errors=[];self.verified=False\n        self.uid=os.geteuid()\n        need(self.uid==501 or synthetic,'actual_mac_uid')\n    def remaining(self,until=None):\n        need(not self.cancelled(),'capture_cancelled')\n        n=min(self.until,until if until is not None else self.until)-time.monotonic()\n        need(n>0,'original_capture_or_query_deadline_exhausted')\n        return n\n    def _open_fd(self,name,flags,parent=None):\n        self.remaining()\n        with self.critical():\n            fd=os.open(name,flags,**({} if parent is None else {'dir_fd':parent}))\n            row={'fd':fd,'closeAttempted':False,'closed':False};self.fds.append(row)\n        return row\n    def parent(self,path):\n        path=Path(path)\n        need(path.is_absolute() and path==Path(os.path.normpath(str(path)))\n             and path.is_relative_to(self.live),'fixed_current_input_scope')\n        target=path.parent\n        previous=None\n        for directory in [Path('/'),*reversed(target.parents),target]:\n            # reversed(target.parents) already contains '/'; do not observe it twice.\n            key=str(directory)\n            if key in self.parents:\n                previous=self.parents[key];continue\n            if directory==Path('/'):\n                name='/';named=os.lstat('/')\n            else:\n                need(previous is not None and Path(previous['path'])==directory.parent,\n                     'held_parent_chain_order')\n                name=directory.name\n                named=os.stat(name,dir_fd=previous['fd'],follow_symlinks=False)\n            known_synthetic_mount=(self.synthetic and directory==Path('/Volumes/T5')\n                and named.st_uid==0 and named.st_gid==0 and stat.S_IMODE(named.st_mode)==0o775)\n            need(stat.S_ISDIR(named.st_mode) and (known_synthetic_mount\n                 or not stat.S_IMODE(named.st_mode)&0o022),'current_parent_plain_no_external_write')\n            # The component's separate HeldT5 UUID/whole-identity guard admits\n            # only this actual root-owned mount; production /Users code has no exception.\n            if directory==self.live or directory.is_relative_to(self.live):\n                need(named.st_uid==self.uid,'current_parent_owner')\n            row=self._open_fd(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,\n                              None if previous is None else previous['fd'])\n            need(parent_identity(os.fstat(row['fd']))==parent_identity(named),'held_parent_open_identity')\n            row.update(path=key,name=name,parent=previous,expected=parent_identity(named))\n            self.parents[key]=row;previous=row\n        need(previous['path']==str(target),'exact_current_input_parent')\n        return previous\n    def directory(self,path,*,optional=False):\n        path=Path(path);key=str(path)\n        if key in self.parents:return self.parents[key]\n        parent=self.parent(path)\n        try:named=os.stat(path.name,dir_fd=parent['fd'],follow_symlinks=False)\n        except FileNotFoundError:\n            need(optional,'required_current_directory_absent')\n            self.absent[key]={'parent':parent,'name':path.name}\n            return None\n        need(stat.S_ISDIR(named.st_mode) and named.st_uid==self.uid\n             and not stat.S_IMODE(named.st_mode)&0o022,'current_directory_custody')\n        row=self._open_fd(path.name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,parent['fd'])\n        need(parent_identity(os.fstat(row['fd']))==parent_identity(named),'current_directory_fd')\n        row.update(path=key,name=path.name,parent=parent,expected=parent_identity(named))\n        self.parents[key]=row\n        return row\n    def hold(self,path,*,optional=False,maximum=None,require_empty=False,private=True):\n        path=Path(path);key=str(path)\n        if key in self.files:return self.files[key]\n        need(key not in self.absent,'absence_not_reopened_as_present')\n        parent=self.parent(path)\n        try:named=os.stat(path.name,dir_fd=parent['fd'],follow_symlinks=False)\n        except FileNotFoundError:\n            need(optional,'required_current_input_absent')\n            self.absent[key]={'parent':parent,'name':path.name}\n            return None\n        need(stat.S_ISREG(named.st_mode) and named.st_uid==self.uid and named.st_nlink==1\n             and (stat.S_IMODE(named.st_mode)==0o600 if private else\n                  stat.S_IMODE(named.st_mode)&0o022==0) and named.st_size>=0,'current_input_custody')\n        if maximum is not None:need(named.st_size<=maximum,'current_input_size_bound')\n        if require_empty:need(named.st_size==0,'nonempty_wal_refused_before_sqlite')\n        row=self._open_fd(path.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,parent['fd'])\n        need(identity(named)==identity(os.fstat(row['fd'])),'current_input_open_identity')\n        row.update(path=key,parent=parent,name=path.name,expected=identity(named))\n        self.files[key]=row\n        return row\n    def account(self,size):\n        need(type(size) is int and size>=0,'byte_accounting')\n        self.byte_count+=size\n        need(self.byte_count<=MAX_RETURNED_AND_READ_BYTES,'capture_returned_and_read_byte_cap')\n    def read(self,path,*,optional=False,maximum=MIB,private=True):\n        row=self.hold(path,optional=optional,maximum=maximum,private=private)\n        if row is None:return None\n        os.lseek(row['fd'],0,os.SEEK_SET);parts=[];count=0\n        while count<=maximum:\n            self.remaining()\n            data=os.read(row['fd'],min(65536,maximum+1-count))\n            if not data:break\n            count+=len(data);self.account(len(data));parts.append(data)\n        need(count==int(row['expected'][6]),'current_input_read_length')\n        self.verify()\n        return b''.join(parts)\n    def database(self,path):\n        main=self.hold(path)\n        need(int(main['expected'][6])>=512,'current_database_header_bound')\n        wal=self.hold(Path(str(path)+'-wal'),optional=True,maximum=0,require_empty=True)\n        shm=self.hold(Path(str(path)+'-shm'),optional=True,maximum=8*MIB)\n        journal=self.hold(Path(str(path)+'-journal'),optional=True,maximum=0)\n        need(journal is None,'rollback_journal_refused_before_immutable')\n        # We deliberately do not read/copy the main database or SHM bytes.\n        self.verify()\n        return main\n    def verify(self):\n        self.remaining();self.verified=False\n        for row in self.parents.values():\n            named=os.lstat('/') if row['parent'] is None else os.stat(\n                row['name'],dir_fd=row['parent']['fd'],follow_symlinks=False)\n            need(parent_identity(named)==parent_identity(os.fstat(row['fd']))==row['expected'],\n                 'held_current_parent_changed')\n        for row in self.files.values():\n            named=os.stat(row['name'],dir_fd=row['parent']['fd'],follow_symlinks=False)\n            need(identity(named)==identity(os.fstat(row['fd']))==row['expected'],\n                 'current_input_fd_name_or_metadata_changed')\n        for row in self.absent.values():\n            try:os.stat(row['name'],dir_fd=row['parent']['fd'],follow_symlinks=False)\n            except FileNotFoundError:pass\n            else:raise CaptureRefused('current_input_absence_changed')\n        self.remaining();self.verified=True\n    def close(self):\n        if self.closed:return\n        for row in reversed(self.fds):\n            if row['closeAttempted']:continue\n            with self.critical():\n                row['closeAttempted']=True\n                try:os.close(row['fd']);row['closed']=True\n                except BaseException as error:self.close_errors.append(type(error).__name__)\n        self.closed=True\n    def public(self):\n        return {'boundedReadAndReturnedBytes':self.byte_count,\n            'sqlitePageReadBytesMeasured':False,'wholeDatabaseCopied':False,\n            'wholeDatabaseBackupQualified':False,'sqliteTransactionSnapshotClaimed':False,\n            'crossAgentAtomicSnapshotClaimed':False,'observation':'bounded_point_in_time_with_fd_name_fences',\n            'actualDatabaseSizes':{p:int(r['expected'][6]) for p,r in self.files.items() if p.endswith('.sqlite')},\n            'files':{p:{'identity':list(r['expected'])} for p,r in self.files.items()},\n            'absentPaths':list(self.absent),'allHeldNamesVerified':self.verified,\n            'allOwnedDescriptorsClosed':self.closed and all(r['closed'] for r in self.fds)\n                and all(r['closed'] for r in self.connections),\n            'sqliteConnectionsOpened':len(self.connections),\n            'sqliteConnectionsClosed':sum(r['closed'] for r in self.connections),\n            'closeErrors':list(self.close_errors)}\n\ndef public_code_pin(path,*,remaining,critical):\n    # Public interpreter/extension/source hashes have their own fixed 64MiB\n    # per-file bound. They do not pretend to be measured SQLite page I/O.\n    remaining();path=Path(path).resolve(strict=True)\n    with critical():\n        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n    try:\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and 0<before.st_size<=64*MIB\n             and not stat.S_IMODE(before.st_mode)&0o022,'public_runtime_code_custody')\n        digest=hashlib.sha256();count=0\n        while count<=before.st_size:\n            remaining()\n            raw=os.read(fd,min(MIB,before.st_size+1-count))\n            if not raw:break\n            count+=len(raw);digest.update(raw)\n        need(count==before.st_size and identity(before)==identity(os.fstat(fd))==identity(path.lstat()),\n             'public_runtime_code_changed')\n        remaining()\n        result={'path':str(path),'bytes':count,'sha256':digest.hexdigest()}\n    finally:\n        with critical():os.close(fd)\n    remaining()\n    return result\n\ndef runtime_identity(*,remaining,critical):\n    return {'pythonExecutable':public_code_pin(sys.executable,remaining=remaining,critical=critical),\n            'sqliteExtension':public_code_pin(_sqlite3.__file__,remaining=remaining,critical=critical),\n            'pythonVersion':sys.version,'sqliteVersion':sqlite3.sqlite_version,\n            'sqliteVersionInfo':list(sqlite3.sqlite_version_info)}\n\n\ndef validate_synthetic_proof(raw, expected_sha,*,remaining,critical):\n    remaining()\n    need(isinstance(raw,bytes) and len(raw)<=65536 and sha(raw)==expected_sha,\n         'actual_synthetic_proof_original_bytes')\n    proof=json.loads(raw)\n    need(isinstance(proof,dict)\n         and proof.get('schema')=='heptabao.mac-immutable-capture-synthetic.r1'\n         and proof.get('ok') is True\n         and proof.get('runtime')==runtime_identity(remaining=remaining,critical=critical)\n         and proof.get('captureSourceSha256')==public_code_pin(\n             __file__,remaining=remaining,critical=critical)['sha256'],\n         'actual_same_runtime_synthetic_proof_required')\n    need(proof.get('ownedDatabaseOnly') is True and proof.get('productionOpened') is False\n         and proof.get('sameHeldFdUriCode') is True and proof.get('readonlyImmutableConnection') is True\n         and proof.get('absentSidecarsStayedAbsent') is True\n         and proof.get('emptyWalStayedEmpty') is True and proof.get('nonemptyWalRefusedBeforeConnect') is True\n         and proof.get('journalRefusedBeforeConnect') is True\n         and proof.get('oversizeRowRefused') is True and proof.get('driftRefused') is True\n         and proof.get('allOwnedDescriptorsClosed') is True,'synthetic_negative_boundaries_required')\n    remaining()\n\ndef immutable_query(inputs,main,query):\n    inputs.verify()\n    until=min(inputs.until,time.monotonic()+MAX_QUERY_SECONDS)\n    inputs.remaining(until)\n    need(hasattr(sqlite3.Connection,'setlimit') and hasattr(sqlite3,'SQLITE_LIMIT_LENGTH'),\n         'actual_sqlite_length_limit_support_required')\n    # /dev/fd/N reopens the already held read-only inode. The same exact URI\n    # and runtime must first pass the owned synthetic proof; there is no\n    # named-path fallback and no initial production experiment.\n    uri='file:/dev/fd/'+str(main['fd'])+'?mode=ro&immutable=1'\n    with inputs.critical():\n        db=sqlite3.connect(uri,uri=True,timeout=0.0,isolation_level=None)\n        connection={'db':db,'closeAttempted':False,'closed':False}\n        inputs.connections.append(connection)\n    try:\n        db.setlimit(sqlite3.SQLITE_LIMIT_LENGTH,MAX_ROW_BYTES+65536)\n        db.setlimit(sqlite3.SQLITE_LIMIT_SQL_LENGTH,8192)\n        db.enable_load_extension(False)\n        db.set_progress_handler(lambda:1 if time.monotonic()>=until else 0,1000)\n        db.execute('PRAGMA query_only=ON')\n        db.execute('PRAGMA temp_store=MEMORY')\n        need(db.execute('PRAGMA query_only').fetchone()==(1,),'connection_query_only')\n        db.execute('BEGIN')\n        value=query(db,until)\n        inputs.remaining(until)\n        db.execute('ROLLBACK')\n    finally:\n        with inputs.critical():\n            connection['closeAttempted']=True\n            try:db.close();connection['closed']=True\n            except BaseException as error:\n                inputs.close_errors.append(type(error).__name__)\n                raise\n    inputs.remaining(until);inputs.verify()\n    return value\n\ndef auth_rows(inputs,agent):\n    path=inputs.live/'agents'/agent/'agent/openclaw-agent.sqlite'\n    main=inputs.database(path)\n    def query(db,until):\n        result={}\n        allowed_tables={x[1] for x in TABLES}\n        allowed_columns={t:{k,c,'updated_at'} for _,t,k,c in TABLES}\n        def authorize(action,arg1,arg2,_db,_trigger):\n            if action==sqlite3.SQLITE_SELECT:return sqlite3.SQLITE_OK\n            if action==sqlite3.SQLITE_READ and arg1 in allowed_tables and arg2 in allowed_columns[arg1]:\n                return sqlite3.SQLITE_OK\n            if action==sqlite3.SQLITE_TRANSACTION and arg1 in ('ROLLBACK',):return sqlite3.SQLITE_OK\n            return sqlite3.SQLITE_DENY\n        db.set_authorizer(authorize)\n        for kind,table,key,column in TABLES:\n            inputs.remaining(until)\n            rows=db.execute('SELECT '+key+','+column+',updated_at FROM '+table+\n                            ' WHERE '+key+'=? LIMIT 2',('primary',)).fetchall()\n            need(len(rows)<=1,'fixed_primary_row_count')\n            for row in rows:\n                need(len(row)==3 and row[0]=='primary' and isinstance(row[1],str)\n                     and type(row[2]) is int and 0<=row[2]<=9007199254740991,'fixed_primary_row_shape')\n                raw=row[1].encode('utf-8')\n                need(len(raw)<=MAX_ROW_BYTES,'auth_primary_payload_cap')\n                parsed=json.loads(raw)\n                need(isinstance(parsed,dict),'auth_primary_json_object')\n                if kind=='store':\n                    need(isinstance(parsed.get('profiles',{}),dict)\n                         and len(parsed.get('profiles',{}))<=128,'bounded_local_profile_dictionary')\n                inputs.account(len(raw)+len(encoded(row)))\n            result[kind]=[list(row) for row in rows]\n        return result\n    rows=immutable_query(inputs,main,query)\n    return {'schema':'heptabao.mac-current-primary-auth-rows.private.r1','agent':agent,\n            'rows':rows,'sourceIdentity':list(main['expected']),\n            'captureScope':'two_fixed_primary_keys_only','nonprimaryRowsCaptured':False}\n\ndef installed_registry(inputs):\n    main=inputs.database(inputs.live/'state/openclaw.sqlite')\n    def query(db,until):\n        # A finite, named table and one fixed key. Physical column order is\n        # retained explicitly, never compared against another SELECT ordering.\n        schema_rows=db.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name=?\",\n                               ('installed_plugin_index',)).fetchall()\n        need(len(schema_rows)==1 and isinstance(schema_rows[0][0],str)\n             and len(schema_rows[0][0].encode())<=16384,'bounded_actual_registry_schema')\n        info=db.execute('PRAGMA table_info(installed_plugin_index)').fetchall()\n        names=[x[1] for x in info]\n        need(len(names)==len(set(names))==13 and all(re.fullmatch('[a-z_]+',x) for x in names)\n             and 'index_key' in names,'actual_installed_registry_thirteen_named_columns')\n        rows=db.execute('SELECT '+','.join('\"'+x+'\"' for x in names)+\n                        ' FROM installed_plugin_index WHERE index_key=? LIMIT 2',\n                        ('installed-plugin-index',)).fetchall()\n        need(len(rows)==1 and len(rows[0])==13,'one_actual_installed_registry_row')\n        need(all(x is None or type(x) in (str,int,float) for x in rows[0]),'registry_scalar_columns')\n        record={'schema':schema_rows[0][0],'columns':names,'row':list(rows[0]),'tableInfo':[list(x) for x in info]}\n        raw=encoded(record);need(len(raw)<=MIB,'registry_returned_byte_cap');inputs.account(len(raw))\n        return record\n    return immutable_query(inputs,main,query)\n\ndef current_models(cfg):\n    declared=cfg.get('agents',{}).get('list')\n    need(isinstance(declared,list) and tuple(x.get('id') for x in declared)==AGENTS,'actual_five_declared_agents')\n    defaults=cfg.get('agents',{}).get('defaults',{})\n    def primary(value):return value.get('primary') if isinstance(value,dict) else value\n    models={}\n    for item in declared:\n        agent=item['id'];directory=LIVE/'agents'/agent/'agent'\n        need(Path(item.get('agentDir',directory))==directory,'actual_agent_directory')\n        origin='agent' if 'model' in item else 'defaults'\n        selected=primary(item.get('model',defaults.get('model')))\n        need(isinstance(selected,str) and re.fullmatch('[A-Za-z0-9_.-]+/[A-Za-z0-9_./:-]+',selected),\n             'actual_declared_or_default_model_shape')\n        provider,model=selected.split('/',1)\n        models[agent]={'provider':provider,'id':model,\n            'origin':origin,'declaredModelSha256':sha(encoded(item.get('model',defaults.get('model')))),\n            'sourceConfigSha256':CONFIG_SHA}\n    return models\n\ndef capture_current(*,critical,cancelled,synthetic_proof,synthetic_proof_sha,until):\n    need(sys.platform=='darwin' and os.getuid()==501,'exact_current_mac')\n    need(until<=time.monotonic()+NEW_CAPTURE_SECONDS,'one_capture_budget_no_reset')\n    inputs=FixedInputs(until=until,critical=critical,cancelled=cancelled)\n    validate_synthetic_proof(synthetic_proof,synthetic_proof_sha,\n                            remaining=inputs.remaining,critical=critical)\n    document=None\n    try:\n        raw_config=inputs.read(LIVE/'openclaw.json')\n        need(sha(raw_config)==CONFIG_SHA,'actual_current_config_pin')\n        cfg=json.loads(raw_config);models=current_models(cfg)\n        documents=[auth_rows(inputs,agent) for agent in AGENTS]\n        caches={}\n        cache_directory=inputs.directory(LIVE/'authbus',optional=True)\n        for name in CACHE_NAMES:\n            raw=None if cache_directory is None else inputs.read(LIVE/'authbus'/name,optional=True)\n            caches[name]={'present':False} if raw is None else {\n                'present':True,'mode':0o600,'bytes':len(raw),'sha256':sha(raw),\n                'base64':base64.b64encode(raw).decode('ascii')}\n        native={}\n        for agent in AGENTS:\n            directory=LIVE/'agents'/agent/'agent/codex-home';values={}\n            native_directory=inputs.directory(directory,optional=True)\n            values['directoryPresent']=native_directory is not None\n            for name in ('config.toml','requirements.toml','auth.json'):\n                raw=None if native_directory is None else inputs.read(directory/name,optional=True,\n                      private=name=='auth.json')\n                values[name]={'present':False} if raw is None else {\n                    'present':True,'bytes':len(raw),'sha256':sha(raw)}\n                if raw is not None and name!='auth.json':\n                    values[name]['base64']=base64.b64encode(raw).decode('ascii')\n            native[agent]=values\n        registry=installed_registry(inputs)\n        inputs.verify()\n        document={'schema':'heptabao.mac-guarded-current-inputs.private.r1',\n            'sourceConfigSha256':CONFIG_SHA,'configBase64':base64.b64encode(raw_config).decode('ascii'),\n            'agentIds':list(AGENTS),'models':models,'authDocuments':documents,\n            'authbusCaches':{'directoryPresent':cache_directory is not None,'files':caches},\n            'nativeHomes':native,'registry':registry,\n            'runtime':runtime_identity(remaining=inputs.remaining,critical=critical),\n            'syntheticProofSha256':synthetic_proof_sha,\n            'scope':'bounded_point_in_time_observation_not_database_or_cross_agent_snapshot'}\n        need(len(encoded(document))<=4*MIB,'combined_private_capsule_bound')\n        inputs.verify()\n    finally:inputs.close()\n    public=inputs.public()\n    need(public['allOwnedDescriptorsClosed'] and not public['closeErrors'],'current_input_descriptor_closure')\n    completed=time.monotonic()\n    need(completed<until,'original_capture_deadline_after_close_and_summary')\n    public['completedMonotonic']=completed\n    public['originalCaptureDeadlineMonotonic']=until\n    public['outerMustRecheckAfterPrivatePublication']=True\n    return document,public\n","mac_owned_commands_r1.py":"#!/usr/bin/env python3\n\"\"\"Bounded foreground commands with retained direct-child custody.\n\nNo import-time I/O. The caller supplies exact reviewed argv and an absolute\ncommand deadline. Pipe reads, exit observation and metadata capture share it.\nCleanup uses the separate once-only TERM1/wait5/group3 custody contract.\n\"\"\"\nfrom __future__ import annotations\nfrom contextlib import contextmanager\nimport hashlib, os, select, signal, subprocess, time\nfrom mac_owned_unreaped_r1 import require_waitid, capture_child, exit_observation, observed_returncode, stop_once_unreaped\n\nclass CommandRefused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise CommandRefused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\n\nclass Signals:\n    def __init__(self):\n        self.protected=0;self.pending=None\n    def receive(self,signum,_frame):\n        self.pending=signum\n        if not self.protected:raise KeyboardInterrupt()\n    def install(self):\n        signal.signal(signal.SIGTERM,self.receive);signal.signal(signal.SIGINT,self.receive)\n    @contextmanager\n    def critical(self):\n        self.protected+=1\n        try:yield\n        finally:self.protected-=1\n\nclass Commands:\n    def __init__(self,signals):\n        self.signals=signals;self.rows=[]\n    def run(self,label,argv,*,until,allow_cancelled_cleanup=False,maximum=2*1024*1024):\n        need(isinstance(label,str) and label.replace('-','').replace('_','').isalnum(),'safe_command_label')\n        need(type(maximum) is int and 0<maximum<=2*1024*1024,'fixed_command_output_bound')\n        need(isinstance(argv,list) and argv and all(isinstance(x,str) for x in argv),'explicit_argv')\n        def remaining():\n            if not allow_cancelled_cleanup:need(self.signals.pending is None,'command_cancelled')\n            n=until-time.monotonic();need(n>0,'original_command_deadline_exhausted');return n\n        require_waitid();remaining()\n        started=time.monotonic();row=None;out=bytearray();err=bytearray()\n        try:\n            with self.signals.critical():\n                remaining()\n                p=subprocess.Popen(argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,\n                    env={'PATH':'/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin','LANG':'C','LC_ALL':'C'},\n                    start_new_session=True,close_fds=True)\n                row={'label':label,'argv':list(argv),'process':p,'custody':None,\n                     'stopAttempted':False,'streamsCloseAttempted':False,'streamsClosed':False,\n                     'completeBeforeDeadline':False,'errorType':None,'errorCode':None}\n                self.rows.append(row)\n            row['custody']=capture_child(p,until=until)\n            streams={p.stdout.fileno():out,p.stderr.fileno():err}\n            for fd in streams:os.set_blocking(fd,False)\n            event=None\n            while streams or event is None:\n                left=remaining()\n                ready,_,_=select.select(list(streams),[],[],min(left,0.025))\n                for fd in ready:\n                    data=os.read(fd,65536)\n                    if not data:del streams[fd]\n                    else:\n                        target=streams[fd];target.extend(data)\n                        need(len(target)<=maximum,'command_output_bound')\n                event=exit_observation(p)\n            remaining()\n            row['completeBeforeDeadline']=True\n            row['observedExit']=event\n            row['observedExitCode']=observed_returncode(event)\n        except BaseException as error:\n            if row is None:raise\n            row['errorType']=type(error).__name__\n            row['errorCode']=str(error) if isinstance(error,CommandRefused) else None\n        finally:\n            if row is not None:\n                with self.signals.critical():\n                    row['stopAttempted']=True\n                    try:row['cleanup']=stop_once_unreaped(row['process'],row['custody'])\n                    except BaseException as error:\n                        row['cleanup']={'ok':False,'outcomeUnknown':True,\n                            'errorType':type(error).__name__,'directChildReaped':row['process'].returncode is not None,\n                            'allGroupRowsEmptyAfterReap':False}\n                    row['streamsCloseAttempted']=True\n                    errors=[]\n                    for stream in (row['process'].stdout,row['process'].stderr):\n                        try:stream.close()\n                        except BaseException as error:errors.append(type(error).__name__)\n                    row['streamsClosed']=not errors\n                    row['streamCloseErrors']=errors\n        p=row['process'];cleanup=row['cleanup']\n        public={'label':label,'argv':list(argv),'pid':p.pid,'exitCode':p.returncode,\n            'completeBeforeDeadline':row['completeBeforeDeadline'],\n            'commandDeadlineMonotonic':until,'elapsedSeconds':time.monotonic()-started,\n            'errorType':row['errorType'],'errorCode':row['errorCode'],'cleanup':cleanup,\n            'stdoutBytes':len(out),'stdoutSha256':sha(out),'stderrBytes':len(err),'stderrSha256':sha(err),\n            'streamsClosed':row['streamsClosed'],\n            'outcomeUnknown':not(row['completeBeforeDeadline'] and cleanup.get('ok') is True\n                and cleanup.get('directChildReaped') is True and cleanup.get('allGroupRowsEmptyAfterReap') is True\n                and row['streamsClosed'] and row['errorType'] is None)}\n        row['public']=public\n        return public,bytes(out),bytes(err)\n    def public(self):\n        values=[r.get('public') for r in self.rows]\n        return {'commands':values,'allOwnedCommandsStopped':all(v is not None\n            and v['cleanup'].get('directChildReaped') is True\n            and v['cleanup'].get('allGroupRowsEmptyAfterReap') is True\n            and v['streamsClosed'] for v in values),\n            'unknownCommandCount':sum(v is None or v['outcomeUnknown'] for v in values)}\n","mac_t5_volume_guard_r1.py":"#!/usr/bin/env python3\n\"\"\"Held, observed T5 anchors and scoped descriptor-relative owned I/O.\n\nNo module-level I/O. No private path is opened before both the exact public\nanchor input and actual owned diskutil output have been checked. This module\ndoes not run diskutil or claim a volume-wide atomic snapshot.\n\"\"\"\nfrom __future__ import annotations\nfrom contextlib import contextmanager\nimport hashlib, json, os, plistlib, stat, time\nfrom pathlib import Path\n\nMOUNT = Path('/Volumes/T5')\nROOT = MOUNT / 'hepta-vnext-recovery-20261013/mac-authbus-df026-current-registry-wal-r1'\nUUID = 'FB804D1B-24CB-4D6E-AEA7-A9E180807758'\nANCHOR_PATHS = ('/', '/Volumes', '/Volumes/T5')\n\nclass VolumeRefused(RuntimeError): pass\n\ndef require(value, code):\n    if not value: raise VolumeRefused(code)\n\ndef identity(info):\n    return tuple(str(x) for x in (info.st_dev, info.st_ino, info.st_uid,\n        info.st_gid, info.st_mode, info.st_nlink, info.st_size,\n        info.st_mtime_ns, info.st_ctime_ns))\n\ndef inode_identity(info):\n    return identity(info)[:5]\n\nclass HeldT5:\n    def __init__(self, raw_public, expected_sha256, remaining, critical):\n        require(isinstance(raw_public, bytes) and len(raw_public) <= 8192,\n                'public_anchor_input_bound')\n        require(hashlib.sha256(raw_public).hexdigest() == expected_sha256,\n                'public_anchor_whole_sha')\n        expected = json.loads(raw_public)\n        require(set(expected) == {'schema', 'source_inventory_sha256', 'volumeUUID',\n                  'expectedVolumeDevice', 'anchors'}\n          and expected['schema'] == 'heptabao.mac-current-t5-public-anchor.r1'\n          and expected['volumeUUID'] == UUID, 'public_anchor_schema')\n        require([x.get('path') for x in expected['anchors']] == list(ANCHOR_PATHS),\n                'exact_public_anchor_paths')\n        require(all(set(x) == {'path','identity'} and len(x['identity']) == 9\n                    and all(isinstance(v,str) and v.isdecimal() for v in x['identity'])\n                    for x in expected['anchors']), 'public_anchor_identity_shape')\n        require(isinstance(expected['expectedVolumeDevice'],str)\n                and expected['expectedVolumeDevice'].isdecimal()\n                and expected['expectedVolumeDevice'] == expected['anchors'][2]['identity'][0],\n                'captured_volume_device')\n        self.expected, self.remaining, self.critical = expected, remaining, critical\n        self.rows, self.anchors = [], []\n        self.uuid_verified = False\n        self.closed = False\n        self.close_errors = []\n        self.last_anchor_check = False\n        try:\n            parent = None\n            for index, item in enumerate(expected['anchors']):\n                self.remaining()\n                name = '/' if index == 0 else Path(item['path']).name\n                named = os.lstat('/') if index == 0 else os.stat(\n                    name, dir_fd=parent['fd'], follow_symlinks=False)\n                require(stat.S_ISDIR(named.st_mode) and identity(named) == tuple(item['identity']),\n                        'captured_anchor_named_identity')\n                with self.critical():\n                    fd = os.open(name, os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,\n                                 **({} if parent is None else {'dir_fd':parent['fd']}))\n                    row = {'fd':fd,'name':name,'parent':parent,'expected':tuple(item['identity']),\n                           'close_attempted':False,'closed':False,'anchor':True}\n                    self.rows.append(row);self.anchors.append(row)\n                require(identity(os.fstat(fd)) == row['expected'], 'captured_anchor_fd_identity')\n                parent = row\n            self.check()\n        except BaseException:\n            self.close()\n            raise\n\n    def check(self, *, check_deadline=True):\n        require(not self.closed, 'volume_guard_not_closed')\n        if check_deadline: self.remaining()\n        self.last_anchor_check = False\n        for row in self.anchors:\n            named = os.lstat('/') if row['parent'] is None else os.stat(\n                row['name'],dir_fd=row['parent']['fd'],follow_symlinks=False)\n            require(identity(named) == identity(os.fstat(row['fd'])) == row['expected'],\n                    'held_t5_anchor_changed')\n        require(os.fstat(self.anchors[-1]['fd']).st_dev ==\n                int(self.expected['expectedVolumeDevice']), 'held_t5_device_changed')\n        self.last_anchor_check = True\n        if check_deadline: self.remaining()\n\n    def accept_diskutil(self, raw):\n        self.check()\n        require(isinstance(raw,bytes) and len(raw) <= 262144, 'bounded_actual_diskutil_bytes')\n        info = plistlib.loads(raw)\n        require(info.get('VolumeUUID') == UUID and info.get('MountPoint') == str(MOUNT),\n                'actual_t5_uuid_mount')\n        self.uuid_verified = True\n        self.check()\n\n    def _admit(self, path):\n        self.check()\n        require(self.uuid_verified, 'uuid_before_owned_private_io')\n        path = Path(path)\n        require(path.is_absolute() and path == Path(os.path.normpath(str(path)))\n                and path.is_relative_to(ROOT), 'fixed_owned_t5_scope')\n        return path\n\n    def _close_row(self, row):\n        if row['close_attempted']: return\n        with self.critical():\n            row['close_attempted'] = True\n            try:\n                os.close(row['fd']);row['closed'] = True\n            except BaseException as error:\n                self.close_errors.append(type(error).__name__)\n                raise\n\n    @contextmanager\n    def parent(self, path):\n        path = self._admit(path)\n        parts = path.relative_to(MOUNT).parts\n        require(parts and all(part not in ('','.', '..') for part in parts),\n                'owned_component_shape')\n        previous = self.anchors[-1]\n        borrowed = []\n        try:\n            for component in parts[:-1]:\n                self.remaining()\n                named = os.stat(component,dir_fd=previous['fd'],follow_symlinks=False)\n                require(stat.S_ISDIR(named.st_mode) and named.st_uid == 501\n                        and named.st_dev == int(self.expected['expectedVolumeDevice'])\n                        and stat.S_IMODE(named.st_mode)&0o022 == 0, 'owned_parent_custody')\n                with self.critical():\n                    fd = os.open(component,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,\n                                 dir_fd=previous['fd'])\n                    row = {'fd':fd,'name':component,'parent':previous,\n                           'expected_inode':inode_identity(named),\n                           'close_attempted':False,'closed':False,'anchor':False}\n                    self.rows.append(row);borrowed.append(row)\n                require(inode_identity(os.fstat(fd)) == row['expected_inode'],\n                        'owned_parent_fd_identity')\n                previous = row\n            self.check()\n            yield previous['fd'], parts[-1]\n            for row in borrowed:\n                named = os.stat(row['name'],dir_fd=row['parent']['fd'],follow_symlinks=False)\n                require(inode_identity(named) == inode_identity(os.fstat(row['fd']))\n                        == row['expected_inode'], 'owned_parent_changed')\n            self.check()\n        finally:\n            errors = []\n            for row in reversed(borrowed):\n                try:self._close_row(row)\n                except BaseException as error:errors.append(type(error).__name__)\n            if errors: raise VolumeRefused('owned_parent_close_failed')\n\n    def read(self, path, maximum=2*1024*1024, *, private=True):\n        require(type(maximum) is int and 0 < maximum <= 16*1024*1024, 'bounded_owned_read')\n        with self.parent(path) as (parent, name):\n            with self.critical():\n                fd = os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent)\n                row = {'fd':fd,'close_attempted':False,'closed':False,'anchor':False}\n                self.rows.append(row)\n            try:\n                before = os.fstat(fd)\n                require(stat.S_ISREG(before.st_mode) and before.st_uid == 501\n                        and before.st_nlink == 1 and before.st_dev == int(self.expected['expectedVolumeDevice'])\n                        and 0 <= before.st_size <= maximum\n                        and (stat.S_IMODE(before.st_mode) == 0o600 if private else\n                             stat.S_IMODE(before.st_mode)&0o022 == 0), 'owned_file_custody')\n                raw = bytearray()\n                while len(raw) <= maximum:\n                    self.remaining()\n                    block = os.read(fd,min(65536,maximum+1-len(raw)))\n                    if not block:break\n                    raw.extend(block)\n                named = os.stat(name,dir_fd=parent,follow_symlinks=False)\n                require(len(raw) == before.st_size and identity(before) ==\n                        identity(os.fstat(fd)) == identity(named), 'owned_file_stable_read')\n                self.check()\n                return bytes(raw)\n            finally:self._close_row(row)\n\n    def write_new(self, path, raw):\n        require(isinstance(raw,bytes) and len(raw) <= 16*1024*1024, 'bounded_owned_write')\n        with self.parent(path) as (parent, name):\n            with self.critical():\n                fd = os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,\n                             0o600,dir_fd=parent)\n                row = {'fd':fd,'close_attempted':False,'closed':False,'anchor':False}\n                self.rows.append(row)\n            try:\n                before = os.fstat(fd)\n                require(stat.S_ISREG(before.st_mode) and before.st_uid == 501\n                        and before.st_nlink == 1 and before.st_dev == int(self.expected['expectedVolumeDevice']),\n                        'new_owned_file_inode')\n                offset=0\n                while offset<len(raw):\n                    self.remaining()\n                    n=os.write(fd,raw[offset:offset+65536])\n                    require(n>0,'new_owned_write_progress');offset+=n\n                os.fchmod(fd,0o600);os.fsync(fd);os.fsync(parent)\n                after=os.fstat(fd);named=os.stat(name,dir_fd=parent,follow_symlinks=False)\n                require(identity(after)==identity(named) and after.st_size==len(raw)\n                        and inode_identity(before)==inode_identity(after), 'new_owned_file_name')\n                self.check()\n                return {'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),\n                        'identity':list(identity(after))}\n            finally:self._close_row(row)\n\n    @contextmanager\n    def capture_sink(self, path, maximum=2*1024*1024):\n        require(type(maximum) is int and 0<maximum<=2*1024*1024,'bounded_capture_sink')\n        with self.parent(path) as (parent,name):\n            with self.critical():\n                fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,\n                           0o600,dir_fd=parent)\n                row={'fd':fd,'close_attempted':False,'closed':False,'anchor':False}\n                self.rows.append(row)\n                stream=os.fdopen(fd,'wb',buffering=0,closefd=False)\n            before=os.fstat(fd)\n            try:\n                require(stat.S_ISREG(before.st_mode) and before.st_uid==501\n                        and before.st_nlink==1 and stat.S_IMODE(before.st_mode)==0o600\n                        and before.st_dev==int(self.expected['expectedVolumeDevice']),\n                        'capture_sink_custody')\n                yield stream\n                os.fsync(fd);os.fsync(parent)\n                after=os.fstat(fd);named=os.stat(name,dir_fd=parent,follow_symlinks=False)\n                require(after.st_size<=maximum and identity(after)==identity(named)\n                        and inode_identity(before)==inode_identity(after),'capture_sink_stable')\n                self.check()\n            finally:\n                with self.critical():\n                    try:stream.close()\n                    finally:self._close_row(row)\n\n    def mkdir_new(self, path):\n        with self.parent(path) as (parent,name):\n            self.remaining()\n            os.mkdir(name,mode=0o700,dir_fd=parent)\n            info=os.stat(name,dir_fd=parent,follow_symlinks=False)\n            require(stat.S_ISDIR(info.st_mode) and info.st_uid==501\n                    and stat.S_IMODE(info.st_mode)==0o700\n                    and info.st_dev==int(self.expected['expectedVolumeDevice']),'new_owned_directory')\n            os.fsync(parent);self.check()\n            return list(identity(info))\n\n    def public_state(self):\n        return {'schema':'heptabao.held-t5-volume-state.r1',\n                'volumeUUIDVerified':self.uuid_verified,\n                'expectedVolumeDevice':self.expected['expectedVolumeDevice'],\n                'anchors':self.expected['anchors'],'lastAnchorCheckPassed':self.last_anchor_check,\n                'allDescriptorsClosed':all(x['closed'] for x in self.rows),\n                'closeErrors':list(self.close_errors)}\n\n    def close(self):\n        if self.closed:return\n        try:self.check(check_deadline=False)\n        except BaseException:\n            self.last_anchor_check=False\n        for row in reversed(self.rows):\n            try:self._close_row(row)\n            except BaseException:pass\n        self.closed=True\n","mac_owned_unreaped_r1.py":"#!/usr/bin/env python3\n\"\"\"Retained direct-child custody for Mac phase workers.\n\nDerived from canonical native_ha_foreground_watchdog.py 74925449. No child is\nstarted here. WNOWAIT observes exit; it never makes the numeric PGID reusable\nbefore signaling. Cleanup keeps the previous wrapper's TERM1 / wait5 /\ngroup3 limits and PS4 maximum. No stage grants business more than phase120.\n\"\"\"\nimport os, signal, subprocess, time\n\nMIB=1024*1024\nclass Refusal(RuntimeError): pass\ndef need(value,code):\n    if not value:raise Refusal(code)\n\ndef require_waitid():\n    need(all(hasattr(os, name) for name in (\"waitid\", \"P_PID\", \"WEXITED\", \"WNOHANG\", \"WNOWAIT\",\n                                          \"CLD_EXITED\", \"CLD_KILLED\", \"CLD_DUMPED\")),\n         \"wnowait_required_no_child_started\")\n    need(signal.getsignal(signal.SIGCHLD) == signal.SIG_DFL,\n         \"direct_child_reaping_policy_changed\")\n\ndef exit_observation(child):\n    \"\"\"This is an observation, never Popen.poll/wait/communicate.\"\"\"\n    need(child.returncode is None, \"child_already_reaped_no_signal\")\n    event = os.waitid(os.P_PID, child.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)\n    if event is None:\n        return None\n    need(event.si_pid == child.pid and event.si_signo == signal.SIGCHLD\n         and event.si_code in (os.CLD_EXITED, os.CLD_KILLED, os.CLD_DUMPED),\n         \"child_exit_identity_changed\")\n    # Darwin reports si_uid=0 even for an observed uid501 child. Actual UID is\n    # bound independently by ps; si_uid never grants ownership here.\n    return {\"pid\": event.si_pid, \"signo\": event.si_signo, \"code\": event.si_code, \"status\": event.si_status}\n\ndef stable(row):\n    return {key: row[key] for key in (\"pid\", \"ppid\", \"pgid\", \"uid\", \"start\")}\n\ndef ps_rows(pid=None, *, seconds=4.0, until=None):\n    if until is not None:\n        remaining = until - time.monotonic()\n        need(remaining > 0, \"original_stop_deadline_expired\")\n        seconds = min(seconds, remaining)\n    argv = [\"/bin/ps\"]\n    argv += [\"-p\", str(pid)] if pid is not None else [\"-ax\"]\n    argv += [\"-o\", \"pid=,ppid=,pgid=,uid=,stat=,lstart=\"]\n    try:\n        result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\n                                stderr=subprocess.PIPE, env=dict(os.environ, LC_ALL=\"C\"),\n                                timeout=seconds)\n    except subprocess.TimeoutExpired as error:\n        code = (\"original_stop_deadline_expired\" if until is not None and time.monotonic() >= until\n                else \"process_projection_deadline_expired\")\n        raise Refusal(code) from error\n    if until is not None:\n        need(time.monotonic() < until, \"original_stop_deadline_expired\")\n    need(len(result.stdout) <= 2 * MIB and len(result.stderr) <= 65536,\n         \"process_projection_bound\")\n    if pid is not None and result.returncode == 1 and not result.stdout.strip():\n        return []\n    need(result.returncode == 0, \"process_projection_unavailable\")\n    rows = []\n    for line in result.stdout.decode(\"ascii\").splitlines():\n        fields = line.split(None, 5)\n        need(len(fields) == 6, \"process_projection_malformed\")\n        rows.append({\"pid\": int(fields[0]), \"ppid\": int(fields[1]),\n                     \"pgid\": int(fields[2]), \"uid\": int(fields[3]),\n                     \"state\": fields[4], \"start\": fields[5]})\n    if pid is not None:\n        need(len(rows) == 1 and rows[0][\"pid\"] == pid, \"process_projection_ambiguous\")\n    return rows\n\ndef capture_child(child, *, until):\n    require_waitid()\n    rows = ps_rows(child.pid, until=until)\n    need(len(rows) == 1, \"owned_child_identity_missing\")\n    row = rows[0]\n    need(row[\"ppid\"] == os.getpid() and row[\"pgid\"] == child.pid\n         and row[\"uid\"] == os.geteuid(), \"owned_child_scope_mismatch\")\n    # Darwin keeps an unreaped zombie in ps but getpgid/getsid return ESRCH.\n    # Use the real live APIs only for a still-live child; otherwise independently\n    # repeat WNOWAIT and retain ps plus Popen direct-parent custody.\n    event, live_sid = exit_observation(child), None\n    if event is None and not row[\"state\"].startswith(\"Z\"):\n        try:\n            need(os.getpgid(child.pid) == child.pid and os.getsid(child.pid) == child.pid,\n                 \"owned_live_session_mismatch\")\n            live_sid = child.pid\n        except ProcessLookupError:\n            # A fast exit between the first ps/waitid and a live API call is\n            # not loss of Popen custody, nor proof that the group is empty.\n            event = exit_observation(child)\n            need(event is not None, \"owned_live_api_failed_without_retained_exit\")\n    if event is not None or row[\"state\"].startswith(\"Z\"):\n        event = exit_observation(child)\n        fresh = ps_rows(child.pid, until=until)\n        need(event is not None and len(fresh) == 1 and stable(fresh[0]) == stable(row)\n             and fresh[0][\"state\"].startswith(\"Z\") and exit_observation(child) == event,\n             \"owned_exit_not_retained\")\n        row = fresh[0]\n    return {\"ps\": stable(row), \"sid_observed_while_live\": live_sid,\n            \"captured_exit\": event}\n\ndef verify_unreaped(child, owner, *, until=None):\n    event = exit_observation(child)\n    rows = ps_rows(child.pid, until=until)\n    need(len(rows) == 1 and stable(rows[0]) == owner[\"ps\"]\n         and rows[0][\"ppid\"] == os.getpid(), \"owned_child_identity_changed_no_signal\")\n    if event is None and not rows[0][\"state\"].startswith(\"Z\"):\n        # Exact ps PGID/start plus direct Popen/WNOWAIT custody keeps the\n        # originally observed session leader reserved. Do not race a normal\n        # exit by consulting Darwin's zombie-unsupported getpgid/getsid here.\n        need(owner[\"ps\"][\"pgid\"] == child.pid, \"owned_live_session_changed_no_signal\")\n    else:\n        event = exit_observation(child)\n        need(event is not None and rows[0][\"state\"].startswith(\"Z\") and exit_observation(child) == event,\n             \"owned_zombie_identity_changed_no_signal\")\n    return event\n\ndef live_group(child, owner, *, until):\n    need(time.monotonic() < until, \"original_stop_deadline_expired\")\n    verify_unreaped(child, owner, until=until)\n    rows = ps_rows(until=until)\n    selected = [row for row in rows if row[\"pgid\"] == child.pid and not row[\"state\"].startswith(\"Z\")]\n    need(all(row[\"uid\"] == os.geteuid() for row in selected), \"owned_group_uid_changed_no_signal\")\n    need(time.monotonic() < until, \"original_stop_deadline_expired\")\n    return [stable(row) for row in selected]\n\ndef observed_returncode(event):\n    if event is None:return None\n    return event['status'] if event['code']==os.CLD_EXITED else -event['status']\n\ndef stop_once_unreaped(child, owner):\n    \"\"\"Called once by the wrapper's protected ledger; never calls Popen.poll.\"\"\"\n    require_waitid()\n    started=time.monotonic()\n    receipt={'pid':child.pid,'pgid':child.pid,'stopAttempted':True,'signals':[],\n             'directChildReaped':False,'ownedLiveGroupEmptyBeforeReap':False,\n             'allGroupRowsEmptyAfterReap':False,'cleanupCaps':{'term':1,'wait':5,'group':3,'psMax':4},\n             'postReapSignalSent':False,'custody':owner}\n    try:\n        need(child.returncode is None,'already_reaped_no_group_signal')\n        term_until=time.monotonic()+1.0\n        if owner is None:\n            owner=capture_child(child,until=term_until)\n            receipt['custody']=owner\n        members=live_group(child,owner,until=term_until)\n        receipt['initialLiveGroup']=members\n        if members:\n            verify_unreaped(child,owner,until=term_until)\n            need(time.monotonic()<term_until,'original_stop_deadline_expired')\n            os.killpg(child.pid,signal.SIGTERM);receipt['signals'].append('SIGTERM')\n            while time.monotonic()<term_until:\n                try:\n                    members=live_group(child,owner,until=term_until)\n                    if not members:break\n                except Refusal as error:\n                    if str(error)!='original_stop_deadline_expired' or time.monotonic()<term_until:\n                        raise\n                    break\n                time.sleep(min(0.02,max(0,term_until-time.monotonic())))\n        wait_until=time.monotonic()+5.0\n        members=live_group(child,owner,until=wait_until)\n        if members:\n            verify_unreaped(child,owner,until=wait_until)\n            need(time.monotonic()<wait_until,'original_stop_deadline_expired')\n            os.killpg(child.pid,signal.SIGKILL);receipt['signals'].append('SIGKILL')\n        event=exit_observation(child)\n        while event is None:\n            verify_unreaped(child,owner,until=wait_until)\n            need(time.monotonic()<wait_until,'original_stop_deadline_expired')\n            time.sleep(min(0.02,max(0,wait_until-time.monotonic())))\n            event=exit_observation(child)\n        need(time.monotonic()<wait_until,'original_stop_deadline_expired')\n        receipt['retainedExit']=event\n        # The old post-exit group3 interval now precedes the first reap.\n        # This retains actual Popen PID custody while other live members leave.\n        group_until=time.monotonic()+3.0\n        while True:\n            members=live_group(child,owner,until=group_until)\n            if not members and exit_observation(child)==event:break\n            need(time.monotonic()<group_until,'original_stop_deadline_expired')\n            time.sleep(min(0.02,max(0,group_until-time.monotonic())))\n        receipt['ownedLiveGroupEmptyBeforeReap']=True\n        need(time.monotonic()<group_until,'original_stop_deadline_expired')\n        child.wait(timeout=group_until-time.monotonic())\n        receipt['directChildReaped']=True\n        receipt['exitCode']=child.returncode\n        need(child.returncode==observed_returncode(event),'actual_reap_matches_retained_exit')\n        # After the first reap, only observe. No signal or ownership claim is\n        # derived from this now-reusable numeric PGID.\n        while True:\n            rows=[row for row in ps_rows(until=group_until) if row['pgid']==child.pid]\n            receipt['remainingGroupRows']=rows\n            if not rows:break\n            need(time.monotonic()<group_until,'original_stop_deadline_expired')\n            time.sleep(min(0.02,max(0,group_until-time.monotonic())))\n        receipt['allGroupRowsEmptyAfterReap']=True\n        need(time.monotonic()<group_until,'original_stop_deadline_expired')\n        receipt['ok']=True\n    except BaseException as error:\n        receipt['ok']=False\n        receipt['errorType']=type(error).__name__\n        receipt['errorCode']=str(error) if isinstance(error,Refusal) else None\n        receipt['directChildReaped']=child.returncode is not None\n        receipt['exitCode']=child.returncode\n        # No second signal sequence, no renewed deadline, no automatic retry.\n    receipt['elapsedSeconds']=time.monotonic()-started\n    receipt['outcomeUnknown']=not(receipt.get('ok') is True\n       and receipt['directChildReaped'] and receipt['allGroupRowsEmptyAfterReap'])\n    return receipt\n","mac_capture_sqlite_synthetic_r1.py":"#!/usr/bin/env python3\n\"\"\"Owned-only Mac SQLite prerequisite for guarded current capture.\n\nThis is a separate one-shot component, not production credential capture.\nIts actual final stdout plus authoritative exit zero is the proof input.\nNo fixture result authorizes a later production run by itself.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, base64, hashlib, json, os, signal, sqlite3, stat, sys, time\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nSTART=time.monotonic();UNTIL=START+45.0\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-r10-current-consumer-r1')\nQA=ROOT/'qa';OWNED=ROOT/'capture-sqlite-synthetic-r1'\nNAMES=('mac_capture_sqlite_synthetic_r1.py','mac_guarded_current_capture_r3.py',\n       'mac_t5_volume_guard_r1.py','mac_owned_unreaped_r1.py','mac_owned_commands_r1.py')\nprotected=0;pending=None\nclass Refused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise Refused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef encoded(value):return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\\n').encode()\ndef remaining():\n    need(pending is None,'synthetic_cancelled')\n    left=UNTIL-time.monotonic();need(left>0,'original_synthetic_45s_exhausted');return left\ndef on_signal(signum,_frame):\n    global pending\n    pending=signum\n    if not protected:raise KeyboardInterrupt()\n@contextmanager\ndef critical():\n    global protected\n    protected+=1\n    try:yield\n    finally:protected-=1\ndef identity(s):\n    return tuple(str(v) for v in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n                                 s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\ndef code_bytes(path,expected):\n    # Only fixed public source files are read before the held volume guard.\n    remaining();need(path.parent==QA and path.name in NAMES,'fixed_public_source_scope')\n    with critical():fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n    try:\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n             and stat.S_IMODE(before.st_mode)==0o600 and 0<before.st_size<=1048576,\n             'public_source_custody')\n        parts=[];count=0\n        while count<=1048576:\n            remaining();raw=os.read(fd,min(65536,1048577-count))\n            if not raw:break\n            count+=len(raw);parts.append(raw)\n        raw=b''.join(parts)\n        need(count==before.st_size and identity(before)==identity(os.fstat(fd))==identity(path.lstat())\n             and sha(raw)==expected,'fixed_whole_source_pin')\n    finally:\n        with critical():os.close(fd)\n    remaining();return raw\n\ndef main():\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--public-volume-anchor-base64',required=True)\n    parser.add_argument('--public-volume-anchor-sha256',required=True)\n    parser.add_argument('--source-pins-base64',required=True)\n    parser.add_argument('--source-pins-sha256',required=True)\n    args=parser.parse_args()\n    os.umask(0o077)\n    for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,on_signal)\n    report={'schema':'heptabao.mac-immutable-capture-synthetic.r1','ok':False,\n        'ownedDatabaseOnly':True,'productionOpened':False,\n        'wholeDatabaseBackupQualified':False,'crossAgentAtomicSnapshotClaimed':False,\n        'newOriginalSyntheticSeconds':45,'cases':[],'outcomeUnknown':False}\n    guard=None;commands=None;setup_connections=[];input_sets=[];extra_fds=[]\n    cap=None;pins=None;complete=False\n    try:\n        need(sys.platform=='darwin' and os.getuid()==501,'actual_mac_component_owner')\n        source_raw=base64.b64decode(args.source_pins_base64,validate=True)\n        need(len(source_raw)<=16384 and sha(source_raw)==args.source_pins_sha256,'source_pin_input')\n        pins=json.loads(source_raw)\n        need(isinstance(pins,dict) and set(pins)==set(NAMES)\n             and all(isinstance(v,str) and len(v)==64 and all(c in '0123456789abcdef' for c in v)\n                     for v in pins.values()),'exact_five_public_sources')\n        for name,pin in pins.items():code_bytes(QA/name,pin)\n        sys.path.insert(0,str(QA))\n        from mac_t5_volume_guard_r1 import HeldT5\n        from mac_owned_commands_r1 import Commands\n        import mac_guarded_current_capture_r3 as capture\n        cap=capture\n        # Commands uses this same pending signal state and critical section.\n        class SignalState:\n            @property\n            def pending(self):return pending\n            def critical(self):return critical()\n        commands=Commands(SignalState())\n        anchor=base64.b64decode(args.public_volume_anchor_base64,validate=True)\n        guard=HeldT5(anchor,args.public_volume_anchor_sha256,remaining,critical)\n        row,out,_=commands.run('synthetic-t5-volume',\n            ['/usr/sbin/diskutil','info','-plist','/Volumes/T5'],\n            until=min(UNTIL,time.monotonic()+30),maximum=262144)\n        need(row['exitCode']==0 and not row['outcomeUnknown'],'actual_volume_query_complete')\n        guard.accept_diskutil(out)\n        report['volumeProbe']=row\n        need(hasattr(sqlite3.Connection,'setlimit') and hasattr(sqlite3,'SQLITE_LIMIT_LENGTH'),\n             'actual_runtime_setlimit_required_no_fallback')\n        need(sqlite3.sqlite_version_info>=(3,22,0),'actual_sqlite_readonly_wal_version')\n        report['runtime']=capture.runtime_identity(remaining=remaining,critical=critical)\n        report['captureSourceSha256']=pins['mac_guarded_current_capture_r3.py']\n        report['sourcePinsSha256']=args.source_pins_sha256\n        report['sourcePins']=pins\n        report['fixedOwnedRoot']=str(OWNED)\n        guard.mkdir_new(OWNED)\n        expected_store={'profiles':{'owned-fixture':{'provider':'synthetic','type':'api_key','key':'synthetic-only'}}}\n        expected_state={'usageStats':{},'order':{}}\n\n        def close_setup(item):\n            if item['closeAttempted']:return\n            with critical():\n                item['closeAttempted']=True\n                try:item['db'].close();item['closed']=True\n                except BaseException as error:item['closeError']=type(error).__name__;raise\n        def make_database(label,*,large=False):\n            remaining()\n            live=OWNED/label\n            for path in (live,live/'agents',live/'agents/main',live/'agents/main/agent'):\n                guard.mkdir_new(path)\n            path=live/'agents/main/agent/openclaw-agent.sqlite'\n            guard.write_new(path,b'')\n            with guard.parent(path):\n                with critical():\n                    db=sqlite3.connect('file:'+str(path)+'?mode=rw',uri=True,timeout=0.0,isolation_level=None)\n                    item={'db':db,'closeAttempted':False,'closed':False,'label':label}\n                    setup_connections.append(item)\n                try:\n                    db.setlimit(sqlite3.SQLITE_LIMIT_LENGTH,2*1048576)\n                    db.execute('PRAGMA journal_mode=WAL')\n                    db.execute('PRAGMA synchronous=FULL')\n                    db.execute('CREATE TABLE auth_profile_store (store_key TEXT PRIMARY KEY, store_json TEXT NOT NULL, updated_at INTEGER NOT NULL)')\n                    db.execute('CREATE TABLE auth_profile_state (state_key TEXT PRIMARY KEY, state_json TEXT NOT NULL, updated_at INTEGER NOT NULL)')\n                    value={'profiles':{'owned-fixture':{'value':'x'*(1048576+128)}}} if large else expected_store\n                    db.execute('INSERT INTO auth_profile_store VALUES (?,?,?)',\n                               ('primary',json.dumps(value,separators=(',',':')),1))\n                    db.execute('INSERT INTO auth_profile_state VALUES (?,?,?)',\n                               ('primary',json.dumps(expected_state,separators=(',',':')),2))\n                    db.execute('PRAGMA wal_checkpoint(TRUNCATE)')\n                finally:close_setup(item)\n            guard.check()\n            # No production or arbitrary file is opened. SQLite owns and closes\n            # its setup sidecars; the immutable reader must not recreate any.\n            for suffix in ('-wal','-shm','-journal'):\n                with guard.parent(Path(str(path)+suffix)) as (parent,name):\n                    try:os.stat(name,dir_fd=parent,follow_symlinks=False)\n                    except FileNotFoundError:pass\n                    else:raise Refused('closed_owned_setup_sidecar_expected_absent')\n            remaining()\n            return live,path\n\n        def input_set(live):\n            obj=capture.FixedInputs(until=UNTIL,critical=critical,cancelled=lambda:pending is not None,\n                                    live=live,synthetic=True)\n            input_sets.append(obj);return obj\n        def record(label,obj,passed,**details):\n            obj.close()\n            info=obj.public()\n            need(info['allOwnedDescriptorsClosed'] and not info['closeErrors'],'component_descriptors_closed')\n            remaining()\n            report['cases'].append({'case':label,'passed':passed,**details,'inputClosure':info})\n            need(passed,'component_case_failed.'+label)\n        def exact_rows(value):\n            return (value['rows']['store']==[['primary',json.dumps(expected_store,separators=(',',':')),1]]\n                 and value['rows']['state']==[['primary',json.dumps(expected_state,separators=(',',':')),2]])\n\n        live,path=make_database('absent-sidecars')\n        inputs=input_set(live)\n        value=capture.auth_rows(inputs,'main');inputs.verify()\n        record('absent_sidecars_stay_absent',inputs,exact_rows(value)\n            and all(str(path)+suffix in inputs.absent for suffix in ('-wal','-shm','-journal')))\n        report['absentSidecarsStayedAbsent']=True;report['sameHeldFdUriCode']=True\n\n        live,path=make_database('zero-wal')\n        guard.write_new(Path(str(path)+'-wal'),b'')\n        guard.write_new(Path(str(path)+'-shm'),bytes(32768))\n        inputs=input_set(live)\n        value=capture.auth_rows(inputs,'main');inputs.verify()\n        record('empty_wal_and_shm_unchanged',inputs,exact_rows(value)\n            and int(inputs.files[str(path)+'-wal']['expected'][6])==0\n            and int(inputs.files[str(path)+'-shm']['expected'][6])==32768)\n        report['emptyWalStayedEmpty']=True\n\n        live,path=make_database('nonempty-wal')\n        guard.write_new(Path(str(path)+'-wal'),b'owned-nonempty-wal')\n        inputs=input_set(live);refusal=None\n        try:capture.auth_rows(inputs,'main')\n        except capture.CaptureRefused as error:refusal=str(error)\n        record('nonempty_wal_refused_before_connection',inputs,\n            refusal in ('current_input_size_bound','nonempty_wal_refused_before_sqlite')\n            and not inputs.connections,refusalCode=refusal)\n        report['nonemptyWalRefusedBeforeConnect']=True\n\n        live,path=make_database('journal-present')\n        guard.write_new(Path(str(path)+'-journal'),b'')\n        inputs=input_set(live);refusal=None\n        try:capture.auth_rows(inputs,'main')\n        except capture.CaptureRefused as error:refusal=str(error)\n        record('journal_refused_before_connection',inputs,\n            refusal=='rollback_journal_refused_before_immutable' and not inputs.connections,refusalCode=refusal)\n        report['journalRefusedBeforeConnect']=True\n\n        live,path=make_database('oversize-row',large=True)\n        inputs=input_set(live);refusal=None\n        try:capture.auth_rows(inputs,'main')\n        except capture.CaptureRefused as error:refusal=str(error)\n        except sqlite3.DataError:refusal='sqlite_length_limit'\n        record('oversize_fixed_primary_row_refused',inputs,\n            refusal in ('auth_primary_payload_cap','sqlite_length_limit'),refusalCode=refusal)\n        report['oversizeRowRefused']=True\n\n        live,path=make_database('drift-before-query')\n        inputs=input_set(live);inputs.database(path)\n        with guard.parent(path) as (parent,name):\n            with critical():\n                fd=os.open(name,os.O_WRONLY|os.O_APPEND|os.O_NOFOLLOW,dir_fd=parent)\n                opened={'fd':fd,'closeAttempted':False,'closed':False};extra_fds.append(opened)\n            try:\n                need(identity(os.fstat(fd))==inputs.files[str(path)]['expected'],'owned_drift_exact_inode')\n                need(os.write(fd,b'D')==1,'owned_drift_write_once');os.fsync(fd)\n            finally:\n                with critical():\n                    opened['closeAttempted']=True;os.close(fd);opened['closed']=True\n        refusal=None\n        try:capture.auth_rows(inputs,'main')\n        except capture.CaptureRefused as error:refusal=str(error)\n        record('held_inode_drift_refused_before_connection',inputs,\n            refusal=='current_input_fd_name_or_metadata_changed' and not inputs.connections,refusalCode=refusal)\n        report['driftRefused']=True\n\n        live,path=make_database('readonly-uri')\n        inputs=input_set(live);main=inputs.database(path)\n        def readonly_attempt(db,until):\n            try:db.execute('CREATE TABLE should_not_exist (value TEXT)')\n            except sqlite3.Error as error:\n                return getattr(error,'sqlite_errorcode',-1)&255==sqlite3.SQLITE_READONLY\n            return False\n        readonly=capture.immutable_query(inputs,main,readonly_attempt)\n        inputs.verify()\n        record('actual_immutable_connection_rejects_write',inputs,readonly is True)\n        report['readonlyImmutableConnection']=True\n        report['sameRuntimeBeforeAfter']=capture.runtime_identity(remaining=remaining,critical=critical)==report['runtime']\n        need(report['sameRuntimeBeforeAfter'],'runtime_code_unchanged')\n        for name,pin in pins.items():code_bytes(QA/name,pin)\n        guard.check();remaining();complete=True\n    except BaseException as error:\n        report['errorType']=type(error).__name__\n        report['errorCode']=str(error) if isinstance(error,Refused) or (cap is not None\n            and isinstance(error,cap.CaptureRefused)) else None\n        if isinstance(error,(KeyboardInterrupt,SystemExit)):report['outcomeUnknown']=True\n    finally:\n        signal.signal(signal.SIGTERM,signal.SIG_IGN);signal.signal(signal.SIGINT,signal.SIG_IGN)\n        for obj in reversed(input_sets):obj.close()\n        for item in reversed(setup_connections):\n            if item['closeAttempted']:continue\n            with critical():\n                item['closeAttempted']=True\n                try:item['db'].close();item['closed']=True\n                except BaseException as error:item['closeError']=type(error).__name__\n        for item in reversed(extra_fds):\n            if item['closeAttempted']:continue\n            with critical():\n                item['closeAttempted']=True\n                try:os.close(item['fd']);item['closed']=True\n                except BaseException as error:item['closeError']=type(error).__name__\n        if commands is not None:report['ownedCommands']=commands.public()\n        report['allOwnedDescriptorsClosed']=(\n            all(obj.public()['allOwnedDescriptorsClosed'] for obj in input_sets)\n            and all(x['closed'] for x in setup_connections) and all(x['closed'] for x in extra_fds))\n        if guard is not None:\n            guard.close();report['heldT5Final']=guard.public_state()\n            report['allOwnedDescriptorsClosed']=(report['allOwnedDescriptorsClosed']\n                and report['heldT5Final']['allDescriptorsClosed'])\n        commands_stopped=commands is not None and commands.public()['allOwnedCommandsStopped']\n        command_unknown=commands is not None and commands.public()['unknownCommandCount']!=0\n        report['outcomeUnknown']=bool(report['outcomeUnknown'] or command_unknown\n            or not commands_stopped or not report['allOwnedDescriptorsClosed'] or pending is not None)\n        completed=time.monotonic()\n        report['elapsedSeconds']=completed-START\n        report['originalDeadlineMetAfterClosure']=completed<UNTIL\n        report['ok']=bool(complete and not report['outcomeUnknown'] and completed<UNTIL\n            and guard is not None and report['heldT5Final']['lastAnchorCheckPassed']\n            and len(report['cases'])==7 and all(x['passed'] for x in report['cases']))\n        report['authoritativeExitZeroAndOriginalDeadlineRequired']=True\n        raw=encoded(report);need(len(raw)<=65536,'bounded_synthetic_public_stdout')\n        sys.stdout.buffer.write(raw);sys.stdout.buffer.flush()\n    return 0 if report['ok'] and time.monotonic()<UNTIL else 1\n\nif __name__=='__main__':sys.exit(main())\n","mac_capture_sqlite_synthetic_r2.py":"#!/usr/bin/env python3\n\"\"\"Owned-only Mac SQLite prerequisite, reviewed second source generation.\n\nThis is a separate one-shot component, not production credential capture.\nIts actual final stdout plus authoritative exit zero is the proof input.\nNo fixture result authorizes a later production run by itself.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, base64, hashlib, json, os, signal, sqlite3, stat, sys, time\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nSTART=time.monotonic();UNTIL=START+45.0\nROOT=Path('/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-r10-current-consumer-r1')\nQA=ROOT/'qa';OWNED=ROOT/'capture-sqlite-synthetic-r1/reviewed-attempt-r2'\nNAMES=('mac_capture_sqlite_synthetic_r2.py','mac_capture_sqlite_synthetic_r1.py',\n       'mac_guarded_current_capture_r3.py',\n       'mac_t5_volume_guard_r1.py','mac_owned_unreaped_r1.py','mac_owned_commands_r1.py')\nprotected=0;pending=None\nclass Refused(RuntimeError):pass\ndef need(value,code):\n    if not value:raise Refused(code)\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef encoded(value):return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\\n').encode()\ndef remaining():\n    need(pending is None,'synthetic_cancelled')\n    left=UNTIL-time.monotonic();need(left>0,'original_synthetic_45s_exhausted');return left\ndef on_signal(signum,_frame):\n    global pending\n    pending=signum\n    if not protected:raise KeyboardInterrupt()\n@contextmanager\ndef critical():\n    global protected\n    protected+=1\n    try:yield\n    finally:protected-=1\ndef identity(s):\n    return tuple(str(v) for v in (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,\n                                 s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns))\ndef code_bytes(path,expected):\n    # Only fixed public source files are read before the held volume guard.\n    remaining();need(path.parent==QA and path.name in NAMES,'fixed_public_source_scope')\n    with critical():fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\n    try:\n        before=os.fstat(fd)\n        need(stat.S_ISREG(before.st_mode) and before.st_uid==501 and before.st_nlink==1\n             and stat.S_IMODE(before.st_mode)==0o600 and 0<before.st_size<=1048576,\n             'public_source_custody')\n        parts=[];count=0\n        while count<=1048576:\n            remaining();raw=os.read(fd,min(65536,1048577-count))\n            if not raw:break\n            count+=len(raw);parts.append(raw)\n        raw=b''.join(parts)\n        need(count==before.st_size and identity(before)==identity(os.fstat(fd))==identity(path.lstat())\n             and sha(raw)==expected,'fixed_whole_source_pin')\n    finally:\n        with critical():os.close(fd)\n    remaining();return raw\n\ndef main():\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--public-volume-anchor-base64',required=True)\n    parser.add_argument('--public-volume-anchor-sha256',required=True)\n    parser.add_argument('--source-pins-base64',required=True)\n    parser.add_argument('--source-pins-sha256',required=True)\n    args=parser.parse_args()\n    os.umask(0o077)\n    for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,on_signal)\n    report={'schema':'heptabao.mac-immutable-capture-synthetic.r1','ok':False,\n        'ownedDatabaseOnly':True,'productionOpened':False,\n        'wholeDatabaseBackupQualified':False,'crossAgentAtomicSnapshotClaimed':False,\n        'newOriginalSyntheticSeconds':45,'cases':[],'outcomeUnknown':False,\n        'controllerGeneration':'r2','originalFailedCasePathsUsedAsInputs':False}\n    guard=None;commands=None;setup_connections=[];input_sets=[];extra_fds=[]\n    cap=None;pins=None;complete=False\n    try:\n        need(sys.platform=='darwin' and os.getuid()==501,'actual_mac_component_owner')\n        source_raw=base64.b64decode(args.source_pins_base64,validate=True)\n        need(len(source_raw)<=16384 and sha(source_raw)==args.source_pins_sha256,'source_pin_input')\n        pins=json.loads(source_raw)\n        need(isinstance(pins,dict) and set(pins)==set(NAMES)\n             and all(isinstance(v,str) and len(v)==64 and all(c in '0123456789abcdef' for c in v)\n                     for v in pins.values()),'exact_six_public_sources_including_preserved_r1')\n        for name,pin in pins.items():code_bytes(QA/name,pin)\n        sys.path.insert(0,str(QA))\n        from mac_t5_volume_guard_r1 import HeldT5\n        from mac_owned_commands_r1 import Commands\n        import mac_guarded_current_capture_r3 as capture\n        cap=capture\n        # Commands uses this same pending signal state and critical section.\n        class SignalState:\n            @property\n            def pending(self):return pending\n            def critical(self):return critical()\n        commands=Commands(SignalState())\n        anchor=base64.b64decode(args.public_volume_anchor_base64,validate=True)\n        guard=HeldT5(anchor,args.public_volume_anchor_sha256,remaining,critical)\n        row,out,_=commands.run('synthetic-t5-volume',\n            ['/usr/sbin/diskutil','info','-plist','/Volumes/T5'],\n            until=min(UNTIL,time.monotonic()+30),maximum=262144)\n        need(row['exitCode']==0 and not row['outcomeUnknown'],'actual_volume_query_complete')\n        guard.accept_diskutil(out)\n        report['volumeProbe']=row\n        need(hasattr(sqlite3.Connection,'setlimit') and hasattr(sqlite3,'SQLITE_LIMIT_LENGTH'),\n             'actual_runtime_setlimit_required_no_fallback')\n        need(sqlite3.sqlite_version_info>=(3,22,0),'actual_sqlite_readonly_wal_version')\n        report['runtime']=capture.runtime_identity(remaining=remaining,critical=critical)\n        report['captureSourceSha256']=pins['mac_guarded_current_capture_r3.py']\n        report['sourcePinsSha256']=args.source_pins_sha256\n        report['sourcePins']=pins\n        report['fixedOwnedRoot']=str(OWNED)\n        guard.mkdir_new(OWNED)\n        expected_store={'profiles':{'owned-fixture':{'provider':'synthetic','type':'api_key','key':'synthetic-only'}}}\n        expected_state={'usageStats':{},'order':{}}\n\n        def close_setup(item):\n            if item['closeAttempted']:return\n            with critical():\n                item['closeAttempted']=True\n                try:item['db'].close();item['closed']=True\n                except BaseException as error:item['closeError']=type(error).__name__;raise\n        def make_database(label,*,large=False):\n            remaining()\n            live=OWNED/label\n            for path in (live,live/'agents',live/'agents/main',live/'agents/main/agent'):\n                guard.mkdir_new(path)\n            path=live/'agents/main/agent/openclaw-agent.sqlite'\n            guard.write_new(path,b'')\n            with guard.parent(path):\n                with critical():\n                    db=sqlite3.connect('file:'+str(path)+'?mode=rw',uri=True,timeout=0.0,isolation_level=None)\n                    item={'db':db,'closeAttempted':False,'closed':False,'label':label}\n                    setup_connections.append(item)\n                try:\n                    db.setlimit(sqlite3.SQLITE_LIMIT_LENGTH,2*1048576)\n                    db.execute('PRAGMA journal_mode=WAL')\n                    db.execute('PRAGMA synchronous=FULL')\n                    db.execute('CREATE TABLE auth_profile_store (store_key TEXT PRIMARY KEY, store_json TEXT NOT NULL, updated_at INTEGER NOT NULL)')\n                    db.execute('CREATE TABLE auth_profile_state (state_key TEXT PRIMARY KEY, state_json TEXT NOT NULL, updated_at INTEGER NOT NULL)')\n                    value={'profiles':{'owned-fixture':{'value':'x'*(1048576+128)}}} if large else expected_store\n                    db.execute('INSERT INTO auth_profile_store VALUES (?,?,?)',\n                               ('primary',json.dumps(value,separators=(',',':')),1))\n                    db.execute('INSERT INTO auth_profile_state VALUES (?,?,?)',\n                               ('primary',json.dumps(expected_state,separators=(',',':')),2))\n                    db.execute('PRAGMA wal_checkpoint(TRUNCATE)')\n                finally:close_setup(item)\n            guard.check()\n            # No production or arbitrary file is opened. SQLite owns and closes\n            # its setup sidecars; the immutable reader must not recreate any.\n            for suffix in ('-wal','-shm','-journal'):\n                with guard.parent(Path(str(path)+suffix)) as (parent,name):\n                    try:os.stat(name,dir_fd=parent,follow_symlinks=False)\n                    except FileNotFoundError:pass\n                    else:raise Refused('closed_owned_setup_sidecar_expected_absent')\n            remaining()\n            return live,path\n\n        def input_set(live):\n            obj=capture.FixedInputs(until=UNTIL,critical=critical,cancelled=lambda:pending is not None,\n                                    live=live,synthetic=True)\n            input_sets.append(obj);return obj\n        def record(label,obj,passed,**details):\n            obj.close()\n            info=obj.public()\n            need(info['allOwnedDescriptorsClosed'] and not info['closeErrors'],'component_descriptors_closed')\n            remaining()\n            report['cases'].append({'case':label,'passed':passed,**details,'inputClosure':info})\n            need(passed,'component_case_failed.'+label)\n        def exact_rows(value):\n            return (value['rows']['store']==[['primary',json.dumps(expected_store,separators=(',',':')),1]]\n                 and value['rows']['state']==[['primary',json.dumps(expected_state,separators=(',',':')),2]])\n\n        live,path=make_database('absent-sidecars')\n        inputs=input_set(live)\n        value=capture.auth_rows(inputs,'main');inputs.verify()\n        record('absent_sidecars_stay_absent',inputs,exact_rows(value)\n            and all(str(path)+suffix in inputs.absent for suffix in ('-wal','-shm','-journal')))\n        report['absentSidecarsStayedAbsent']=True;report['sameHeldFdUriCode']=True\n\n        live,path=make_database('zero-wal')\n        guard.write_new(Path(str(path)+'-wal'),b'')\n        guard.write_new(Path(str(path)+'-shm'),bytes(32768))\n        inputs=input_set(live)\n        value=capture.auth_rows(inputs,'main');inputs.verify()\n        record('empty_wal_and_shm_unchanged',inputs,exact_rows(value)\n            and int(inputs.files[str(path)+'-wal']['expected'][6])==0\n            and int(inputs.files[str(path)+'-shm']['expected'][6])==32768)\n        report['emptyWalStayedEmpty']=True\n\n        live,path=make_database('nonempty-wal')\n        guard.write_new(Path(str(path)+'-wal'),b'owned-nonempty-wal')\n        inputs=input_set(live);refusal=None\n        try:capture.auth_rows(inputs,'main')\n        except capture.CaptureRefused as error:refusal=str(error)\n        record('nonempty_wal_refused_before_connection',inputs,\n            refusal in ('current_input_size_bound','nonempty_wal_refused_before_sqlite')\n            and not inputs.connections,refusalCode=refusal)\n        report['nonemptyWalRefusedBeforeConnect']=True\n\n        live,path=make_database('journal-present')\n        guard.write_new(Path(str(path)+'-journal'),b'')\n        inputs=input_set(live);refusal=None\n        try:capture.auth_rows(inputs,'main')\n        except capture.CaptureRefused as error:refusal=str(error)\n        record('journal_refused_before_connection',inputs,\n            refusal=='rollback_journal_refused_before_immutable' and not inputs.connections,refusalCode=refusal)\n        report['journalRefusedBeforeConnect']=True\n\n        live,path=make_database('oversize-row',large=True)\n        inputs=input_set(live);refusal=None\n        try:capture.auth_rows(inputs,'main')\n        except capture.CaptureRefused as error:refusal=str(error)\n        except sqlite3.DataError:refusal='sqlite_length_limit'\n        record('oversize_fixed_primary_row_refused',inputs,\n            refusal in ('auth_primary_payload_cap','sqlite_length_limit'),refusalCode=refusal)\n        report['oversizeRowRefused']=True\n\n        live,path=make_database('drift-before-query')\n        inputs=input_set(live);main=inputs.database(path)\n        with guard.parent(path) as (parent,name):\n            with critical():\n                fd=os.open(name,os.O_WRONLY|os.O_APPEND|os.O_NOFOLLOW,dir_fd=parent)\n                opened={'fd':fd,'closeAttempted':False,'closed':False};extra_fds.append(opened)\n            try:\n                need(identity(os.fstat(fd))==inputs.files[str(path)]['expected'],'owned_drift_exact_inode')\n                need(os.write(fd,b'D')==1,'owned_drift_write_once');os.fsync(fd)\n            finally:\n                with critical():\n                    opened['closeAttempted']=True;os.close(fd);opened['closed']=True\n        refusal=None\n        # Exercise the actual immutable-query admission on the already held\n        # main inode. Re-entering database() would first reject its previously\n        # recorded absent sidecars, never reaching this drift verification.\n        try:capture.immutable_query(inputs,main,lambda _db,_until: None)\n        except capture.CaptureRefused as error:refusal=str(error)\n        record('held_inode_drift_refused_before_connection',inputs,\n            refusal=='current_input_fd_name_or_metadata_changed' and not inputs.connections,refusalCode=refusal)\n        report['driftRefused']=True\n\n        live,path=make_database('readonly-uri')\n        inputs=input_set(live);main=inputs.database(path)\n        def readonly_attempt(db,until):\n            try:db.execute('CREATE TABLE should_not_exist (value TEXT)')\n            except sqlite3.Error as error:\n                return getattr(error,'sqlite_errorcode',-1)&255==sqlite3.SQLITE_READONLY\n            return False\n        readonly=capture.immutable_query(inputs,main,readonly_attempt)\n        inputs.verify()\n        record('actual_immutable_connection_rejects_write',inputs,readonly is True)\n        report['readonlyImmutableConnection']=True\n        report['sameRuntimeBeforeAfter']=capture.runtime_identity(remaining=remaining,critical=critical)==report['runtime']\n        need(report['sameRuntimeBeforeAfter'],'runtime_code_unchanged')\n        for name,pin in pins.items():code_bytes(QA/name,pin)\n        guard.check();remaining();complete=True\n    except BaseException as error:\n        report['errorType']=type(error).__name__\n        report['errorCode']=str(error) if isinstance(error,Refused) or (cap is not None\n            and isinstance(error,cap.CaptureRefused)) else None\n        if isinstance(error,(KeyboardInterrupt,SystemExit)):report['outcomeUnknown']=True\n    finally:\n        signal.signal(signal.SIGTERM,signal.SIG_IGN);signal.signal(signal.SIGINT,signal.SIG_IGN)\n        for obj in reversed(input_sets):obj.close()\n        for item in reversed(setup_connections):\n            if item['closeAttempted']:continue\n            with critical():\n                item['closeAttempted']=True\n                try:item['db'].close();item['closed']=True\n                except BaseException as error:item['closeError']=type(error).__name__\n        for item in reversed(extra_fds):\n            if item['closeAttempted']:continue\n            with critical():\n                item['closeAttempted']=True\n                try:os.close(item['fd']);item['closed']=True\n                except BaseException as error:item['closeError']=type(error).__name__\n        if commands is not None:report['ownedCommands']=commands.public()\n        report['allOwnedDescriptorsClosed']=(\n            all(obj.public()['allOwnedDescriptorsClosed'] for obj in input_sets)\n            and all(x['closed'] for x in setup_connections) and all(x['closed'] for x in extra_fds))\n        if guard is not None:\n            guard.close();report['heldT5Final']=guard.public_state()\n            report['allOwnedDescriptorsClosed']=(report['allOwnedDescriptorsClosed']\n                and report['heldT5Final']['allDescriptorsClosed'])\n        commands_stopped=commands is not None and commands.public()['allOwnedCommandsStopped']\n        command_unknown=commands is not None and commands.public()['unknownCommandCount']!=0\n        report['outcomeUnknown']=bool(report['outcomeUnknown'] or command_unknown\n            or not commands_stopped or not report['allOwnedDescriptorsClosed'] or pending is not None)\n        completed=time.monotonic()\n        report['elapsedSeconds']=completed-START\n        report['originalDeadlineMetAfterClosure']=completed<UNTIL\n        report['ok']=bool(complete and not report['outcomeUnknown'] and completed<UNTIL\n            and guard is not None and report['heldT5Final']['lastAnchorCheckPassed']\n            and len(report['cases'])==7 and all(x['passed'] for x in report['cases']))\n        report['authoritativeExitZeroAndOriginalDeadlineRequired']=True\n        raw=encoded(report);need(len(raw)<=65536,'bounded_synthetic_public_stdout')\n        sys.stdout.buffer.write(raw);sys.stdout.buffer.flush()\n    return 0 if report['ok'] and time.monotonic()<UNTIL else 1\n\nif __name__=='__main__':sys.exit(main())\n","mac_current_cycle_r2.mjs":"#!/usr/bin/env node\n/** One Mac AuthBus cycle over five actual stores, or its exact once inverse.\n * Preserve original flags, profile3, order/usage and trnm's inherited state.\n * Native consumers run in separate one-factory workers under the same phase\n * owner. Effective state is derived evidence and is never a rollback write.\n */\nimport fs from 'node:fs';\nimport { captureAuthRows, restoreAuthRowsWithCas, authRowsDigest } from './mac_auth_rows_cas_r1.mjs';\nimport { captureAuthBusCaches, cacheContentDigest, restoreAuthBusCachesWithCas } from './mac_authbus_cache_cas_r1.mjs';\nimport path from 'node:path';\nimport https from 'node:https';\nimport http from 'node:http';\nimport childProcess from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { pathToFileURL } from 'node:url';\nimport { syncBuiltinESMExports } from 'node:module';\n\nprocess.umask(0o077);\nconst hash = value => createHash('sha256').update(value).digest('hex');\nconst stable = value => Array.isArray(value) ? value.map(stable) : value && typeof value === 'object'\n  ? Object.fromEntries(Object.keys(value).sort().map(key => [key, stable(value[key])])) : value;\nconst digest = value => hash(JSON.stringify(stable(value)));\nconst report = { schema: 'heptabao.mac-five-agent-authbus-cycle-and-inverse.r1', ok: false,\n  productionChanged: false, productionTrafficCutover: false, providerNetworkEgress: false,\n  refreshNetworkEgress: false, modelCalled: false, j3160Contacted: false,\n  nativeBackendAttemptsNotCounted: true, providerAvailabilityQualified: false,\n  credentialValuesPublished: false, accountIdentitiesPublished: false,\n  allAccountsQualified: false, checks: [], wire: [] };\nlet service, baoAgent, plan, sdkRuntime, storeRuntime, baselineDoc;\nlet serviceStopAttempted = false, serviceStopped = true;\nlet inverseMutationAttempted = false, inverseCompleted = false;\nconst workerStarted = process.hrtime.bigint();\nlet workerUntil;\nfunction remainingMs(cap) {\n  const left=Number((workerUntil-process.hrtime.bigint())/1000000n);\n  need(left>0,'shared_phase_allocation_exhausted');\n  return Math.min(cap,left);\n}\nasync function stopServiceOnce() {\n  need(service && !serviceStopAttempted,'service_stop_once');\n  serviceStopAttempted=true;\n  await service.stop(); serviceStopped=true; service=null;\n}\nconst agentIds = ['main','trnm','hepta-ui','hepta','hepta-backend'];\nlet blockedOperations = 0;\nconst tokens = [];\nconst sensitive = [];\n\nfunction need(value, code) { if (!value) throw Object.assign(new Error(code), { safeCode: code }); }\nfunction check(code, value) { report.checks.push({ case: code, passed: value === true }); need(value, code); }\nfunction privateRead(file) {\n  const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);\n  try {\n    const s = fs.fstatSync(fd);\n    need(s.isFile() && s.uid === process.getuid() && (s.mode & 0o077) === 0 && s.nlink === 1 && s.size <= 1024 * 1024,\n      'private_file_custody');\n    const data = fs.readFileSync(fd), after = fs.fstatSync(fd), current = fs.lstatSync(file);\n    need([after, current].every(x => x.dev === s.dev && x.ino === s.ino && x.size === s.size && x.mtimeMs === s.mtimeMs),\n      'private_file_changed');\n    return data;\n  } finally { fs.closeSync(fd); }\n}\nfunction save(file, value) {\n  const fd = fs.openSync(file, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);\n  try { fs.writeFileSync(fd, JSON.stringify(value)); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }\n  const dir=fs.openSync(path.dirname(file),fs.constants.O_RDONLY|fs.constants.O_DIRECTORY|fs.constants.O_NOFOLLOW);\n  try { fs.fsyncSync(dir); } finally { fs.closeSync(dir); }\n}\nfunction within(root, file) {\n  const rel = path.relative(root, file);\n  return rel !== '' && rel !== '..' && !rel.startsWith('../') && !path.isAbsolute(rel);\n}\nfunction deny() { blockedOperations++; throw Object.assign(new Error('unexpected_operation_refused'), { safeCode: 'unexpected_operation_refused' }); }\nfunction secrets(credential) {\n  return Object.entries(credential ?? {}).filter(([key, value]) => typeof value === 'string' && value.length >= 8\n    && !['provider', 'type', 'chatgptPlanType'].includes(key)).map(([, value]) => value);\n}\n\ntry {\n  plan = JSON.parse(privateRead(process.argv[2]));\n  const ROOT='/Volumes/T5/hepta-vnext-recovery-20261013/mac-authbus-df026-current-registry-wal-r1';\n  need(plan.schema==='heptabao.mac-five-agent-worker.private.r1'\n    && ['cycle','rollback'].includes(plan.mode) && ['initial','cold-new-process'].includes(plan.phase),\n    'fixed_cycle_or_inverse_phase');\n  need(plan.workRoot===ROOT && plan.phaseRoot===path.join(ROOT,plan.phase)\n    && plan.stateRoot===path.join(plan.phaseRoot,'state')\n    && fs.realpathSync(plan.stateRoot)===plan.stateRoot,'fixed_owned_five_agent_state');\n  need(Number.isSafeInteger(plan.phaseRemainingMs) && plan.phaseRemainingMs>0\n    && plan.phaseRemainingMs<=120000 && plan.phaseOwnerPid===process.ppid,\n    'real_phase_owner_and_shared_remaining_allocation');\n  workerUntil=workerStarted+BigInt(plan.phaseRemainingMs)*1000000n;\n  report.mode=plan.mode;report.phase=plan.phase;\n  report.phaseOwnerAbsoluteDeadlineAuthoritative=true;\n  report.allocatedRemainingMs=plan.phaseRemainingMs;\n  check('scoped_application_roots',process.env.OPENCLAW_STATE_DIR===plan.stateRoot\n    && process.env.OPENCLAW_CONFIG_PATH===path.join(plan.stateRoot,'openclaw.json')\n    && process.env.OPENCLAW_OAUTH_DIR===path.join(plan.stateRoot,'oauth'));\n  for(const key of ['baselineOutput','candidateOutput','custodyOutput','rollbackOnce'])\n    need(within(plan.phaseRoot,plan[key]),'private_phase_output_scope.'+key);\n  need(within(ROOT,plan.pluginEntry),'owned_plugin_copy_scope');\n  const cfg=JSON.parse(privateRead(path.join(plan.stateRoot,'openclaw.json')));\n  check('all_five_actual_configured_agents',digest(cfg.agents.list.map(x=>x.id))===digest(agentIds));\n  const agentDir=path.join(plan.stateRoot,'agents/main/agent');\n  const target=new URL(plan.pluginConfig.address);\n  check('one_owned_loopback_https',target.protocol==='https:' && target.hostname==='127.0.0.1' && !!target.port);\n  const withoutConnection=value=>Object.fromEntries(Object.entries(value).filter(([key])=>\n    !['address','caFile','roleIdFile','secretIdFile'].includes(key)));\n  check('complete_original_authbus_flags_preserved',digest(withoutConnection(plan.pluginConfig))\n    ===digest(withoutConnection(plan.originalPluginConfig)));\n  check('actual_mac_publish_and_order_flags',plan.pluginConfig.hostId==='mac'\n    && plan.pluginConfig.leader===false && plan.pluginConfig.publishNew===true\n    && plan.pluginConfig.manageOrder===true);\n  check('owned_config_only_connection_difference',digest(cfg.plugins.entries['openclaw-authbus'].config)\n    ===digest(plan.pluginConfig));\n  for(const [file,pin]of Object.entries(plan.sourcePins))\n    check('source.'+path.basename(file),hash(fs.readFileSync(file))===pin);\n  const originalHttpsRequest=https.request;\n  const originalExecFileSync=childProcess.execFileSync;\n  for(const method of ['log','warn','error','info','debug'])console[method]=()=>{};\n  globalThis.fetch=deny;http.request=deny;http.get=deny;https.get=deny;\n  for(const method of ['spawn','spawnSync','exec','execSync','execFile','execFileSync','fork'])\n    childProcess[method]=deny;\n  childProcess.execFileSync=(file,args,options)=>{\n    if(file!=='mount'||!Array.isArray(args)||args.length||options!==undefined)return deny();\n    const s=fs.lstatSync('/sbin/mount');\n    need(process.platform==='darwin'&&s.isFile()&&s.uid===0&&(s.mode&0o022)===0,'trusted_mount_tool');\n    return originalExecFileSync('/sbin/mount',[],{timeout:remainingMs(3000),maxBuffer:262144,\n      stdio:['ignore','pipe','pipe'],env:{PATH:'/usr/bin:/bin:/usr/sbin:/sbin'}});\n  };\n  baoAgent=new https.Agent({keepAlive:false,maxCachedSessions:0});\n  https.request=(options,callback)=>{\n    need(plan.mode==='cycle','inverse_has_no_network');\n    need(options&&typeof options==='object'&&!(options instanceof URL),'https_shape');\n    need((options.hostname||options.host)===target.hostname\n      &&String(options.port||443)===target.port&&options.rejectUnauthorized===true,'https_endpoint_or_trust');\n    const route=options.path;\n    const allowed=options.method==='POST'&&route==='/v1/auth/approle/login'\n      ||options.method==='GET'&&route.startsWith('/v1/openclaw-auth/data/')\n      ||options.method==='POST'&&route.startsWith('/v1/openclaw-auth/data/inbox/'+plan.pluginConfig.hostId+'/');\n    need(allowed,'https_operation_scope');\n    remainingMs(1);\n    const item={method:options.method,path:route,dispatched:true,complete:false};\n    report.wire.push(item);\n    const req=originalHttpsRequest({...options,agent:baoAgent},response=>{\n      item.status=response.statusCode;item.tlsVerified=response.socket.authorized===true;\n      const cert=response.socket.getPeerCertificate?.();item.peerSha256=cert?.raw?hash(cert.raw):null;\n      need(item.tlsVerified&&item.peerSha256===plan.serverCertificateSha256,'https_peer_pin');\n      let size=0;const chunks=[];\n      response.on('data',part=>{size+=part.length;if(size<=1048576)chunks.push(part);});\n      response.on('aborted',()=>{item.aborted=true;});\n      response.on('error',()=>{item.responseError=true;});\n      response.on('end',()=>{\n        item.complete=response.complete===true&&size<=1048576;\n        item.responseBytes=size;\n        if(!item.complete)return;\n        if(route==='/v1/auth/approle/login'){\n          try{\n            const value=JSON.parse(Buffer.concat(chunks));\n            if(response.statusCode===200&&typeof value.auth?.client_token==='string'){\n              tokens.push(value.auth.client_token);sensitive.push(value.auth.client_token);\n            }else item.complete=false;\n          }catch{item.complete=false;}\n        }\n      });\n      callback(response);\n    });\n    req.on('error',()=>{item.requestError=true;});\n    return req;\n  };\n  syncBuiltinESMExports();\n  const rawBefore=Object.fromEntries(agentIds.map(id=>[id,captureAuthRows(plan.stateRoot,id)]));\n  const cachesBefore=captureAuthBusCaches(plan.stateRoot);\n  const sdk=await import(pathToFileURL(path.join(plan.sdkRoot,'dist/plugin-sdk/agent-runtime.js')));\n  const storeApi=await import(pathToFileURL(path.join(plan.sdkRoot,'dist/store-DH33UrUj.js')));\n  sdkRuntime=sdk;storeRuntime=storeApi;\n  const orderApi=await import(pathToFileURL(path.join(plan.sdkRoot,'dist/order-CeBlX0NH.js')));\n  check('sdk_default_scope',path.resolve(sdk.resolveDefaultAgentDir({}))===agentDir);\n  const currentStores=()=>{\n    sdk.clearRuntimeAuthProfileStoreSnapshots();\n    return Object.fromEntries(agentIds.map(id=>[id,sdk.loadAuthProfileStoreWithoutExternalProfiles(\n      path.join(plan.stateRoot,'agents',id,'agent'),{allowKeychainPrompt:false})]));\n  };\n  const localStores=async()=>{\n    const result={};\n    for(const id of agentIds){\n      let observed;\n      const value=await storeApi.m({agentDir:path.join(plan.stateRoot,'agents',id,'agent'),updater:store=>{\n        observed=structuredClone(store);return false;\n      }});\n      check('actual_sdk_local_observation.'+id,value!==null&&observed!==undefined&&digest(value)===digest(observed));\n      result[id]=observed;\n    }\n    return result;\n  };\n  const allCurrent=currentStores(),allLocal=await localStores();\n  for(const id of agentIds){\n    check('read_only_sdk_observation_preserved_raw.'+id,\n      authRowsDigest(captureAuthRows(plan.stateRoot,id))===authRowsDigest(rawBefore[id]));\n    for(const [profile,cred]of Object.entries(allCurrent[id].profiles)){\n      sensitive.push(profile);sensitive.push(...secrets(cred));\n    }\n  }\n  if(plan.mode==='rollback'){\n    // Durable create-only consumption precedes every mutation and every CAS.\n    // A conflict consumes this operation; no later worker may retry it.\n    save(plan.rollbackOnce,{schema:'heptabao.mac-inverse-once.r1',phase:plan.phase,\n      pid:process.pid,baselineSha256:hash(privateRead(plan.baselineOutput)),\n      candidateSha256:hash(privateRead(plan.candidateOutput))});\n    baselineDoc=JSON.parse(privateRead(plan.baselineOutput));\n    const candidate=JSON.parse(privateRead(plan.candidateOutput));\n    check('five_agent_baseline_and_candidate_scope',\n      digest(Object.keys(baselineDoc.stores).sort())===digest([...agentIds].sort())\n      &&digest(Object.keys(candidate.stores).sort())===digest([...agentIds].sort()));\n    check('inverse_complete_six_cache_candidate',digest(cachesBefore)===digest(candidate.authbusCaches));\n    for(const id of agentIds){\n      check('inverse_effective_read_candidate.'+id,digest(allCurrent[id])===digest(candidate.stores[id]));\n      check('inverse_local_write_candidate.'+id,digest(allLocal[id])===digest(candidate.localStores[id]));\n      check('inverse_raw_candidate.'+id,authRowsDigest(rawBefore[id])===authRowsDigest(candidate.authRows[id]));\n    }\n    inverseMutationAttempted=true;\n    for(const id of agentIds){\n      let applied=false;\n      const value=await storeApi.m({agentDir:path.join(plan.stateRoot,'agents',id,'agent'),updater:store=>{\n        if(digest(store)!==digest(candidate.localStores[id]))return false;\n        for(const key of Object.keys(store))delete store[key];\n        // ONLY the actually captured local store is written. Derived effective\n        // inheritance is never a write input, including trnm's empty primary.\n        Object.assign(store,structuredClone(baselineDoc.localStores[id]));applied=true;return true;\n      }});\n      check('installed_sdk_local_cas_inverse.'+id,value!==null&&applied);\n    }\n    const postSdkRows=Object.fromEntries(agentIds.map(id=>[id,captureAuthRows(plan.stateRoot,id)]));\n    for(const id of agentIds)check('original_raw_rows_and_stamps_inverse.'+id,\n      restoreAuthRowsWithCas(plan.stateRoot,id,postSdkRows[id],baselineDoc.authRows[id]));\n    // Recompute effective stores ONLY after every real local/raw row is back.\n    const restored=currentStores(),restoredLocal=await localStores();\n    for(const id of agentIds){\n      check('restored_local_exact.'+id,digest(restoredLocal[id])===digest(baselineDoc.localStores[id]));\n      check('derived_effective_recomputed_exact.'+id,digest(restored[id])===digest(baselineDoc.stores[id]));\n      check('restored_raw_still_exact_after_reads.'+id,\n        authRowsDigest(captureAuthRows(plan.stateRoot,id))===authRowsDigest(baselineDoc.authRows[id]));\n    }\n    check('six_cache_exact_candidate_cas_inverse',\n      restoreAuthBusCachesWithCas(plan.stateRoot,candidate.authbusCaches,baselineDoc.authbusCaches));\n    check('six_original_cache_bytes_modes_absences',\n      cacheContentDigest(captureAuthBusCaches(plan.stateRoot))===cacheContentDigest(baselineDoc.authbusCaches));\n    inverseCompleted=true;\n    report.inverseWritesOnlyLocalAndRaw=true;\n    report.effectiveStoresOnlyRecomputedAndVerified=true;\n    report.rollbackAttemptedOnce=true;report.rollbackRetried=false;\n  }else{\n    baselineDoc={schema:'heptabao.mac-five-agent-baseline.private.r1',\n      stores:allCurrent,localStores:allLocal,authRows:rawBefore,authbusCaches:cachesBefore,phase:plan.phase};\n    check('six_original_cache_bytes_materialized',\n      cacheContentDigest(cachesBefore)===plan.originalCacheContentSha256);\n    for(const id of agentIds)check('actual_captured_primary_rows_materialized.'+id,\n      authRowsDigest(rawBefore[id])===plan.originalAuthRowsDigestByAgent[id]);\n    save(plan.baselineOutput,baselineDoc);\n    check('two_managed_same_identity_generations',Array.isArray(plan.managedProfiles)\n      &&plan.managedProfiles.length===2&&new Set(plan.managedProfiles.map(x=>x.profileId)).size===2);\n    const managedIds=new Set(plan.managedProfiles.map(x=>x.profileId));\n    const identity=cred=>({provider:cred?.provider,type:cred?.type,accountId:cred?.accountId,email:cred?.email});\n    for(const id of agentIds)for(const [index,item]of plan.managedProfiles.entries())\n      check('current_managed_identity_match.'+id+'.'+(index+1),\n        Object.hasOwn(allCurrent[id].profiles,item.profileId)\n        &&digest(identity(allCurrent[id].profiles[item.profileId]))===item.identityDigest);\n    check('original_trnm_local_profile_free',Object.keys(allLocal.trnm.profiles).length===0);\n    const plugin=(await import(pathToFileURL(plan.pluginEntry))).default;\n    check('actual_installed_plugin_export',plugin?.id==='openclaw-authbus'&&typeof plugin.register==='function');\n    let subscriptions=0;\n    plugin.register({registrationMode:'full',p