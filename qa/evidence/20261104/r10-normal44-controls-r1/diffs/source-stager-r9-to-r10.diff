+    assert git(SOURCE, 'show', '-s', '--format=%P', CANONICAL_COMMIT).decode().strip() == profile['commit']
+    assert git(SOURCE, 'rev-list', '--count', profile['commit']).decode().strip() == str(BASE_COUNT)
+    assert git(SOURCE, 'rev-list', '--count', CANONICAL_COMMIT).decode().strip() == str(CANONICAL_COUNT)
+    assert git(SOURCE, 'rev-list', '--max-parents=0', CANONICAL_COMMIT).decode().strip() == ROOT_COMMIT
+    added = git(SOURCE, 'rev-list', CANONICAL_COMMIT, '^' + profile['commit']).decode().splitlines()
+    assert added == [CANONICAL_COMMIT]
+    git(SOURCE, 'fsck', '--full', '--strict', '--no-reflogs', '--no-dangling', CANONICAL_COMMIT)
+    return {'commit': CANONICAL_COMMIT, 'tree': CANONICAL_TREE,
+            'sole_parent': profile['commit'], 'base_commit_count': BASE_COUNT,
+            'commit_count': CANONICAL_COUNT, 'added_commits': added, 'full_fsck_passed': True}
+
