+    let mut f = f.restart()?;
+    status(&f.admin("DELETE", "sys/mounts/ssh", json!({}))?, 204);
+    assert_eq!(
+        f.service
+            .state
+            .as_ref()
+            .ok_or("state")?
+            .engines
+            .record_root(),
