+/// Select the existing authenticated complete-reply framing, never a backend
+/// or authorization decision. An SSH mount may have any path (including a
+/// named issuer); only the actual engine owner can produce its private raw
+/// reply after normal Service admission. Carry the already admitted ingress
+/// through the peer frame rather than minting another one at the leader.
+pub(crate) fn requires_original_reply(
+    method: &str,
+    path: &str,
+    wrap_ttl_seconds: Option<u64>,
+    original_ingress: bool,
+    lexical_body: bool,
+) -> bool {
+    let public_key_reply = method == "GET"
+        && path
+            .rsplit_once('/')
+            .is_some_and(|(owner, leaf)| !owner.is_empty() && leaf == "public_key");
+    path == "sys/wrapping/unwrap"
+        || path.starts_with("sys/workflows/execute/")
+        || original_ingress && (wrap_ttl_seconds.is_some_and(|ttl| ttl > 0) || public_key_reply)
+        || lexical_body
+}
+
