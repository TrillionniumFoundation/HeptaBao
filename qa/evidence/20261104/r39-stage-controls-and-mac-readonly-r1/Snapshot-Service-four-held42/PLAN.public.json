  "gates": [
    {
      "id": "service-regression-1",
      "test": "service::native_v6_ha_pipeline_tests::historical_restore_tests::snapshot_forward_audit_tests::native_ha_snapshot_forward_source_publication_audit_veto_keeps_real_restore_after_cold_reopen",
      "fault": "After actual successful retained restore finalizer and response status/quota check, before peer publication validation",
      "actualPath": "Production snapshot listener -> source Actor admission -> real archive parse -> real quorum root/epoch restore -> finalizer/mandatory audit -> test-only activation drift and next-audit capacity exhaustion -> retained historical receipt publication-veto -> actual mTLS denial -> ingress audit",
      "expected": "503/outcome_unknown/retry_allowed=false/root_attempted=true/exact actual operation recovery reference; source fenced, no private response file, audit append denied, real cold reopen retains restored history/one epoch",
      "completionTrust": "Source-side original affine historical receipt; this case does not claim a successful binary CompletionWire was emitted."
    },
    {
      "id": "service-regression-2",
      "test": "service::native_v6_ha_pipeline_tests::historical_restore_tests::snapshot_forward_audit_tests::native_ha_snapshot_forward_first_delivery_audit_veto_keeps_authenticated_restore_after_cold_reopen",
      "fault": "After authenticated CompletionWire and actual final catch-up, before ingress first delivery_check",
      "actualPath": "Real successful source restore/MAC/body completion; ingress sync then actual activation mismatch; original audit_failure(data) attempts real denied audit append",
      "expected": "Authenticated original operation/reference survives audit failure, UNKNOWN/no replay, ingress fenced, actual epoch and cold reopen independently match."
    },
    {
      "id": "service-regression-3",
      "test": "service::native_v6_ha_pipeline_tests::historical_restore_tests::snapshot_forward_audit_tests::native_ha_snapshot_forward_second_delivery_audit_veto_keeps_authenticated_restore_after_cold_reopen",
      "fault": "After mandatory successful ingress response audit, before second delivery_check",
      "actualPath": "Real authenticated completion and first delivery gate; after success audit inject activation drift and exhaust capacity; second gate veto then failed_delivery attempts real denied audit append",
      "expected": "Same authenticated operation/reference survives secondary audit failure; no binary/publication capability, actual restored epoch/cold state persists."
    },
    {
      "id": "service-regression-4",
      "test": "service::native_v6_ha_pipeline_tests::historical_restore_tests::snapshot_forward_audit_tests::native_ha_snapshot_forward_unverified_attempt_audit_failure_cannot_mint_root_authority",
      "subcases": 2,
      "fault": "After actual ingress admission, deny next real audit append; branch A calls real reject_before_exchange with forged JSON, branch B performs one actual enrolled mTLS exchange receiving nonce-bound forged denial without READY/CompletionMAC",
      "expected": "Branch A no UNKNOWN/root/reference, zero peer calls. Branch B conservative UNKNOWN/no replay but no root/reference, one actual peer callback. Both actual selected root/epoch unchanged."
    }
