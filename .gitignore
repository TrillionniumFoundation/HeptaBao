# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python virtual environments
.venv/
venv/
env/

# Rust build outputs
/target/
**/target/

# Local editor and OS metadata
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local execution artifacts. Reviewed originals already tracked in qa/*/evidence,
# docs/evidence, planning/evidence, or qualifications remain versioned.
*.log
*.tmp

# Historical executable captures belong to their original Git commit or an
# evidence artifact, not the current source tree. See docs/REPOSITORY_LAYOUT.md.
# Current QA programs live beside evidence/ and remain tracked normally.
/qa/openbao-acceptance/evidence/**/*.py
/qa/openbao-acceptance/evidence/**/*.js
/qa/openbao-acceptance/evidence/**/*.mjs
/qa/openbao-acceptance/evidence/**/*.rs
