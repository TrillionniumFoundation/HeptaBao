+    fn batch_mutations() -> Result<Vec<(String, Option<Secret>)>, ServiceError> {
+        Ok(vec![
+            ("secret/a".into(), Some(Secret::new(b"alpha".to_vec())?)),
+            ("secret/b".into(), Some(Secret::new(b"beta".to_vec())?)),
+            ("secret/c".into(), None),
+        ])
+    }
+
+    #[test]
+    fn atomic_batch_commits_multiple_resources_under_one_identity() -> Result<(), ServiceError> {
+        let _serial = serial_test();
+        let root = TestRoot::new("atomic-batch")?;
+        let mut service = DurableService::create_new(&root.0, TestBarrier::new(), 8)?;
+        service.put(PutRequest::new(
+            "principal-a",
+            "tenant-a",
+            "seed",
+            "secret/c",
+            [8; 32],
+            Secret::new(b"old".to_vec())?,
+        )?)?;
+        let before = service.retained_request_count();
+        assert!(matches!(
+            service.apply_batch(
+                "principal-a",
+                "tenant-a",
+                "batch-1",
+                [9; 32],
+                batch_mutations()?,
+            )?,
+            MutationOutcome::Committed { generation: 2, .. }
+        ));
+        assert_eq!(service.retained_request_count(), before + 1);
+        assert_eq!(
+            service.get("tenant-a", "secret/a")?.unwrap().expose(),
+            b"alpha"
+        );
+        assert_eq!(
+            service.get("tenant-a", "secret/b")?.unwrap().expose(),
+            b"beta"
+        );
+        assert!(service.get("tenant-a", "secret/c")?.is_none());
+        assert!(matches!(
+            service.apply_batch(
+                "principal-a",
+                "tenant-a",
+                "batch-1",
+                [9; 32],
+                batch_mutations()?,
+            )?,
+            MutationOutcome::Duplicate { generation: 2, .. }
+        ));
+        assert_eq!(service.retained_request_count(), before + 1);
+        Ok(())
+    }
